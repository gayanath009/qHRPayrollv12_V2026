@model qHRM.Areas.SysAdmin.Models.AdmUserGroup
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

<form asp-action="Edit" asp-controller="AdmUserGroup">
    <div class="dl-horizontal">
        <span class="alert-success ">
            @Html.ValidationSummary(true)
        </span>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.GrpId)
        @Html.HiddenFor(model => model.DshbrdId)
        <div class="form-group">
            <input asp-for="exName" class="form-control form-control-sm" hidden />
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control form-control-sm" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Desc" class="control-label"></label>
            <input asp-for="Desc" class="form-control form-control-sm" />
            <span asp-validation-for="Desc" class="text-danger"></span>
        </div>
        <div class="form-check">
            <input type="checkbox" asp-for="ShwAlEmp" class="form-check-input" id="chkShwAlEmp">
            <label class="form-check-label" for="chkShwAlEmp">Show All Employees</label>
            <span asp-validation-for="ShwAlEmp" class="text-danger"></span>
        </div>
        <div class="form-row"></div>

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Close" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
</form>


