@model qHRM.Areas.SysAdmin.Models.AdmUserGroup
<h5>Are you sure you want to delete this?</h5>

<form asp-action="Delete" asp-controller="AdmUserGroup">
    <div>
        @Html.HiddenFor(model => model.GrpId)
        <div class="form-group">
            @Html.DisplayNameFor(model => model.Name) : @Html.DisplayFor(model => model.Name)
        </div>
        <div class="form-group">
            @Html.DisplayNameFor(model => model.Desc) : @Html.DisplayFor(model => model.Desc)
        </div>

        <input type="submit" value="Delete" class="btn btn-sm  btn-danger" />        
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary" data-dismiss="modal" />
    </div>
</form>