@model qHRM.Areas.SysAdmin.Models.mvGroupPrivilege
<h5>Are you sure you want to delete this?</h5>
@using (Html.BeginForm("Delete", "AdmUserGroupPrivilege"))
{<div>
        @Html.HiddenFor(model => model.GrpId)
        <div class="form-group">
            @Html.DisplayNameFor(model => model.NameEng) : @Html.DisplayFor(model => model.NameEng)
        </div>
        
        <form asp-action="DeleteGet">
            <input type="submit" value="Delete" class="btn btn-sm  btn-danger" />            
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary" data-dismiss="modal" />
        </form>
    </div>
}