@model qHRM.Areas.SysAdmin.Models.AdmUserView

@using (Html.BeginForm("Delete", "AdmUser", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Usr_Id)
    @Html.HiddenFor(model => model.AspUser_Id)
    @Html.HiddenFor(model => model.AspUser_Name)
    @Html.HiddenFor(model => model.Usr_Name)

    <div class="alert alert-warning mb-3">
        <strong>Are you sure you want to delete this user?</strong>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label font-weight-bold">@Html.DisplayNameFor(model => model.Usr_Name):</label>
        <div class="col-sm-8 col-form-label">
            @Html.DisplayFor(model => model.Usr_Name)
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-4 col-form-label font-weight-bold">@Html.DisplayNameFor(model => model.Full_Name):</label>
        <div class="col-sm-8 col-form-label">
            @Html.DisplayFor(model => model.Full_Name)
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-4 col-form-label font-weight-bold">Group Name:</label>
        <div class="col-sm-8 col-form-label">
            @Html.DisplayFor(model => model.Grp_Name)
        </div>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Delete" class="btn btn-sm btn-danger btn-block" />
        <input type="button" value="Back" class="btn btn-sm btn-outline-secondary btn-block" data-dismiss="modal" />
    </div>
}