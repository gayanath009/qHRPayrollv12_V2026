</div>

<!-- ============================================================== -->
<!-- MODAL: APPROVAL / REJECTION COMMENTS                           -->
<!-- ============================================================== -->
<div class="modal fade" id="modalApprovalAction" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light py-2">
                <h6 class="modal-title font-weight-bold text-dark" id="approvalActionTitle">
                    Workflow Action
                </h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="actionRegId" />
                <input type="hidden" id="actionIsApprove" />
                <p id="actionPromptText" class="small text-dark mb-2"></p>
                <div class="form-group mb-0">
                    <label class="reg-field-label">Comments / Remarks *</label>
                    <textarea id="actionComments" class="form-control form-control-sm" rows="3" placeholder="Enter comments..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnConfirmApprovalAction" onclick="executeApprovalAction()">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    // State variables
    let currentFromDate = '@fromDateStr';
    let currentToDate = '@toDateStr';
    let currentTargetEmpId = @targetEmpSysId;
    let applicableDatesCache = [];

    // =========================================================================
    // SEARCHABLE EMPLOYEE DROPDOWNS (SELECT2 INITIALIZATION)
    // =========================================================================
    $(document).ready(function () {
        if ($.fn.select2) {
            // Global header employee dropdown
            $('#selGlobalEmployee').select2({
                theme: 'bootstrap4',
                width: '300px',
                placeholder: 'Search employee...'
            }).on('change', function () {
                onEmployeeChanged(this.value);
            });

            // Modal employee dropdown
            $('#modalEmpSysId').select2({
                theme: 'bootstrap4',
                width: '100%',
                dropdownParent: $('#modalRequestRegularization'),
                placeholder: 'Search employee...'
            }).on('change', function () {
                loadApplicableDates();
            });
        }
    });

    // =========================================================================
    // TOAST NOTIFICATIONS (Matching user's style)
    // =========================================================================
    function showAppToast(title, message, isError = false) {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = 'app-toast-pill ' + (isError ? 'error' : '');
        toast.innerHTML = `
            <div>
                <strong class="${isError ? 'text-danger' : 'text-success'}">${title}</strong> ${message}
            </div>
            <button type="button" class="toast-close" onclick="this.parentElement.remove()">&times;</button>
        `;
        container.appendChild(toast);
        setTimeout(() => {
            if (toast.parentElement) toast.remove();
        }, 5000);
    }

    // =========================================================================
    // MAIN TAB SWITCHING
    // =========================================================================
    function switchMainTab(tabKey) {
        document.querySelectorAll('.reg-nav-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-pane-content').forEach(p => p.style.display = 'none');

        const activeTabEl = document.querySelector(`.reg-nav-tab[data-tab="${tabKey}"]`);
        if (activeTabEl) activeTabEl.classList.add('active');

        if (tabKey === 'summary') {
            document.getElementById('tabSummary').style.display = 'block';
        } else if (tabKey === 'requests') {
            document.getElementById('tabRequests').style.display = 'block';
        } else if (tabKey === 'approvals') {
            document.getElementById('tabApprovals').style.display = 'block';
        } else if (tabKey === 'config') {
            const el = document.getElementById('tabConfig');
            if (el) el.style.display = 'block';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        try {
            const urlParams = new URLSearchParams(window.location.search);
            const targetTab = urlParams.get('tab') || urlParams.get('viewTab') || (window.location.hash ? window.location.hash.replace('#', '') : null) || '@(ViewBag.ViewTab ?? "summary")';
            if (targetTab && targetTab !== 'summary' && ['requests', 'approvals', 'config'].includes(targetTab)) {
                switchMainTab(targetTab);
            }
        } catch (e) {
            console.error('Error switching main tab:', e);
        }
    });

    // =========================================================================
    // EMPLOYEE CHANGE & WEEK NAVIGATION
    // =========================================================================
    function onEmployeeChanged(empSysId) {
        currentTargetEmpId = empSysId;
        window.location.href = `/Attendance/HrEmpAttendExp?empSysId=${empSysId}&fromDate=${currentFromDate}&toDate=${currentToDate}`;
    }

    function navigateWeek(dayOffset) {
        let baseDate = new Date(currentFromDate);
        if (isNaN(baseDate.getTime())) baseDate = new Date();

        if (dayOffset === 0) {
            window.location.href = `/Attendance/HrEmpAttendExp?empSysId=${currentTargetEmpId}`;
            return;
        }

        baseDate.setDate(baseDate.getDate() + dayOffset);
        const diff = (7 + (baseDate.getDay() - 0)) % 7;
        const newFrom = new Date(baseDate);
        newFrom.setDate(baseDate.getDate() - diff);
        const newTo = new Date(newFrom);
        newTo.setDate(newFrom.getDate() + 6);

        const fromStr = formatDate(newFrom);
        const toStr = formatDate(newTo);
        window.location.href = `/Attendance/HrEmpAttendExp?empSysId=${currentTargetEmpId}&fromDate=${fromStr}&toDate=${toStr}`;
    }

    function formatDate(d) {
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const day = ('0' + d.getDate()).slice(-2);
        return `${day}-${months[d.getMonth()]}-${d.getFullYear()}`;
    }

    // =========================================================================
    // MODAL: REQUEST REGULARIZATION
    // =========================================================================
    // =========================================================================
    // WORKING DAYS & CONFIGURATION HELPERS
    // =========================================================================
    const maxWorkingDaysConfig = @config.MaxDaysAllowed;

    function getYesterdayYMD() {
        const d = new Date();
        d.setDate(d.getDate() - 1);
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function isQatarWorkingDay(d) {
        const day = d.getDay();
        return day !== 5 && day !== 6; // 5 = Friday, 6 = Saturday (weekends in Qatar)
    }

    function getLatestWorkingDay(date) {
        let d = new Date(date);
        while (d.getDay() === 5 || d.getDay() === 6) {
            d.setDate(d.getDate() - 1);
        }
        return d;
    }

    function countWorkingDays(startDateStr, endDateStr) {
        if (!startDateStr || !endDateStr) return 0;
        let start = new Date(startDateStr);
        let end = new Date(endDateStr);
        if (end < start) return 0;

        let count = 0;
        let curr = new Date(start);
        while (curr <= end) {
            if (isQatarWorkingDay(curr)) {
                count++;
            }
            curr.setDate(curr.getDate() + 1);
        }
        return count;
    }

    function getStartDateForWorkingDaysBackwards(endDate, workingDaysCount) {
        let curr = new Date(endDate);
        let count = 0;
        while (count < workingDaysCount) {
            if (isQatarWorkingDay(curr)) {
                count++;
                if (count === workingDaysCount) {
                    return curr;
                }
            }
            curr.setDate(curr.getDate() - 1);
        }
        return curr;
    }

    function formatDateYMD(d) {
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function openRegularizationModal(targetDateStr, empSysId) {
        if (targetDateStr) {
            const checkDate = new Date(targetDateStr);
            const dayOfWeek = checkDate.getDay();
            if (dayOfWeek === 5 || dayOfWeek === 6) {
                showAppToast('Weekend Not Applicable', 'Regularization is not applicable for weekends (Friday and Saturday).', true);
                return;
            }
        }

        if (empSysId && empSysId > 0) {
            currentTargetEmpId = empSysId;
        }

        const empSelect = document.getElementById('modalEmpSysId');
        if (empSelect) empSelect.value = currentTargetEmpId;
        if ($.fn.select2 && $('#modalEmpSysId').data('select2')) {
            $('#modalEmpSysId').val(currentTargetEmpId).trigger('change.select2');
        }

        const periodSelect = document.getElementById('modalPeriodType');
        if (periodSelect) periodSelect.value = 'Day';

        const wrapSingle = document.getElementById('wrapSingleDate');
        const wrapCustom = document.getElementById('wrapCustomEndDate');
        if (wrapSingle) wrapSingle.className = 'col-md-6';
        if (wrapCustom) wrapCustom.style.display = 'none';

        const yesterdayStr = getYesterdayYMD();
        const targetDateInput = document.getElementById('modalTargetDate');
        const customEndDateInput = document.getElementById('modalCustomEndDate');
        targetDateInput.max = yesterdayStr;
        customEndDateInput.max = yesterdayStr;

        if (targetDateStr && targetDateStr <= yesterdayStr) {
            targetDateInput.value = targetDateStr;
        } else {
            const yesterdayDate = new Date();
            yesterdayDate.setDate(yesterdayDate.getDate() - 1);
            const latestWorking = getLatestWorkingDay(yesterdayDate);
            targetDateInput.value = formatDateYMD(latestWorking);
        }

        document.getElementById('fileAttachmentInput').value = '';
        const ind = document.getElementById('fileSelectedIndicator');
        if (ind) {
            ind.style.display = 'none';
            ind.innerHTML = '';
        }

        loadApplicableDates();
        $('#modalRequestRegularization').modal('show');
    }

    function onPeriodTypeChanged(periodType) {
        const wrapSingle = document.getElementById('wrapSingleDate');
        const wrapCustom = document.getElementById('wrapCustomEndDate');
        const yesterdayStr = getYesterdayYMD();
        const targetDateInput = document.getElementById('modalTargetDate');
        const customEndDateInput = document.getElementById('modalCustomEndDate');

        targetDateInput.max = yesterdayStr;
        customEndDateInput.max = yesterdayStr;

        if (periodType === 'Custom') {
            wrapSingle.className = 'col-md-3';
            wrapCustom.style.display = 'block';

            // End date defaults to yesterday
            customEndDateInput.value = yesterdayStr;

            // Start date defaults to maxWorkingDaysConfig working days backwards from yesterday
            const yesterdayDate = new Date();
            yesterdayDate.setDate(yesterdayDate.getDate() - 1);
            const startDateObj = getStartDateForWorkingDaysBackwards(yesterdayDate, maxWorkingDaysConfig);
            targetDateInput.value = formatDateYMD(startDateObj);
        } else {
            wrapSingle.className = 'col-md-6';
            wrapCustom.style.display = 'none';
            if (targetDateInput.value > yesterdayStr) {
                targetDateInput.value = yesterdayStr;
            }
        }
        loadApplicableDates();
    }

    function handleFileSelect(input) {
        const ind = document.getElementById('fileSelectedIndicator');
        if (input.files && input.files[0]) {
            const f = input.files[0];
            if (f.size > 5 * 1024 * 1024) {
                showAppToast('Validation', 'File size exceeds 5MB limit.', true);
                input.value = '';
                ind.style.display = 'none';
                return;
            }
            ind.innerHTML = `<i class="fas fa-paperclip mr-1"></i> Attached: <strong>${f.name}</strong> (${(f.size / 1024).toFixed(1)} KB)`;
            ind.style.display = 'block';
        } else {
            ind.style.display = 'none';
        }
    }

    // =========================================================================
    // AJAX: LOAD APPLICABLE DATES & TIMER CONTROLS
    // =========================================================================
    function loadApplicableDates() {
        const empSysId = document.getElementById('modalEmpSysId').value || currentTargetEmpId;
        const periodType = document.getElementById('modalPeriodType').value;
        const targetDate = document.getElementById('modalTargetDate').value;
        const customEndDate = (periodType === 'Custom') ? document.getElementById('modalCustomEndDate').value : '';

        const tbody = document.getElementById('tbodyApplicableDates');
        const btnSubmit = document.getElementById('btnSubmitRegularization');
        const yesterdayStr = getYesterdayYMD();

        // Strict rule: Today's attendance cannot be regularized until shift completes
        if (targetDate > yesterdayStr) {
            document.getElementById('modalTargetDate').value = yesterdayStr;
            showAppToast('Validation', "Today's attendance cannot be regularized until the shift is completed.", true);
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-warning font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> Today's attendance cannot be regularized until the shift is completed. You can regularize attendance up to yesterday.</td></tr>`;
            document.getElementById('lblApplicableSummary').innerText = '0 eligible day(s)';
            applicableDatesCache = [];
            if (btnSubmit) btnSubmit.disabled = true;
            return;
        }

        if (periodType === 'Day' && targetDate) {
            const checkDate = new Date(targetDate);
            const dayOfWeek = checkDate.getDay();
            if (dayOfWeek === 5 || dayOfWeek === 6) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-warning font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> Weekends (Friday and Saturday) are non-working days and cannot be regularized.</td></tr>`;
                document.getElementById('lblApplicableSummary').innerText = '0 eligible day(s) (Weekend)';
                applicableDatesCache = [];
                if (btnSubmit) btnSubmit.disabled = true;
                return;
            }
        }

        if (periodType === 'Custom') {
            if (customEndDate > yesterdayStr) {
                document.getElementById('modalCustomEndDate').value = yesterdayStr;
                showAppToast('Validation', "Today's attendance cannot be regularized. End Date has been set to yesterday.", true);
                loadApplicableDates();
                return;
            }

            if (customEndDate < targetDate) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-warning font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> End Date cannot be before Start Date.</td></tr>`;
                document.getElementById('lblApplicableSummary').innerText = '0 day(s)';
                applicableDatesCache = [];
                if (btnSubmit) btnSubmit.disabled = true;
                return;
            }

            const workingDaysCount = countWorkingDays(targetDate, customEndDate);
            if (workingDaysCount > maxWorkingDaysConfig) {
                showAppToast('Warning', `You cannot regularize more than ${maxWorkingDaysConfig} working days entries.`, true);
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-warning font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> You cannot regularize more than ${maxWorkingDaysConfig} working days entries. Selected range contains ${workingDaysCount} working days. Please adjust your date range.</td></tr>`;
                document.getElementById('lblApplicableSummary').innerText = `${workingDaysCount} working days (Exceeds max ${maxWorkingDaysConfig})`;
                applicableDatesCache = [];
