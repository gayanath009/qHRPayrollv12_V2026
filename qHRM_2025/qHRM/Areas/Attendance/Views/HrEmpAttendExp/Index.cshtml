    // =========================================================================
    // TOGGLE ROW SKIP REGULARIZATION
    // Disables inputs and dims row when marked to skip; excludes from validation
    // =========================================================================
    function toggleRowSkip(idx) {
        const chk = document.getElementById(`chkSkip_${idx}`);
        if (!chk) return;
        const isSkipped = chk.checked;
        const row = document.querySelector(`tr[data-index="${idx}"]`);
        const inEl = document.getElementById(`chkInTime_${idx}`);
        const outEl = document.getElementById(`chkOutTime_${idx}`);
        const selEl = document.getElementById(`selReason_${idx}`);
        const descEl = document.getElementById(`txtDesc_${idx}`);
        const totEl = document.getElementById(`totHours_${idx}`);

        if (isSkipped) {
            if (row) {
                row.classList.add('table-secondary', 'row-skipped');
            }
            if (inEl) {
                inEl.disabled = true;
                inEl.value = '';
                inEl.classList.remove('border-danger');
            }
            if (outEl) {
                outEl.disabled = true;
                outEl.value = '';
                outEl.classList.remove('border-danger');
            }
            if (selEl) {
                selEl.disabled = true;
                selEl.classList.remove('border-danger');
            }
            if (descEl) {
                descEl.disabled = true;
                descEl.classList.remove('border-danger');
            }
            if (totEl) {
                totEl.innerText = '00:00';
                totEl.classList.add('text-muted');
            }
        } else {
            if (row) {
                row.classList.remove('table-secondary', 'row-skipped');
            }
            if (inEl) inEl.disabled = false;
            if (outEl) outEl.disabled = false;
            if (selEl) selEl.disabled = false;
            if (descEl) descEl.disabled = false;
            if (totEl) totEl.classList.remove('text-muted');
        }
    }

    // =========================================================================
    // SYNC DESCRIPTION WITH SELECTED REASON & HANDLE "OTHER" MANDATORY
    // =========================================================================
    function onReasonChanged(idx) {
        const sel = document.getElementById(`selReason_${idx}`);
        const descEl = document.getElementById(`txtDesc_${idx}`);
        if (!sel || !descEl) return;

        const val = sel.value;
        if (val === 'Other') {
            descEl.value = '';
            descEl.placeholder = 'Please enter reason description (Mandatory) *';
            descEl.classList.add('border-danger');
            descEl.focus();
        } else if (val) {
            descEl.value = val;
            descEl.placeholder = 'Description';
            descEl.classList.remove('border-danger');
        } else {
            descEl.value = '';
            descEl.placeholder = 'Description';
            descEl.classList.remove('border-danger');
        }
    }

    // =========================================================================
    // DYNAMIC HOURS CALCULATION BASED ON CHECK-IN & CHECK-OUT TIMER CONTROLS
    // Check-in defaults to AM, Check-out defaults to PM
    // =========================================================================
    function onCheckInChanged(idx) {
        const inEl = document.getElementById(`chkInTime_${idx}`);
        if (!inEl) return;
        let val = inEl.value;
        if (val) {
            const parts = val.split(':');
            let h = parseInt(parts[0], 10);
            const m = parseInt(parts[1], 10);

            const lastH = inEl.dataset.lastH ? parseInt(inEl.dataset.lastH, 10) : null;
            const lastM = inEl.dataset.lastM ? parseInt(inEl.dataset.lastM, 10) : null;
            const isManualToggle = (lastH !== null && Math.abs(h - lastH) === 12 && m === lastM);

            if (isManualToggle) {
                inEl.dataset.manualChoice = "true";
            } else if (!inEl.dataset.manualChoice) {
                // By default, Check-in is AM (morning shift):
                // If input entered / defaulted to PM (h >= 12), convert to AM
                if (h >= 12) {
                    h = h % 12;
                    val = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
                    inEl.value = val;
                }
            }
            inEl.dataset.lastH = h;
            inEl.dataset.lastM = m;
        } else {
            delete inEl.dataset.lastH;
            delete inEl.dataset.lastM;
            delete inEl.dataset.manualChoice;
        }
        recalculateRowHours(idx);
    }

    function onCheckOutChanged(idx) {
        const outEl = document.getElementById(`chkOutTime_${idx}`);
        if (!outEl) return;
        let val = outEl.value;
        if (val) {
            const parts = val.split(':');
            let h = parseInt(parts[0], 10);
            const m = parseInt(parts[1], 10);

            const lastH = outEl.dataset.lastH ? parseInt(outEl.dataset.lastH, 10) : null;
            const lastM = outEl.dataset.lastM ? parseInt(outEl.dataset.lastM, 10) : null;
            const isManualToggle = (lastH !== null && Math.abs(h - lastH) === 12 && m === lastM);

            if (isManualToggle) {
                outEl.dataset.manualChoice = "true";
            } else if (!outEl.dataset.manualChoice) {
                // By default, Check-out is PM (afternoon/evening):
                // In 12-hour locales, typing numbers 1..11 yields 01:00..11:59 (AM).
                // Automatically convert 1..11 to PM (13:00..23:59):
                if (h >= 1 && h <= 11) {
                    h = h + 12;
                    val = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
                    outEl.value = val;
                }
            }
            outEl.dataset.lastH = h;
            outEl.dataset.lastM = m;
        } else {
            delete outEl.dataset.lastH;
            delete outEl.dataset.lastM;
            delete outEl.dataset.manualChoice;
        }
        recalculateRowHours(idx);
    }

    function recalculateRowHours(idx) {
        const inEl = document.getElementById(`chkInTime_${idx}`);
        const outEl = document.getElementById(`chkOutTime_${idx}`);
        const totEl = document.getElementById(`totHours_${idx}`);
        if (!inEl || !outEl || !totEl) return;

        const inVal = inEl.value;
        const outVal = outEl.value;

        if (!inVal || !outVal) {
            totEl.innerText = "00:00";
            return;
        }

        const [inH, inM] = inVal.split(':').map(Number);
        const [outH, outM] = outVal.split(':').map(Number);

        let diffMinutes = (outH * 60 + outM) - (inH * 60 + inM);
        if (diffMinutes < 0) {
            diffMinutes = 0;
        }

        const h = Math.floor(diffMinutes / 60);
        const m = diffMinutes % 60;
        totEl.innerText = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
    }

    // =========================================================================
    // SUBMIT REGULARIZATION REQUEST
    // =========================================================================
    function submitRegularizationForm() {
        if (!applicableDatesCache || applicableDatesCache.length === 0) {
            showAppToast('Validation', 'No eligible working days to regularize.', true);
            return;
        }

        const itemsToSubmit = [];
        for (let i = 0; i < applicableDatesCache.length; i++) {
            const d = applicableDatesCache[i];
            const isEligible = (d.IsEligible !== undefined) ? d.IsEligible : (d.isEligible !== undefined ? d.isEligible : true);
            if (!isEligible) continue;

            // If user checked Skip for this day, skip validation and submission
            const isSkipped = document.getElementById(`chkSkip_${i}`)?.checked;
            if (isSkipped) {
                continue;
            }

            const workedDay = d.WorkedDayText || d.workedDayText || `Day ${i + 1}`;
            const inTime = document.getElementById(`chkInTime_${i}`)?.value;
            const outTime = document.getElementById(`chkOutTime_${i}`)?.value;

            if (!inTime && !outTime) {
                showAppToast('Validation', `Please enter timings for ${workedDay} or check 'Skip' to exclude it.`, true);
                document.getElementById(`chkInTime_${i}`)?.focus();
                return;
            }

            if (!inTime) {
                showAppToast('Validation', `Please specify Check-in time for ${workedDay} or check 'Skip' to exclude it.`, true);
                document.getElementById(`chkInTime_${i}`)?.focus();
                return;
            }
            if (!outTime) {
                showAppToast('Validation', `Please specify Check-out time for ${workedDay} or check 'Skip' to exclude it.`, true);
                document.getElementById(`chkOutTime_${i}`)?.focus();
                return;
            }

            const reason = document.getElementById(`selReason_${i}`)?.value;
            if (!reason || reason === 'Select' || reason === '') {
                showAppToast('Validation', `Please select a Regularization Reason for ${workedDay}.`, true);
                document.getElementById(`selReason_${i}`)?.focus();
                return;
            }

            const [inH, inM] = inTime.split(':').map(Number);
            const [outH, outM] = outTime.split(':').map(Number);
            if ((outH * 60 + outM) <= (inH * 60 + inM)) {
                showAppToast('Validation', `Check-out time must be after Check-in time for ${workedDay}.`, true);
                document.getElementById(`chkOutTime_${i}`)?.focus();
                return;
            }

            const desc = (document.getElementById(`txtDesc_${i}`)?.value || '').trim();
            if (reason === 'Other' && !desc) {
                showAppToast('Validation', `Description is mandatory when reason is 'Other' for ${workedDay}.`, true);
                const descEl = document.getElementById(`txtDesc_${i}`);
                if (descEl) {
                    descEl.classList.add('border-danger');
                    descEl.focus();
                }
                return;
            }

            const dateStr = d.DateStr || d.dateStr || (d.Date ? d.Date.split('T')[0] : (d.date ? d.date.split('T')[0] : ''));

            const formattedInTime = inTime.length === 5 ? `${inTime}:00` : inTime;
            const formattedOutTime = outTime.length === 5 ? `${outTime}:00` : outTime;

            itemsToSubmit.push({
                date: dateStr,
                checkIn: `${dateStr}T${formattedInTime}`,
                checkOut: `${dateStr}T${formattedOutTime}`,
                reasonCategory: reason,
                description: desc || reason
            });
        }

        if (itemsToSubmit.length === 0) {
            showAppToast('Validation', 'Please select at least one day to regularize (uncheck Skip).', true);
            return;
        }

        if (itemsToSubmit.length > maxWorkingDaysConfig) {
            showAppToast('Validation', `You cannot regularize more than ${maxWorkingDaysConfig} working days entries.`, true);
            return;
        }

        const btn = document.getElementById('btnSubmitRegularization');
        btn.disabled = true;
        btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-1"></i> Submitting...`;

        const formData = new FormData();
        formData.append('EmpSysId', document.getElementById('modalEmpSysId').value);
        formData.append('PeriodType', document.getElementById('modalPeriodType').value);
        formData.append('ItemsJson', JSON.stringify(itemsToSubmit));

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append('__RequestVerificationToken', token);

        const fileInput = document.getElementById('fileAttachmentInput');
        if (fileInput.files && fileInput.files[0]) {
            formData.append('attachment', fileInput.files[0]);
        }

        fetch('/Attendance/HrEmpAttendExp/SubmitRegularization', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(result => {
            btn.disabled = false;
            btn.innerHTML = `<i class="fas fa-paper-plane mr-1"></i> Submit Regularization`;

            if (result.success || result.Success) {
                $('#modalRequestRegularization').modal('hide');
                showAppToast('Regularization', result.message || result.Message || 'Request Submitted Successfully');
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showAppToast('Submission Failed', result.message || result.Message, true);
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = `<i class="fas fa-paper-plane mr-1"></i> Submit Regularization`;
            showAppToast('Error', err.message, true);
        });
    }

    // =========================================================================
    // APPROVAL / REJECTION ACTIONS (REPORTING MANAGER & HR)
    // =========================================================================
    function promptApprovalAction(regId, isApprove, reqNo) {
        document.getElementById('actionRegId').value = regId;
        document.getElementById('actionIsApprove').value = isApprove ? '1' : '0';
        document.getElementById('actionComments').value = '';

        const title = document.getElementById('approvalActionTitle');
        const prompt = document.getElementById('actionPromptText');
        const btn = document.getElementById('btnConfirmApprovalAction');

        if (isApprove) {
            title.innerHTML = `<span class="text-success"><i class="fas fa-check-circle mr-1"></i> Approve Regularization</span>`;
            prompt.innerHTML = `Are you sure you want to <strong>APPROVE</strong> regularization request <strong>${reqNo}</strong>?`;
            btn.className = 'btn btn-sm btn-success';
            btn.innerText = 'Approve Request';
        } else {
            title.innerHTML = `<span class="text-danger"><i class="fas fa-times-circle mr-1"></i> Reject Regularization</span>`;
            prompt.innerHTML = `Are you sure you want to <strong>REJECT</strong> regularization request <strong>${reqNo}</strong>? (Full-day rejections will apply Loss of Pay).`;
            btn.className = 'btn btn-sm btn-danger';
            btn.innerText = 'Reject Request';
        }

        $('#modalApprovalAction').modal('show');
    }

    function executeApprovalAction() {
        const regId = document.getElementById('actionRegId').value;
        const isApprove = document.getElementById('actionIsApprove').value === '1';
        const comments = document.getElementById('actionComments').value.trim();

        if (!isApprove && !comments) {
            showAppToast('Validation', 'Please enter comments explaining why the request is rejected.', true);
            return;
        }

        const endpoint = isApprove ? '/Attendance/HrEmpAttendExp/ApproveRequest' : '/Attendance/HrEmpAttendExp/RejectRequest';
        const formData = new FormData();
        formData.append('regId', regId);
        formData.append('comments', comments);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append('__RequestVerificationToken', token);

        fetch(endpoint, {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(result => {
            $('#modalApprovalAction').modal('hide');
            if (result.success || result.Success) {
                showAppToast('Workflow', result.message || result.Message);
                setTimeout(() => window.location.reload(), 1400);
            } else {
                showAppToast('Action Failed', result.message || result.Message, true);
            }
        })
        .catch(err => {
            showAppToast('Error', err.message, true);
        });
    }

    // =========================================================================
    // WORKFLOW HISTORY TRACKING
    // =========================================================================
    function viewWorkflowHistory(regId) {
        fetch(`/Attendance/HrEmpAttendExp/GetWorkflowHistory?regId=${regId}`)
            .then(res => res.json())
            .then(data => {
                if (!data.success && !data.Success) {
                    showAppToast('Error', data.message || data.Message, true);
                    return;
                }

                const reqNo = data.ReqNo || data.reqNo || `REG-${regId}`;
                const currentStatus = data.CurrentStatus || data.currentStatus || 'Pending';
                const isLop = data.IsLop !== undefined ? data.IsLop : data.isLop;
                const historyList = data.History || data.history || [];

                document.getElementById('modalHistoryTitle').innerHTML = `<i class="fas fa-history text-primary mr-1"></i> Workflow Tracking - ${reqNo}`;
                document.getElementById('historyStatusBadge').innerText = currentStatus;
                document.getElementById('historyLopWarning').style.display = isLop ? 'block' : 'none';

                let html = '<div class="list-group list-group-flush">';
                if (historyList && historyList.length > 0) {
                    historyList.forEach(h => {
                        const stepName = h.StepName || h.stepName || '';
                        const action = h.Action || h.action || '';
                        const actorName = h.ActorName || h.actorName || '';
                        const actionDateTime = h.ActionDateTime || h.actionDateTime || '';
                        const comments = h.Comments || h.comments || '';

                        let actionColor = 'badge-secondary';
                        if (action === 'Approved') actionColor = 'badge-success';
                        else if (action === 'Rejected') actionColor = 'badge-danger';
                        else if (action === 'Submitted') actionColor = 'badge-primary';

                        html += `
                            <div class="list-group-item px-0 py-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark small">${stepName}</strong>
                                    <span class="badge ${actionColor}">${action}</span>
                                </div>
                                <div class="small text-muted mb-1">
                                    <i class="far fa-user mr-1"></i> ${actorName} &bull; <i class="far fa-clock mr-1"></i> ${actionDateTime}
                                </div>
                                ${comments ? `<div class="small bg-light p-2 rounded text-dark">${comments}</div>` : ''}
                            </div>
                        `;
                    });
                } else {
                    html += '<div class="text-center py-3 text-muted small">No workflow history records logged yet.</div>';
                }
                html += '</div>';

                document.getElementById('historyTimelineContent').innerHTML = html;
                $('#modalWorkflowHistory').modal('show');
            });
    }

    // =========================================================================
    // CONFIGURATION SAVE (ADMINS ONLY)
    // =========================================================================
    function saveConfiguration(e) {
        e.preventDefault();
        const maxDays = document.getElementById('cfgMaxDays').value;
        const allowFuture = document.getElementById('cfgAllowFuture').checked;
        const workingDays = document.getElementById('cfgWorkingDays').value;

        const formData = new FormData();
        formData.append('maxDays', maxDays);
        formData.append('allowFuture', allowFuture);
        formData.append('workingDays', workingDays);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append('__RequestVerificationToken', token);

        const btn = document.getElementById('btnSaveConfig');
        btn.disabled = true;

        fetch('/Attendance/HrEmpAttendExp/SaveConfig', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            if (data.success || data.Success) {
                showAppToast('Configuration', data.message || data.Message);
            } else {
                showAppToast('Config Error', data.message || data.Message, true);
            }
        })
        .catch(err => {
            btn.disabled = false;
            showAppToast('Error', err.message, true);
        });
    }
</script>
