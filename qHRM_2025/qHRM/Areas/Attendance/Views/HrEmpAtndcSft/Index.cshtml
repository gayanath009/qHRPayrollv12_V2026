<!-- Scripts -->
<script>
    $(document).ready(function () {
        // Initialize Select2 on Employee and Department dropdowns
        if ($.fn.select2) {
            $('#drpEmp').select2({
                theme: 'bootstrap4',
                width: '100%',
                placeholder: 'All Employee'
            });

            $('#drpDept').select2({
                theme: 'bootstrap4',
                width: '100%',
                placeholder: 'All Departments'
            });

            $('#drpEmp').on('change select2:select select2:clear', function () {
                loadAttdData();
                loadAttdSummary();
            });

            $('#drpDept').on('change select2:select select2:clear', function () {
                loadAttdData();
                loadAttdSummary();
            });
        }

        enblFxRngFltr();
    });

    function onDateRangeChange() {
        if ($('#chkDateRange').is(':checked')) {
            var dtFrom = $("#dtFrom").val();
            var dtTo = $("#dtTo").val();
            if (dtFrom && dtTo) {
                if (new Date(dtFrom) <= new Date(dtTo)) {
                    loadAttdData();
                    loadAttdSummary();
                }
            }
        }
    }

    function parseISODate(str) {
        if (!str) return new Date();
        var parts = str.split('-');
        if (parts.length === 3) {
            var y = parseInt(parts[0], 10);
            var m = parseInt(parts[1], 10) - 1;
            var d = parseInt(parts[2], 10);
            return new Date(y, m, d);
        }
        return new Date(str);
    }

    function formatAtndcDateToISO(d) {
        var year = d.getFullYear();
        var month = ('0' + (d.getMonth() + 1)).slice(-2);
        var day = ('0' + d.getDate()).slice(-2);
        return year + '-' + month + '-' + day;
    }

    function shiftAtndcCycle(direction) {
        var fromInput = document.getElementById('dtFrom');
        var toInput = document.getElementById('dtTo');

        var currFromVal = fromInput ? fromInput.value : '';
        var currFrom = currFromVal ? parseISODate(currFromVal) : new Date();

        // Shift month by direction with cycle starting on the 21st and ending on the 20th
        var newFrom = new Date(currFrom.getFullYear(), currFrom.getMonth() + direction, 21);
        var newTo = new Date(newFrom.getFullYear(), newFrom.getMonth() + 1, 20);

        // Auto select Date Range radio button and enable inputs
        $('#chkDateRange').prop('checked', true);
        $('#chkFxRngFltr').prop('checked', false);
        enblFxRngFltr();

        if (fromInput) fromInput.value = formatAtndcDateToISO(newFrom);
        if (toInput) toInput.value = formatAtndcDateToISO(newTo);

        loadAttdData();
        loadAttdSummary();
    }

    function resetAtndcCurrentCycle() {
        var today = new Date();
        var fromDate, toDate;
        if (today.getDate() <= 20) {
            fromDate = new Date(today.getFullYear(), today.getMonth() - 1, 21);
            toDate = new Date(today.getFullYear(), today.getMonth(), 20);
        } else {
            fromDate = new Date(today.getFullYear(), today.getMonth(), 21);
            toDate = new Date(today.getFullYear(), today.getMonth() + 1, 20);
        }

        // Auto select Date Range radio button and enable inputs
        $('#chkDateRange').prop('checked', true);
        $('#chkFxRngFltr').prop('checked', false);
        enblFxRngFltr();

        var fromInput = document.getElementById('dtFrom');
        var toInput = document.getElementById('dtTo');
        if (fromInput) fromInput.value = formatAtndcDateToISO(fromDate);
        if (toInput) toInput.value = formatAtndcDateToISO(toDate);

        loadAttdData();
        loadAttdSummary();
    }

    var editFunc = function (atndcSftId) {
        var url = "/Attendance/HrEmpAtndcSft/EditGet?atndcSftId=" + atndcSftId;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
        });
    };

    var shiftFunc = function (atndcSftId) {
        var url = "/Attendance/HrEmpAtndcSft/ShiftGet?atndcSftId=" + atndcSftId;
        $("#shiftModalBody").load(url, function () {
            $("#modalShift").modal("show");
        });
    };

    var markAbsentFunc = function () {
        var url = "/Attendance/HrEmpAtndcSft/GetMarkAbsent";
        $("#markabsentModalBody").load(url, function () {
            $("#modalMarkAbsent").modal("show");
        });
    };

    var markResetAbsentFunc = function () {
        var url = "/Attendance/HrEmpAtndcSft/GetResetMarkAbsent";
        $("#markResetAbsentModalBody").load(url, function () {
            $("#modalResetMarkAbsent").modal("show");
        });
    };

    var reloadAtndcFunc = function () {
        var drpEmp = $('#chkEmpFltr').is(":checked") ? ($("#drpEmp").val() || 0) : 0;
        var dtFrom = "";
        var dtTo = "";

        if ($('#chkFxRngFltr').is(':checked')) {
            var valdrpRngs = parseInt($("#drpRngs").val()) || 1;
            var toD = new Date();
            toD.setDate(toD.getDate() - 1);
            var fromD = new Date();
            fromD.setDate(fromD.getDate() - valdrpRngs);

            var formatD = function (d) {
                var m = '' + (d.getMonth() + 1);
                var day = '' + d.getDate();
                var y = d.getFullYear();
                if (m.length < 2) m = '0' + m;
                if (day.length < 2) day = '0' + day;
                return [y, m, day].join('-');
            };

            dtFrom = formatD(fromD);
            dtTo = formatD(toD);
        } else {
            dtFrom = $("#dtFrom").val();
            dtTo = $("#dtTo").val();
        }

        if (!dtFrom || !dtTo) {
            alert("Please choose a valid date range or period.");
            return;
        }

        var url = "/Attendance/HrEmpAtndcSft/GetReloadAtndc?frmDate=" + dtFrom + '&toDate=' + dtTo + '&empSysId=' + drpEmp;
        $("#reloadAtndcModalBody").html('<div class="text-center py-4"><div class="spinner-border text-danger mb-2" role="status" style="width: 2.5rem; height: 2.5rem; color: #540033 !important;"><span class="sr-only">Loading...</span></div><div class="font-weight-bold" style="color: #540033;"><i class="fas fa-spinner fa-spin mr-1"></i> Loading details...</div></div>');
        $("#modalReloadAtndc").modal("show");
        $("#reloadAtndcModalBody").load(url);
    };

    var resetFunc = function (recId) {
        var url = "/Attendance/HrEmpAtndcSft/GetResetMarkAbsent?recId=" + recId;
        $("#resetModalBody").load(url, function () {
            $("#modalReset").modal("show");
        });
    };

    function enblEmpFltr() {
        var isChecked = $('#chkEmpFltr').is(':checked');
        var $drpEmp = $('#drpEmp');
        $drpEmp.prop('disabled', !isChecked);
        if (!isChecked) {
            $drpEmp.val('0');
        }
        if ($.fn.select2 && $drpEmp.data('select2')) {
            $drpEmp.trigger('change.select2');
        }
        loadAttdData();
        loadAttdSummary();
    }

    function enblDeptFltr() {
        var isChecked = $('#chkDeptFltr').is(':checked');
        var $drpDept = $('#drpDept');
        $drpDept.prop('disabled', !isChecked);
        if (!isChecked) {
            $drpDept.val('0');
        }
        if ($.fn.select2 && $drpDept.data('select2')) {
            $drpDept.trigger('change.select2');
        }
        loadAttdData();
        loadAttdSummary();
    }

    function enblFxRngFltr() {
        var chkFxRngFltr = document.getElementById("chkFxRngFltr");
        var drpRngs = document.getElementById("drpRngs");
        var chkDateRange = document.getElementById("chkDateRange");
        var dtFrom = document.getElementById("dtFrom");
        var dtTo = document.getElementById("dtTo");
        var btnReloadAtndc = document.getElementById("btnReloadAtndc");
        var btnRpt = document.getElementById("btnRpt");
        var valdrpRngs = $("#drpRngs").val();

        if (chkFxRngFltr.checked == true) {
            drpRngs.disabled = false;
            dtFrom.disabled = true;
            dtTo.disabled = true;
            if (btnReloadAtndc) btnReloadAtndc.disabled = false;
            if (btnRpt) btnRpt.disabled = false;
            $("#valFxRngFilter").val(valdrpRngs);
        }
        else if (chkDateRange.checked == true) {
            drpRngs.disabled = true;
            dtFrom.disabled = false;
            dtTo.disabled = false;
            if (btnReloadAtndc) btnReloadAtndc.disabled = false;
            if (btnRpt) btnRpt.disabled = false;
            $("#valFxRngFilter").val(0);
        }
    }

    // Attendance Logs
    function loadAttdData() {
        if ($('#chkFxRngFltr').is(':checked')) {
            var valdrpRngs = $("#drpRngs").val();
            $("#valFxRngFilter").val(valdrpRngs);
        }
        else if ($('#chkDateRange').is(':checked')) {
            $("#valFxRngFilter").val(0);
        }

        var drpEmp = 0;
        var drpRngs = "";
        var dtFrom = "";
        var dtTo = "";

        if ($('#chkDateRange').is(":checked")) {
            drpRngs = 0;
            dtFrom = $("#dtFrom").val();
            dtTo = $("#dtTo").val();
            if (!dtFrom || !dtTo) {
                return;
            }
            if (new Date(dtFrom) > new Date(dtTo)) {
                return;
            }
        }
        else {
            drpRngs = $("#drpRngs").val();
            dtFrom = "";
            dtTo = "";
        }

        if ($('#chkEmpFltr').is(":checked")) {
            drpEmp = $("#drpEmp").val() || 0;
        }
        else {
            drpEmp = 0;
        }

        var onlyAbsent = $('#chkAbsentOnly').is(':checked');

        var grid = document.getElementById('Grid').ej2_instances[0];
        grid.dataSource = null;
        grid.showSpinner();

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: "@(Url.Action("GetAtndcLogs", "HrEmpAtndcSft"))",
            dataType: "json",
            data: { refId: drpEmp, dateFilter: drpRngs, sDate: dtFrom, eDate: dtTo, onlyAbsent: onlyAbsent },
            success: function (data) {
                grid.dataSource = data.data;
                grid.hideSpinner();
            },
            error: function (xhr, err) {
                alert("Grid Error");
            }
        });
    }

    function loadAttdSummary() {
    }

    function validateAttdReportForm(event) {
        var isPredefined = $('#chkFxRngFltr').is(':checked');
        var dtFromElem = document.getElementById("dtFrom");
        var dtToElem = document.getElementById("dtTo");

        if (isPredefined) {
            var valdrpRngs = parseInt($("#drpRngs").val()) || 1;
            $("#valFxRngFilter").val(valdrpRngs);

            var toD = new Date();
            toD.setDate(toD.getDate() - 1);
            var fromD = new Date();
            fromD.setDate(fromD.getDate() - valdrpRngs);

            var formatD = function (d) {
                var m = '' + (d.getMonth() + 1);
                var day = '' + d.getDate();
                var y = d.getFullYear();
                if (m.length < 2) m = '0' + m;
                if (day.length < 2) day = '0' + day;
                return [y, m, day].join('-');
            };

            if (dtFromElem) dtFromElem.value = formatD(fromD);
            if (dtToElem) dtToElem.value = formatD(toD);
        } else {
            $("#valFxRngFilter").val(0);
            var fromDate = $("#dtFrom").val();
            var toDate = $("#dtTo").val();

            if (!fromDate || !toDate) {
                if (window.toastObj && window.toasts) toastObj.show(toasts[0]);
                else alert("Please choose the Date Range.");
                if (event) event.preventDefault();
                return false;
            } else if (fromDate > toDate) {
                if (window.toastObj && window.toasts) toastObj.show(toasts[3]);
                else alert("From Date cannot be later than To Date.");
                if (event) event.preventDefault();
                return false;
            }
        }

        // Enable inputs before submission so their values are sent in POST
        if (dtFromElem) dtFromElem.disabled = false;
        if (dtToElem) dtToElem.disabled = false;

        var isAbsentChecked = $('#chkAbsentOnly').is(':checked');
        $('#prmAbsentOnly').val(isAbsentChecked);

        return true;
    }

    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];
        if (args.item.id === 'Grid_excelexport' || args.item.id === 'Grid_print') {
            gridObj.excelExport();
        }
    }

    function excelQueryCellInfo(args) {
        if (args.column.headerText === 'Status' && args.value) {
            var status = args.value.toString().trim().toLowerCase();
            if (status.indexOf("absent") >= 0) {
                args.style = { backColor: '#ef4444', fontColor: '#ffffff', bold: true };
            } else if (status.indexOf("missing") >= 0) {
                args.style = { backColor: '#fee2e2', fontColor: '#991b1b', bold: true };
            } else if (status.indexOf("late") >= 0 || status.indexOf("early") >= 0 || status.indexOf("earlry") >= 0) {
                args.style = { backColor: '#facc15', fontColor: '#713f12', bold: true };
            } else if (status === "ontime" || status === "on time" || status.indexOf("ontime") >= 0 || status.indexOf("on time") >= 0) {
                args.style = { backColor: '#22c55e', fontColor: '#ffffff', bold: true };
            }
        }
    }

    function prntGrid() {
        var gridObj = document.getElementById("Grid").ej2_instances[0];
        gridObj.print();
    }

    var toastObj;
    var toasts = [
        { title: 'Warning!', content: 'Please choose the Date Range.', cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' },
        { title: 'Error!', content: 'Application Error', cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' },
        { title: 'Success!', content: 'Salary Sheet Generated', cssClass: 'e-toast-warning', icon: 'e-success toast-icons' },
        { title: 'Warning!', content: 'Please specify the date range', cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' }
    ];
    var btnEleHide = document.getElementById('hideToast');

    setTimeout(() => {
        if (toastObj) {
            toastObj.show({ target: document.body });
        }
    }, 500);

    function created() {
        toastObj = this;
    }

    function onclose(e) {
        if (e.toastContainer && e.toastContainer.childElementCount === 0 && btnEleHide) {
            btnEleHide.style.display = 'none';
        }
    }

    function onBeforeOpen() {
        if (btnEleHide) btnEleHide.style.display = 'inline-block';
    }

    function loadFormattings() {
        var grid = document.getElementsByClassName('e-grid')[0].ej2_instances[0];
        this.columns[0].format = { type: 'date', format: 'yyyy-MM-dd' };
    }

    function mrkLteCmrs(args) {
        if (args.column.field === 'Status' && args.data && args.data.Status) {
            var status = (args.data.Status || "").trim().toLowerCase();
            if (status.indexOf("absent") >= 0) {
                args.cell.setAttribute('style', 'background-color:#ef4444 !important;color:#ffffff !important;font-weight:600;text-align:center;');
            } else if (status.indexOf("missing") >= 0) {
                args.cell.setAttribute('style', 'background-color:#fee2e2 !important;color:#991b1b !important;font-weight:600;text-align:center;');
            } else if (status.indexOf("late") >= 0 || status.indexOf("early") >= 0 || status.indexOf("earlry") >= 0) {
                args.cell.setAttribute('style', 'background-color:#facc15 !important;color:#713f12 !important;font-weight:600;text-align:center;');
            } else if (status === "ontime" || status === "on time" || status.indexOf("ontime") >= 0 || status.indexOf("on time") >= 0) {
                args.cell.setAttribute('style', 'background-color:#22c55e !important;color:#ffffff !important;font-weight:600;text-align:center;');
            }
        }
    }
</script>
