@using Syncfusion.EJ2
@using Microsoft.AspNetCore.Http;
@model qHRM.Models.RptParam

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --org-primary: #540033;
        --org-primary-hover: #3e0026;
        --org-primary-light: #fdf2f8;
        --org-primary-border: #fbcfe8;
        --clr-bg: #f7fafc;
        --clr-surface: #ffffff;
        --clr-border: rgba(2,6,23,0.06);
        --clr-text: #0f172a;
        --clr-muted: #475569;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
    }

    .org-page-container {
        padding: 0.75rem 0.5rem 1.5rem 0.5rem;
    }

    /* Compact Header Card */
    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border);
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--clr-text);
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: var(--org-primary-light);
        color: var(--org-primary);
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid var(--org-primary-border);
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: var(--clr-muted);
        margin-top: 0.15rem;
        line-height: 1.2;
    }
    .org-breadcrumb a {
        color: var(--clr-muted);
        text-decoration: none;
        transition: color 0.15s;
    }
    .org-breadcrumb a:hover {
        color: var(--org-primary);
    }

    /* Action Buttons in Grid */
    .org-actions-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .org-action-btn {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        transition: all 0.15s ease;
        text-decoration: none !important;
        cursor: pointer;
        font-size: 0.75rem;
        padding: 0;
        outline: none;
    }

    .org-action-edit {
        background: #fdf2f8;
        color: var(--org-primary);
        border-color: #fbcfe8;
    }

    .org-action-edit:hover {
        background: var(--org-primary);
        color: #ffffff !important;
        border-color: var(--org-primary);
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(84, 0, 51, 0.25);
    }

    .org-action-delete {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .org-action-delete:hover {
        background: #dc2626;
        color: #ffffff !important;
        border-color: #dc2626;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);
    }

    /* Filter Controls Modern styling */
    .attendance-filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    }

    .attendance-filter-card .form-control-sm {
        height: 34px !important;
        border-radius: 6px !important;
        border: 1px solid #cbd5e1 !important;
        font-size: 0.85rem !important;
        color: #1e293b;
    }
    .attendance-filter-card .form-control-sm:focus {
        border-color: #990049 !important;
        box-shadow: 0 0 0 2px rgba(153, 0, 73, 0.15) !important;
    }

    /* Select2 customization for Employee & Department dropdowns */
    .attendance-filter-card .select2-container .select2-selection--single {
        height: 34px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 3px 8px !important;
        display: flex;
        align-items: center;
    }
    .attendance-filter-card .select2-container--bootstrap4 .select2-selection--single .select2-selection__rendered {
        line-height: 28px !important;
        font-size: 0.85rem !important;
        color: #1e293b !important;
        padding-left: 2px !important;
    }
    .attendance-filter-card .select2-container--bootstrap4 .select2-selection--single .select2-selection__arrow {
        height: 32px !important;
        right: 8px !important;
    }
    .attendance-filter-card .select2-container--disabled .select2-selection--single {
        background-color: #f1f5f9 !important;
        border-color: #e2e8f0 !important;
        opacity: 0.7 !important;
        cursor: not-allowed !important;
    }
    .select2-dropdown {
        border: 1px solid #cbd5e1 !important;
        border-radius: 8px !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        font-size: 0.85rem !important;
        z-index: 9999 !important;
    }
    .select2-search--dropdown .select2-search__field {
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 6px 10px !important;
        font-size: 0.85rem !important;
    }

    /* Search & Print Grid Buttons */
    .btn-atndc-search {
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff !important;
        border: none;
        border-radius: 6px;
        height: 34px;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s;
        box-shadow: 0 2px 6px rgba(84, 0, 51, 0.2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        cursor: pointer;
    }
    .btn-atndc-search:hover {
        background: linear-gradient(135deg, #6a0041 0%, #8a0054 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(84, 0, 51, 0.35);
    }
    .btn-atndc-print-grid {
        background: #ffffff;
        color: #475569 !important;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        height: 34px;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        cursor: pointer;
    }
    .btn-atndc-print-grid:hover {
        background: #f8fafc;
        color: #0f172a !important;
        border-color: #94a3b8;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    /* Actions Panel & Buttons (Matching Payroll/HrPrSlryPrcDtl) */
    .atndc-actions-panel {
        border-left: 1px solid #edf2f7;
        padding-left: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    @@media (max-width: 991px) {
        .atndc-actions-panel {
            border-left: none;
            border-top: 1px solid #edf2f7;
            padding-left: 0;
            padding-top: 1.25rem;
            margin-top: 1.25rem;
        }
    }

    .atndc-action-btn {
        width: 100%;
        border: none;
        border-radius: 6px;
        height: 36px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: inherit;
        letter-spacing: 0.01em;
        text-decoration: none;
        outline: none;
    }

    .atndc-action-btn:disabled, .atndc-action-btn[disabled] {
        opacity: 0.38 !important;
        cursor: not-allowed !important;
        box-shadow: none !important;
        filter: grayscale(25%) !important;
        pointer-events: none !important;
    }

    /* 1. Mark Absent -> Maroon (Matching Run Salary Process: #990049, #b80058) */
    .btn-mark-absent {
        background: linear-gradient(135deg, #990049, #b80058);
        color: #ffffff !important;
        box-shadow: 0 2px 10px rgba(153, 0, 73, 0.35);
    }
    .btn-mark-absent:hover:not(:disabled) {
        box-shadow: 0 4px 18px rgba(153, 0, 73, 0.55);
        transform: translateY(-1px);
        color: #ffffff !important;
    }

    /* 2. Reset Absent -> Purple / Lavender (Matching Salary Re-Process: #6366f1, #8b5cf6) */
    .btn-reset-absent {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #ffffff !important;
        box-shadow: 0 2px 10px rgba(99, 102, 241, 0.35);
    }
    .btn-reset-absent:hover:not(:disabled) {
        box-shadow: 0 4px 18px rgba(99, 102, 241, 0.55);
        transform: translateY(-1px);
        color: #ffffff !important;
    }

    /* 3. Load Attendance -> Teal / Cyan (Matching Verify: #06b6d4, #0891b2) */
    .btn-load-atndc {
        background: linear-gradient(135deg, #06b6d4, #0891b2);
        color: #ffffff !important;
        box-shadow: 0 2px 10px rgba(6, 182, 212, 0.35);
    }
    .btn-load-atndc:hover:not(:disabled) {
        box-shadow: 0 4px 18px rgba(6, 182, 212, 0.55);
        transform: translateY(-1px);
        color: #ffffff !important;
    }

    /* 4. Print Attendance Report -> Green (Matching Complete: #22c55e, #16a34a) */
    .btn-print-report {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #ffffff !important;
        box-shadow: 0 2px 10px rgba(34, 197, 94, 0.35);
    }
    .btn-print-report:hover:not(:disabled) {
        box-shadow: 0 4px 18px rgba(34, 197, 94, 0.55);
        transform: translateY(-1px);
        color: #ffffff !important;
    }

    /* 5. Print Grid in Actions Panel -> Ocean Blue (Matching Generate WPS: #0077b6, #0096c7) */
    .btn-action-print-grid {
        background: linear-gradient(135deg, #0077b6, #0096c7);
        color: #ffffff !important;
        box-shadow: 0 2px 10px rgba(0, 119, 182, 0.35);
    }
    .btn-action-print-grid:hover:not(:disabled) {
        box-shadow: 0 4px 18px rgba(0, 119, 182, 0.55);
        transform: translateY(-1px);
        color: #ffffff !important;
    }

    /* Modern Modals */
    .org-modal .modal-content {
        border: 1px solid var(--clr-border) !important;
        border-radius: var(--radius) !important;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.2) !important;
        overflow: hidden;
    }

    .org-modal .modal-header {
        background: linear-gradient(135deg, #540033 0%, #3b0024 100%) !important;
        color: #ffffff !important;
        padding: 1rem 1.25rem !important;
        border-bottom: none !important;
    }

    .org-modal .modal-header .modal-title {
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        display: flex;
        align-items: center;
    }

    .org-modal .modal-header .close {
        color: #ffffff !important;
        opacity: 0.8 !important;
        text-shadow: none !important;
        transition: opacity 0.15s !important;
        outline: none !important;
    }

    .org-modal .modal-header .close:hover {
        opacity: 1 !important;
    }

    .org-modal-delete .modal-header {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%) !important;
    }

    /* Cycle Control Pills (Prev, Current, Next Cycle) */
    .atndc-cycle-btn {
        background-color: #ffffff;
        color: #4e73df;
        border: 1px solid #b7b9cc;
        border-radius: 6px;
        padding: 0.18rem 0.55rem;
        font-size: 0.74rem;
        font-weight: 500;
        line-height: 1.3;
        transition: all 0.15s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        cursor: pointer;
        text-decoration: none !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    .atndc-cycle-btn:hover {
        background-color: #f8f9fc;
        border-color: #858796;
        color: #2e59d9;
        transform: translateY(-1px);
    }
    .atndc-cycle-btn.btn-curr-cycle {
        border: 1px solid #540033 !important;
        color: #540033 !important;
        font-weight: 600;
    }
    .atndc-cycle-btn.btn-curr-cycle:hover {
        background-color: #fdf2f8 !important;
        border-color: #3e0026 !important;
        color: #3e0026 !important;
    }

    /* Syncfusion Grid Styling (Matching Payroll/HrPrSlryPrcDtl) */
    .e-grid { background: transparent !important; border: none !important; }
    .e-grid .e-headercell { background: #f8fafc !important; color: var(--clr-muted) !important; font-size: 0.72rem !important; font-weight: 600 !important; text-transform: uppercase !important; letter-spacing: 0.06em !important; border-color: var(--clr-border) !important; }
    .e-grid .e-rowcell { background: transparent !important; border-color: var(--clr-border) !important; color: var(--clr-text) !important; font-size: 0.8rem !important; }
    .e-grid .e-altrow .e-rowcell { background: #f8fafc !important; }
    .e-grid .e-row:hover .e-rowcell { background: rgba(99,102,241,0.06) !important; }
    .e-grid .e-pager { background: #f8fafc !important; border-color: var(--clr-border) !important; color: var(--clr-muted) !important; }
    .e-grid .e-toolbar { background: #f8fafc !important; border-color: var(--clr-border) !important; }
</style>

<div class="org-page-container">
    <main>
        <div class="container-fluid px-0">

            <!-- COMPACT HERO HEADER -->
            <div class="org-hero-card">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
                    <div class="d-flex align-items-center">
                        <div class="org-icon-badge mr-3">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                                <h1 class="org-title">Employee Shift Attendance</h1>
                                <span class="badge org-category-pill">ATTENDANCE</span>
                            </div>
                            <div class="org-breadcrumb">
                                <a href="#">Human Resource</a> / <span class="text-dark font-weight-medium">Attendance</span>
                                <span class="text-muted mx-1">&bull;</span>
                                <span class="text-muted">Monitor daily attendance logs, shift punches, overtime, and late arrivals</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filter and Actions Card -->
            <div class="card mb-4">
                <div class="card-body">

                    <ejs-toast id="toast_type" close="onclose" beforeOpen="onBeforeOpen" created="created" width="75%">
                        <e-toast-position X="Center"></e-toast-position>
                    </ejs-toast>

                    <div class="row justify-content-center">
                        <div class="col-12 col-md-6">
                            <div class="attendance-filter-card">
                                @using (Html.BeginForm("PrintAtndcSht", "HrEmpAtndcSft", FormMethod.Post, new { target = "_blank", onsubmit = "validateAttdReportForm(event)" }))
                                {
                                    <!-- Row 1: Filters (Employee/Dept on left, Predefined/Date Range on right) -->
                                    <div class="row">
                                        <!-- Sub-Col 1: Employee & Department -->
                                        <div class="col-12 col-sm-6 mb-3 mb-sm-0">
                                            <div class="form-group mb-3">
                                                <div class="form-check mb-1">
                                                    <input type="checkbox" class="form-check-input" id="chkEmpFltr" checked="checked" onclick="enblEmpFltr();">
                                                    <label class="form-check-label font-weight-bold" for="chkEmpFltr">Employee</label>
                                                </div>
                                                <select placeholder="Select Employee" id="drpEmp" asp-for="prm3"
                                                        asp-items="@(new SelectList(ViewBag.lstEmployee, "EmpSysId", "FullName"))" class="form-control form-control-sm select2-dropdown" onchange="loadAttdData();loadAttdSummary();">
                                                    <option value="0">All Employee</option>
                                                </select>
                                            </div>
                                            <div class="form-group mb-0">
                                                <div class="form-check mb-1">
                                                    <input type="checkbox" class="form-check-input" id="chkDeptFltr" onclick="enblDeptFltr();">
                                                    <label class="form-check-label font-weight-bold" for="chkDeptFltr">Department</label>
                                                </div>
                                                <select placeholder="Select Department" id="drpDept" asp-for="prm4"
                                                        asp-items="@(new SelectList(ViewBag.lstDept, "DeptId", "DeptName"))" disabled class="form-control form-control-sm select2-dropdown">
                                                    <option value="0">All Departments</option>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Sub-Col 2: Predefined Period & Date Range -->
                                        <div class="col-12 col-sm-6 mb-3 mb-sm-0">
                                            <div class="form-group mb-3">
                                                <div class="form-check mb-1">
                                                    <input type="radio" name="dateRange" class="form-check-input" id="chkFxRngFltr" checked onclick="enblFxRngFltr();loadAttdData();loadAttdSummary();">
                                                    <label class="form-check-label font-weight-bold" for="chkFxRngFltr">Pre Defined Period</label>
                                                </div>
                                                <select placeholder="Select Date Range" id="drpRngs"
                                                        asp-items="@(new SelectList(ViewBag.lstFilter, "Prop", "Val"))" onchange="loadAttdData();loadAttdSummary();" class="form-control form-control-sm">
                                                </select>
                                            </div>
                                            <div class="form-group mb-0">
                                                <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap" style="gap: 0.35rem;">
                                                    <div class="form-check">
                                                        <input type="radio" name="dateRange" class="form-check-input" id="chkDateRange" onclick="resetAtndcCurrentCycle();">
                                                        <label class="form-check-label font-weight-bold" for="chkDateRange" style="cursor: pointer;">Date Range</label>
                                                    </div>
                                                    <!-- Quick Payroll Cycle Controls (21st to 20th) -->
                                                    <div class="d-inline-flex align-items-center" style="gap: 0.3rem;">
                                                        <button type="button" class="atndc-cycle-btn" onclick="shiftAtndcCycle(-1)" title="Previous Payroll Cycle (21st to 20th)">
                                                            <i class="fas fa-chevron-left fa-xs"></i> Prev Cycle
                                                        </button>
                                                        <button type="button" class="atndc-cycle-btn btn-curr-cycle" onclick="resetAtndcCurrentCycle()" title="Current Payroll Cycle (21st to 20th)">
                                                            Current Cycle
                                                        </button>
                                                        <button type="button" class="atndc-cycle-btn" onclick="shiftAtndcCycle(1)" title="Next Payroll Cycle (21st to 20th)">
                                                            Next Cycle <i class="fas fa-chevron-right fa-xs"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="form-row">
                                                    <div class="col-6">
                                                        <label class="small text-muted mb-0">From</label>
                                                        <input id="dtFrom" type="date" asp-for="prm1" disabled class="form-control form-control-sm" value="@ViewBag.FromDate" onchange="onDateRangeChange();" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="small text-muted mb-0">To</label>
                                                        <input id="dtTo" type="date" asp-for="prm2" disabled class="form-control form-control-sm" value="@ViewBag.ToDate" onchange="onDateRangeChange();" />
                                                        <input id="valFxRngFilter" type="number" asp-for="prm5" class="form-control form-control-sm" hidden />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Row 2: Filter - Absent any of the days -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <div class="d-flex align-items-center p-2 rounded" style="background: rgba(220, 38, 38, 0.05); border: 1px dashed rgba(220, 38, 38, 0.35);">
                                                <div class="form-check mb-0">
                                                    <input type="checkbox" class="form-check-input" id="chkAbsentOnly" name="chkAbsentOnly" value="true" onchange="loadAttdData();">
                                                    <input type="hidden" name="prmAbsentOnly" id="prmAbsentOnly" value="false" />
                                                    <label class="form-check-label font-weight-bold text-danger" for="chkAbsentOnly" style="cursor: pointer; font-size: 0.85rem;">
                                                        <i class="fas fa-user-times mr-1"></i> Whoever absent any of the days within that cycle
                                                    </label>
                                                </div>
                                                <span class="badge badge-light border text-muted ml-auto font-weight-normal" style="font-size: 0.72rem;">
                                                    Filters Print Report &amp; Grid
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Row 3: Search Button -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <button type="button" class="btn btn-block btn-atndc-search" onclick="loadAttdData(); loadAttdSummary();">
                                                <i class="fas fa-search mr-1"></i> Search
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Row 4: Load Attendance & Print Attendance Report Underneath Search -->
                                    <div class="row mt-2">
                                        @if (ViewBag.RecEdit == true)
                                        {
                                            <div class="col-12 col-sm-6 mb-2 mb-sm-0">
                                                <button type="button" class="atndc-action-btn btn-load-atndc w-100" onclick="reloadAtndcFunc();" id="btnReloadAtndc">
                                                    <i class="fas fa-sync-alt mr-2"></i> Load Attendance
                                                </button>
                                            </div>
                                            <div class="col-12 col-sm-6">
                                                <button type="submit" class="atndc-action-btn btn-print-report w-100" id="btnRpt">
                                                    <i class="fas fa-print mr-2"></i> Print Attendance Report
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-12">
                                                <button type="submit" class="atndc-action-btn btn-print-report w-100" id="btnRpt">
                                                    <i class="fas fa-print mr-2"></i> Print Attendance Report
                                                </button>
                                            </div>
                                        }
                                    </div>

                                    <!-- Hidden Legacy Action Buttons -->
                                    <div style="display: none !important;">
                                        <button type="button" class="atndc-action-btn btn-mark-absent" onclick="markAbsentFunc();" id="btnMarkAbsent"></button>
