@page
@model ForgotPasswordModel
@{
    Layout = "/Areas/Identity/Pages/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password - qHR System";
}

<style>
    .forgot-container {
        max-width: 420px;
        margin: 0 auto;
    }
    .forgot-header h4 {
        color: #2c3e50;
        font-weight: 700;
        font-size: 1.45rem;
        margin-bottom: 0.35rem;
    }
    .forgot-header p {
        color: #718096;
        font-size: 0.88rem;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }
    .icon-badge {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, rgba(108, 19, 58, 0.1) 0%, rgba(108, 19, 58, 0.2) 100%);
        color: #6c133a;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 1.2rem;
    }
    .form-group label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #4a5568;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.4rem;
    }
    .form-control-custom {
        height: 46px;
        border-radius: 8px;
        border: 1.5px solid #e2e8f0;
        padding: 0.6rem 1rem;
        font-size: 0.95rem;
        transition: all 0.2s ease-in-out;
    }
    .form-control-custom:focus {
        border-color: #6c133a;
        box-shadow: 0 0 0 3px rgba(108, 19, 58, 0.15);
    }
    .btn-submit-reset {
        background: linear-gradient(135deg, #6c133a 0%, #4a0d28 100%);
        color: #ffffff;
        font-weight: 600;
        font-size: 0.98rem;
        height: 46px;
        border-radius: 8px;
        border: none;
        width: 100%;
        box-shadow: 0 4px 10px rgba(108, 19, 58, 0.25);
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .btn-submit-reset:hover {
        background: linear-gradient(135deg, #590f2f 0%, #3a0a1f 100%);
        color: #ffffff;
        box-shadow: 0 6px 14px rgba(108, 19, 58, 0.35);
        transform: translateY(-1px);
    }
    .btn-submit-reset:active {
        transform: translateY(0);
    }
    .back-link {
        color: #6c133a;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color 0.15s;
    }
    .back-link:hover {
        color: #4a0d28;
        text-decoration: underline;
    }
    .security-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        color: #718096;
        background-color: #f7fafc;
        border: 1px solid #edf2f7;
        padding: 4px 10px;
        border-radius: 20px;
        margin-top: 1.5rem;
    }
</style>

<div class="forgot-container">
    <div class="icon-badge">
        <i class="fas fa-key"></i>
    </div>

    <div class="forgot-header">
        <h4>Forgot Password?</h4>
        <p>Enter your registered email address or username and we will generate a secure reset link to verify your identity.</p>
    </div>

    <form method="post" id="forgotForm">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <div class="form-group mb-4">
            <label asp-for="Input.Email">Registered Email or Username</label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-white border-right-0" style="border-radius: 8px 0 0 8px; border-color: #e2e8f0; color: #a0aec0;">
                        <i class="fas fa-user-shield"></i>
                    </span>
                </div>
                <input asp-for="Input.Email" class="form-control form-control-custom border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="e.g. name@qcs-qatar.com or username" autofocus autocomplete="username" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-submit-reset" id="btnSubmitReset">
            <span id="btnSubmitText"><i class="fas fa-paper-plane mr-1"></i> Send Reset Link</span>
            <span id="btnSubmitSpinner" style="display: none;">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Sending...
            </span>
        </button>

        <div class="text-center mt-4">
            <a asp-page="./Login" class="back-link">
                <i class="fas fa-arrow-left"></i> Return to Login
            </a>
        </div>

        <div class="text-center">
            <div class="security-badge">
                <i class="fas fa-lock text-success"></i>
                <span>Enforced with AES-256</span>
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('forgotForm');
        var btn = document.getElementById('btnSubmitReset');
        var btnText = document.getElementById('btnSubmitText');
        var btnSpinner = document.getElementById('btnSubmitSpinner');

        if (form && btn) {
            form.addEventListener('submit', function (e) {
                if (window.jQuery && $(form).length && $(form).data('validator')) {
                    if (!$(form).valid()) {
                        return false;
                    }
                }
                btnText.style.display = 'none';
                btnSpinner.style.display = 'inline-block';
                setTimeout(function () {
                    btn.disabled = true;
                }, 50);
            });
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
