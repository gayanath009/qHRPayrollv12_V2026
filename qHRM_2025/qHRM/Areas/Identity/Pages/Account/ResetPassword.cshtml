@page
@model ResetPasswordModel
@{
    Layout = "/Areas/Identity/Pages/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Password - qHR System";
}

<style>
    .reset-container {
        max-width: 440px;
        margin: 0 auto;
    }
    .reset-header h4 {
        color: #2c3e50;
        font-weight: 700;
        font-size: 1.45rem;
        margin-bottom: 0.35rem;
    }
    .reset-header p {
        color: #718096;
        font-size: 0.88rem;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }
    .icon-badge {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, rgba(108, 19, 58, 0.1) 0%, rgba(108, 19, 58, 0.2) 100%);
        color: #6c133a;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 1.2rem;
    }
    .form-group label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #4a5568;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.4rem;
    }
    .form-control-custom {
        height: 46px;
        border-radius: 8px;
        border: 1.5px solid #e2e8f0;
        padding: 0.6rem 1rem;
        font-size: 0.95rem;
        transition: all 0.2s ease-in-out;
    }
    .form-control-custom:focus {
        border-color: #6c133a;
        box-shadow: 0 0 0 3px rgba(108, 19, 58, 0.15);
    }
    .btn-submit-reset {
        background: linear-gradient(135deg, #6c133a 0%, #4a0d28 100%);
        color: #ffffff;
        font-weight: 600;
        font-size: 0.98rem;
        height: 46px;
        border-radius: 8px;
        border: none;
        width: 100%;
        box-shadow: 0 4px 10px rgba(108, 19, 58, 0.25);
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .btn-submit-reset:hover {
        background: linear-gradient(135deg, #590f2f 0%, #3a0a1f 100%);
        color: #ffffff;
        box-shadow: 0 6px 14px rgba(108, 19, 58, 0.35);
        transform: translateY(-1px);
    }
    .btn-submit-reset:active {
        transform: translateY(0);
    }
    .toggle-pwd-btn {
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-left: none;
        border-radius: 0 8px 8px 0;
        color: #718096;
        padding: 0 14px;
        cursor: pointer;
        transition: color 0.2s;
    }
    .toggle-pwd-btn:hover {
        color: #2d3748;
    }
    .pwd-requirements {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 6px;
        padding: 10px 14px;
        margin-top: 6px;
        margin-bottom: 14px;
        font-size: 0.78rem;
        color: #64748b;
    }
    .pwd-requirements ul {
        margin: 4px 0 0 0;
        padding-left: 18px;
    }
    .security-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        color: #718096;
        background-color: #f7fafc;
        border: 1px solid #edf2f7;
        padding: 4px 10px;
        border-radius: 20px;
        margin-top: 1.5rem;
    }
    .back-link {
        color: #6c133a;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .back-link:hover {
        color: #4a0d28;
        text-decoration: underline;
    }
</style>

<div class="reset-container">
    <div class="icon-badge">
        <i class="fas fa-shield-alt"></i>
    </div>

    <div class="reset-header">
        <h4>Set New Password</h4>
        <p>Choose a strong password to protect your account and personal records.</p>
    </div>

    <form method="post" id="resetPasswordForm">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <input asp-for="Input.Code" type="hidden" />

        <div class="form-group mb-3">
            <label asp-for="Input.Email">Account Email or Username</label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-light border-right-0" style="border-radius: 8px 0 0 8px; border-color: #e2e8f0; color: #a0aec0;">
                        <i class="fas fa-user"></i>
                    </span>
                </div>
                <input asp-for="Input.Email" class="form-control form-control-custom border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Registered email or username" autocomplete="username" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <div class="form-group mb-1">
            <label asp-for="Input.Password">New Password</label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-white border-right-0" style="border-radius: 8px 0 0 8px; border-color: #e2e8f0; color: #a0aec0;">
                        <i class="fas fa-lock"></i>
                    </span>
                </div>
                <input asp-for="Input.Password" id="inputNewPassword" class="form-control form-control-custom border-left-0 border-right-0" placeholder="Enter new password" autocomplete="new-password" />
                <div class="input-group-append">
                    <button type="button" class="btn toggle-pwd-btn" id="btnToggleNewPwd" tabindex="-1">
                        <i class="fas fa-eye" id="iconNewPwd"></i>
                    </button>
                </div>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>

        <div class="pwd-requirements">
            <i class="fas fa-info-circle mr-1 text-primary"></i> <strong>Password Guidelines:</strong>
            <ul class="mb-0">
                <li>Minimum of 6 characters in length</li>
                <li>Must contain at least one letter and one number</li>
            </ul>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-white border-right-0" style="border-radius: 8px 0 0 8px; border-color: #e2e8f0; color: #a0aec0;">
                        <i class="fas fa-check-circle"></i>
                    </span>
                </div>
                <input asp-for="Input.ConfirmPassword" id="inputConfirmPassword" class="form-control form-control-custom border-left-0 border-right-0" placeholder="Re-enter new password" autocomplete="new-password" />
                <div class="input-group-append">
                    <button type="button" class="btn toggle-pwd-btn" id="btnToggleConfirmPwd" tabindex="-1">
                        <i class="fas fa-eye" id="iconConfirmPwd"></i>
                    </button>
                </div>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-submit-reset" id="btnSubmitNewPassword">
            <span id="btnSubmitText"><i class="fas fa-save mr-1"></i> Update &amp; Save Password</span>
            <span id="btnSubmitSpinner" style="display: none;">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Securing...
            </span>
        </button>

        <div class="text-center mt-4">
            <a asp-page="./Login" class="back-link">
                <i class="fas fa-arrow-left"></i> Cancel and Return to Login
            </a>
        </div>

        <div class="text-center">
            <div class="security-badge">
                <i class="fas fa-lock text-success"></i>
                <span>Enforced with AES-256</span>
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Toggle new password visibility
        var btnToggleNew = document.getElementById('btnToggleNewPwd');
        var inputNew = document.getElementById('inputNewPassword');
        var iconNew = document.getElementById('iconNewPwd');

        if (btnToggleNew && inputNew && iconNew) {
            btnToggleNew.addEventListener('click', function () {
                if (inputNew.type === 'password') {
                    inputNew.type = 'text';
                    iconNew.classList.remove('fa-eye');
                    iconNew.classList.add('fa-eye-slash');
                } else {
                    inputNew.type = 'password';
                    iconNew.classList.remove('fa-eye-slash');
                    iconNew.classList.add('fa-eye');
                }
            });
        }

        // Toggle confirm password visibility
        var btnToggleConfirm = document.getElementById('btnToggleConfirmPwd');
        var inputConfirm = document.getElementById('inputConfirmPassword');
        var iconConfirm = document.getElementById('iconConfirmPwd');

        if (btnToggleConfirm && inputConfirm && iconConfirm) {
            btnToggleConfirm.addEventListener('click', function () {
                if (inputConfirm.type === 'password') {
                    inputConfirm.type = 'text';
                    iconConfirm.classList.remove('fa-eye');
                    iconConfirm.classList.add('fa-eye-slash');
                } else {
                    inputConfirm.type = 'password';
                    iconConfirm.classList.remove('fa-eye-slash');
                    iconConfirm.classList.add('fa-eye');
                }
            });
        }

        // Form submission spinner
        var form = document.getElementById('resetPasswordForm');
        var btnSubmit = document.getElementById('btnSubmitNewPassword');
        var btnText = document.getElementById('btnSubmitText');
        var btnSpinner = document.getElementById('btnSubmitSpinner');

        if (form && btnSubmit) {
            form.addEventListener('submit', function (e) {
                if (window.jQuery && $(form).length && $(form).data('validator')) {
                    if (!$(form).valid()) {
                        return false;
                    }
                }
                btnText.style.display = 'none';
                btnSpinner.style.display = 'inline-block';
                setTimeout(function () {
                    btnSubmit.disabled = true;
                }, 50);
            });
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
