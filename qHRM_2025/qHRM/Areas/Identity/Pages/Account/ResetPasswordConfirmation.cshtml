@page
@model ResetPasswordConfirmationModel
@{
    Layout = "/Areas/Identity/Pages/_AuthLayout.cshtml";
    ViewData["Title"] = "Password Reset Complete - qHR System";
}

<style>
    .confirm-container {
        max-width: 440px;
        margin: 0 auto;
        text-align: center;
    }
    .icon-badge-success {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, rgba(40, 167, 69, 0.12) 0%, rgba(40, 167, 69, 0.22) 100%);
        color: #28a745;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 1.3rem;
    }
    .confirm-header h4 {
        color: #2c3e50;
        font-weight: 700;
        font-size: 1.45rem;
        margin-bottom: 0.5rem;
    }
    .confirm-header p {
        color: #4a5568;
        font-size: 0.92rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }
    .success-alert {
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        text-align: left;
        margin-bottom: 1.75rem;
        font-size: 0.85rem;
        color: #166534;
    }
    .btn-login {
        background: linear-gradient(135deg, #6c133a 0%, #4a0d28 100%);
        color: #ffffff;
        font-weight: 600;
        font-size: 0.98rem;
        height: 46px;
        border-radius: 8px;
        border: none;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none !important;
        box-shadow: 0 4px 10px rgba(108, 19, 58, 0.25);
        transition: all 0.2s ease-in-out;
    }
    .btn-login:hover {
        background: linear-gradient(135deg, #590f2f 0%, #3a0a1f 100%);
        color: #ffffff;
        box-shadow: 0 6px 14px rgba(108, 19, 58, 0.35);
        transform: translateY(-1px);
    }
    .security-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        color: #718096;
        background-color: #f7fafc;
        border: 1px solid #edf2f7;
        padding: 4px 10px;
        border-radius: 20px;
        margin-top: 1.5rem;
    }
</style>

<div class="confirm-container">
    <div class="icon-badge-success">
        <i class="fas fa-check"></i>
    </div>

    <div class="confirm-header">
        <h4>Password Reset Successfully</h4>
        <p>Your password has been safely updated and synchronized across all qHR system security directories.</p>
    </div>

    <div class="success-alert">
        <div class="font-weight-bold mb-1">
            <i class="fas fa-shield-alt mr-1"></i> Security Confirmation
        </div>
        <div>
            Your new credentials are protected with <strong>AES-256</strong>. For your security, any previous active sessions have been automatically terminated.
        </div>
    </div>

    <a asp-page="./Login" class="btn-login">
        <i class="fas fa-sign-in-alt"></i> Proceed to Login
    </a>

    <div class="text-center">
        <div class="security-badge">
            <i class="fas fa-lock text-success"></i>
            <span>Enforced with AES-256</span>
        </div>
    </div>
</div>
