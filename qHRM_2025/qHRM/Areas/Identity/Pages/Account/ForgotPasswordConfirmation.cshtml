@page
@model ForgotPasswordConfirmation
@{
    Layout = "/Areas/Identity/Pages/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Link Sent - qHR System";
}

<style>
    .confirm-container {
        max-width: 440px;
        margin: 0 auto;
        text-align: center;
    }
    .icon-badge-success {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, rgba(40, 167, 69, 0.12) 0%, rgba(40, 167, 69, 0.22) 100%);
        color: #28a745;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 1.3rem;
    }
    .confirm-header h4 {
        color: #2c3e50;
        font-weight: 700;
        font-size: 1.45rem;
        margin-bottom: 0.5rem;
    }
    .confirm-header p {
        color: #64748b;
        font-size: 0.92rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }
    .info-card {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1.15rem 1.25rem;
        text-align: left;
        margin-bottom: 1.5rem;
        font-size: 0.88rem;
    }
    .info-card .info-header {
        color: #475569 !important;
        font-weight: 600;
        font-size: 0.92rem;
        margin-bottom: 0.6rem;
    }
    .info-card ul {
        margin: 0;
        padding-left: 1.25rem;
    }
    .info-card li {
        color: #64748b !important;
        margin-bottom: 0.45rem;
        line-height: 1.55;
    }
    .info-card li:last-child {
        margin-bottom: 0;
    }
    .info-card li strong {
        color: #475569 !important;
        font-weight: 600;
    }
    .info-card li em {
        color: #475569 !important;
    }
    .btn-return-login {
        background: linear-gradient(135deg, #6c133a 0%, #4a0d28 100%);
        color: #ffffff;
        font-weight: 600;
        font-size: 0.95rem;
        height: 44px;
        border-radius: 8px;
        border: none;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none !important;
        box-shadow: 0 4px 10px rgba(108, 19, 58, 0.2);
        transition: all 0.2s ease-in-out;
    }
    .btn-return-login:hover {
        background: linear-gradient(135deg, #590f2f 0%, #3a0a1f 100%);
        color: #ffffff;
        box-shadow: 0 6px 14px rgba(108, 19, 58, 0.3);
        transform: translateY(-1px);
    }
</style>

<div class="confirm-container">
    <div class="icon-badge-success">
        <i class="fas fa-envelope-open-text"></i>
    </div>

    <div class="confirm-header">
        <h4>Check Your Email</h4>
        <p>If an active account matches the details you provided, we have sent a secure password reset link to your registered email address.</p>
    </div>

    <div class="info-card">
        <div class="info-header">
            <i class="fas fa-info-circle mr-1" style="color: #64748b;"></i> What to do next:
        </div>
        <ul>
            <li>Open the email sent from <strong>qHR System</strong>.</li>
            <li>Click the <strong>"Reset My Password"</strong> button inside.</li>
            <li>Check your <em>Junk/Spam</em> folder if the email does not appear within 2 minutes.</li>
            <li>Reset links are single-use and expire after a short period for security.</li>
        </ul>
    </div>

    <a asp-page="./Login" class="btn-return-login">
        <i class="fas fa-arrow-left"></i> Return to Login
    </a>

    <div class="text-center mt-3">
        <div style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; color: #718096; background-color: #f7fafc; border: 1px solid #edf2f7; padding: 4px 10px; border-radius: 20px;">
            <i class="fas fa-lock text-success"></i>
            <span>Enforced with AES-256</span>
        </div>
    </div>
</div>
