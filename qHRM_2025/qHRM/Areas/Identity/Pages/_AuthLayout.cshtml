@{
    Layout = "/Views/Shared/_Layout.cshtml";
    bool showBanner = (ViewData["ShowAuthBanner"] as bool?) == true;
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 85vh;">
        @if (showBanner)
        {
            <div class="col-xl-10 col-lg-11 col-md-12">
                <div class="card o-hidden border-0 shadow-lg my-4" style="border-radius: 14px; overflow: hidden;">
                    <div class="card-body p-0">
                        <div class="row no-gutters">
                            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center bg-white p-0" style="background-color: #fafbfc; border-right: 1px solid #edf2f7;">
                                <img src="~/images/bg-banner.png" alt="QCS HR and Payroll" style="width: 100%; height: 100%; object-fit: cover; max-height: 540px;">
                            </div>
                            <div class="col-lg-6 col-md-12">
                                <div class="p-4 p-md-5">
                                    @RenderBody()
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">
                <div class="card o-hidden border-0 shadow-lg my-4" style="border-radius: 14px; overflow: hidden; background: #ffffff;">
                    <div class="card-body p-4 p-md-5">
                        @RenderBody()
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts
{
    @RenderSection("Scripts", required: false)
}
