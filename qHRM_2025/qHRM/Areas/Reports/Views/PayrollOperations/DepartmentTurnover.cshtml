@model DepartmentTurnoverReportVm
@{
    ViewData["Title"] = "Department-wise Employee Turnover";
}

<style>
    .hr-ops-title { color: #550033 !important; font-weight: 700 !important; font-size: 1.4rem; margin-bottom: 2px; }
    .hr-kpi-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 14px 18px; border: 1px solid #eef0f4; height: 100%; }
    .hr-kpi-purple { border-top: 3px solid #6f42c1; }
    .hr-kpi-green { border-top: 3px solid #0f9d58; }
    .hr-kpi-red { border-top: 3px solid #dc2626; }
    .hr-kpi-orange { border-top: 3px solid #e67e22; }
    .hr-kpi-lbl { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #5f6368 !important; margin-bottom: 4px; }
    .hr-kpi-val { font-size: 24px; font-weight: 700; color: #111827 !important; line-height: 1.2; }
    .hr-kpi-sub { font-size: 11px; color: #6b7280 !important; margin-top: 3px; }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <div>
            <div class="hr-ops-title"><i class="fas fa-user-minus mr-2"></i>Department-wise Employee Turnover</div>
            <small class="text-muted">Payroll Operations &bull; Compare 3-Month, 6-Month &amp; 12-Month department attrition, turnover %, and exit details</small>
        </div>
        <form method="get" class="form-inline" style="gap:0.4rem;">
            <select name="months" class="form-control form-control-sm">
                <option value="3" selected="@(Model.PeriodMonths == 3)">Last 3 Months</option>
                <option value="6" selected="@(Model.PeriodMonths == 6)">Last 6 Months</option>
                <option value="12" selected="@(Model.PeriodMonths == 12)">Last 12 Months</option>
            </select>
            <select name="staffCat" class="form-control form-control-sm">
                <option value="ALL" selected="@(Model.StaffCat == "ALL")">All Staff</option>
                <option value="INTERNAL" selected="@(Model.StaffCat == "INTERNAL")">In-House</option>
                <option value="OUTSOURCE" selected="@(Model.StaffCat == "OUTSOURCE")">Outsource</option>
            </select>
            <button type="submit" class="btn btn-sm text-white" style="background:#550033;"><i class="fas fa-filter mr-1"></i>Apply</button>
        </form>
    </div>

    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-purple">
                <div class="hr-kpi-lbl">Active Headcount</div>
                <div class="hr-kpi-val">@Model.ActiveHeadcount</div>
                <div class="hr-kpi-sub">Current active employees</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-red">
                <div class="hr-kpi-lbl">Exits (Last @Model.PeriodMonths M)</div>
                <div id="kpiTurnExits" class="hr-kpi-val">@Model.ExitsInPeriod</div>
                <div class="hr-kpi-sub">Employees separated</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-orange">
                <div class="hr-kpi-lbl">Turnover Rate %</div>
                <div class="hr-kpi-val">@Model.TurnoverRatePct.ToString("N1")%</div>
                <div class="hr-kpi-sub">Last @Model.PeriodMonths months rate</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-green">
                <div class="hr-kpi-lbl">New Joiners (Last @Model.PeriodMonths M)</div>
                <div class="hr-kpi-val">@Model.JoinersInPeriod</div>
                <div class="hr-kpi-sub">Hired in selected window</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header py-2 bg-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold" style="color:#550033 !important;">Department Exits Comparison (3M / 6M / 12M) <small class="text-muted font-weight-normal">(Click a bar to filter exit details)</small></h6>
            <button id="btnClearTurnFilter" type="button" class="btn btn-xs btn-outline-secondary" style="display:none;" onclick="clearTurnFilter()"><i class="fas fa-times mr-1"></i>Show All</button>
        </div>
        <div class="card-body">
            <ejs-chart id="turnoverChart" height="270px" pointClick="onTurnChartClick" style="cursor:pointer;">
                <e-chart-primaryxaxis valueType="Category"></e-chart-primaryxaxis>
                <e-chart-tooltipsettings enable="true"></e-chart-tooltipsettings>
                <e-series-collection>
                    <e-series dataSource="Model.DeptSummaries" xName="Department" yName="Exits3M" name="Last 3 Months" type="Column" fill="#FDE6A8"></e-series>
                    <e-series dataSource="Model.DeptSummaries" xName="Department" yName="Exits6M" name="Last 6 Months" type="Column" fill="#F8C4C0"></e-series>
                    <e-series dataSource="Model.DeptSummaries" xName="Department" yName="Exits12M" name="Last 12 Months" type="Column" fill="#F3C6DC"></e-series>
                </e-series-collection>
            </ejs-chart>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header py-2 bg-white">
            <h6 class="m-0 font-weight-bold" style="color:#550033 !important;">Department Turnover Summary (@Model.DeptSummaries.Count)</h6>
        </div>
        <div class="card-body">
            <ejs-grid id="turnSummaryGrid" dataSource="Model.DeptSummaries" allowPaging="true" allowSorting="true" allowFiltering="true" allowPdfExport="true" queryCellInfo="onTurnQueryCellInfo" toolbarClick="onTurnSummaryToolbarClick" toolbar="@(new List<string>() { "PdfExport", "Search" })">
                <e-grid-pagesettings pageSize="12"></e-grid-pagesettings>
                <e-grid-filterSettings type="Excel"></e-grid-filterSettings>
                <e-grid-columns>
                    <e-grid-column field="Department" headerText="Department" width="180"></e-grid-column>
                    <e-grid-column field="ActiveCount" headerText="Active" textAlign="Right" width="80"></e-grid-column>
                    <e-grid-column field="JoinersInPeriod" headerText="Joined" textAlign="Right" width="80"></e-grid-column>
                    <e-grid-column field="Exits3M" headerText="Exits 3M" textAlign="Right" width="85"></e-grid-column>
                    <e-grid-column field="Exits6M" headerText="Exits 6M" textAlign="Right" width="85"></e-grid-column>
                    <e-grid-column field="Exits12M" headerText="Exits 12M" textAlign="Right" width="90"></e-grid-column>
                    <e-grid-column field="TurnoverRatePct" headerText="Turnover %" format="N1" textAlign="Right" width="100"></e-grid-column>
                    <e-grid-column field="AvgTenureYears" headerText="Avg Tenure (Yrs)" format="N1" textAlign="Right" width="120"></e-grid-column>
                </e-grid-columns>
            </ejs-grid>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-2 bg-white">
            <h6 id="turnDetailTitle" class="m-0 font-weight-bold" style="color:#550033 !important;">Exited Employees - Last @Model.PeriodMonths Months (@Model.ExitDetails.Count)</h6>
        </div>
        <div class="card-body">
            <ejs-grid id="turnDetailGrid" dataSource="Model.ExitDetails" allowPaging="true" allowSorting="true" allowFiltering="true" allowPdfExport="true" toolbarClick="onTurnDetailToolbarClick" toolbar="@(new List<string>() { "PdfExport", "Search" })">
                <e-grid-pagesettings pageSize="12"></e-grid-pagesettings>
                <e-grid-filterSettings type="Excel"></e-grid-filterSettings>
                <e-grid-columns>
                    <e-grid-column field="EmpId" headerText="Emp ID" width="95"></e-grid-column>
                    <e-grid-column field="FullName" headerText="Employee Name" width="175"></e-grid-column>
                    <e-grid-column field="Department" headerText="Department" width="160"></e-grid-column>
                    <e-grid-column field="StaffCategory" headerText="Category" width="100"></e-grid-column>
                    <e-grid-column field="JoinedDateStr" headerText="Joined Date" width="115"></e-grid-column>
                    <e-grid-column field="ExitDateStr" headerText="Exit Date" width="115"></e-grid-column>
                    <e-grid-column field="TenureYears" headerText="Tenure (Yrs)" format="N1" textAlign="Right" width="105"></e-grid-column>
                </e-grid-columns>
            </ejs-grid>
        </div>
    </div>
</div>

<script>
    var allExitItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExitDetails));
    var selectedTurnDept = null;

    function onTurnSummaryToolbarClick(args) {
        if (args.item.id === 'turnSummaryGrid_pdfexport') {
            exportReportGridPdf('turnSummaryGrid', 'Department_Employee_Turnover_Summary.pdf', 'Department-wise Employee Turnover Summary (Last @Model.PeriodMonths Months)');
        }
    }

    function onTurnDetailToolbarClick(args) {
        if (args.item.id === 'turnDetailGrid_pdfexport') {
            exportReportGridPdf('turnDetailGrid', 'Exited_Employees_Detail_@(Model.PeriodMonths)M.pdf', 'Exited Employees Detail (Last @Model.PeriodMonths Months)');
        }
    }

    function onTurnQueryCellInfo(args) {
        if (!args.column || !args.data) return;
        if (args.column.field === 'Exits3M' && args.data.Exits3M > 0) { args.cell.style.backgroundColor = '#FDE6A8'; args.cell.style.color = '#1e293b'; }
        else if (args.column.field === 'Exits6M' && args.data.Exits6M > 0) { args.cell.style.backgroundColor = '#F8C4C0'; args.cell.style.color = '#1e293b'; }
        else if (args.column.field === 'Exits12M' && args.data.Exits12M > 0) { args.cell.style.backgroundColor = '#F3C6DC'; args.cell.style.color = '#1e293b'; args.cell.style.fontWeight = '600'; }
    }

    function onTurnChartClick(args) {
        if (!args || !args.point || !args.point.x) return;
        var clicked = args.point.x;
        if (selectedTurnDept === clicked) { clearTurnFilter(); return; }
        selectedTurnDept = clicked;
        applyTurnSelection(allExitItems.filter(function (x) { return x.Department === clicked; }), clicked);
    }

    function clearTurnFilter() {
        selectedTurnDept = null;
        applyTurnSelection(allExitItems, null);
    }

    function applyTurnSelection(rows, deptLabel) {
        var grid = document.getElementById('turnDetailGrid').ej2_instances[0];
        grid.dataSource = rows; grid.refresh();
        document.getElementById('kpiTurnExits').innerText = rows.length;
        document.getElementById('turnDetailTitle').innerText = deptLabel
            ? ('Exited Employees - ' + deptLabel + ' (' + rows.length + ')')
            : ('Exited Employees - Last @Model.PeriodMonths Months (' + rows.length + ')');
        document.getElementById('btnClearTurnFilter').style.display = deptLabel ? 'inline-block' : 'none';
    }
</script>
