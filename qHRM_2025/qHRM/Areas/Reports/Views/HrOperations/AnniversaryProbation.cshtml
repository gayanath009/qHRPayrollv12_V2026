@model AnniversaryProbationReportVm
@{
    ViewData["Title"] = "Probation & Anniversary Tracker";
}

<style>
    .hr-ops-title { color: #550033 !important; font-weight: 700 !important; font-size: 1.4rem; margin-bottom: 2px; }
    .hr-kpi-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 14px 18px; border: 1px solid #eef0f4; height: 100%; }
    .hr-kpi-purple { border-top: 3px solid #6f42c1; }
    .hr-kpi-green { border-top: 3px solid #0f9d58; }
    .hr-kpi-red { border-top: 3px solid #dc2626; }
    .hr-kpi-orange { border-top: 3px solid #e67e22; }
    .hr-kpi-lbl { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #5f6368 !important; margin-bottom: 4px; }
    .hr-kpi-val { font-size: 24px; font-weight: 700; color: #111827 !important; line-height: 1.2; }
    .hr-kpi-sub { font-size: 11px; color: #6b7280 !important; margin-top: 3px; }
</style>

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <div>
            <div class="hr-ops-title"><i class="fas fa-award mr-2"></i>Probation &amp; Anniversary Tracker</div>
            <small class="text-muted">HR Operations &bull; Track active probation end dates and upcoming service anniversaries (1st-Year Ticket-Only vs. 2+ Year Leave &amp; Ticket)</small>
        </div>
        <form method="get" class="form-inline">
            <select name="staffCat" class="form-control form-control-sm mr-2">
                <option value="ALL" selected="@(Model.StaffCat == "ALL")">All Staff</option>
                <option value="INTERNAL" selected="@(Model.StaffCat == "INTERNAL")">In-House</option>
                <option value="OUTSOURCE" selected="@(Model.StaffCat == "OUTSOURCE")">Outsource</option>
            </select>
            <select name="days" class="form-control form-control-sm mr-2">
                <option value="30" selected="@(Model.HorizonDays == 30)">Next 30 Days</option>
                <option value="60" selected="@(Model.HorizonDays == 60)">Next 60 Days</option>
                <option value="90" selected="@(Model.HorizonDays == 90)">Next 90 Days</option>
                <option value="180" selected="@(Model.HorizonDays == 180)">Next 180 Days</option>
            </select>
            <button type="submit" class="btn btn-sm text-white" style="background:#550033;"><i class="fas fa-filter mr-1"></i>Apply</button>
        </form>
    </div>

    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-purple">
                <div class="hr-kpi-lbl">Active Probations</div>
                <div id="kpiActiveProb" class="hr-kpi-val">@Model.ActiveProbationCount</div>
                <div class="hr-kpi-sub">Currently under probation</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-orange">
                <div class="hr-kpi-lbl">Probation Ending &le;30d</div>
                <div id="kpiProbSoon" class="hr-kpi-val">@Model.ProbationEndingSoonCount</div>
                <div class="hr-kpi-sub">Evaluation due soon</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-red">
                <div class="hr-kpi-lbl">1st-Year (Ticket Only)</div>
                <div id="kpiFirstYear" class="hr-kpi-val">@Model.UpcomingFirstYearCount</div>
                <div class="hr-kpi-sub">Air ticket entitlement only</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-2">
            <div class="hr-kpi-card hr-kpi-green">
                <div class="hr-kpi-lbl">2+ Year (Leave + Ticket)</div>
                <div id="kpiMultiYear" class="hr-kpi-val">@Model.UpcomingMultiYearCount</div>
                <div class="hr-kpi-sub">Leave salary &amp; air ticket</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header py-2 bg-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold" style="color:#550033 !important;">Upcoming Anniversaries by Month <small class="text-muted font-weight-normal">(Click a bar to filter both grids)</small></h6>
            <button id="btnClearAnnivFilter" type="button" class="btn btn-xs btn-outline-secondary" style="display:none;" onclick="clearAnnivFilter()"><i class="fas fa-times mr-1"></i>Show All</button>
        </div>
        <div class="card-body">
            <ejs-chart id="annivChart" height="250px" pointClick="onAnnivChartPointClick" style="cursor:pointer;">
                <e-chart-primaryxaxis valueType="Category"></e-chart-primaryxaxis>
                <e-chart-tooltipsettings enable="true"></e-chart-tooltipsettings>
                <e-series-collection>
                    <e-series dataSource="Model.MonthlyChartData" xName="MonthLabel" yName="FirstYearTicketOnly" name="1st Year (Ticket Only)" type="StackingColumn" fill="#C7D8FA">
                        <e-series-marker><e-series-datalabel visible="true"></e-series-datalabel></e-series-marker>
                    </e-series>
                    <e-series dataSource="Model.MonthlyChartData" xName="MonthLabel" yName="MultiYearLeaveAndTicket" name="2+ Years (Leave &amp; Ticket)" type="StackingColumn" fill="#BDECD6">
                        <e-series-marker><e-series-datalabel visible="true"></e-series-datalabel></e-series-marker>
                    </e-series>
                </e-series-collection>
            </ejs-chart>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header py-2 bg-white">
            <h6 id="annivGridTitle" class="m-0 font-weight-bold" style="color:#550033 !important;">Upcoming Service Anniversaries (@Model.Anniversaries.Count)</h6>
        </div>
        <div class="card-body">
            <ejs-grid id="annivGrid" dataSource="Model.Anniversaries" allowPaging="true" allowSorting="true" allowFiltering="true" allowPdfExport="true" queryCellInfo="onAnnivQueryCellInfo" toolbarClick="onAnnivToolbarClick" toolbar="@(new List<string>() { "PdfExport", "Search" })">
                <e-grid-pagesettings pageSize="10"></e-grid-pagesettings>
                <e-grid-filterSettings type="Excel"></e-grid-filterSettings>
                <e-grid-columns>
                    <e-grid-column field="EmpId" headerText="Emp ID" width="95"></e-grid-column>
                    <e-grid-column field="FullName" headerText="Employee Name" width="175"></e-grid-column>
                    <e-grid-column field="Department" headerText="Department" width="150"></e-grid-column>
                    <e-grid-column field="StaffCategory" headerText="Category" width="105"></e-grid-column>
                    <e-grid-column field="JoinedDateStr" headerText="Joined Date" width="120"></e-grid-column>
                    <e-grid-column field="NextAnniversaryDateStr" headerText="Anniversary" width="120"></e-grid-column>
                    <e-grid-column field="CompletedYears" headerText="Years" textAlign="Right" width="80"></e-grid-column>
                    <e-grid-column field="DaysUntil" headerText="In Days" textAlign="Right" width="85"></e-grid-column>
                    <e-grid-column field="EncashmentEntitlement" headerText="Encashment Rule" width="190"></e-grid-column>
                </e-grid-columns>
            </ejs-grid>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-2 bg-white">
            <h6 id="probGridTitle" class="m-0 font-weight-bold" style="color:#550033 !important;">Active Probation Periods (@Model.Probations.Count)</h6>
        </div>
        <div class="card-body">
            <ejs-grid id="probGrid" dataSource="Model.Probations" allowPaging="true" allowSorting="true" allowFiltering="true" allowPdfExport="true" toolbarClick="onProbToolbarClick" toolbar="@(new List<string>() { "PdfExport", "Search" })">
                <e-grid-pagesettings pageSize="10"></e-grid-pagesettings>
                <e-grid-filterSettings type="Excel"></e-grid-filterSettings>
                <e-grid-columns>
                    <e-grid-column field="EmpId" headerText="Emp ID" width="95"></e-grid-column>
                    <e-grid-column field="FullName" headerText="Employee Name" width="175"></e-grid-column>
                    <e-grid-column field="Department" headerText="Department" width="150"></e-grid-column>
                    <e-grid-column field="StDateStr" headerText="Start Date" width="120"></e-grid-column>
                    <e-grid-column field="EndDateStr" headerText="End Date" width="120"></e-grid-column>
                    <e-grid-column field="DaysRemaining" headerText="Days Left" textAlign="Right" width="95"></e-grid-column>
                    <e-grid-column field="IsExtended" headerText="Extended" width="95"></e-grid-column>
                    <e-grid-column field="Note" headerText="Remarks" width="200"></e-grid-column>
                </e-grid-columns>
            </ejs-grid>
        </div>
    </div>
</div>

<script>
    var allAnnivItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Anniversaries));
    var allProbItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Probations));
    var selectedMonthLabel = null;
    var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function toMonthLabel(isoDateStr) {
        if (!isoDateStr) return '';
        var d = new Date(isoDateStr);
        if (isNaN(d.getTime())) return '';
        return monthNames[d.getMonth()] + ' ' + d.getFullYear();
    }

    function onAnnivToolbarClick(args) {
        if (args.item.id === 'annivGrid_pdfexport') {
            exportReportGridPdf('annivGrid', 'Upcoming_Service_Anniversaries.pdf', 'Upcoming Service Anniversaries Report');
        }
    }
    function onProbToolbarClick(args) {
        if (args.item.id === 'probGrid_pdfexport') {
            exportReportGridPdf('probGrid', 'Active_Probation_Periods.pdf', 'Active Probation Periods Report');
        }
    }

    function onAnnivQueryCellInfo(args) {
        if (args.column.field === 'EncashmentEntitlement' && args.data) {
            args.cell.style.backgroundColor = args.data.CompletedYears === 1 ? '#C7D8FA' : '#BDECD6';
            args.cell.style.color = '#1e293b';
            args.cell.style.fontWeight = '600';
        }
    }

    function onAnnivChartPointClick(args) {
        if (!args || !args.point || !args.point.x) return;
        var clicked = args.point.x;
        if (selectedMonthLabel === clicked) { clearAnnivFilter(); return; }
        selectedMonthLabel = clicked;
        applyAnnivSelection(
            allAnnivItems.filter(function (x) { return toMonthLabel(x.NextAnniversaryDate) === clicked; }),
            allProbItems.filter(function (x) { return toMonthLabel(x.EndDate) === clicked; }),
            clicked
        );
    }

    function clearAnnivFilter() {
        selectedMonthLabel = null;
        applyAnnivSelection(allAnnivItems, allProbItems, null);
    }

    function applyAnnivSelection(annivRows, probRows, monthLabel) {
        var aGrid = document.getElementById('annivGrid').ej2_instances[0];
        aGrid.dataSource = annivRows; aGrid.refresh();
        var pGrid = document.getElementById('probGrid').ej2_instances[0];
        pGrid.dataSource = probRows; pGrid.refresh();

        var firstYr = 0, multiYr = 0, probSoon = 0;
        for (var i = 0; i < annivRows.length; i++) {
            if (annivRows[i].CompletedYears === 1) firstYr++;
            else if (annivRows[i].CompletedYears > 1) multiYr++;
        }
        for (var j = 0; j < probRows.length; j++) {
            if (probRows[j].DaysRemaining <= 30) probSoon++;
        }

        document.getElementById('kpiActiveProb').innerText = probRows.length;
        document.getElementById('kpiProbSoon').innerText = probSoon;
        document.getElementById('kpiFirstYear').innerText = firstYr;
        document.getElementById('kpiMultiYear').innerText = multiYr;
        document.getElementById('annivGridTitle').innerText = monthLabel ? ('Upcoming Service Anniversaries - ' + monthLabel + ' (' + annivRows.length + ')') : ('Upcoming Service Anniversaries (' + annivRows.length + ')');
        document.getElementById('probGridTitle').innerText = monthLabel ? ('Active Probation Periods - ' + monthLabel + ' (' + probRows.length + ')') : ('Active Probation Periods (' + probRows.length + ')');
        document.getElementById('btnClearAnnivFilter').style.display = monthLabel ? 'inline-block' : 'none';
    }
</script>
