@model qHRM.Areas.Leave.Models.HrLvWfConfig

<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

@using (Html.BeginForm("Create", "HrLvWfConfig", new { area = "Leave" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <span class="alert-success">@Html.ValidationSummary(true)</span>
    @Html.HiddenFor(m => m.WfCfgId)
    @Html.HiddenFor(m => m.BuHeadEmpId)

    <div class="row">
        <!-- LEFT COLUMN: Core Config -->
        <div class="col-md-6">
            <h6 class="text-muted font-weight-bold mb-3" style="color:#540033!important;border-bottom:2px solid rgba(153,0,73,.2);padding-bottom:6px;">
                <i class="fas fa-cog"></i> Workflow Mapping
            </h6>

            <div class="form-group">
                <label asp-for="WfType" class="control-label font-weight-bold">Workflow Type</label>
                <select asp-for="WfType" id="drpCreateWfType" class="form-control form-control-sm">
                    <option value="Leave Approval">Leave Approval</option>
                    <option value="Salary Process">Salary Process</option>
                    <option value="Leave Salary & Air Ticket Encashment">Leave Salary & Air Ticket Encashment</option>
                </select>
            </div>

            <div class="form-group" id="grpCreateLvTyp">
                <label asp-for="LvTypId" class="control-label"></label>
                <select asp-for="LvTypId" id="drpLvTyp" class="form-control form-control-sm select2-dropdown"
                        asp-items="@(new SelectList(ViewBag.lstLvTyp, "LvTypId", "NameEng"))">
                    <option value="">-- Select Leave Type --</option>
                </select>
                <span asp-validation-for="LvTypId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="WfCode" class="control-label"></label>
                <input asp-for="WfCode" id="txtCreateWfCode" class="form-control form-control-sm"
                       placeholder="e.g. LV_SICK, LV_CSL, SALARY_PROCESS, ENCASH_PROCESS" />
                <small class="text-muted">Must match the Workflow Code in the Workflow Engine.</small>
                <span asp-validation-for="WfCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EffDate" class="control-label"></label>
                <input asp-for="EffDate" type="date" class="form-control form-control-sm" />
            </div>

            <div class="form-group">
                <label asp-for="ExpDate" class="control-label"></label>
                <input asp-for="ExpDate" type="date" class="form-control form-control-sm" />
            </div>

            <div class="form-group">
                <div class="custom-control custom-switch">
                    <input asp-for="IsEnabled" type="checkbox" class="custom-control-input" id="chkIsEnabled" />
                    <label class="custom-control-label" for="chkIsEnabled">Workflow Enabled</label>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Approver Config -->
        <div class="col-md-6">
            <!-- LEAVE APPROVERS (5 STEPS) -->
            <div id="secLeaveApprovers">
                <h6 class="text-muted font-weight-bold mb-3" style="color:#540033!important;border-bottom:2px solid rgba(153,0,73,.2);padding-bottom:6px;">
                    <i class="fas fa-users"></i> Designated Approvers (Leave)
                </h6>
                <small class="text-muted d-block mb-2">
                    Select the specific employee for each workflow step role in execution order.
                </small>

                <div class="form-group">
                    <label class="control-label">Step 1 - Outsource Record Owner</label>
                    <select asp-for="OutsourceRecordOwnerEmpId" id="drpOutsourceOwner" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.OutsourceRecordOwnerEmpId))">
                        <option value="">-- Select Outsource Record Owner --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="control-label">Step 2 - Reporting Manager</label>
                    <select asp-for="ReportingManagerEmpId" id="drpRepMgr" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.ReportingManagerEmpId))">
                        <option value="">-- Select Reporting Manager --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="control-label">Step 3 - HR</label>
                    <select asp-for="HrManagerEmpId" id="drpHrMgr" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.HrManagerEmpId))">
                        <option value="">-- Select HR Approver --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="control-label">Step 4 - Finance</label>
                    <select asp-for="FinanceEmpId" id="drpFinance" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.FinanceEmpId))">
                        <option value="">-- Select Finance Approver --</option>
                    </select>
                </div>

                <div class="form-group" id="grpCreateCeoStep">
                    <label class="control-label">Step 5 - CEO (Final Approver)</label>
                    <select asp-for="CeoEmpId" id="drpCeo" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.CeoEmpId))">
                        <option value="">-- Select CEO Approver --</option>
                    </select>
                </div>
            </div>

            <!-- PAYROLL & ENCASHMENT APPROVERS (3 STEPS) -->
            <div id="secPayrollApprovers" style="display:none;">
                <h6 class="text-muted font-weight-bold mb-3" style="color:#540033!important;border-bottom:2px solid rgba(153,0,73,.2);padding-bottom:6px;">
                    <i class="fas fa-users-cog"></i> Designated Approvers (Payroll / Encashment)
                </h6>
                <small class="text-muted d-block mb-2">
                    Approval flow: Step 1 (Initiator & Verifier) &rarr; Step 2 (Level 1 Approver) &rarr; Step 3 (Final Approver).
                </small>

                <div class="form-group">
                    <label class="control-label">Step 1 - Initiator & Verifier</label>
                    <select asp-for="InitiatorEmpId" id="drpPayrollInitiator" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.InitiatorEmpId ?? 6))">
                    </select>
                    <small class="text-muted">Select employee assigned to initiate & verify this workflow</small>
                </div>

                <div class="form-group">
                    <label class="control-label">Step 2 - Level 1 Approver</label>
                    <select asp-for="Level1ApproverEmpId" id="drpPayrollLevel1" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.Level1ApproverEmpId ?? 452))">
                    </select>
                    <small class="text-muted">Select employee assigned to review and provide Level 1 approval</small>
                </div>

                <div class="form-group">
                    <label class="control-label">Step 3 - Final Approver</label>
                    <select asp-for="FinalApproverEmpId" id="drpPayrollFinal" class="form-control form-control-sm select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.FinalApproverEmpId ?? 11))">
                    </select>
                    <small class="text-muted">Select employee assigned to provide final sign-off</small>
                </div>
            </div>
        </div>
    </div>

    <!-- POLICY RULES -->
    <div id="secPolicyRules">
        <hr style="border-color:rgba(153,0,73,.2);margin:16px 0;" />
        <h6 class="font-weight-bold mb-3" style="color:#540033;">
            <i class="fas fa-shield-alt"></i> Policy Rules
        </h6>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <div class="custom-control custom-checkbox">
                        <input asp-for="MedCertRequired" type="checkbox" class="custom-control-input" id="chkMedCert" />
                        <label class="custom-control-label" for="chkMedCert">Medical Certificate Required</label>
                    </div>
                </div>
                <div class="form-group">
                    <div class="custom-control custom-checkbox">
                        <input asp-for="NoPay" type="checkbox" class="custom-control-input" id="chkNoPay" />
                        <label class="custom-control-label" for="chkNoPay">No Pay Leave</label>
                    </div>
                </div>
                <div class="custom-control custom-checkbox">
                    <input asp-for="OnceInService" type="checkbox" class="custom-control-input" id="chkOnce" />
                    <label class="custom-control-label" for="chkOnce">Once in Service Only</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="control-label">Payroll Cutoff Day</label>
                    <input asp-for="PayrollCutoffDay" type="number" min="1" max="31" class="form-control form-control-sm" placeholder="20" />
                    <small class="text-muted">Day of month (e.g. 20). Used for Casual Leave.</small>
                </div>
                <div class="form-group">
                    <label class="control-label">Full Pay Days (Sick)</label>
                    <input asp-for="FullPayDays" type="number" min="0" class="form-control form-control-sm" placeholder="14" />
                </div>
                <div class="form-group">
                    <label class="control-label">Half Pay Days (Sick)</label>
                    <input asp-for="HalfPayDays" type="number" min="0" class="form-control form-control-sm" placeholder="28" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="control-label">Max Days per Application</label>
                    <input asp-for="MaxDays" type="number" min="0" class="form-control form-control-sm" placeholder="e.g. 14 for Hajj" />
                </div>
                <div class="form-group">
                    <label class="control-label">Annual Entitlement (Days)</label>
                    <input asp-for="AnnualEntitlement" type="number" min="0" class="form-control form-control-sm" placeholder="e.g. 3 for Casual" />
                </div>
                <div class="form-group">
                    <label class="control-label">Gender Required (M/F blank=any)</label>
                    <input asp-for="GenderRequired" class="form-control form-control-sm" placeholder="F" maxlength="1" />
                </div>
            </div>
        </div>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Save Configuration" class="btn btn-sm btn-primary" />
        <input type="button" value="Cancel" class="btn btn-sm btn-outline-secondary" data-dismiss="modal" />
    </div>
}

<script>
    $(function () {
        $('#modalCreate .select2-dropdown').each(function () {
            var $this = $(this);
            if ($this.hasClass("select2-hidden-accessible")) {
                $this.select2('destroy');
            }
            $this.select2({
                theme: 'bootstrap4',
                width: '100%',
                dropdownParent: $('#modalCreate')
            });
        });

        $('#modalCreate .select2-dropdown').on('change', function () {
            try { $(this).valid(); } catch (e) { }
        });

        function toggleWfTypeCreate() {
            var wfType = $('#drpCreateWfType').val();
            if (wfType === 'Leave Approval') {
                $('#grpCreateLvTyp').show();
                $('#secLeaveApprovers').show();
                $('#secPolicyRules').show();
                $('#secPayrollApprovers').hide();
            } else {
                $('#grpCreateLvTyp').hide();
                $('#secLeaveApprovers').hide();
                $('#secPolicyRules').hide();
                $('#secPayrollApprovers').show();
                if (wfType === 'Salary Process' && !$('#txtCreateWfCode').val()) {
                    $('#txtCreateWfCode').val('SALARY_PROCESS');
                } else if (wfType === 'Leave Salary & Air Ticket Encashment' && !$('#txtCreateWfCode').val()) {
                    $('#txtCreateWfCode').val('ENCASH_PROCESS');
                }
            }
        }

        function toggleCreateCeoStep() {
            var code = ($('#txtCreateWfCode').val() || '').toUpperCase();
            var lvText = ($('#drpLvTyp option:selected').text() || '').toUpperCase();
            if (code.indexOf('SICK') !== -1 || code.indexOf('CSL') !== -1 || lvText.indexOf('SICK') !== -1 || lvText.indexOf('CASUAL') !== -1) {
                $('#grpCreateCeoStep').hide();
            } else {
                $('#grpCreateCeoStep').show();
            }
        }

        $('#drpCreateWfType').on('change', toggleWfTypeCreate);
        $('#txtCreateWfCode, #drpLvTyp').on('input change', toggleCreateCeoStep);

        toggleWfTypeCreate();
        toggleCreateCeoStep();
    });
</script>
