@model IEnumerable<qHRM.Areas.Leave.Models.HrLvWfConfig>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Leave Workflow Configuration";
}
<script src="~/js/ej2.min.js"></script>

<div>
    <main>
        <div class="container-fluid">
            <h1 class="mt-4">Leave Workflow Configuration</h1>
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item"><a href="#">Leave</a></li>
                <li class="breadcrumb-item">Workflow Configuration</li>
            </ol>

            @* Alert Banner *@
            <div class="alert" style="background:rgba(153,0,73,0.08);border-left:4px solid #540033;border-radius:6px;padding:14px 18px;margin-bottom:20px;">
                <i class="fas fa-info-circle" style="color:#540033;"></i>
                <strong style="color:#540033;"> Configuration Guide:</strong>
                Manage distinct Leave Workflow Configurations for both <strong>In-House</strong> and <strong>Outsource</strong> employees.
                Designated approvers and policy rules (e.g. medical certificates, payroll cutoff) are configured per employee category and leave type.
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <p>
                        @if (ViewBag.RecAdd == true)
                        {
                            <a href="#" class="btn btn-sm btn-primary" id="btnAddNew" onclick="createFunc();">
                                <i class="fas fa-plus-circle"></i> Add Workflow Config
                            </a>
                        }
                    </p>

                    <!-- Syncfusion Grid -->
                    <div class="control-section">
                        <ejs-grid id="GridWfCfg" width="auto" dataSource="ViewBag.DataSource"
                                  allowPaging="true" allowFiltering="true" allowSorting="true"
                                  allowExcelExport="true" toolbarClick="toolbarClick"
                                  toolbar="@(new List<string>() {"ExcelExport"})"
                                  load="loadFormattings"
                                  queryCellInfo="customizeCells">
                            <e-grid-filterSettings type="CheckBox"></e-grid-filterSettings>
                            <e-grid-pagesettings pageCount="5"></e-grid-pagesettings>
                            <e-grid-columns>
                                <e-grid-column field="WfType"      headerText="Workflow Type"   width="200"></e-grid-column>
                                <e-grid-column field="LvTypName"   headerText="Type / Target"   width="180"></e-grid-column>
                                <e-grid-column field="WfCode"      headerText="Workflow Code"   width="150"></e-grid-column>
                                <e-grid-column field="EffDate"     headerText="Eff. Date"       width="100" type="date" format="dd-MMM-yyyy"></e-grid-column>
                                <e-grid-column field="ExpDate"     headerText="Exp. Date"       width="100" type="date" format="dd-MMM-yyyy"></e-grid-column>
                                <e-grid-column field="IsEnabled"   headerText="Status"          width="110" textAlign="Center"></e-grid-column>
                                <e-grid-column field="CrtDateTime" headerText="Created"         width="120" type="date" format="dd-MMM-yyyy"></e-grid-column>
                                @if (ViewBag.RecEdit == true)
                                {
                                    <e-grid-column field="" headerText="" template="#_edit" width="60" textAlign="Center"></e-grid-column>
                                }
                            </e-grid-columns>
                        </ejs-grid>
                    </div>

                    <!-- CREATE Modal -->
                    <div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content" style="border-top:4px solid #540033;">
                                <div class="modal-header" style="background:rgba(153,0,73,0.06);">
                                    <h5 class="modal-title" style="color:#540033;font-weight:700;">
                                        <i class="fas fa-cogs"></i> New Leave Workflow Configuration
                                    </h5>
                                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                </div>
                                <div class="modal-body" id="createForm"></div>
                            </div>
                        </div>
                    </div>

                    <!-- EDIT Modal -->
                    <div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content" style="border-top:4px solid #540033;">
                                <div class="modal-header" style="background:rgba(153,0,73,0.06);">
                                    <h5 class="modal-title" style="color:#540033;font-weight:700;">
                                        <i class="fas fa-edit"></i> Edit Leave Workflow Configuration
                                    </h5>
                                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                </div>
                                <div class="modal-body" id="editForm"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Edit Button Template -->
<script id="_edit" type="text/x-template">
    <a href="#" class="btn btn-sm btn-outline-primary" onclick="editFunc(${WfCfgId})" title="Edit">
        <i class="fas fa-pencil-alt"></i>
    </a>
</script>

<script>
    function customizeCells(args) {
        if (args.column.field === 'WfType') {
            var val = args.data.WfType || '';
            if (val.indexOf('In-House') !== -1) {
                args.cell.innerHTML = '<span class="badge" style="background:#0d6efd;color:#fff;font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;display:inline-flex;align-items:center;gap:5px;"><i class="fas fa-building"></i> In-House Leave</span>';
            } else if (val.indexOf('Outsource') !== -1 || val === 'Leave Approval') {
                args.cell.innerHTML = '<span class="badge" style="background:#6f42c1;color:#fff;font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;display:inline-flex;align-items:center;gap:5px;"><i class="fas fa-users"></i> Outsource Leave</span>';
            } else if (val.indexOf('Salary') !== -1) {
                args.cell.innerHTML = '<span class="badge badge-danger" style="background:#dc3545;color:#fff;font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;display:inline-flex;align-items:center;gap:5px;"><i class="fas fa-money-check-alt"></i> Salary Process</span>';
            } else if (val.indexOf('Encashment') !== -1) {
                args.cell.innerHTML = '<span class="badge badge-secondary" style="background:#6c757d;color:#fff;font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;display:inline-flex;align-items:center;gap:5px;"><i class="fas fa-plane"></i> Encashment</span>';
            } else if (val.indexOf('Regularization') !== -1) {
                args.cell.innerHTML = '<span class="badge badge-dark" style="background:#343a40;color:#fff;font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;display:inline-flex;align-items:center;gap:5px;"><i class="fas fa-clock"></i> Regularization</span>';
            } else {
                args.cell.innerHTML = '<span class="badge badge-info" style="font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;">' + val + '</span>';
            }
        } else if (args.column.field === 'IsEnabled') {
            if (args.data.IsEnabled) {
                args.cell.innerHTML = '<span class="badge badge-success" style="background:#28a745;color:#fff;font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;display:inline-flex;align-items:center;gap:5px;"><i class="fas fa-check-circle"></i> Active</span>';
            } else {
                args.cell.innerHTML = '<span class="badge badge-secondary" style="background:#6c757d;color:#fff;font-size:11.5px;padding:5px 10px;border-radius:4px;font-weight:600;display:inline-flex;align-items:center;gap:5px;"><i class="fas fa-times-circle"></i> Inactive</span>';
            }
        }
    }

    function createFunc() {
        $.ajax({
            url: '/Leave/HrLvWfConfig/CreateNew',
            type: 'GET',
            success: function (data) {
                $('#createForm').html(data);
                $('#modalCreate').modal('show');
            }
        });
    }

    function editFunc(wfCfgId) {
        $.ajax({
            url: '/Leave/HrLvWfConfig/EditGet?wfCfgId=' + wfCfgId,
            type: 'GET',
            success: function (data) {
                $('#editForm').html(data);
                $('#modalEdit').modal('show');
            }
        });
    }

    function toolbarClick(args) {
        if (args.item.id === 'GridWfCfg_excelexport') {
            var gridObj = document.getElementById('GridWfCfg').ej2_instances[0];
            gridObj.excelExport();
        }
    }

    function loadFormattings() {
        this.element.style.fontFamily = 'Nunito, Segoe UI, sans-serif';
        this.element.style.fontSize = '13px';
    }
</script>

<ejs-scripts></ejs-scripts>
