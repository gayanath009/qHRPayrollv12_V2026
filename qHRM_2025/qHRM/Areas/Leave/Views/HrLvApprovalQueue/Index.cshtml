@model qHRM.Areas.Leave.Models.LeaveApprovalQueueViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Leave Approval Queue";
}

@Html.AntiForgeryToken()

<style>
    :root {
        --org-primary: #540033;
        --org-primary-hover: #3e0026;
        --org-primary-light: #fdf2f8;
        --org-primary-border: #fbcfe8;
        --clr-border: rgba(2,6,23,0.08);
        --clr-text: #0f172a;
        --clr-muted: #64748b;
        --radius-sm: 8px;
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
        --shadow-md: 0 4px 16px rgba(2,6,23,0.08);
    }

    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border);
        padding: 0.85rem 1.35rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.25);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--clr-text);
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: var(--org-primary-light);
        color: var(--org-primary);
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid var(--org-primary-border);
        text-transform: uppercase;
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: var(--clr-muted);
        margin-top: 0.2rem;
        line-height: 1.2;
    }

    .filter-tab {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--clr-muted);
        background: #ffffff;
        border: 1px solid var(--clr-border);
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none !important;
    }

    .filter-tab:hover {
        background: #f8fafc;
        color: var(--org-primary);
        border-color: var(--org-primary-border);
    }

    .filter-tab.active {
        background: var(--org-primary);
        color: #ffffff;
        border-color: var(--org-primary);
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.25);
    }

    .filter-tab .badge {
        margin-left: 0.5rem;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 12px;
    }

    .filter-tab.active .badge {
        background: rgba(255, 255, 255, 0.25) !important;
        color: #ffffff !important;
    }

    .queue-table {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .queue-table table {
        margin-bottom: 0;
    }

    .queue-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        border-top: none;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.85rem 1rem;
        white-space: nowrap;
    }

    .queue-table td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
        font-size: 0.85rem;
        border-bottom: 1px solid #f1f5f9;
        color: var(--clr-text);
    }

    .queue-table tr:hover td {
        background-color: #fbfcfe;
    }

    .badge-status {
        padding: 0.35rem 0.65rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 6px;
        letter-spacing: 0.02em;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .status-approved {
        background-color: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .status-pending {
        background-color: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .status-rejected {
        background-color: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .status-cancelled {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
    }

    .btn-action-approve {
        background-color: #1bc387 !important;
        color: #ffffff !important;
        border: 1px solid #1bc387 !important;
        border-radius: 6px !important;
        padding: 0.35rem 0.75rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        transition: all 0.15s ease !important;
        box-shadow: 0 1px 3px rgba(27, 195, 135, 0.3) !important;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .btn-action-approve:hover {
        background-color: #17a673 !important;
        border-color: #17a673 !important;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(27, 195, 135, 0.4) !important;
    }

    .btn-action-reject {
        background-color: #e74a3b !important;
        color: #ffffff !important;
        border: 1px solid #e74a3b !important;
        border-radius: 6px !important;
        padding: 0.35rem 0.75rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        transition: all 0.15s ease !important;
        box-shadow: 0 1px 3px rgba(231, 74, 59, 0.3) !important;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .btn-action-reject:hover {
        background-color: #d52a1a !important;
        border-color: #d52a1a !important;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(231, 74, 59, 0.4) !important;
    }

    .btn-action-timeline {
        background: #f8fafc;
        color: #475569 !important;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 0.35rem 0.65rem;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .btn-action-timeline:hover {
        background: #f1f5f9;
        color: var(--org-primary) !important;
    }

    .cycle-control-box {
        background: #ffffff;
        border-radius: 10px;
        border: 1px solid var(--clr-border);
        padding: 0.75rem 1rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
    }
</style>

<div class="container-fluid px-4 py-3">

    <!-- HERO HEADER -->
    <div class="org-hero-card">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
            <div class="d-flex align-items-center">
                <div class="org-icon-badge mr-3">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center" style="gap: 0.5rem;">
                        <h1 class="org-title">Leave Approval Queue</h1>
                        <span class="org-category-pill">Leave</span>
                    </div>
                    <div class="org-breadcrumb">
                        Leave / Leave Approval Queue &bull; Payroll Cycle Approval &amp; Attendance Finalization
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center" style="gap: 0.5rem;">
                <span class="badge badge-light border px-3 py-2" style="font-size: 0.85rem; font-weight: 600; color: #540033;">
                    <i class="fas fa-calendar-alt mr-1"></i> Cycle: @Model.CycleLabel
                </span>
            </div>
        </div>
    </div>

    <!-- PAYROLL CYCLE FILTER & CONTROLS -->
    <div class="cycle-control-box">
        <form method="get" asp-action="Index" id="cycleFilterForm" class="row align-items-center">
            <input type="hidden" name="filter" value="@Model.Filter" />
            
            <div class="col-lg-5 col-md-12 mb-2 mb-lg-0">
                <div class="d-flex align-items-center" style="gap: 0.5rem;">
                    <span class="text-muted small font-weight-bold" style="white-space:nowrap;">Quick Cycle:</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="shiftCycle(-1)">
                        <i class="fas fa-chevron-left"></i> Prev Cycle
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" style="color:#540033; border-color:#540033;" onclick="resetToCurrentCycle()">
                        Current Cycle
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="shiftCycle(1)">
                        Next Cycle <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="col-lg-4 col-md-7 mb-2 mb-lg-0">
                <div class="input-group input-group-sm">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-light text-muted" style="font-size:0.75rem;">From</span>
                    </div>
                    <input type="date" class="form-control form-control-sm" id="fromDate" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                    <div class="input-group-prepend input-group-append">
                        <span class="input-group-text bg-light text-muted" style="font-size:0.75rem;">To</span>
                    </div>
                    <input type="date" class="form-control form-control-sm" id="toDate" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-sm" style="background:#540033; color:#fff;">
                            <i class="fas fa-filter"></i> Apply
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-5">
                <div class="input-group input-group-sm">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-light text-muted"><i class="fas fa-search"></i></span>
                    </div>
                    <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Search employee, leave type..." value="@Model.SearchQuery" onkeyup="filterTableLocally()" />
                </div>
            </div>
        </form>
    </div>

    <!-- QUICK FILTER TABS -->
    <div class="d-flex flex-wrap align-items-center mb-3">
        <a asp-action="Index" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-filter="all" class="filter-tab @(Model.Filter == "all" ? "active" : "")">
            All Requests <span class="badge badge-secondary">@Model.TotalAll</span>
        </a>
        <a asp-action="Index" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-filter="pending" class="filter-tab @(Model.Filter == "pending" ? "active" : "")">
            Pending <span class="badge badge-warning">@Model.TotalPending</span>
        </a>
        <a asp-action="Index" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-filter="approved" class="filter-tab @(Model.Filter == "approved" ? "active" : "")">
            Approved <span class="badge badge-success">@Model.TotalApproved</span>
        </a>
        <a asp-action="Index" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-filter="rejected" class="filter-tab @(Model.Filter == "rejected" ? "active" : "")">
            Rejected <span class="badge badge-danger">@Model.TotalRejected</span>
        </a>
        <a asp-action="Index" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-filter="cancelled" class="filter-tab @(Model.Filter == "cancelled" ? "active" : "")">
            Cancelled <span class="badge badge-light">@Model.TotalCancelled</span>
        </a>
    </div>

    <!-- NOTICE BANNER FOR PAYROLL IMPACT -->
    <div class="alert alert-light border d-flex align-items-center py-2 px-3 mb-3" style="border-left: 4px solid #059669 !important; font-size: 0.82rem; background: #f0fdf4;">
        <i class="fas fa-info-circle text-success mr-2 fa-lg"></i>
        <span>
            <strong>Payroll &amp; LOP Integration:</strong> When approved directly from this screen, leave requests are <strong>finalized immediately</strong> and active attendance records in the cycle are synchronized as authorized leave (0 deduction factor), ensuring they are <strong>never considered as LOP / NoPay</strong> during payroll processing.
        </span>
    </div>

    <!-- LEAVE DATA TABLE -->
    <div class="queue-table">
        <div class="table-responsive">
            <table class="table table-hover" id="queueTable">
                <thead>
                    <tr>
                        <th style="width: 80px;">Ref #</th>
                        <th>Employee</th>
                        <th>Department &amp; Designation</th>
                        <th>Leave Type</th>
                        <th>Leave Period</th>
                        <th class="text-center" style="width: 70px;">Days</th>
                        <th>Applied On</th>
                        <th>Pending With</th>
                        <th class="text-center" style="width: 100px;">Status</th>
                        <th class="text-center" style="width: 160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr id="noRecordsRow">
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-list fa-3x mb-3 text-gray-300 d-block"></i>
                                <strong>No leave requests found for the selected payroll cycle and filter.</strong>
                                <div class="small mt-1">Try switching to another cycle or clearing the filter.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr id="row-@item.LvId" data-search="@item.EmpId @item.FullName @item.Department @item.Designation @item.LeaveType @item.Reason @item.PendingWith">
                                <td class="font-weight-bold text-muted">
                                    #@item.LvId
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark" style="font-size:0.88rem;">@item.FullName</div>
                                    <div class="small text-muted font-italic"><i class="far fa-id-badge mr-1"></i>@item.EmpId</div>
                                </td>
                                <td>
                                    <div>@(string.IsNullOrEmpty(item.Department) ? "—" : item.Department)</div>
                                    <div class="small text-muted">@(string.IsNullOrEmpty(item.Designation) ? "—" : item.Designation)</div>
                                </td>
                                <td>
                                    <span class="badge badge-light border px-2 py-1" style="font-size:0.8rem; font-weight:600; color:#540033;">
                                        @item.LeaveType
                                    </span>
                                </td>
                                <td>
                                    <div class="font-weight-bold" style="font-size:0.83rem;">@item.FormattedPeriod</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Reason))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 220px;" title="@item.Reason">
                                            <i class="far fa-comment-alt mr-1"></i>@item.Reason
                                        </div>
                                    }
                                </td>
                                <td class="text-center font-weight-bold" style="font-size:0.95rem; color:#0f172a;">
                                    @item.Days
                                </td>
                                <td class="small text-muted">
                                    @item.FormattedAppliedDate
                                </td>
                                <td>
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge-status status-approved"><i class="fas fa-check-circle"></i> Completed</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge-status status-rejected"><i class="fas fa-times-circle"></i> Rejected</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge-status status-cancelled"><i class="fas fa-ban"></i> Cancelled</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center text-dark font-weight-500" style="font-size:0.82rem;">
                                            <i class="fas fa-user-clock text-warning mr-1"></i>
                                            <span>@item.PendingWith</span>
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge-status status-approved"><i class="fas fa-check"></i> Approved</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge-status status-pending"><i class="fas fa-clock"></i> Pending</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge-status status-rejected"><i class="fas fa-times"></i> Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status status-cancelled">@item.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center" style="gap: 0.35rem;">
                                        @if (item.CanDirectApprove)
                                        {
                                            <button type="button" class="btn btn-action-approve" onclick="openApproveModal(@item.LvId, '@item.FullName', @item.Days, '@item.LeaveType')" title="Approve &amp; Finalize">
                                                <i class="fas fa-check mr-1"></i>Approve
                                            </button>
                                        }
                                        @if (item.CanDirectReject)
                                        {
                                            <button type="button" class="btn btn-action-reject" onclick="openRejectModal(@item.LvId, '@item.FullName')" title="Reject">
                                                <i class="fas fa-times mr-1"></i>Reject
                                            </button>
                                        }
                                        <button type="button" class="btn btn-action-timeline" onclick="viewTimeline(@item.LvId)" title="View Timeline / Details">
                                            <i class="fas fa-history"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- APPROVE MODAL -->
<div class="modal fade" id="approveModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header text-white py-3" style="background-color: #1bc387; border-top-left-radius:12px; border-top-right-radius:12px;">
                <h5 class="modal-title font-weight-bold" style="font-size:1.05rem;">
                    <i class="fas fa-check-circle mr-2"></i>Approve Leave Request
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="approveLvId" />
                <p class="mb-3 text-dark" id="approveModalText" style="font-size:0.95rem;">
                    Are you sure you want to approve this leave request?
                </p>
                <div class="alert alert-success py-2 px-3 small mb-3">
                    <i class="fas fa-shield-alt mr-1"></i>
                    <strong>No LOP Guarantee:</strong> Approval is finalized immediately. All overlapping dates in the attendance sheet will be marked as authorized leave with 0 salary deduction.
                </div>
                <div class="form-group mb-0">
                    <label class="font-weight-600 text-muted small">Approval Comment (Optional):</label>
                    <textarea class="form-control" id="approveComment" rows="2" placeholder="e.g. Approved directly via Leave Approval Queue"></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-4" style="border-bottom-left-radius:12px; border-bottom-right-radius:12px;">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm px-4 font-weight-bold text-white" id="btnConfirmApprove" style="background-color: #1bc387; border-color: #1bc387;" onclick="submitApprove()">
                    <i class="fas fa-check mr-1"></i>Confirm Approval
                </button>
            </div>
        </div>
    </div>
</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="rejectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header text-white py-3" style="background-color: #e74a3b; border-top-left-radius:12px; border-top-right-radius:12px;">
                <h5 class="modal-title font-weight-bold" style="font-size:1.05rem;">
                    <i class="fas fa-times-circle mr-2"></i>Reject Leave Request
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="rejectLvId" />
                <p class="mb-3 text-dark" id="rejectModalText" style="font-size:0.95rem;">
                    Are you sure you want to reject this leave request?
                </p>
                <div class="form-group mb-0">
                    <label class="font-weight-600 text-muted small">Rejection Reason / Comment <span class="text-danger">*</span>:</label>
                    <textarea class="form-control" id="rejectComment" rows="3" placeholder="Enter reason for rejection..."></textarea>
                    <small class="text-danger d-none" id="rejectCommentError">Rejection reason is required.</small>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-4" style="border-bottom-left-radius:12px; border-bottom-right-radius:12px;">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm px-4 font-weight-bold text-white" id="btnConfirmReject" style="background-color: #e74a3b; border-color: #e74a3b;" onclick="submitReject()">
                    <i class="fas fa-times mr-1"></i>Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

<!-- TIMELINE MODAL -->
<div class="modal fade" id="timelineModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header py-3" style="background:#540033; color:#ffffff; border-top-left-radius:12px; border-top-right-radius:12px;">
                <h5 class="modal-title font-weight-bold" style="font-size:1.05rem;">
                    <i class="fas fa-history mr-2"></i>Leave Application Details &amp; Timeline
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0" id="timelineModalContent">
                <div class="text-center py-5">
                    <i class="fas fa-spinner fa-spin fa-2x text-muted"></i>
                    <div class="small mt-2 text-muted">Loading leave details...</div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-3" style="border-bottom-left-radius:12px; border-bottom-right-radius:12px;">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getCsrfToken() {
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        // Quick Cycle Navigation
        function shiftCycle(direction) {
            var fromInput = document.getElementById('fromDate');
            var toInput = document.getElementById('toDate');
            if (!fromInput.value || !toInput.value) return;

            var curFrom = new Date(fromInput.value);
            // Move by 1 month
            var newMonth = curFrom.getMonth() + direction;
            var newYear = curFrom.getFullYear();
            if (newMonth < 0) { newMonth = 11; newYear--; }
            else if (newMonth > 11) { newMonth = 0; newYear++; }

            var shiftedFrom = new Date(newYear, newMonth, 21);
            // End date is 20th of the following month
            var endMonth = newMonth + 1;
            var endYear = newYear;
            if (endMonth > 11) { endMonth = 0; endYear++; }
            var shiftedTo = new Date(endYear, endMonth, 20);

            fromInput.value = formatDateIso(shiftedFrom);
            toInput.value = formatDateIso(shiftedTo);
            document.getElementById('cycleFilterForm').submit();
        }

        function resetToCurrentCycle() {
            var today = new Date();
            var curFrom, curTo;
            if (today.getDate() <= 20) {
                // 21st prev month to 20th current month
                var prevMonth = today.getMonth() - 1;
                var prevYear = today.getFullYear();
                if (prevMonth < 0) { prevMonth = 11; prevYear--; }
                curFrom = new Date(prevYear, prevMonth, 21);
                curTo = new Date(today.getFullYear(), today.getMonth(), 20);
            } else {
                // 21st current month to 20th next month
                curFrom = new Date(today.getFullYear(), today.getMonth(), 21);
                var nextMonth = today.getMonth() + 1;
                var nextYear = today.getFullYear();
                if (nextMonth > 11) { nextMonth = 0; nextYear++; }
                curTo = new Date(nextYear, nextMonth, 20);
            }

            document.getElementById('fromDate').value = formatDateIso(curFrom);
            document.getElementById('toDate').value = formatDateIso(curTo);
            document.getElementById('cycleFilterForm').submit();
        }

        function formatDateIso(d) {
            var month = '' + (d.getMonth() + 1);
            var day = '' + d.getDate();
            var year = d.getFullYear();
            if (month.length < 2) month = '0' + month;
            if (day.length < 2) day = '0' + day;
            return [year, month, day].join('-');
        }

        // Local Filter / Search
        function filterTableLocally() {
            var input = document.getElementById('searchInput');
            var filter = input.value.toLowerCase().trim();
            var rows = document.querySelectorAll('#queueTable tbody tr[data-search]');
            var visibleCount = 0;

            rows.forEach(function(row) {
                var searchData = (row.getAttribute('data-search') || '').toLowerCase();
                if (searchData.indexOf(filter) > -1) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            var noRecordsRow = document.getElementById('noRecordsRow');
            if (noRecordsRow) {
                noRecordsRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
            }
        }

        // Modal triggers
        function openApproveModal(lvId, empName, days, lvType) {
            document.getElementById('approveLvId').value = lvId;
            document.getElementById('approveComment').value = '';
            document.getElementById('approveModalText').innerHTML = 
                'Are you sure you want to approve <strong>' + days + ' day(s)</strong> of <strong>' + lvType + '</strong> for <strong>' + empName + '</strong> (Ref #' + lvId + ')?';
            $('#approveModal').modal('show');
        }

        function openRejectModal(lvId, empName) {
            document.getElementById('rejectLvId').value = lvId;
            document.getElementById('rejectComment').value = '';
            document.getElementById('rejectCommentError').classList.add('d-none');
            document.getElementById('rejectModalText').innerHTML = 
                'Are you sure you want to reject the leave request for <strong>' + empName + '</strong> (Ref #' + lvId + ')?';
            $('#rejectModal').modal('show');
        }

        // AJAX Action Submissions
        function submitApprove() {
            var lvId = parseInt(document.getElementById('approveLvId').value, 10);
            var comment = document.getElementById('approveComment').value;
            var btn = document.getElementById('btnConfirmApprove');

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Approving...';

            fetch('@Url.Action("ApproveLeave", "HrLvApprovalQueue", new { area = "Leave" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: JSON.stringify({ lvId: lvId, comment: comment })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check mr-1"></i> Confirm Approval';
                $('#approveModal').modal('hide');

                if (data.success) {
                    // Update row UI immediately or reload
                    window.location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(function(err) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check mr-1"></i> Confirm Approval';
                alert('Network or server error: ' + err);
            });
        }

        function submitReject() {
            var lvId = parseInt(document.getElementById('rejectLvId').value, 10);
            var comment = document.getElementById('rejectComment').value.trim();
            var errEl = document.getElementById('rejectCommentError');

            if (!comment) {
                errEl.classList.remove('d-none');
                return;
            }
            errEl.classList.add('d-none');

            var btn = document.getElementById('btnConfirmReject');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Rejecting...';

            fetch('@Url.Action("RejectLeave", "HrLvApprovalQueue", new { area = "Leave" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: JSON.stringify({ lvId: lvId, comment: comment })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-times mr-1"></i> Confirm Rejection';
                $('#rejectModal').modal('hide');

                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(function(err) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-times mr-1"></i> Confirm Rejection';
                alert('Network or server error: ' + err);
            });
        }

        function viewTimeline(lvId) {
            $('#timelineModalContent').html('<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i><div class="small mt-2 text-muted">Loading leave details...</div></div>');
            $('#timelineModal').modal('show');

            fetch('@Url.Action("Timeline", "HrLvApprovalQueue", new { area = "Leave" })?lvId=' + lvId)
                .then(function(res) { return res.text(); })
                .then(function(html) {
                    $('#timelineModalContent').html(html);
                })
                .catch(function(err) {
                    $('#timelineModalContent').html('<div class="alert alert-danger m-3">Failed to load timeline: ' + err + '</div>');
                });
        }
    </script>
}

