        </button>
    ${else if(WfStat === 'Rejected')}
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent btn-wf-timeline" data-lvid="${LvId}" onclick="viewWorkflowTimeline(${LvId}, event)" title="Click to view Approval Timeline">
            <span class="badge badge-danger" style="background:#c0392b;color:#fff;padding:6px 10px;border-radius:4px;font-size:11px;white-space:nowrap;display:inline-flex;align-items:center;gap:5px;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,0.1);">
                <i class="fas fa-times-circle"></i> Rejected
            </span>
        </button>
    ${else if(WfStat === 'Leave Initiated' || WfStat === 'Submitted' || WfStat === 'InProgress')}
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent btn-wf-timeline" data-lvid="${LvId}" onclick="viewWorkflowTimeline(${LvId}, event)" title="Click to view Approval Timeline">
            <span class="badge badge-primary" style="background:#2563eb;color:#fff;padding:6px 10px;border-radius:4px;font-size:11px;white-space:nowrap;display:inline-flex;align-items:center;gap:5px;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,0.1);">
                <i class="fas fa-paper-plane"></i> Leave Initiated
            </span>
        </button>
    ${else if(WfStat === 'PendingResubmission')}
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent btn-wf-timeline" data-lvid="${LvId}" onclick="viewWorkflowTimeline(${LvId}, event)" title="Click to view Approval Timeline">
            <span class="badge badge-warning" style="background:#e67e22;color:#fff;padding:6px 10px;border-radius:4px;font-size:11px;white-space:nowrap;display:inline-flex;align-items:center;gap:5px;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,0.1);">
                <i class="fas fa-redo"></i> Returned
            </span>
        </button>
    ${else if(WfStat === 'Cancelled')}
        <span class="badge badge-secondary" style="background:#7f8c8d;color:#fff;padding:6px 10px;border-radius:4px;font-size:11px;white-space:nowrap;">
            Cancelled
        </span>
    ${else}
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent btn-wf-timeline" data-lvid="${LvId}" onclick="viewWorkflowTimeline(${LvId}, event)" title="Click to view Approval Timeline">
            <span class="badge badge-light" style="background:#ecf0f1;color:#666;padding:6px 10px;border-radius:4px;border:1px solid #ddd;font-size:11px;white-space:nowrap;cursor:pointer;">
                Not Submitted
            </span>
        </button>
    ${/if}
    </div>
</script>

