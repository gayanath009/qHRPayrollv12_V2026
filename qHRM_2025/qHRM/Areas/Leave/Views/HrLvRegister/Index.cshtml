<script>
    function loadFormattings(args) {
        if (this && this.sortSettings) {
            this.sortSettings.columns = [{ field: 'CrtDateTime', direction: 'Descending' }];
        }
    }

    function toolbarClick(args) {
        if (args && args.item && args.item.id === 'Grid_excelexport') {
            this.excelExport();
        }
    }

    var createFunc = function () {
        var url = "/Leave/HrLvRegister/CreateNew";
        $("#createModalBody").load(url, function () {
            $("#modalCreate").modal("show");
        });
    };

    var editFunc = function (args) {
        var url = "/Leave/HrLvRegister/EditGet?id=" + args;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
        });
    };

    var deleteFunc = function (args) {
        var url = "/Leave/HrLvRegister/DeleteGet?id=" + args;
        $("#deleteModalBody").load(url, function () {
            $("#modalDelete").modal("show");
        });
    };

    var rejoinFunc = function (args) {
        var url = "/Leave/HrLvRegister/RejoinGet?lvId=" + args;
        $("#rejoinModalBody").load(url, function () {
            $("#modalRejoin").modal("show");
        });
    };

    // ─────────────────────────────────────────────────────────────────────────
    // WORKFLOW ENGINE ACTIONS & CONFIRMATION MODAL
    // ─────────────────────────────────────────────────────────────────────────
    var pendingSubmitLvId = 0;

    function openSubmitConfirmModal(lvId, empName, lvType, days) {
        if (!lvId || lvId <= 0) return;
        pendingSubmitLvId = lvId;
        $("#wfSubmitAlertArea").empty();
        $("#wfModalEmpName").text(empName || "—");
        $("#wfModalLvType").text(lvType || "—");
        $("#wfModalDays").text(days ? (days + " day(s)") : "—");
        $("#btnDoSubmitWorkflow").prop("disabled", false).html('<i class="fas fa-paper-plane mr-1"></i> Confirm & Submit');
        $("#btnCancelSubmitWf").prop("disabled", false);
        $("#modalConfirmSubmit").modal("show");
    }

    $("#btnDoSubmitWorkflow").on('click', function () {
        if (!pendingSubmitLvId || pendingSubmitLvId <= 0) return;
        var btn = $(this);
        var cancelBtn = $("#btnCancelSubmitWf");
        btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm mr-1" role="status"></span> Submitting to Workflow...');
        cancelBtn.prop("disabled", true);
        $("#wfSubmitAlertArea").empty();

        var token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("SubmitToWorkflow", "HrLvRegister", new { area = "Leave" })',
            type: 'POST',
            data: {
                lvId: pendingSubmitLvId,
                __RequestVerificationToken: token
            },
            success: function (result) {
                if (result.success) {
                    $("#wfSubmitAlertArea").html(
                        '<div class="alert alert-success d-flex align-items-center py-2 px-3 mb-3" style="font-size:0.88rem; border-radius:6px;">' +
                        '<i class="fas fa-check-circle fa-lg mr-2 text-success"></i>' +
                        '<div><strong>Success!</strong> ' + (result.message || 'Leave application submitted to approval workflow successfully.') + '</div>' +
                        '</div>'
                    );
                    btn.html('<i class="fas fa-check mr-1"></i> Submitted!');
                    setTimeout(function () {
                        location.reload();
                    }, 1200);
                } else {
                    btn.prop("disabled", false).html('<i class="fas fa-paper-plane mr-1"></i> Confirm & Submit');
                    cancelBtn.prop("disabled", false);
                    $("#wfSubmitAlertArea").html(
                        '<div class="alert alert-danger py-2 px-3 mb-3" style="font-size:0.85rem; border-radius:6px;">' +
                        '<div class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i> Submission Failed</div>' +
                        '<div>' + (result.message || 'Unknown error occurred.') + '</div>' +
                        '</div>'
                    );
                }
            },
            error: function (xhr) {
                btn.prop("disabled", false).html('<i class="fas fa-paper-plane mr-1"></i> Confirm & Submit');
                cancelBtn.prop("disabled", false);
                var msg = xhr.responseJSON ? xhr.responseJSON.message : (xhr.responseText ? xhr.responseText : 'An unexpected error occurred. Please try again.');
                $("#wfSubmitAlertArea").html(
                    '<div class="alert alert-danger py-2 px-3 mb-3" style="font-size:0.85rem; border-radius:6px;">' +
                    '<div class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i> Network/Server Error</div>' +
                    '<div>' + msg + '</div>' +
                    '</div>'
                );
            }
        });
    });

    function submitToWorkflow(lvId, eventOrEl) {
        if (!lvId || lvId <= 0) return;
        if (eventOrEl && typeof eventOrEl.preventDefault === 'function') {
            try { eventOrEl.preventDefault(); eventOrEl.stopPropagation(); } catch (e) { }
        }
        var btn = document.querySelector('.btn-wf-submit[data-lvid="' + lvId + '"]');
        var empName = btn ? btn.getAttribute('data-emp') : '';
        var lvType = btn ? btn.getAttribute('data-lvtyp') : '';
        var days = btn ? btn.getAttribute('data-days') : '';
        openSubmitConfirmModal(lvId, empName, lvType, days);
    }

    var viewWorkflowTimeline = function (lvId, eventOrEl) {
        if (!lvId || lvId <= 0) return;

        if (eventOrEl && typeof eventOrEl.preventDefault === 'function') {
            try {
                eventOrEl.preventDefault();
                eventOrEl.stopPropagation();
            } catch (e) { }
        }
        var url = '@Url.Action("TimelineGet", "HrLvRegister", new { area = "Leave" })?lvId=' + lvId + '&_t=' + Date.now();
        $("#timelineModalBody").html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status" style="color: #540033 !important;"><span class="sr-only">Loading...</span></div><p class="text-muted small mt-2">Loading approval workflow progress...</p></div>');
        $("#modalTimeline").modal("show");

        $.ajax({
            url: url,
            type: 'GET',
            cache: false,
            success: function (htmlContent) {
                $("#timelineModalBody").html(htmlContent);
            },
            error: function (xhr, status, error) {
                var errDesc = "Unable to load approval timeline.";
                if (xhr && xhr.status > 0) {
                    errDesc += " (" + xhr.status + " " + xhr.statusText + ")";
                }
                $("#timelineModalBody").html('<div class="alert alert-danger m-3"><i class="fas fa-exclamation-triangle mr-2"></i> ' + errDesc + '</div>');
            }
        });
    };

    // Delegated click handlers for dynamically rendered Syncfusion grid templates
    $(document).on('click', '.btn-wf-submit', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var lvId = $(this).attr('data-lvid') || $(this).data('lvid');
        var empName = $(this).attr('data-emp') || $(this).data('emp');
        var lvType = $(this).attr('data-lvtyp') || $(this).data('lvtyp');
        var days = $(this).attr('data-days') || $(this).data('days');
        openSubmitConfirmModal(parseInt(lvId), empName, lvType, days);
    });

    $(document).on('click', '.btn-wf-timeline', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var lvId = $(this).attr('data-lvid') || $(this).data('lvid');
        viewWorkflowTimeline(parseInt(lvId), this);
    });

    $(document).ready(function () {
        var urlParams = new URLSearchParams(window.location.search);
        var openLvId = urlParams.get('openLvId');
        if (openLvId && parseInt(openLvId) > 0) {
            setTimeout(function () {
                viewWorkflowTimeline(parseInt(openLvId));
            }, 600);
        }
    });
    // ─────────────────────────────────────────────────────────────────────────
</script>
