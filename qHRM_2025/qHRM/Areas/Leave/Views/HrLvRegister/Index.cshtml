                write: (args) => {

                    daterangepicker = new ej.calendars.DateRangePicker({
                        change: function (e) {
                            var target = e.element;

                            if (e.value) {
                                startDate = e.value[0];
                                endDate = e.value[1];
                                (startDate.toDateString() === endDate.toDateString()) ? customFilter = false : customFilter = true;
                                (startDate.toDateString() === endDate.toDateString()) ? grid.filterByColumn('StDate', 'equal', startDate) : grid.filterByColumn('StDate', 'greaterthan', startDate);

                            }
                            else {
                                grid.filterSettings.columns = [];
                                grid.removeFilteredColsByField(target.id);
                            }
                        },
                    });
                    daterangepicker.appendTo(flValInput);
                }
            },
        };

        this.columns[6].filter = {
            type: "Menu",
            ui: {
                create: (args) => {
                    flValInput = ej.base.createElement('input', { className: 'e-input' });
                    args.target.appendChild(flValInput);
