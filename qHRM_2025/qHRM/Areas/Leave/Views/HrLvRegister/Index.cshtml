    ${if(WfStat === 'Approved')}
        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent btn-wf-timeline" data-lvid="${LvId}" onclick="viewWorkflowTimeline(${LvId}, event)" title="Click to view Approval Timeline">
            <span class="badge badge-success" style="background:#27ae60;color:#fff;padding:6px 10px;border-radius:4px;font-size:11px;white-space:nowrap;display:inline-flex;align-items:center;gap:5px;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,0.1);">
                <i class="fas fa-check-circle"></i> Approved
