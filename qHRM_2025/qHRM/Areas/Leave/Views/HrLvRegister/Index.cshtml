                            if (e.value) {
                                startDate = e.value[0];
                                endDate = e.value[1];
                                (startDate.toDateString() === endDate.toDateString()) ? customFilter = false : customFilter = true;
                                (startDate.toDateString() === endDate.toDateString()) ? grid.filterByColumn('EndDate', 'equal', startDate) : grid.filterByColumn('EndDate', 'greaterthan', startDate);

                            }
                            else {
                                grid.filterSettings.columns = [];
                                grid.removeFilteredColsByField(target.id);
                            }
                        },
                    });
                    daterangepicker.appendTo(flValInput);
                }
            },
        };

    }
</script>


<script>
    function rowDataBound(args) {
        if (args.data.LvTyp === "Annual") {
            btnRjnDiv.style.display="none";
        }
    }

    var loggedInEmpSysId = @(ViewBag.CurrentEmpSysId != null && (int)ViewBag.CurrentEmpSysId > 0 ? (int)ViewBag.CurrentEmpSysId : 1);
    var currentBalanceEmpSysId = loggedInEmpSysId;

    function openLeaveBalanceModal(empSysId) {
        var isShowAll = @(ViewBag.IsRestrictedUser != true && (ViewBag.ShowAllEmployees == true || ViewBag.IsOutsourceAdmin == true || ViewBag.CanSelectEmployee == true) ? "true" : "false");
        if (!isShowAll) {
            empSysId = loggedInEmpSysId;
        }
        else if (!empSysId || empSysId <= 0) {
            // Admin or HR Admin logged in: default to his/her own balances & history at first view
            empSysId = loggedInEmpSysId;
        }

        currentBalanceEmpSysId = parseInt(empSysId) || loggedInEmpSysId;
        $('#modalBalEmpSelect').val(currentBalanceEmpSysId);

        // Fallback to whatever value is actually in the dropdown if empSysId was not found
        var actualVal = $('#modalBalEmpSelect').val();
        if (actualVal) {
            currentBalanceEmpSysId = parseInt(actualVal);
        }

        $('#modalLeaveBalance').modal('show');
        initModalBalEmpSelect2();
        $('#modalBalEmpSelect').val(currentBalanceEmpSysId).trigger('change.select2');
        refreshModalBalances();
    }

    function initModalBalEmpSelect2() {
        if ($('#modalBalEmpSelect').is(':disabled')) return;
        if (!$('#modalBalEmpSelect').hasClass('select2-hidden-accessible')) {
            $('#modalBalEmpSelect').select2({
                theme: 'bootstrap4',
                dropdownParent: $('#modalLeaveBalance'),
                width: '100%',
                placeholder: 'Search by Emp ID or Name...',
                allowClear: false,
                matcher: function(params, data) {
                    if ($.trim(params.term) === '') {
                        return data;
                    }
                    if (typeof data.text === 'undefined') {
                        return null;
                    }
                    var term = params.term.toLowerCase();
                    var text = data.text.toLowerCase();
                    var empId = $(data.element).data('empid') ? $(data.element).data('empid').toString().toLowerCase() : '';
                    if (text.indexOf(term) > -1 || empId.indexOf(term) > -1) {
                        return data;
                    }
                    return null;
                }
            });
            $('#modalBalEmpSelect').on('select2:select', function (e) {
                onModalEmployeeChange();
            });
        }
    }

    function onModalEmployeeChange() {
        currentBalanceEmpSysId = parseInt($('#modalBalEmpSelect').val()) || 1;
        refreshModalBalances();
    }

    function syncAllBalances() {
        var year = $('#modalBalYear').val() || new Date().getFullYear();
        $('#tblLeaveBalancesBody').html('<tr><td colspan="7" class="text-center py-3 text-info"><i class="fas fa-spinner fa-spin mr-1"></i> Synchronizing running balances with active leave types...</td></tr>');
        
        $.ajax({
            type: "POST",
            url: "/Leave/HrLvRegister/SyncRunningBalances",
            data: { year: year },
            dataType: "json",
            success: function (res) {
                if (res.success) {
                    refreshModalBalances();
                } else {
                    alert('Sync error: ' + (res.message || 'Unknown error'));
                    refreshModalBalances();
                }
            },
            error: function (xhr, status, error) {
                alert('Error syncing balances: ' + error);
                refreshModalBalances();
            }
        });
    }

    function refreshModalBalances() {
        var year = $('#modalBalYear').val() || new Date().getFullYear();
        var empSysId = currentBalanceEmpSysId || $('#modalBalEmpSelect').val() || 1;

        $('#tblLeaveBalancesBody').html('<tr><td colspan="7" class="text-center py-3 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i> Loading balances...</td></tr>');
        $('#tblBalanceAuditBody').html('<tr><td colspan="7" class="text-center py-3 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i> Loading transactions...</td></tr>');

        // Fetch balances summary
        $.ajax({
            type: "GET",
            url: "/Leave/HrLvRegister/GetEmployeeBalances",
            data: { empSysId: empSysId, year: year },
            dataType: "json",
            success: function (res) {
                if (res.success && res.data) {
                    var data = res.data;
                    currentBalanceEmpSysId = data.empSysId || data.EmpSysId || empSysId;
                    $('#modalBalEmpSelect').val(currentBalanceEmpSysId);

                    var empId = data.empId || data.EmpId || '';
                    var dept = data.department || data.Department || '';
                    var gender = data.gender || data.Gender || '';
                    var religion = data.religion || data.Religion || '';
                    var empDetails = [];
                    if (empId) empDetails.push('Emp ID: ' + empId);
                    if (dept) empDetails.push('Dept: ' + dept);
                    if (gender) empDetails.push('Gender: ' + gender);
                    if (religion) empDetails.push('Religion: ' + religion);
                    $('#modalBalEmpInfo').text(empDetails.join(' | '));

                    var totInProg = data.totalInProgress !== undefined ? data.totalInProgress : (data.TotalInProgress !== undefined ? data.TotalInProgress : 0);
                    var totUsed = data.totalUsed !== undefined ? data.totalUsed : (data.TotalUsed !== undefined ? data.TotalUsed : 0);

                    $('#kpiTotalInProgress').text(totInProg + ' days');
                    $('#kpiTotalUsed').text(totUsed + ' days');

                    var html = '';
                    var list = data.leaveBalances || data.LeaveBalances || data.balances || data.Balances;
                    if (list && list.length > 0) {
                        list.forEach(function (b) {
                            var ltName = b.leaveTypeName || b.LeaveTypeName || '-';
                            var ltCode = b.leaveTypeCode || b.LeaveTypeCode || '-';
                            var ent = b.entitlement !== undefined ? b.entitlement : (b.Entitlement !== undefined ? b.Entitlement : 0);
                            var inProg = b.inProgress !== undefined ? b.inProgress : (b.InProgress !== undefined ? b.InProgress : 0);
                            var used = b.used !== undefined ? b.used : (b.Used !== undefined ? b.Used : 0);
                            var rem = b.remaining !== undefined ? b.remaining : (b.Remaining !== undefined ? b.Remaining : 0);
                            var ruleNotice = b.ruleNotice || b.RuleNotice || '';

                            var pct = ent > 0 ? Math.min(100, Math.round(((used + inProg) / ent) * 100)) : 0;
                            var badgeClass = rem > 5 ? 'badge-success' : (rem > 0 ? 'badge-warning' : 'badge-danger');
                            var barClass = pct > 80 ? 'bg-danger' : (pct > 50 ? 'bg-warning' : 'bg-primary');

                            html += '<tr>' +
                                '<td class="font-weight-bold text-dark">' +
                                    ltName +
                                    (ruleNotice ? '<br><small class="text-muted" style="font-weight:normal;">' + ruleNotice + '</small>' : '') +
                                '</td>' +
                                '<td><span class="badge badge-light border">' + ltCode + '</span></td>' +
                                '<td class="text-center font-weight-bold">' + ent + '</td>' +
                                '<td class="text-center text-info font-weight-bold">' + inProg + '</td>' +
                                '<td class="text-center text-danger font-weight-bold">' + used + '</td>' +
                                '<td class="text-center"><span class="badge ' + badgeClass + ' px-2 py-1" style="font-size:0.9rem;">' + rem + ' days</span></td>' +
                                '<td class="text-center" style="min-width: 130px;">' +
                                    '<div class="progress" style="height: 12px; border-radius: 6px;">' +
                                        '<div class="progress-bar ' + barClass + '" role="progressbar" style="width: ' + pct + '%;" aria-valuenow="' + pct + '" aria-valuemin="0" aria-valuemax="100"></div>' +
                                    '</div>' +
                                    '<small class="text-muted">' + pct + '% utilized</small>' +
                                '</td>' +
                            '</tr>';
                        });
                    } else {
                        html = '<tr><td colspan="7" class="text-center py-3 text-muted">No active leave entitlements configured for this year.</td></tr>';
                    }
                    $('#tblLeaveBalancesBody').html(html);
                } else {
                    $('#tblLeaveBalancesBody').html('<tr><td colspan="7" class="text-center py-3 text-danger">Failed to load leave balances: ' + (res.message || 'Unknown error') + '</td></tr>');
                }
            },
            error: function (xhr, status, error) {
                $('#tblLeaveBalancesBody').html('<tr><td colspan="7" class="text-center py-3 text-danger">Error contacting server (' + error + ').</td></tr>');
            }
        });

        // Fetch Audit history
        $.ajax({
            type: "GET",
            url: "/Leave/HrLvRegister/GetBalanceAudit",
            data: { empSysId: empSysId, year: year },
            dataType: "json",
            success: function (res) {
                if (res.success && res.data) {
                    var html = '';
                    if (res.data.length > 0) {
                        res.data.forEach(function (tx) {
                            var delta = tx.days !== undefined ? tx.days : (tx.Days !== undefined ? tx.Days : (tx.deltaDays !== undefined ? tx.deltaDays : 0));
                            var dtDisplay = tx.dateFormatted || tx.DateFormatted || tx.transactionDateDisplay || tx.TransactionDateDisplay || '-';
                            var ltName = tx.leaveTypeName || tx.LeaveTypeName || '-';
                            var trnType = tx.transactionType || tx.TransactionType || tx.trnType || tx.TrnType || '-';
                            var balBf = tx.balanceBefore !== undefined ? tx.balanceBefore : (tx.BalanceBefore !== undefined ? tx.BalanceBefore : 0);
                            var balAf = tx.balanceAfter !== undefined ? tx.balanceAfter : (tx.BalanceAfter !== undefined ? tx.BalanceAfter : 0);
                            var rmks = tx.remarks || tx.Remarks || '-';

                            var deltaBadge = delta >= 0 
                                ? '<span class="badge badge-success">+' + delta + '</span>' 
                                : '<span class="badge badge-danger">' + delta + '</span>';

                            html += '<tr>' +
                                '<td class="text-muted" style="font-size: 0.85rem;">' + dtDisplay + '</td>' +
                                '<td class="font-weight-bold">' + ltName + '</td>' +
                                '<td><span class="badge badge-secondary">' + trnType + '</span></td>' +
                                '<td class="text-center">' + deltaBadge + '</td>' +
                                '<td class="text-center">' + balBf + '</td>' +
                                '<td class="text-center font-weight-bold text-primary">' + balAf + '</td>' +
                                '<td><small class="text-muted">' + rmks + '</small></td>' +
                            '</tr>';
                        });
                    } else {
                        html = '<tr><td colspan="7" class="text-center py-3 text-muted">No transaction ledger entries recorded.</td></tr>';
                    }
                    $('#tblBalanceAuditBody').html(html);
                } else {
                    $('#tblBalanceAuditBody').html('<tr><td colspan="7" class="text-center py-3 text-danger">Failed to load transaction history.</td></tr>');
                }
            },
            error: function (xhr, status, error) {
                $('#tblBalanceAuditBody').html('<tr><td colspan="7" class="text-center py-3 text-danger">Error loading transactions.</td></tr>');
            }
        });
    }
</script>
