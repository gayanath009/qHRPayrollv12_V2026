@model qHRM.Areas.Leave.Models.LeaveIncidentReviewViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Leave Approval Review";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4" style="max-width: 900px;">

    <!-- Header & Navigation -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold" style="color: #333;">
                Leave Request Review
            </h1>
            <p class="text-muted small mb-0">Review, approve or reject this leave application assigned to you</p>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-area="Leave" asp-controller="HrLvRegister" asp-action="Pending" class="btn btn-sm shadow-sm text-white mr-1" style="background-color: #990049; border-radius: 6px;">
                <i class="fas fa-inbox mr-1"></i> Pending Inbox
            </a>
            <a asp-area="Leave" asp-controller="HrLvRegister" asp-action="Index" class="btn btn-sm btn-outline-secondary shadow-sm" style="border-radius: 6px;">
                <i class="fas fa-list mr-1"></i> Leave Register
            </a>
        </div>
    </div>

    @if (!Model.Success || Model.LvId <= 0)
    {
        <div class="alert alert-warning shadow-sm border-0 p-4" style="border-radius: 8px;">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-2x mr-3 text-warning"></i>
                <div>
                    <h5 class="font-weight-bold mb-1">Leave Incident Not Found</h5>
                    <p class="mb-0 text-muted">@(string.IsNullOrEmpty(Model.Message) ? "Unable to load the requested leave incident. Please check the leave register or pending approvals." : Model.Message)</p>
                </div>
            </div>
            <div class="mt-3">
                <a asp-area="Leave" asp-controller="HrLvRegister" asp-action="Pending" class="btn btn-sm btn-primary" style="background-color: #540033; border: none; border-radius: 6px;">
                    View All Pending Approvals
                </a>
            </div>
        </div>
    }
    else
    {
        var stDateFormatted = Model.StDate.HasValue ? Model.StDate.Value.ToString("yyyy-MM-dd") : "—";
        var endDateFormatted = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "—";
        var safeEmpName = (Model.EmployeeName ?? "Employee").Replace("'", "\\'");
        var safeLvType = (Model.LeaveType ?? "Leave").Replace("'", "\\'");
        var safeInstNo = (Model.InstanceNo ?? "—").Replace("'", "\\'");
        var wfInstIdStr = Model.WfInstanceId.HasValue ? Model.WfInstanceId.Value.ToString() : "";
        var approvalIdStr = Model.ApprovalId.HasValue ? Model.ApprovalId.Value.ToString() : "";

        <!-- Main Incident Card (Exact Clone of Pending Approval Card) -->
        <div class="card shadow-sm border mb-4" id="review-card-@approvalIdStr" style="border-radius: 8px; border-top: 4px solid #540033 !important; background: #fff;">
            <div class="card-body p-4">
                
                <!-- Card Header -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="font-weight-bold mb-1" style="font-size: 17px; color: #334155;">
                            @Model.EmployeeName
                            @if (!string.IsNullOrEmpty(Model.EmpId))
                            {
                                <span class="text-muted font-weight-normal ml-1">(@Model.EmpId)</span>
                            }
                        </h5>
                        <div class="text-muted small mt-1" style="font-size: 13px;">
                            <i class="fas fa-building mr-1 text-secondary"></i> @Model.Department @(string.IsNullOrEmpty(Model.Designation) || Model.Designation == "—" ? "" : $"• {Model.Designation}")
                        </div>
                        <span class="badge badge-light border text-dark mt-2" style="font-size: 11px; padding: 4px 8px;">
                            @(string.IsNullOrEmpty(Model.InstanceNo) ? $"LV#{Model.LvId}" : Model.InstanceNo)
                        </span>
                    </div>
                    <span class="badge badge-pill badge-primary" style="background:#540033; font-size:13px; padding: 6px 14px; font-weight: 600;">
                        @Model.LeaveType
                    </span>
                </div>

                <!-- Incident Details Box -->
                <div class="bg-light p-3 rounded mb-3" style="font-size: 13px; border: 1px solid #e2e8f0;">
                    <div class="d-flex justify-content-between mb-2 pb-1 border-bottom" style="border-color: #edf2f7 !important;">
                        <span class="text-muted"><i class="far fa-calendar-alt mr-2 text-secondary"></i> Period:</span>
                        <span class="font-weight-bold text-dark">@stDateFormatted &rarr; @endDateFormatted</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-1 border-bottom" style="border-color: #edf2f7 !important;">
                        <span class="text-muted"><i class="far fa-clock mr-2 text-secondary"></i> Total Days:</span>
                        <span class="font-weight-bold text-dark">@Model.Days Day(s)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-1 border-bottom" style="border-color: #edf2f7 !important;">
                        <span class="text-muted"><i class="fas fa-info-circle mr-2 text-secondary"></i> Status:</span>
                        <span class="badge @Model.WfStatusBadge px-2 py-1" style="font-size: 12px;">@Model.WfStatus</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-1 border-bottom" style="border-color: #edf2f7 !important;">
                        <span class="text-muted"><i class="far fa-comment-alt mr-2 text-secondary"></i> Reason:</span>
                        <span class="text-dark font-weight-500">@Model.Reason</span>
                    </div>
                    <div class="d-flex justify-content-between @(Model.HasAttachment ? "mb-2 pb-1 border-bottom" : "")" style="border-color: #edf2f7 !important;">
                        <span class="text-muted"><i class="fas fa-map-marker-alt mr-2 text-secondary"></i> Seating Location:</span>
                        <span class="text-dark font-weight-500">@(string.IsNullOrWhiteSpace(Model.SeatingLocation) ? "—" : Model.SeatingLocation)</span>
                    </div>
                    @if (Model.HasAttachment)
                    {
                        <div class="d-flex justify-content-between align-items-center pt-1">
                            <span class="text-muted"><i class="fas fa-paperclip mr-2 text-secondary"></i> Attachment:</span>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 12px; padding: 3px 12px; border-radius: 6px;"
                                        onclick="openAttachmentViewer('@Model.AttachmentUrl', '@Model.AttachmentType', '@((Model.AttachmentFileName ?? "attachment").Replace("'", "\\'"))')">
                                    @if (Model.AttachmentType == "pdf")
                                    {
                                        <i class="fas fa-file-pdf text-danger mr-1"></i><span>View PDF</span>
                                    }
                                    else if (Model.AttachmentType == "image")
                                    {
                                        <i class="fas fa-file-image text-info mr-1"></i><span>View Attachment</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-file text-secondary mr-1"></i><span>View Document</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Action Bar -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary" onclick="openTimelineModal(@Model.LvId, '@safeInstNo', '@wfInstIdStr')" style="border-radius: 6px; font-size: 13px; padding: 6px 14px;" title="View Workflow Timeline">
                        <i class="fas fa-history mr-1"></i> Timeline
                    </button>

                    <div>
                        @if (Model.CanApprove && Model.ApprovalId.HasValue)
                        {
                            <button type="button" class="btn btn-danger mr-2 px-3 py-2 font-weight-bold" onclick="openRejectModal('@approvalIdStr', @Model.LvId, '@safeEmpName', '@safeLvType', '@safeInstNo')" style="border-radius: 6px; font-size: 13px;">
                                <i class="fas fa-times mr-1"></i> Reject
                            </button>
                            <button type="button" class="btn btn-success px-4 py-2 font-weight-bold" onclick="openApproveModal('@approvalIdStr', @Model.LvId, '@safeEmpName', '@safeLvType', '@stDateFormatted to @endDateFormatted (@Model.Days days)', '@safeInstNo')" style="border-radius: 6px; font-size: 13px;">
                                <i class="fas fa-check mr-1"></i> Approve
                            </button>
                        }
                        else
                        {
                            <span class="badge @Model.WfStatusBadge px-3 py-2" style="font-size: 13px;">
                                @(Model.WfStatus == "Approved" || Model.WfStatus == "FinalApproved" ? "✓ Already Approved" : (Model.WfStatus == "Rejected" ? "✗ Rejected" : Model.WfStatus))
                            </span>
                        }
                    </div>
                </div>

            </div>
        </div>
    }

</div>

<!-- ========================================================================= -->
<!-- MODAL: Approve Request                                                    -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalApprove" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 10px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
            <div class="modal-header bg-success text-white py-3" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <h5 class="modal-title font-weight-bold" style="font-size: 1.1rem;">
                    <i class="fas fa-check-circle mr-2"></i>Approve Leave Request
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="approveApprovalId" />
                <input type="hidden" id="approveLvId" />

                <div class="alert alert-light border mb-3 p-3" style="border-radius: 6px;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Employee:</span>
                        <span class="font-weight-bold text-gray-1000 small" id="approveEmpName"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Leave Type:</span>
                        <span class="badge badge-info" id="approveLvType"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Duration:</span>
                        <span class="font-weight-bold small" id="approveDuration"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Workflow Ref:</span>
                        <span class="font-weight-bold text-dark small" id="approveRef"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold small text-gray-700">Approval Comments (Optional):</label>
                    <textarea class="form-control" id="approveComments" rows="3" placeholder="Add approval remarks or instructions..." style="border-radius: 6px; font-size: 13px;"></textarea>
                </div>

                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="chkDigitalSign" checked>
                    <label class="custom-control-label small text-muted" for="chkDigitalSign">
                        Sign digitally with authenticated credentials
                    </label>
                </div>
            </div>
            <div class="modal-footer bg-light py-2" style="border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="border-radius: 6px;">Cancel</button>
                <button type="button" class="btn btn-sm btn-success px-3" id="btnConfirmApprove" onclick="executeApprove();" style="border-radius: 6px;">
                    <i class="fas fa-check mr-1"></i> Confirm Approval
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: Reject Request                                                     -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalReject" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 10px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
            <div class="modal-header bg-danger text-white py-3" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <h5 class="modal-title font-weight-bold" style="font-size: 1.1rem;">
                    <i class="fas fa-times-circle mr-2"></i>Reject Leave Request
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="rejectApprovalId" />
                <input type="hidden" id="rejectLvId" />

                <div class="alert alert-light border mb-3 p-3" style="border-radius: 6px;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Employee:</span>
                        <span class="font-weight-bold text-gray-800 small" id="rejectEmpName"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Leave Type:</span>
                        <span class="badge badge-info" id="rejectLvType"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Workflow Ref:</span>
                        <span class="font-weight-bold text-dark small" id="rejectRef"></span>
                    </div>
                </div>

                <div class="form-group mb-0">
                    <label class="font-weight-bold small text-danger">Rejection Reason (Required):</label>
                    <textarea class="form-control border-danger" id="rejectReason" rows="3" placeholder="Please provide clear justification for rejection..." style="border-radius: 6px; font-size: 13px;" required></textarea>
                    <small class="text-muted">This reason will be recorded in the workflow audit trail and sent to the employee via email.</small>
                </div>
            </div>
            <div class="modal-footer bg-light py-2" style="border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="border-radius: 6px;">Cancel</button>
                <button type="button" class="btn btn-sm btn-danger px-3" id="btnConfirmReject" onclick="executeReject();" style="border-radius: 6px;">
                    <i class="fas fa-times mr-1"></i> Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: Workflow Approval Timeline                                         -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalTimeline" tabindex="-1" role="dialog" aria-labelledby="timelineModalLongTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document" style="max-width: 1120px; width: 95vw;">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 15px 35px rgba(0,0,0,0.18); overflow: hidden;">
            <div class="modal-header py-3 px-4 bg-white border-bottom align-items-center">
                <h5 class="modal-title font-weight-bold mb-0 text-gray-900" style="font-size: 1.15rem; color: #1e293b;">
                    <i class="fas fa-project-diagram mr-2" style="color: #540033;"></i> Leave Approval Status
                </h5>
                <button type="button" class="close text-muted" data-dismiss="modal" aria-label="Close" style="outline: none;">
                    <span aria-hidden="true" style="font-size: 1.5rem;">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0" id="timelineModalBody" style="background-color: #ffffff; max-height: 80vh; overflow-y: auto;">
            </div>
            <div class="modal-footer bg-white py-2 border-top">
                <button type="button" class="btn btn-sm btn-secondary px-3" data-dismiss="modal" style="border-radius: 6px;">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: Attachment Viewer (JPG/PNG Image & PDF)                            -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalAttachmentViewer" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content" style="border-radius: 10px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.25);">
            <div class="modal-header text-white py-3" style="background: linear-gradient(135deg, #540033, #6d0034); border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <div class="d-flex align-items-center">
                    <i class="fas fa-paperclip mr-2 fa-lg"></i>
                    <div>
                        <h5 class="modal-title font-weight-bold mb-0" id="viewerModalTitle" style="font-size: 1.1rem;">
                            Document Attachment Viewer
                        </h5>
                        <small class="text-white-50" id="viewerFileName">attachment</small>
                    </div>
                </div>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3" style="background-color: #f8fafc;">
                <!-- Image Viewer Container -->
                <div id="viewerImageContainer" class="text-center p-2 d-none" style="min-height: 250px; max-height: 68vh; overflow: auto;">
                    <img id="viewerImageElement" src="" alt="Attachment Preview" class="img-fluid rounded shadow-sm border" style="max-height: 65vh; object-fit: contain; background: #fff;" />
                </div>

                <!-- PDF Viewer Container -->
                <div id="viewerPdfContainer" class="d-none" style="height: 68vh;">
                    <iframe id="viewerPdfFrame" src="" style="width: 100%; height: 100%; border: 1px solid #e2e8f0; border-radius: 6px;"></iframe>
                </div>

                <!-- Fallback / Unsupported Container -->
                <div id="viewerOtherContainer" class="text-center py-5 d-none">
                    <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
                    <h5 class="font-weight-bold text-dark">File Preview Not Available Directly</h5>
                    <p class="text-muted small">You can download or open this document in a new browser tab.</p>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 d-flex justify-content-between" style="border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                <div>
                    <a id="btnViewerOpenNewTab" href="#" target="_blank" class="btn btn-sm btn-outline-secondary mr-1" style="border-radius: 6px;">
                        <i class="fas fa-external-link-alt mr-1"></i> Open in New Tab
                    </a>
                    <a id="btnViewerDownload" href="#" download class="btn btn-sm btn-primary" style="background-color: #540033; border: none; border-radius: 6px;">
                        <i class="fas fa-download mr-1"></i> Download File
                    </a>
                </div>
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="border-radius: 6px;">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAttachmentViewer(url, type, fileName) {
            if (!url) {
                alert("Attachment URL not found.");
                return;
            }

            $("#viewerFileName").text(fileName || "Attachment");
            $("#btnViewerOpenNewTab").attr("href", url);
            $("#btnViewerDownload").attr("href", url).attr("download", fileName || "attachment");

            // Reset containers
            $("#viewerImageContainer").addClass("d-none");
            $("#viewerPdfContainer").addClass("d-none");
            $("#viewerOtherContainer").addClass("d-none");

            var ext = (fileName ? fileName.split('.').pop().toLowerCase() : '') || (type || '');

            if (type === "pdf" || ext === "pdf") {
                $("#viewerModalTitle").html('<i class="fas fa-file-pdf text-danger mr-2"></i> PDF Document Viewer');
                $("#viewerPdfFrame").attr("src", url);
                $("#viewerPdfContainer").removeClass("d-none");
            } else if (type === "image" || ["jpg", "jpeg", "png", "gif", "webp", "bmp"].indexOf(ext) !== -1) {
                $("#viewerModalTitle").html('<i class="fas fa-file-image text-info mr-2"></i> Image Attachment Viewer');
                $("#viewerImageElement").attr("src", url);
                $("#viewerImageContainer").removeClass("d-none");
            } else {
                $("#viewerModalTitle").html('<i class="fas fa-file mr-2"></i> Document Viewer');
                $("#viewerOtherContainer").removeClass("d-none");
            }

            $("#modalAttachmentViewer").modal("show");
        }
        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function openApproveModal(approvalId, lvId, empName, lvType, duration, ref) {
            $("#approveApprovalId").val(approvalId);
            $("#approveLvId").val(lvId);
            $("#approveEmpName").text(empName || 'Employee');
            $("#approveLvType").text(lvType || 'Leave');
            $("#approveDuration").text(duration || '—');
            $("#approveRef").text(ref || '—');
            $("#approveComments").val("");
            $("#chkDigitalSign").prop("checked", true);
            $("#modalApprove").modal("show");
        }

        function openRejectModal(approvalId, lvId, empName, lvType, ref) {
            $("#rejectApprovalId").val(approvalId);
            $("#rejectLvId").val(lvId);
            $("#rejectEmpName").text(empName || 'Employee');
            $("#rejectLvType").text(lvType || 'Leave');
            $("#rejectRef").text(ref || '—');
            $("#rejectReason").val("");
            $("#modalReject").modal("show");
        }

        function executeApprove() {
            var approvalId = $("#approveApprovalId").val();
            var comment = $("#approveComments").val();

            if (!approvalId) {
                alert("Approval ID is missing.");
                return;
            }

            var btn = $("#btnConfirmApprove");
            btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Processing...');

            $.ajax({
                url: "/Leave/HrLvRegister/ApproveStep",
                type: "POST",
                contentType: "application/json",
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                data: JSON.stringify({
                    approvalId: approvalId,
                    comment: comment
                }),
                success: function (res) {
                    btn.prop("disabled", false).html('<i class="fas fa-check mr-1"></i> Confirm Approval');
                    $("#modalApprove").modal("hide");

                    if (res && res.success) {
                        alert("Leave application approved successfully.");
                        window.location.reload();
                    } else {
                        alert("Approval failed: " + (res.message || "Unknown error."));
                    }
                },
                error: function (xhr) {
                    btn.prop("disabled", false).html('<i class="fas fa-check mr-1"></i> Confirm Approval');
                    alert("An error occurred while communicating with the workflow engine: " + (xhr.responseText || xhr.statusText));
                }
            });
        }

        function executeReject() {
            var approvalId = $("#rejectApprovalId").val();
            var reason = $("#rejectReason").val();

            if (!reason || reason.trim() === "") {
                alert("Please provide a reason for rejection.");
                $("#rejectReason").focus();
                return;
            }

            if (!approvalId) {
                alert("Approval ID is missing.");
                return;
            }

            var btn = $("#btnConfirmReject");
            btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Processing...');

            $.ajax({
                url: "/Leave/HrLvRegister/RejectStep",
                type: "POST",
                contentType: "application/json",
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                data: JSON.stringify({
                    approvalId: approvalId,
                    comment: reason
                }),
                success: function (res) {
                    btn.prop("disabled", false).html('<i class="fas fa-times mr-1"></i> Confirm Rejection');
                    $("#modalReject").modal("hide");

                    if (res && res.success) {
                        alert("Leave application rejected successfully.");
                        window.location.reload();
                    } else {
                        alert("Rejection failed: " + (res.message || "Unknown error."));
                    }
                },
                error: function (xhr) {
                    btn.prop("disabled", false).html('<i class="fas fa-times mr-1"></i> Confirm Rejection');
                    alert("An error occurred while communicating with the workflow engine: " + (xhr.responseText || xhr.statusText));
                }
            });
        }

        function openTimelineModal(lvId, instanceRef, wfInstanceId, event) {
            if (event) {
                try {
                    event.preventDefault();
                    event.stopPropagation();
                } catch (e) { }
            }
            var targetLvId = lvId || @Model.LvId;
            var url = '@Url.Action("TimelineGet", "HrLvRegister", new { area = "Leave" })?lvId=' + targetLvId + '&_t=' + Date.now();
            $("#timelineModalBody").html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status" style="color: #540033 !important;"><span class="sr-only">Loading...</span></div><p class="text-muted small mt-2">Loading approval workflow progress...</p></div>');
            $("#modalTimeline").modal("show");
            $.ajax({
                url: url,
                type: 'GET',
                cache: false,
                success: function (htmlContent) {
                    $("#timelineModalBody").html(htmlContent);
                },
                error: function (xhr, status, error) {
                    var errDesc = "Unable to load approval timeline.";
                    if (xhr && xhr.status > 0) {
                        errDesc += " (" + xhr.status + " " + xhr.statusText + ")";
                    }
                    $("#timelineModalBody").html('<div class="alert alert-danger m-3"><i class="fas fa-exclamation-triangle mr-2"></i> ' + errDesc + '</div>');
                }
            });
        }
    </script>
}
