@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Leave Approvals Inbox";
}

@Html.AntiForgeryToken()

<style>
    :root {
        --org-primary: #540033;
        --org-primary-hover: #3e0026;
        --org-primary-light: #fdf2f8;
        --org-primary-border: #fbcfe8;
        --clr-border: rgba(2,6,23,0.06);
        --clr-text: #0f172a;
        --clr-muted: #475569;
        --radius-sm: 8px;
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
    }

    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border);
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--clr-text);
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: var(--org-primary-light);
        color: var(--org-primary);
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid var(--org-primary-border);
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: var(--clr-muted);
        margin-top: 0.15rem;
        line-height: 1.2;
    }
    .org-breadcrumb a {
        color: var(--clr-muted);
        text-decoration: none;
        transition: color 0.15s;
    }
    .org-breadcrumb a:hover {
        color: var(--org-primary);
    }

    .org-btn-create {
        background: linear-gradient(135deg, #540033 0%, #750047 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: var(--radius-sm) !important;
        padding: 0.45rem 1rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.01em !important;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease !important;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.25) !important;
        text-decoration: none !important;
    }
    .org-btn-create:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(84, 0, 51, 0.35) !important;
        color: #ffffff !important;
    }

    .org-btn-outline {
        background: #ffffff !important;
        color: var(--org-primary) !important;
        border: 1px solid var(--org-primary-border) !important;
        border-radius: var(--radius-sm) !important;
        padding: 0.45rem 1rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.01em !important;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease !important;
        text-decoration: none !important;
    }
    .org-btn-outline:hover {
        background: var(--org-primary-light) !important;
        color: var(--org-primary-hover) !important;
        border-color: var(--org-primary) !important;
    }
</style>

<div class="container-fluid">
    <!-- COMPACT HERO HEADER -->
    <div class="org-hero-card mt-2">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
            <div class="d-flex align-items-center">
                <div class="org-icon-badge mr-3">
                    <i class="fas fa-inbox"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                        <h1 class="org-title">Leave Approvals Inbox</h1>
                        <span class="badge org-category-pill">LEAVE</span>
                    </div>
                    <div class="org-breadcrumb">
                        <a href="#">Leave</a> / <span class="text-dark font-weight-medium">Approvals Inbox</span>
                        <span class="text-muted mx-1">&bull;</span>
                        <span class="text-muted">Review, approve or reject leave requests assigned to you in the dynamic workflow</span>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                <button class="btn org-btn-create" id="btnRefresh" onclick="loadPendingApprovals();">
                    <i class="fas fa-sync-alt mr-1"></i> Refresh List
                </button>
                <a asp-area="Leave" asp-controller="HrLvRegister" asp-action="Index" class="btn org-btn-outline">
                    <i class="fas fa-list mr-1"></i> Leave Register
                </a>
            </div>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow-sm h-100 py-2" style="border-left: 4px solid #550033 !important; border-radius: 8px;">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #990049;">Pending Approvals</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="cntPending">
                                <span class="spinner-border spinner-border-sm text-muted" role="status" style="width:1rem;height:1rem;"></span>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 10px;">System-wide in-progress leaves</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow-sm h-100 py-2" style="border-left: 4px solid #17a2b8 !important; border-radius: 8px;">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Awaiting Action</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="cntAction">
                                <span class="spinner-border spinner-border-sm text-muted" role="status" style="width:1rem;height:1rem;"></span>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 10px;">Assigned to me for review</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Approvals List Card -->
    <div class="card shadow-sm mb-4" style="border-radius: 10px; border: 1px solid #e3e6f0;">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
            <h6 class="m-0 font-weight-bold text-gray-800">
                <i class="fas fa-tasks mr-2 text-muted"></i>Pending Leave Requests
            </h6>
            <div class="w-25">
                <input type="text" id="txtSearchPending" class="form-control form-control-sm" placeholder="Search by name, type, reference..." onkeyup="filterPendingCards();" style="border-radius: 6px;">
            </div>
        </div>
        <div class="card-body p-3">
            <!-- Loading Indicator -->
            <div id="loadingState" class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="color: #990049 !important;">
                    <span class="sr-only">Loading...</span>
                </div>
                <p class="text-muted mt-2 small">Loading pending approvals from Workflow Engine...</p>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-5 d-none">
                <div class="mb-3">
                    <i class="fas fa-clipboard-check fa-4x" style="color: #27ae60; opacity: 0.8;"></i>
                </div>
                <h5 class="font-weight-bold text-gray-800">You're All Caught Up!</h5>
                <p class="text-muted small mb-3">There are currently no pending leave requests requiring your review or approval.</p>
                <button class="btn btn-sm btn-outline-secondary" onclick="loadPendingApprovals();" style="border-radius: 6px;">
                    <i class="fas fa-sync-alt mr-1"></i> Check Again
                </button>
            </div>

            <!-- Pending Items Container -->
            <div id="pendingList" class="row d-none">
                <!-- Cards dynamically populated via JS -->
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: Approve Request                                                    -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalApprove" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 10px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
            <div class="modal-header bg-success text-white py-3" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <h5 class="modal-title font-weight-bold" style="font-size: 1.1rem;">
                    <i class="fas fa-check-circle mr-2"></i>Approve Leave Request
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="approveApprovalId" />
                <input type="hidden" id="approveLvId" />

                <div class="alert alert-light border mb-3 p-3" style="border-radius: 6px;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Employee:</span>
                        <span class="font-weight-bold text-gray-1000 small" id="approveEmpName"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Leave Type:</span>
                        <span class="badge badge-info" id="approveLvType"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Duration:</span>
                        <span class="font-weight-bold small" id="approveDuration"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Workflow Ref:</span>
                        <span class="font-weight-bold text-dark small" id="approveRef"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold small text-gray-700">Approval Comments (Optional):</label>
                    <textarea class="form-control" id="approveComments" rows="3" placeholder="Add approval remarks or instructions..." style="border-radius: 6px; font-size: 13px;"></textarea>
                </div>

                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="chkDigitalSign" checked>
                    <label class="custom-control-label small text-muted" for="chkDigitalSign">
                        Sign digitally with authenticated credentials
                    </label>
                </div>
            </div>
            <div class="modal-footer bg-light py-2" style="border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="border-radius: 6px;">Cancel</button>
                <button type="button" class="btn btn-sm btn-success px-3" id="btnConfirmApprove" onclick="executeApprove();" style="border-radius: 6px;">
                    <i class="fas fa-check mr-1"></i> Confirm Approval
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: Reject Request                                                     -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalReject" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 10px; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
            <div class="modal-header bg-danger text-white py-3" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <h5 class="modal-title font-weight-bold" style="font-size: 1.1rem;">
                    <i class="fas fa-times-circle mr-2"></i>Reject Leave Request
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="rejectApprovalId" />
                <input type="hidden" id="rejectLvId" />

                <div class="alert alert-light border mb-3 p-3" style="border-radius: 6px;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Employee:</span>
                        <span class="font-weight-bold text-gray-800 small" id="rejectEmpName"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Leave Type:</span>
                        <span class="badge badge-info" id="rejectLvType"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Workflow Ref:</span>
                        <span class="font-weight-bold text-dark small" id="rejectRef"></span>
                    </div>
                </div>

                <div class="form-group mb-0">
                    <label class="font-weight-bold small text-danger">Rejection Reason (Required):</label>
                    <textarea class="form-control border-danger" id="rejectReason" rows="3" placeholder="Please provide clear justification for rejection..." style="border-radius: 6px; font-size: 13px;" required></textarea>
                    <small class="text-muted">This reason will be recorded in the workflow audit trail and sent to the employee via email.</small>
                </div>
            </div>
            <div class="modal-footer bg-light py-2" style="border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="border-radius: 6px;">Cancel</button>
                <button type="button" class="btn btn-sm btn-danger px-3" id="btnConfirmReject" onclick="executeReject();" style="border-radius: 6px;">
                    <i class="fas fa-times mr-1"></i> Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: Workflow Approval Timeline                                         -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalTimeline" tabindex="-1" role="dialog" aria-labelledby="timelineModalLongTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document" style="max-width: 1120px; width: 95vw;">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 15px 35px rgba(0,0,0,0.18); overflow: hidden;">
            <div class="modal-header py-3 px-4 bg-white border-bottom align-items-center">
                <h5 class="modal-title font-weight-bold mb-0 text-gray-900" style="font-size: 1.15rem; color: #1e293b;">
                    <i class="fas fa-project-diagram mr-2" style="color: #540033;"></i> Leave Approval Status
                </h5>
                <button type="button" class="close text-muted" data-dismiss="modal" aria-label="Close" style="outline: none;">
                    <span aria-hidden="true" style="font-size: 1.5rem;">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0" id="timelineModalBody" style="background-color: #ffffff; max-height: 80vh; overflow-y: auto;">
            </div>
            <div class="modal-footer bg-white py-2 border-top">
                <button type="button" class="btn btn-sm btn-secondary px-3" data-dismiss="modal" style="border-radius: 6px;">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: Attachment Viewer (JPG/PNG Image & PDF)                            -->
<!-- ========================================================================= -->
<div class="modal fade" id="modalAttachmentViewer" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content" style="border-radius: 10px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.25);">
            <div class="modal-header text-white py-3" style="background: linear-gradient(135deg, #540033, #6d0034); border-top-left-radius: 10px; border-top-right-radius: 10px;">
                <div class="d-flex align-items-center">
                    <i class="fas fa-paperclip mr-2 fa-lg"></i>
                    <div>
                        <h5 class="modal-title font-weight-bold mb-0" id="viewerModalTitle" style="font-size: 1.1rem;">
                            Document Attachment Viewer
                        </h5>
                        <small class="text-white-50" id="viewerFileName">attachment</small>
                    </div>
                </div>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-3" style="background-color: #f8fafc;">
                <!-- Image Viewer Container -->
                <div id="viewerImageContainer" class="text-center p-2 d-none" style="min-height: 250px; max-height: 68vh; overflow: auto;">
                    <img id="viewerImageElement" src="" alt="Attachment Preview" class="img-fluid rounded shadow-sm border" style="max-height: 65vh; object-fit: contain; background: #fff;" />
                </div>

                <!-- PDF Viewer Container -->
                <div id="viewerPdfContainer" class="d-none" style="height: 68vh;">
                    <iframe id="viewerPdfFrame" src="" style="width: 100%; height: 100%; border: 1px solid #e2e8f0; border-radius: 6px;"></iframe>
                </div>

                <!-- Fallback / Unsupported Container -->
                <div id="viewerOtherContainer" class="text-center py-5 d-none">
                    <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
                    <h5 class="font-weight-bold text-dark">File Preview Not Available Directly</h5>
                    <p class="text-muted small">You can download or open this document in a new browser tab.</p>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 d-flex justify-content-between" style="border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                <div>
                    <a id="btnViewerOpenNewTab" href="#" target="_blank" class="btn btn-sm btn-outline-secondary mr-1" style="border-radius: 6px;">
                        <i class="fas fa-external-link-alt mr-1"></i> Open in New Tab
                    </a>
                    <a id="btnViewerDownload" href="#" download class="btn btn-sm btn-primary" style="background-color: #540033; border: none; border-radius: 6px;">
                        <i class="fas fa-download mr-1"></i> Download File
                    </a>
                </div>
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="border-radius: 6px;">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
@section Scripts {
<script>
    function openAttachmentViewer(url, type, fileName) {
        if (!url) {
            alert("Attachment URL not found.");
            return;
        }

        $("#viewerFileName").text(fileName || "Attachment");
        $("#btnViewerOpenNewTab").attr("href", url);
        $("#btnViewerDownload").attr("href", url).attr("download", fileName || "attachment");

        // Reset containers
        $("#viewerImageContainer").addClass("d-none");
        $("#viewerPdfContainer").addClass("d-none");
        $("#viewerOtherContainer").addClass("d-none");

        var ext = (fileName ? fileName.split('.').pop().toLowerCase() : '') || (type || '');

        if (type === "pdf" || ext === "pdf") {
            $("#viewerModalTitle").html('<i class="fas fa-file-pdf text-danger mr-2"></i> PDF Document Viewer');
            $("#viewerPdfFrame").attr("src", url);
            $("#viewerPdfContainer").removeClass("d-none");
        } else if (type === "image" || ["jpg", "jpeg", "png", "gif", "webp", "bmp"].indexOf(ext) !== -1) {
            $("#viewerModalTitle").html('<i class="fas fa-file-image text-info mr-2"></i> Image Attachment Viewer');
            $("#viewerImageElement").attr("src", url);
            $("#viewerImageContainer").removeClass("d-none");
        } else {
            $("#viewerModalTitle").html('<i class="fas fa-file mr-2"></i> Document Viewer');
            $("#viewerOtherContainer").removeClass("d-none");
        }

        $("#modalAttachmentViewer").modal("show");
    }
    var pendingItemsData = [];

    $(function () {
        loadPendingInboxSummary();
        loadPendingApprovals();
    });

    window.addEventListener("load", function () {
        if (!pendingItemsData || pendingItemsData.length === 0) {
            loadPendingApprovals();
        }
    });

    function showNotification(type, message) {
        var isSuccess = type === "success";
        var bgColor = isSuccess ? "#27ae60" : "#d9534f";
        var icon = isSuccess ? "fa-check-circle" : "fa-exclamation-circle";
        var toastId = "toast_" + Date.now();

        var toastHtml = `
            <div id="${toastId}" class="shadow-lg text-white p-3 mb-2 rounded d-flex align-items-center justify-content-between" 
                 style="background-color: ${bgColor}; min-width: 300px; max-width: 450px; font-size: 13px; transition: opacity 0.3s ease;">
                <div class="d-flex align-items-center">
                    <i class="fas ${icon} mr-2 fa-lg"></i>
                    <span>${message}</span>
                </div>
                <button type="button" class="close text-white ml-3" onclick="$('#${toastId}').remove();" style="font-size: 16px; outline: none;">
                    &times;
                </button>
            </div>
        `;

        var container = $("#actionToastContainer");
        if (container.length === 0) {
            $("body").append('<div id="actionToastContainer" style="position: fixed; top: 20px; right: 25px; z-index: 99999;"></div>');
            container = $("#actionToastContainer");
        }

        var $toast = $(toastHtml);
        container.append($toast);

        setTimeout(function () {
            $toast.fadeOut(400, function () { $(this).remove(); });
        }, 4000);
    }

    function removeCardOptimistically(approvalId) {
        var card = $("#pending-card-" + approvalId);
        if (card.length > 0) {
            card.fadeOut(350, function () {
                $(this).remove();
                var remaining = $(".pending-card-item:visible").length;
                // cntAction tracks MY queue; decrement it as I action items
                var myAction = parseInt($("#cntAction").text()) || 0;
                $("#cntAction").text(Math.max(0, myAction - 1));
                // cntPending is a system-wide total – refresh it quietly
                loadPendingInboxSummary(true);
                if (remaining === 0) {
                    $("#pendingList").addClass("d-none");
                    $("#emptyState").removeClass("d-none");
                }
            });
        }
    }

    function loadPendingInboxSummary(silent) {
        $.ajax({
            url: "/Leave/HrLvRegister/GetPendingInboxSummary?_t=" + Date.now(),
            type: "GET",
            dataType: "json",
            cache: false,
            success: function (data) {
                if (data) {
                    $("#cntPending").text(data.totalPending || 0);
                    if (!silent) {
                        // Only set cntAction from summary if loadPendingApprovals hasn't run yet
                        // (it will override with the exact list length once the card list loads)
                        if ($("#cntAction").text() === "0" || $("#cntAction").text() === "") {
                            $("#cntAction").text(data.awaitingMyAction || 0);
                        }
                    } else {
                        // Silent refresh (after an action) – update system total only
                        $("#cntPending").text(data.totalPending || 0);
                    }
                }
            },
            error: function () {
                // silently ignore – cards will retain last-known values
            }
        });
    }

    function loadPendingApprovals(silent) {
        if (!silent) {
            $("#loadingState").removeClass("d-none");
            $("#emptyState").addClass("d-none");
            $("#pendingList").addClass("d-none").empty();
        }

        $.ajax({
            url: "/Leave/HrLvRegister/GetMyPendingApprovals?_t=" + Date.now(),
            type: "GET",
            dataType: "json",
            cache: false,
            success: function (data) {
                if (!silent) $("#loadingState").addClass("d-none");
                if (data && data.length > 0) {
                    pendingItemsData = data;
                    // cntAction = items specifically assigned to ME (from the list)
                    $("#cntAction").text(data.length);
                    // cntPending (system total) is already set by loadPendingInboxSummary()
                    renderPendingCards(data);
                    $("#emptyState").addClass("d-none");
                    $("#pendingList").removeClass("d-none");
                } else {
                    pendingItemsData = [];
                    $("#cntAction").text(0);
                    // cntPending keeps the system total — don't zero it out
                    $("#pendingList").addClass("d-none").empty();
                    $("#emptyState").removeClass("d-none");
                }
            },
            error: function (xhr) {
                if (!silent) {
                    $("#loadingState").addClass("d-none");
                    $("#emptyState").removeClass("d-none");
                }
                console.error("Failed to load pending approvals", xhr);
            }
        });
    }

    function renderPendingCards(items) {
        var container = $("#pendingList");
        container.empty();

        items.forEach(function (rawItem, index) {
            // Support both camelCase and PascalCase properties safely
            var item = {
                lvId: rawItem.lvId || rawItem.LvId || 0,
                approvalId: rawItem.approvalId || rawItem.ApprovalId || "",
                wfInstanceId: rawItem.wfInstanceId || rawItem.WfInstanceId || rawItem.instanceId || rawItem.InstanceId || "",
                instanceNo: rawItem.instanceNo || rawItem.InstanceNo || rawItem.wfInstanceNo || rawItem.WfInstanceNo || "—",
                employeeName: rawItem.employeeName || rawItem.EmployeeName || rawItem.fullName || rawItem.FullName || "Employee",
                empId: rawItem.empId || rawItem.EmpId || "",
                department: rawItem.department || rawItem.Department || "—",
                designation: rawItem.designation || rawItem.Designation || "",
                leaveType: rawItem.leaveType || rawItem.LeaveType || "Leave",
                stDate: rawItem.stDate || rawItem.StDate || "",
                endDate: rawItem.endDate || rawItem.EndDate || "",
                days: (rawItem.days !== undefined && rawItem.days !== null) ? rawItem.days : (rawItem.Days !== undefined ? rawItem.Days : 1),
                reason: rawItem.reason || rawItem.Reason || "—",
                seatingLocation: rawItem.seatingLocation || rawItem.SeatingLocation || "—",
                hasAttachment: !!(rawItem.hasAttachment || rawItem.HasAttachment),
                attachmentUrl: rawItem.attachmentUrl || rawItem.AttachmentUrl || "",
                attachmentFileName: rawItem.attachmentFileName || rawItem.AttachmentFileName || "",
                attachmentType: rawItem.attachmentType || rawItem.AttachmentType || "",
                wfStatus: rawItem.wfStatus || rawItem.WfStatus || rawItem.status || rawItem.Status || "Pending",
                wfStatusBadge: rawItem.wfStatusBadge || rawItem.WfStatusBadge || "badge-info",
                submittedOn: rawItem.submittedOn || rawItem.SubmittedOn || ""
            };

            var empName = (item.employeeName && String(item.employeeName).trim().length > 0 && item.employeeName !== "—") 
                ? String(item.employeeName).trim() 
                : (item.empId ? "Employee (" + item.empId + ")" : "Employee");

            var stDateFormatted = item.stDate ? String(item.stDate).substring(0, 10) : "";
            var endDateFormatted = item.endDate ? String(item.endDate).substring(0, 10) : "";
            var subDate = item.submittedOn ? String(item.submittedOn).substring(0, 10) : "";
            var safeEmpName = empName.replace(/'/g, "\\'");
            var safeLvType = String(item.leaveType).replace(/'/g, "\\'");
            var safeInstNo = String(item.instanceNo).replace(/'/g, "\\'");
            var safeFileName = String(item.attachmentFileName || 'attachment').replace(/'/g, "\\'");

            var cardHtml = `
                <div class="col-lg-6 col-xl-4 mb-3 pending-card-item" id="pending-card-${item.approvalId}" data-approval-id="${item.approvalId}" data-search="${(empName + ' ' + item.empId + ' ' + item.department + ' ' + item.leaveType + ' ' + item.instanceNo + ' ' + item.reason + ' ' + item.seatingLocation).toLowerCase()}">
                    <div class="card h-100 shadow-sm border" style="border-radius: 8px; border-top: 3px solid #540033 !important;">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="font-weight-bold mb-0" style="font-size: 14px; color: #4e5d78 !important;">
                                        ${empName}
                                        ${item.empId ? `<small class="text-muted font-weight-normal ml-1">(${item.empId})</small>` : ''}
                                    </h6>
                                    <div class="text-muted small mt-1" style="font-size: 11px;">
                                        <i class="fas fa-building mr-1 text-secondary"></i> ${item.department} ${item.designation ? `&bull; ${item.designation}` : ''}
                                    </div>
                                    <span class="badge badge-light border text-muted mt-1" style="font-size: 10px;">${item.instanceNo}</span>
                                </div>
                                <span class="badge badge-pill badge-primary" style="background:#540033; font-size:11px; padding: 4px 10px;">${item.leaveType}</span>
                            </div>

                            <div class="bg-light p-2 rounded mb-3" style="font-size: 12px;">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted"><i class="far fa-calendar-alt mr-1"></i> Period:</span>
                                    <span class="font-weight-bold text-dark">${stDateFormatted} &rarr; ${endDateFormatted}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted"><i class="far fa-clock mr-1"></i> Total Days:</span>
                                    <span class="font-weight-bold text-dark">${item.days} Day(s)</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted"><i class="fas fa-info-circle mr-1"></i> Status:</span>
                                    <span class="badge ${item.wfStatusBadge || 'badge-info'}">${item.wfStatus || 'Pending'}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted"><i class="far fa-comment-alt mr-1"></i> Reason:</span>
                                    <span class="font-weight-500 text-dark text-right" style="max-width: 65%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${item.reason}">${item.reason}</span>
                                </div>
                                <div class="d-flex justify-content-between ${item.hasAttachment ? 'mb-1' : ''}">
                                    <span class="text-muted"><i class="fas fa-map-marker-alt mr-1"></i> Seating Location:</span>
                                    <span class="font-weight-500 text-dark text-right" style="max-width: 65%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${item.seatingLocation}">${item.seatingLocation}</span>
                                </div>
                                ${item.hasAttachment ? `
                                <div class="d-flex justify-content-between align-items-center pt-1 border-top" style="border-color: #e2e8f0 !important;">
                                    <span class="text-muted"><i class="fas fa-paperclip mr-1"></i> Attachment:</span>
                                    <button type="button" class="btn btn-xs btn-outline-primary" style="font-size: 11px; padding: 2px 8px; border-radius: 4px;" onclick="openAttachmentViewer('${item.attachmentUrl}', '${item.attachmentType}', '${safeFileName}')">
                                        <i class="${item.attachmentType === 'pdf' ? 'fas fa-file-pdf text-danger' : (item.attachmentType === 'image' ? 'fas fa-file-image text-info' : 'fas fa-file text-secondary')} mr-1"></i> View ${item.attachmentType === 'pdf' ? 'PDF' : 'File'}
                                    </button>
                                </div>
                                ` : ''}
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <button type="button" class="btn btn-xs btn-outline-secondary" onclick="openTimelineModal(${item.lvId}, '${safeInstNo}', '${item.wfInstanceId}')" style="border-radius: 4px; font-size: 11px; padding: 3px 8px;" title="View Workflow Timeline">
                                    <i class="fas fa-history mr-1"></i> Timeline
                                </button>
                                <div>
                                    <button type="button" class="btn btn-xs btn-danger mr-1" onclick="openRejectModal('${item.approvalId}', ${item.lvId}, '${safeEmpName}', '${safeLvType}', '${safeInstNo}')" style="border-radius: 4px; font-size: 11px; padding: 4px 10px;">
                                        <i class="fas fa-times mr-1"></i> Reject
                                    </button>
                                    <button type="button" class="btn btn-xs btn-success" onclick="openApproveModal('${item.approvalId}', ${item.lvId}, '${safeEmpName}', '${safeLvType}', '${stDateFormatted} to ${endDateFormatted} (${item.days} days)', '${safeInstNo}')" style="border-radius: 4px; font-size: 11px; padding: 4px 10px;">
                                        <i class="fas fa-check mr-1"></i> Approve
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            container.append(cardHtml);
        });
    }

    function filterPendingCards() {
        var term = $("#txtSearchPending").val().toLowerCase();
        $(".pending-card-item").each(function () {
            var searchData = $(this).attr("data-search");
            if (!term || searchData.indexOf(term) > -1) {
                $(this).removeClass("d-none");
            } else {
                $(this).addClass("d-none");
            }
        });
    }

    // --- Approve Flow ---
    function openApproveModal(approvalId, lvId, empName, lvType, duration, instanceNo) {
        $("#approveApprovalId").val(approvalId);
        $("#approveLvId").val(lvId);
        $("#approveEmpName").text(empName);
        $("#approveLvType").text(lvType);
        $("#approveDuration").text(duration);
        $("#approveRef").text(instanceNo);
        $("#approveComments").val("");
        $("#modalApprove").modal("show");
    }

    function executeApprove() {
        var approvalId = $("#approveApprovalId").val();
        var comment = $("#approveComments").val();

        var btn = $("#btnConfirmApprove");
        var origHtml = btn.html();
        btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Approving...');

        $.ajax({
            url: "/Leave/HrLvRegister/ApproveStep",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                ApprovalId: approvalId,
                Comment: comment
            }),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                btn.prop("disabled", false).html(origHtml);
                $("#modalApprove").modal("hide");
                if (res && res.success) {
                    showNotification("success", "Leave request approved successfully!");
                    removeCardOptimistically(approvalId);
                    setTimeout(function () {
                        loadPendingApprovals(true);
                    }, 500);
                } else {
                    showNotification("error", "Approval failed: " + (res.message || "Unknown error"));
                }
            },
            error: function (xhr) {
                btn.prop("disabled", false).html(origHtml);
                showNotification("error", "Approval error: " + (xhr.responseJSON ? xhr.responseJSON.message : "Failed to record approval decision."));
            }
        });
    }

    // --- Reject Flow ---
    function openRejectModal(approvalId, lvId, empName, lvType, instanceNo) {
        $("#rejectApprovalId").val(approvalId);
        $("#rejectLvId").val(lvId);
        $("#rejectEmpName").text(empName);
        $("#rejectLvType").text(lvType);
        $("#rejectRef").text(instanceNo);
        $("#rejectReason").val("");
        $("#modalReject").modal("show");
    }

    function executeReject() {
        var approvalId = $("#rejectApprovalId").val();
        var reason = $("#rejectReason").val().trim();

        if (!reason) {
            showNotification("error", "Please provide a rejection reason.");
            $("#rejectReason").focus();
            return;
        }

        var btn = $("#btnConfirmReject");
        var origHtml = btn.html();
        btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Rejecting...');

        $.ajax({
            url: "/Leave/HrLvRegister/RejectStep",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                ApprovalId: approvalId,
                Comment: reason
            }),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (res) {
                btn.prop("disabled", false).html(origHtml);
                $("#modalReject").modal("hide");
                if (res && res.success) {
                    showNotification("success", "Leave request rejected.");
                    removeCardOptimistically(approvalId);
                    setTimeout(function () {
                        loadPendingApprovals(true);
                    }, 500);
                } else {
                    showNotification("error", "Rejection failed: " + (res.message || "Unknown error"));
                }
            },
            error: function (xhr) {
                btn.prop("disabled", false).html(origHtml);
                showNotification("error", "Rejection error: " + (xhr.responseJSON ? xhr.responseJSON.message : "Failed to record rejection decision."));
            }
        });
    }

    // --- Timeline Flow ---
    function openTimelineModal(lvId, instanceNo, wfInstanceId, event) {
        if (event) {
            try {
                event.preventDefault();
                event.stopPropagation();
            } catch (e) { }
        }
        var url = '@Url.Action("TimelineGet", "HrLvRegister", new { area = "Leave" })?lvId=' + lvId + '&_t=' + Date.now();
        $("#timelineModalBody").html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status" style="color: #540033 !important;"><span class="sr-only">Loading...</span></div><p class="text-muted small mt-2">Loading approval workflow progress...</p></div>');
        $("#modalTimeline").modal("show");
        $.ajax({
            url: url,
            type: 'GET',
            cache: false,
            success: function (htmlContent) {
                $("#timelineModalBody").html(htmlContent);
            },
            error: function (xhr, status, error) {
                var errDesc = "Unable to load approval timeline.";
                if (xhr && xhr.status > 0) {
                    errDesc += " (" + xhr.status + " " + xhr.statusText + ")";
                }
                $("#timelineModalBody").html('<div class="alert alert-danger m-3"><i class="fas fa-exclamation-triangle mr-2"></i> ' + errDesc + '</div>');
            }
        });
    }
</script>
}
