@model qHRM.Areas.Leave.Models.HrLvType

@using Syncfusion.EJ2
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Edit", "HrLvType"))
{
    <span class="alert-success ">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.LvTypId)
        @Html.HiddenFor(model => model.RecStat)
        <div class="form-group">
            <label asp-for="LvTypCode" class="control-label"></label>
            <input asp-for="ex_LvTypCode" class="form-control form-control-sm" hidden />
            <input asp-for="LvTypCode" class="form-control form-control-sm" />
            <span asp-validation-for="LvTypCode" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NameEng" class="control-label"></label>
            <input asp-for="NameEng" class="form-control form-control-sm" />
            <span asp-validation-for="NameEng" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Desc" class="control-label"></label>
            <input asp-for="Desc" class="form-control form-control-sm" />
            <span asp-validation-for="Desc" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ElgDays" class="control-label"></label>
            <input asp-for="ElgDays" class="form-control form-control-sm" />
            <span asp-validation-for="ElgDays" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="MaxCntDays" class="control-label"></label>
            <input asp-for="MaxCntDays" class="form-control form-control-sm" />
            <span asp-validation-for="MaxCntDays" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="SlryDctFct" class="control-label"></label>
            <input asp-for="SlryDctFct" class="form-control form-control-sm" />
            <span asp-validation-for="SlryDctFct" class="text-danger"></span>
        </div>
        <div class="form-check">
            <input type="checkbox" asp-for="AprlRqd" class="form-check-input" id="chkAprlRqd">
            <label class="form-check-label" for="chkAprlRqd">Prior Approval</label>
        </div>
        <div class="form-check">
            <input type="checkbox" asp-for="PreShld" class="form-check-input" id="chkPreShld">
            <label class="form-check-label" for="chkPreShld">Prior Schedule</label>
        </div>
        <div class="form-check">
            <input type="checkbox" asp-for="RjnFmRqd" class="form-check-input" id="chkRjnFmRqd">
            <label class="form-check-label" for="chkRjnFmRqd">Rejoining Form</label>
        </div>
        <div class="form-check">
            <input type="checkbox" asp-for="Encsh" class="form-check-input" id="chkEncsh">
            <label class="form-check-label" for="chkEncsh">Applicable for Encashment</label>
        </div>

        <div class="form-group">
            <input type="submit" value="Save" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}
<ejs-scripts></ejs-scripts>