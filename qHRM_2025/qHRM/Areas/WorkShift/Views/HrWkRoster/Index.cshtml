@model IEnumerable<qHRM.Areas.WorkShift.Models.HrWkRoster>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/ej2.min.js"></script>
<ejs-scripts></ejs-scripts>
<ejs-treeview id="listdata"></ejs-treeview>

<style>
    :root {
        --org-primary: #540033;
        --org-primary-hover: #3e0026;
        --org-primary-light: #fdf2f8;
        --org-primary-border: #fbcfe8;
        --clr-bg: #f7fafc;
        --clr-surface: #ffffff;
        --clr-border: rgba(2,6,23,0.06);
        --clr-text: #0f172a;
        --clr-muted: #475569;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
    }

    .org-page-container {
        padding: 0.75rem 0.5rem 1.5rem 0.5rem;
    }

    /* Compact Header Card */
    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border);
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--clr-text);
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: var(--org-primary-light);
        color: var(--org-primary);
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid var(--org-primary-border);
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: var(--clr-muted);
        margin-top: 0.15rem;
        line-height: 1.2;
    }
    .org-breadcrumb a {
        color: var(--clr-muted);
        text-decoration: none;
        transition: color 0.15s;
    }
    .org-breadcrumb a:hover {
        color: var(--org-primary);
    }

    /* Create Button */
    .org-btn-create {
        background: linear-gradient(135deg, #540033 0%, #750047 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: var(--radius-sm) !important;
        padding: 0.45rem 1rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.01em !important;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease !important;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.25) !important;
    }

    .org-btn-create:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(84, 0, 51, 0.35) !important;
        color: #ffffff !important;
    }

    .org-btn-create:active {
        transform: translateY(0);
    }

    /* Action Buttons in Grid */
    .org-actions-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .org-action-btn {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        transition: all 0.15s ease;
        text-decoration: none !important;
        cursor: pointer;
        font-size: 0.75rem;
        padding: 0;
        outline: none;
    }

    .org-action-edit {
        background: #fdf2f8;
        color: var(--org-primary);
        border-color: #fbcfe8;
    }

    .org-action-edit:hover {
        background: var(--org-primary);
        color: #ffffff !important;
        border-color: var(--org-primary);
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(84, 0, 51, 0.25);
    }

    .org-action-delete {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .org-action-delete:hover {
        background: #dc2626;
        color: #ffffff !important;
        border-color: #dc2626;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);
    }

    /* Modern Modals */
    .org-modal .modal-content {
        border: 1px solid var(--clr-border) !important;
        border-radius: var(--radius) !important;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.2) !important;
        overflow: hidden;
    }

    .org-modal .modal-header {
        background: linear-gradient(135deg, #540033 0%, #3b0024 100%) !important;
        color: #ffffff !important;
        padding: 1rem 1.25rem !important;
        border-bottom: none !important;
    }

    .org-modal .modal-header .modal-title {
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        display: flex;
        align-items: center;
    }

    .org-modal .modal-header .close {
        color: #ffffff !important;
        opacity: 0.8 !important;
        text-shadow: none !important;
        transition: opacity 0.15s !important;
        outline: none !important;
    }

    .org-modal .modal-header .close:hover {
        opacity: 1 !important;
    }

    .org-modal-delete .modal-header {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%) !important;
    }
</style>

<div class="org-page-container">
    <main>
        <div class="container-fluid px-0">

            <!-- COMPACT HERO HEADER -->
            <div class="org-hero-card">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
                    <div class="d-flex align-items-center">
                        <div class="org-icon-badge mr-3">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                                <h1 class="org-title">Manage Rosters</h1>
                                <span class="badge org-category-pill">WORK SHIFT</span>
                            </div>
                            <div class="org-breadcrumb">
                                <a href="#">Work Shift</a> / <span class="text-dark font-weight-medium">Manage Rosters</span>
                                <span class="text-muted mx-1">&bull;</span>
                                <span class="text-muted">Configure duty rosters, schedule shift patterns, and manage weekly rotations</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn org-btn-create" id="btnNewRoster" onclick="createFunc();">
                            <i class="fas fa-plus-circle mr-1"></i> Add New Roster
                        </button>
                    </div>
                </div>
            </div>

            <!-- Two Column Layout -->
            <div class="form-row">
                <!-- Left: Rosters Grid -->
                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <!--Grid-->
                            <div class="control-section">
                                <ejs-grid id="Grid" width="auto" dataSource="@ViewBag.DsRst" allowPaging="true" allowFiltering="true" allowResizing="true">
                                    <e-grid-filterSettings type="CheckBox"></e-grid-filterSettings>
                                    <e-grid-pagesettings pageCount=5></e-grid-pagesettings>
                                    <e-grid-columns>
                                        <e-grid-column template="#dataTemplate" field="RstCode" headerText="Code" width="100" />
                                        <e-grid-column field="NameEng" headerText="Name" width="160" />
                                        <e-grid-column field="RecStatTxt" headerText="Status" width="110" />
                                        <e-grid-column field="" headerText="Actions" template="#_actions" width="130" textAlign="Center" />
                                    </e-grid-columns>
                                </ejs-grid>
                            </div>
                            <!--Grid-->
                        </div>
                    </div>
                </div>

                <!-- Right: Schedule Viewer -->
                <div class="col-lg-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h6 class="font-weight-bold text-dark mb-0" id="lblRstName">Roster Shift Calendar</h6>
                                <span class="small text-muted font-weight-bold" id="lblTotHours"></span>
                            </div>
                            <div>
                                <ejs-schedule id="schedule" height="600px" selectedDate="new DateTime(2017, 1, 1)" showQuickInfo="false" currentView="Week" showHeaderBar="false" allowDragAndDrop="false" eventClick="OnEventClick" eventRendered="onEventRendered">
                                    <e-schedule-eventsettings dataSource="@ViewBag.DsRstSftDtls" enableTooltip="true" tooltipTemplate="#toolTip"></e-schedule-eventsettings>
                                    <e-schedule-views>
                                        <e-schedule-view option="Week" showWeekNumber="false"></e-schedule-view>
                                    </e-schedule-views>
                                    <e-schedule-timescale interval="120" slotCount="1"></e-schedule-timescale>
                                </ejs-schedule>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MODALS -->
            <!--Create Roster-->
            <div class="modal fade org-modal" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="modalCreateTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCreateTitle">
                                <i class="fas fa-plus-circle mr-2"></i> New Roster
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="createModalBody">
                        </div>
                    </div>
                </div>
            </div>

            <!--Edit Roster-->
            <div class="modal fade org-modal" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="modalEditTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalEditTitle">
                                <i class="fas fa-edit mr-2"></i> Update Roster
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="editModalBody">
                        </div>
                    </div>
                </div>
            </div>

            <!--Deactivate/Cancel Roster-->
            <div class="modal fade org-modal org-modal-delete" id="modalCancel" tabindex="-1" role="dialog" aria-labelledby="modalCancelTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCancelTitle">
                                <i class="fas fa-exclamation-triangle mr-2"></i> Deactivate Roster
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="cancelModalBody">
                        </div>
                    </div>
                </div>
            </div>

            <!--Add Shift to Roster Modal-->
            <div class="modal fade org-modal" id="modalRstSftCreate" tabindex="-1" role="dialog" aria-labelledby="modalRstSftCreateTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalRstSftCreateTitle">
                                <i class="fas fa-plus-circle mr-2"></i> Add Shift to Roster
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="createRstSftModalBody">
                        </div>
                    </div>
                </div>
            </div>

            <!--Edit Roster Shift Modal-->
            <div class="modal fade org-modal" id="modalRstSftEdit" tabindex="-1" role="dialog" aria-labelledby="modalRstSftEditTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalRstSftEditTitle">
                                <i class="fas fa-edit mr-2"></i> Update Roster Shift
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="editRstSftModalBody">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<!-- JSRENDER ACTION TEMPLATES -->
<script type="text/x-jsrender" id="_actions">
    <div class="org-actions-wrapper">
        <button type="button" class="org-action-btn org-action-edit" onclick="editFunc(${RstId})" title="Edit Roster">
            <i class="fas fa-pen"></i>
        </button>
        <button type="button" class="org-action-btn" style="background:#ecfdf5;color:#059669;border-color:#a7f3d0;" onclick="addRstSftFunc(${RstId})" title="Add Shift to Roster">
            <i class="fas fa-plus"></i>
        </button>
        <button type="button" class="org-action-btn org-action-delete" onclick="cancelFunc(${RstId})" title="Deactivate Roster">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>
</script>

<!-- Backward Compatibility Templates -->
<script type="text/x-jsrender" id="_edit">
    <button type="button" class="org-action-btn org-action-edit" onclick="editFunc(${RstId})" title="Edit">
        <i class="fas fa-pen"></i>
    </button>
</script>
<script type="text/x-jsrender" id="_cancel">
    <button type="button" class="org-action-btn org-action-delete" onclick="cancelFunc(${RstId})" title="Deactivate">
        <i class="fas fa-trash-alt"></i>
    </button>
</script>
<script type="text/x-jsrender" id="_addRstSft">
    <button type="button" class="org-action-btn" style="background:#ecfdf5;color:#059669;border-color:#a7f3d0;" onclick="addRstSftFunc(${RstId})" title="Add Shift">
        <i class="fas fa-plus"></i>
    </button>
</script>

<!-- Template Column for Code Click -->
<script id="dataTemplate" type="text/x-template">
    <div>
        <a rel='tag' href="#" class="text-primary font-weight-bold" onclick="showShiftsDtl(${RstId})">${RstCode}</a>
    </div>
</script>

<!-- Tooltip Template -->
<script id="toolTip" type="text/x-template">
    <div class="tooltip-wrap">
        <div class="content-area">
            <div class="name font-weight-bold">${Subject}</div>
            <div class="time small">From: ${StartTime.toLocaleString()}</div>
            <div class="time small">To: ${EndTime.toLocaleString()}</div>
        </div>
    </div>
</script>

<!-- Scripts -->
<script>
    var createFunc = function () {
        var url = "/WorkShift/HrWkRoster/RstCreateNew";
        $("#createModalBody").load(url, function () {
            $("#modalCreate").modal("show");
        });
    };

    var editFunc = function (rstId) {
        var url = "/WorkShift/HrWkRoster/RstEditGet?rstId=" + rstId;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
        });
    };

    var cancelFunc = function (rstId) {
        var url = "/WorkShift/HrWkRoster/RstCancelGet?rstId=" + rstId;
        $("#cancelModalBody").load(url, function () {
            $("#modalCancel").modal("show");
        });
    };

    var addRstSftFunc = function (rstId) {
        var url = "/WorkShift/HrWkRoster/GetRstSftCreate?rstId=" + rstId;
        $("#createRstSftModalBody").load(url, function () {
            $("#modalRstSftCreate").modal("show");
        });
    };

    var editRstSftFunc = function (schId) {
        var url = "/WorkShift/HrWkRoster/GetRstSftEdit?schId=" + schId;
        $("#editRstSftModalBody").load(url, function () {
            $("#modalRstSftEdit").modal("show");
        });
    };

    function showShiftsDtl(id) {
        var scheduleObj = document.getElementById('schedule').ej2_instances[0];

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '/WorkShift/HrWkRoster/GetShiftDataByRstId',
            dataType: "json",
            data: { rstId: id },
            success: function (data) {
                scheduleObj.eventSettings.dataSource = data.data;
            },
            error: function (xhr, err) {
            }
        });
    }

    function OnEventClick(args) {
        var scheduleObj = document.querySelector('.e-schedule').ej2_instances[0];
        var event = scheduleObj.getEventDetails(args.element);
        editRstSftFunc(event.Id);
    }

    function onEventRendered(args) {
        var scheduleObj = document.querySelector('.e-schedule').ej2_instances[0];
        applyCategoryColor(args, scheduleObj.currentView);
    }

    function applyCategoryColor(args, currentView) {
        let categoryColor = args.data.CategoryColor;
        if (!args.element || !categoryColor) {
            return;
        }
        if (currentView === 'Agenda') {
            args.element.firstChild.style.borderLeftColor = categoryColor;
        }
        else {
            args.element.style.backgroundColor = categoryColor;
        }
    }
</script>