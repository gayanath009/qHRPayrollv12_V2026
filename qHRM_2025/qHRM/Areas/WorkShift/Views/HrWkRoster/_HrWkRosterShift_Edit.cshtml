@model qHRM.Areas.WorkShift.Models.HrWkRosterShift
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("EditSft", "HrWkRoster"))
{
<span class="alert-success">
    @Html.ValidationSummary(true)
</span>
<div class="dl-horizontal">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input id="txtSchId" asp-for="SchId" hidden />
    <input id="txtRstId" asp-for="RstId" hidden />
    @Html.HiddenFor(model => model.EntId)
    @Html.HiddenFor(model => model.Day)
</div>
<div class="card-body">
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="RstId" class="control-label"></label>
            <p>
                @Html.LabelFor(model => model.SchId, ((string)ViewBag.RstName))
            </p>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="Day" class="control-label"></label>
            <p>@Html.DisplayFor(model => model.Day)</p>
            <span asp-validation-for="Day" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-12">
            <label asp-for="SftId" class="control-label"></label>
            <select asp-for="SftId" id="dpSftE" class="form-control form-control-sm select2-dropdown"
                    asp-items="@(new SelectList(ViewBag.lstSft, "SftId", "ShtDtl", Model?.SftId))">
                <option value="">-- Select Shift --</option>
            </select>
            <span asp-validation-for="SftId" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-12">
            <label asp-for="DescEng" class="control-label"></label>
            <input asp-for="DescEng" class="form-control form-control-sm" />
            <span asp-validation-for="DescEng" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group"></div>

    <div class="form-group">
        <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
        <input type="button" value="Remove" class="btn btn-sm btn-primary btn-block" onclick="removeShift()"/>
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
    </div>
</div> 
}
<script>
    function removeShift() {
        var schId = $("#txtSchId").val();
        var rstId = $("#txtRstId").val();
        var returnurl = "/WorkShift/HrWkRoster/Index?rstId=" + rstId;             

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '/WorkShift/HrWkRoster/DeleteSft',
            dataType: "json",
            data: { schId: schId},
            success: function (data) {
                if (data.data == 1) {
                    $('#modalRstSftEdit').modal('hide');
                    window.location.href = returnurl;
                }
            },
            error: function (xhr, err) {
                alert("Error: " + data.Message);
            }
        });
    }

    $(function () {
        $('#modalEdit').find('.select2-dropdown').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalEdit')
        });

        $('#modalEdit').find('.select2-dropdown').on('change', function () {
            try { $(this).valid(); } catch (e) { }
        });
    });
</script>
