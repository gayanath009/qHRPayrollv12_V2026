@model qHRM.Areas.WorkShift.Models.HrWkRosterShift
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

@using (Html.BeginForm("EditSft", "HrWkRoster", FormMethod.Post, new { id = "frmEditSft" }))
{
    @Html.AntiForgeryToken()
    <span class="text-danger">
        @Html.ValidationSummary(true)
    </span>
    <input id="txtSchId" asp-for="SchId" type="hidden" />
    <input id="txtRstId" asp-for="RstId" type="hidden" />
    @Html.HiddenFor(model => model.EntId)
    @Html.HiddenFor(model => model.Day)

    <div class="card-body p-1">
        <div class="form-row">
            <div class="form-group col-md-6 mb-3">
                <label class="control-label font-weight-bold text-muted small text-uppercase">Roster</label>
                <div class="p-2 bg-light rounded border text-dark font-weight-bold">
                    <i class="fas fa-calendar-alt text-primary mr-2"></i>@ViewBag.RstName
                </div>
            </div>
            <div class="form-group col-md-6 mb-3">
                <label class="control-label font-weight-bold text-muted small text-uppercase">Day</label>
                <div class="p-2 bg-light rounded border text-dark font-weight-bold">
                    <i class="far fa-calendar-day text-info mr-2"></i>@Model.Day
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-12 mb-3">
                <label asp-for="SftId" class="control-label font-weight-bold">Shift <span class="text-danger">*</span></label>
                <select asp-for="SftId" id="dpSftE" class="form-control form-control-sm select2-rst-edit" required
                        asp-items="@(new SelectList(ViewBag.lstSft, "SftId", "ShtDtl", Model?.SftId))">
                    <option value="">-- Select Shift --</option>
                </select>
                <span asp-validation-for="SftId" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-12 mb-3">
                <label asp-for="DescEng" class="control-label font-weight-bold">Description</label>
                <input asp-for="DescEng" id="txtEditDescEng" class="form-control form-control-sm" placeholder="Shift description" />
                <span asp-validation-for="DescEng" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeShift()">
                <i class="fas fa-trash-alt mr-1"></i> Remove Shift
            </button>
            <div style="gap: 10px;" class="d-flex">
                <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-sm btn-primary px-4">
                    <i class="fas fa-save mr-1"></i> Update Shift
                </button>
            </div>
        </div>
    </div>
}

<script>
    function removeShift() {
        if (!confirm('Are you sure you want to remove this shift from the roster?')) return;
        var schId = $("#txtSchId").val();
        var rstId = $("#txtRstId").val();
        var returnurl = "/WorkShift/HrWkRoster/Index?rstId=" + rstId;

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '/WorkShift/HrWkRoster/DeleteSft',
            dataType: "json",
            data: { schId: schId },
            success: function (data) {
                $('#modalRstSftEdit').modal('hide');
                window.location.href = returnurl;
            },
            error: function (xhr, err) {
                alert("Error removing shift");
            }
        });
    }

    $(function () {
        $('#modalRstSftEdit .select2-rst-edit').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalRstSftEdit')
        });

        $('#dpSftE').on('change', function () {
            var selectedText = $(this).find('option:selected').text();
            if (selectedText && selectedText.indexOf('--') < 0 && !$('#txtEditDescEng').val()) {
                var parts = selectedText.split(' - ');
                $('#txtEditDescEng').val(parts.length > 1 ? parts[1] : selectedText);
            }
        });
    });
</script>
