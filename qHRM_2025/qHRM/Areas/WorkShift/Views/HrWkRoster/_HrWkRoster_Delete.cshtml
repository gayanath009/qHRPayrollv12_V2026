@model qHRM.Areas.WorkShift.Models.HrWkRoster

<div class="p-2">
    <div class="alert alert-warning d-flex align-items-center mb-3">
        <i class="fas fa-exclamation-triangle fa-2x mr-3 text-warning"></i>
        <div>
            <h6 class="mb-1 font-weight-bold">Deactivate Roster Confirmation</h6>
            <p class="mb-0 small text-muted">Are you sure you want to deactivate this work roster? Employees currently assigned will need an active roster.</p>
        </div>
    </div>

    @using (Html.BeginForm("RstCancel", "HrWkRoster", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="rstId" value="@Model.RstId" />

        <div class="card mb-3 border-light bg-light">
            <div class="card-body py-3">
                <div class="row mb-2">
                    <div class="col-sm-4 text-muted small">Roster Code:</div>
                    <div class="col-sm-8 font-weight-bold">@Model.RstCode</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 text-muted small">Roster Name:</div>
                    <div class="col-sm-8 font-weight-bold">@Model.NameEng</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted small">Description:</div>
                    <div class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.DescEng) ? "-" : Model.DescEng)</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end" style="gap: 10px;">
            <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-danger px-4">
                <i class="fas fa-trash-alt mr-1"></i> Deactivate
            </button>
        </div>
    }
</div>

