@model qHRM.Areas.WorkShift.Models.HrWkRosterShift
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

@using (Html.BeginForm("CreateSft", "HrWkRoster", FormMethod.Post, new { id = "frmCreateSft" }))
{
    @Html.AntiForgeryToken()
    <span class="text-danger">
        @Html.ValidationSummary(true)
    </span>
    <input id="txtRstId" asp-for="RstId" type="hidden" />

    <div class="card-body p-1">
        <div class="form-row">
            <div class="form-group col-md-12 mb-3">
                <label class="control-label font-weight-bold text-muted small text-uppercase">Roster</label>
                <div class="p-2 bg-light rounded border text-dark font-weight-bold">
                    <i class="fas fa-calendar-alt text-primary mr-2"></i>@ViewBag.RstName
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6 mb-3">
                <label asp-for="Day" class="control-label font-weight-bold">Day of Week <span class="text-danger">*</span></label>
                <select asp-for="Day" id="dpDay" class="form-control form-control-sm select2-rst-create" required
                        asp-items="@(new SelectList(ViewBag.lstDays, "ElmntTxt", "ElmntTxt"))">
                    <option value="">-- Select Day --</option>
                </select>
                <span asp-validation-for="Day" class="text-danger small"></span>
            </div>

            <div class="form-group col-md-6 mb-3">
                <label asp-for="SftId" class="control-label font-weight-bold">Shift <span class="text-danger">*</span></label>
                <select asp-for="SftId" id="dpSft" class="form-control form-control-sm select2-rst-create" required
                        asp-items="@(new SelectList(ViewBag.lstSft, "SftId", "ShtDtl"))">
                    <option value="">-- Select Shift --</option>
                </select>
                <span asp-validation-for="SftId" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-12 mb-3">
                <label asp-for="DescEng" class="control-label font-weight-bold">Description</label>
                <input asp-for="DescEng" id="txtDescEng" class="form-control form-control-sm" placeholder="Shift description (optional, defaults to shift name)" />
                <span asp-validation-for="DescEng" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3" style="gap: 10px;">
            <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-sm btn-primary px-4">
                <i class="fas fa-save mr-1"></i> Save Shift
            </button>
        </div>
    </div>
}

<script type="text/javascript">
    function onDayChange() {
        var dayVal = $('#dpDay').val();
        var rstId = $('#txtRstId').val();
        var $sft = $('#dpSft');

        if (dayVal) {
            $.ajax({
                type: "GET",
                contentType: "application/json; charset=utf-8",
                url: '/WorkShift/HrWkRoster/GetShiftByRstIdDay',
                dataType: "json",
                data: { rstId: rstId, day: dayVal, sftId: "0" },
                success: function (data) {
                    var currentVal = $sft.val();
                    $sft.empty();
                    $sft.append($('<option value="">-- Select Shift --</option>'));
                    if (data && data.data) {
                        $.each(data.data, function (i, item) {
                            var id = item.sftId || item.SftId;
                            var text = item.shtDtl || item.ShtDtl;
                            $sft.append($('<option></option>').val(id).text(text));
                        });
                    }
                    if (currentVal && $sft.find('option[value="' + currentVal + '"]').length > 0) {
                        $sft.val(currentVal);
                    } else if (dayVal === 'FRI' || dayVal === 'SAT') {
                        // Pre-select WK_END if weekend
                        $sft.find('option').each(function () {
                            if ($(this).text().indexOf('WK_END') >= 0 || $(this).text().indexOf('Week End') >= 0) {
                                $sft.val($(this).val());
                            }
                        });
                    }
                    $sft.trigger('change.select2');
                },
                error: function (xhr, err) { }
            });
        }
    }

    $(function () {
        $('#modalRstSftCreate .select2-rst-create').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalRstSftCreate')
        });

        $('#dpDay').on('change', function () {
            onDayChange();
        });

        $('#dpSft').on('change', function () {
            var selectedText = $(this).find('option:selected').text();
            if (selectedText && selectedText.indexOf('--') < 0 && !$('#txtDescEng').val()) {
                var parts = selectedText.split(' - ');
                $('#txtDescEng').val(parts.length > 1 ? parts[1] : selectedText);
            }
        });
    });
</script>
