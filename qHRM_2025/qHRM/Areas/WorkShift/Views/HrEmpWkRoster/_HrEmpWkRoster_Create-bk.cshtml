
@model qHRM.Areas.WorkShift.Models.HrEmpWkRoster
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

@using (Html.BeginForm("Create", "HrEmpWkRoster"))
{
    <span class="alert-success">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <ejs-toast id="toast_type" close="onclose" beforeOpen="onBeforeOpen" created="created" width="75%">
            <e-toast-position X="Center"></e-toast-position>
        </ejs-toast>

        @*<div class="form-group">
                <label asp-for="EmpSysId" class="control-label"></label>
                <ejs-dropdownlist id="drpEmployee" placeholder="Select Employee" dataSource="ViewBag.lstEmp" ejs-for="EmpSysId" filterBarPlaceholder="Search" allowFiltering="true" filterType="Contains">
                    <e-dropdownlist-fields text="FulNme" value="ESysId"></e-dropdownlist-fields>
                </ejs-dropdownlist>
                <span asp-validation-for="EmpSysId" class="text-danger"></span>
            </div>*@

        <div class="form-row">
            <div class="form-group col-md-4">
                <label class="control-label">Employee Type</label>
                <br />
                <fieldset class="form-group">
                    <div class="row">
                        <div class="col-sm-10">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="gridRadios" id="chkAllEmp" value="A" checked onclick="showReProcessOptions();">
                                <label class="form-check-label" for="gridRadios1">
                                    All Employees
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="gridRadios" id="chkSlctdEmp" value="S" onclick="showReProcessOptions();">
                                <label class="form-check-label" for="gridRadios2">
                                    Individual Employee
                                </label>
                            </div>
                            <input id="txtempTyp" asp-for="EmpTyp" hidden />
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="form-group col-md-8">
                <br /> <br />
                <div id="dvEmp">
                    <ejs-dropdownlist id="drpEmp" placeholder="Select Employee" dataSource="ViewBag.lstEmp" ejs-for="EmpSysId" filterBarPlaceholder="Search" allowFiltering="true" filterType="Contains">
                        <e-dropdownlist-fields text="FulNme" value="ESysId"></e-dropdownlist-fields>
                    </ejs-dropdownlist>
                </div>
            </div>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-12">
            <label asp-for="RstId" class="control-label"></label>
            <ejs-dropdownlist id="drpRstTyp" placeholder="Select Roster" dataSource="ViewBag.lstRstrs" ejs-for="RstId" filterBarPlaceholder="Search" allowFiltering="true">
                <e-dropdownlist-fields text="NameEng" value="RstId"></e-dropdownlist-fields>
            </ejs-dropdownlist>
            <span asp-validation-for="RstId" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group  col-md-6">
            <label asp-for="StDate" class="control-label"></label>
            <input asp-for="StDate" class="form-control form-control-sm" />
            <span asp-validation-for="StDate" class="text-danger"></span>
        </div>
        <div class="form-group  col-md-6">
            <label>
                End Date
                <input type="checkbox" id="chkEndDate" onclick="enableEndDate()" class="e-left mycheckbox" >
            </label>
            <input id="dtpEndDate" asp-for="EndDate" class="form-control form-control-sm" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group col-md-6">
            <label>
                Skip Roster Validation
                <input type="checkbox" data-ng-model="rememberMe" asp-for="SkpRstVldtn" class="pull-right mycheckbox">
            </label>

        </div>
        <div class="form-group col-md-6">
            <label>
                Consider for Attendance
                <input type="checkbox" data-ng-model="rememberMe" asp-for="CndrAtndc" class="pull-right mycheckbox">
            </label>
            <span asp-validation-for="CndrAtndc" class="text-danger"></span>
        </div>
    </div>

        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-sm btn-primary btn-block" />
            @*<input type="button" value="Test" class="btn btn-sm btn-outline-primary btn-block" onclick="listTestFunc();"/>*@
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>

        }

        <script>

            $(document).ready(function () {
                showReProcessOptions();
            });

            function showReProcessOptions() {
                var chkAllEmp = document.getElementById("chkAllEmp");
                var chkSlctdEmp = document.getElementById("chkSlctdEmp");
                var dvEmp = document.getElementById("dvEmp");

                if (chkAllEmp.checked == true) {
                    dvEmp.style.display = "none";
                    $('#txtempTyp').val('A');
                }
                else if (chkSlctdEmp.checked == true) {
                    dvEmp.style.display = "block";
                    $('#txtempTyp').val('S');
                }
            }

            function enableEndDate() {
                var chkEndDate = document.getElementById("chkEndDate");
                var dtpEndDate = document.getElementById("dtpEndDate");

                if (chkEndDate.checked == true) {
                    dtpEndDate.style.display = "block";
                }
                else {
                    dtpEndDate.style.display = "none";
                }
            }


            $('form').each(function () {
                $(this).submit(function (e) {
                    var ref = 0;
                    var drpEmp = document.getElementById('drpEmp').ej2_instances[0];


                    if (chkAllEmp.checked == true) {
                        empTyp = 'A';
                        ref = 0;
                    }
                    else if (chkSlctdEmp.checked == true) {
                        empTyp = 'S';
                        ref = drpEmp.value;
                    }

                    if (empTyp = 'S' && ref == null) {
                        toastObj.show(toasts[4]);
                        return false;
                    }

                    else {
                        return true;
                    }
                });
            });


        </script>
        <!--Start Toast Start-->
        <script type="text/javascript">

            var toastObj;
            var toasts = [
                { title: 'Success!', content: 'Record Added Successfully', cssClass: 'e-toast-success', icon: 'e-success toast-icons' },
                { title: 'Success!', content: 'Record Deleted Successfully', cssClass: 'e-toast-success', icon: 'e-success toast-icons' },
                { title: 'Error!', content: 'Adding record got failed', cssClass: 'e-toast-danger', icon: 'e-error toast-icons' },
                { title: 'Error!', content: 'Deleting record got failed', cssClass: 'e-toast-danger', icon: 'e-error toast-icons' },
                { title: 'Warning!', content: 'Please choose one or more employees', cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' }]

            var btnEleHide = document.getElementById('hideToast');

            setTimeout(
                () => {
                    toastObj.show({
                        target: document.body
                    });
                }, 500);

            function created() {
                toastObj = this;
            }


            function onclose(e) {
                if (e.toastContainer.childElementCount === 0) {
                    btnEleHide.style.display = 'none';
                }
            }
            function onBeforeOpen() {
                btnEleHide.style.display = 'inline-block';
            }
        </script>

        <style>
            @@font-face {
                font-family: 'Toast_icons';
                src: url(data:application/x-font-ttf;charset=utf-8;base64,) format('truetype');
                font-weight: normal;
                font-style: normal;
            }

            #toast_types button {
                margin: 5px;
                min-width: 160px;
                max-width: 160px;
            }

            .toast-icons {
                font-family: 'Toast_icons' !important;
                speak: none;
                font-size: 55px;
                font-style: normal;
                font-weight: normal;
                font-variant: normal;
                text-transform: none;
                line-height: 1;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            #toast_type .e-toast-icon.e-icons {
                height: auto;
                font-size: 30px;
            }

            .toast-icons.e-success::before {
                content: "\e701";
            }

            .toast-icons.e-error::before {
                content: "\e700";
            }

            .toast-icons.e-info::before {
                content: "\e704";
            }

            .toast-icons.e-warning::before {
                content: "\e703";
            }
        </style>
        <!--End Toast End-->

        <script type="text/javascript">
            $(function () {
                $('#modalCreate').on('shown.bs.modal', function () {
                    $(document).off('focusin.modal');
                });
            });
        </script>
        <ejs-scripts></ejs-scripts>

