@model qHRM.Areas.WorkShift.Models.HrEmpWkRoster

<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Edit", "HrEmpWkRoster"))
{
    <span class="alert-success">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            @Html.HiddenFor(model => model.RecId)
            <label asp-for="EmpSysId" class="control-label"></label>
            <select asp-for="EmpSysId" id="drpEmployeeE" class="form-control form-control-sm select2-dropdown"
                    asp-items="@(new SelectList(ViewBag.lstEmp, "ESysId", "FulNme", Model?.EmpSysId))">
                <option value="">-- Select Employee --</option>
            </select>
            <span asp-validation-for="EmpSysId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="RstId" class="control-label"></label>
            <select asp-for="RstId" id="drpRstTypE" class="form-control form-control-sm select2-dropdown"
                    asp-items="@(new SelectList(ViewBag.lstRstrs, "RstId", "NameEng", Model?.RstId))">
                <option value="">-- Select Roster --</option>
            </select>
            <span asp-validation-for="RstId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="StDate" class="control-label"></label>
            <input asp-for="StDate" class="form-control form-control-sm" />
            <span asp-validation-for="StDate" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="EndDate" class="control-label"></label>
            <input asp-for="EndDate" class="form-control form-control-sm" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>        

        <div class="form-group col-md-6">
            <label>
               Consider for Attendance
                <input type="checkbox" data-ng-model="rememberMe" asp-for="CndrAtndc" class="pull-right mycheckbox">
            </label>
            <span asp-validation-for="CndrAtndc" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}

<script>
    $(function () {
        $('#modalEdit').find('.select2-dropdown').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalEdit')
        });

        $('#modalEdit').find('.select2-dropdown').on('change', function () {
            try { $(this).valid(); } catch (e) { }
        });
    });
</script>
