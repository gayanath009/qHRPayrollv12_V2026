@model qHRM.Areas.Employee.Models.HrEmpProbation
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

@using (Html.BeginForm("Edit", "HrEmpProbation"))
{
    <span class="alert-success ">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger">
            <input asp-for="EmpSysId" />
        </div>
        @Html.HiddenFor(model => model.ProbId)

        <div class="card-body">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="StDate" class="control-label"></label>                    
                    <input asp-for="StDate" class="form-control form-control-sm" />
                    <span asp-validation-for="StDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="EndDate" class="control-label"></label>                    
                    <input asp-for="EndDate" class="form-control form-control-sm" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6"></div>
            </div>
            <div class="form-check">
                <input type="checkbox" asp-for="IsExtended" class="form-check-input" id="chkIsExtended">
                <label class="form-check-label" for="chkSalaryAcct">Extended</label>
            </div>
            <div class="form-row">
                <div class="form-group col-md-12">
                    <label asp-for="Note" class="control-label"></label>
                    <input asp-for="Note" class="form-control form-control-sm" />
                </div>
            </div>
        </div>
        <div class="form-group">
            @if (ViewBag.RecAdd == true)
            {
                <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            }
                <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
            </div>
    </div>
}
<ejs-scripts></ejs-scripts>

