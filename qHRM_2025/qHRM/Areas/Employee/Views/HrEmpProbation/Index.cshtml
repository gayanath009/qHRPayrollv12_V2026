@model qHRM.Areas.Employee.Models.HrEmpProbation
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor

<div>
    <main>
        <div class="container-fluid">
            <h4 class="mt-4">Probation Periods</h4>
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item"><a href="/Employee/HrEmpGenInfo/HrEmpGenInfo_EditGet?id=@HttpContextAccessor.HttpContext.Session.GetInt32("EmpSysId")">Employee Information</a></li>
                <li class="breadcrumb-item active">Probation Periods  (@HttpContextAccessor.HttpContext.Session.GetString("EmpName"))</li>
            </ol>
            <div class="card mb-4">
                <div class="card-body">
                    <div id="tabs">
                        <!--Start Tabs Start-->
                        <partial name="~/Views/Shared/_EmpNavBar.cshtml" />
                        <br/>
                        <!--End Tabs End-->
                        <!--Grid-->
                        <div class="card-body">
                            <p>
                                <div class="form-row">
                                    <div>
                                        @if (ViewBag.RecAdd == true)
                                        {
                                            <a href="#" class="btn btn-sm btn-primary" id="btnCreate" onclick="createFunc(@ViewBag.EmpSysId);">
                                                Create New Period
                                            </a>
                                        }
                                    </div>
                                    <div>&nbsp;&nbsp;</div>
                                    <div>
                                        @if (ViewBag.RecEdit == true)
                                        {
                                            <a href="#" class="btn btn-sm btn-primary" id="btnClose" onclick="closeFunc(@ViewBag.EmpSysId);">
                                                Close Current Period
                                            </a>
                                        }
                                    </div>
                                </div>


                            </p>
                            <!--Grid-->
                            <div class="control-section">
                                <ejs-grid id="Grid" width="auto" dataSource="@ViewBag.DataSource" allowPaging="true" allowGrouping=" true" allowFiltering="true"
                                          allowExcelExport="true" allowPdfExport="true" toolbarClick="toolbarClick" toolbar="@(new List<string>() {"ExcelExport"} )">
                                    <e-grid-filterSettings type="CheckBox"></e-grid-filterSettings>
                                    <e-grid-pagesettings pageCount=5></e-grid-pagesettings>
                                    <e-grid-columns>
                                        <e-grid-column field="StDate" headerText="Assigned Date" width="50" format='yMd'></e-grid-column>
                                        <e-grid-column field="EndDate" headerText="End Date" width="50" format='yMd'></e-grid-column>
                                        <e-grid-column field="WkStatName" headerText="Status" width="50"></e-grid-column>
                                        <e-grid-column field="Extended" headerText="Extended" width="50"></e-grid-column>
                                        @if (ViewBag.RecEdit == true)
                                        {
                                            <e-grid-column field="" headerText="" template="#_edit" width="60"></e-grid-column>
                                        }
                                    </e-grid-columns>
                                </ejs-grid>
                            </div>
                            <!--Grid-->
                            <!--Create-->
                            <div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                <div class="modal-dialog modal-xl" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalLongTitle">New Probation</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body" id="createModalBody">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--Create-->
                            <!--Edit-->
                            <div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                <div class="modal-dialog modal-xl" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalLongTitle">Close On-Going Probation Period</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Cancel">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body" id="editModalBody">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--Edit-->
                        </div>
                        <!--Grid-->
                    </div>
                </div>
            </div>
    </main>
</div>

<!--Command Buttons-->
<script type="text/x-jsrender" id="_edit">
    <a href="#" class="btn btn-sm btn-primary btn-block" onclick="editFunc(${ProbId})">
        <span class="glyphicon glyphicon-pencil"></span>
    </a>
</script>
<!--Command Buttons-->
<!--Open Partial Views-->
<script>
    var createFunc = function (empSysId) {
        var url = "/Employee/HrEmpProbation/CreateNew?empSysId=" + empSysId;
        $("#createModalBody").load(url, function () {
            $("#modalCreate").modal("show");
        })
    }

    var editFunc = function (probId) {
        var url = "/Employee/HrEmpProbation/EditGet?probId=" + probId;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
        })
    }
</script>
<!--Open Partial Views-->

<script>
    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];

        if (args.item.id === 'Grid_excelexport') {
            gridObj.excelExport();
        }
    }
</script>