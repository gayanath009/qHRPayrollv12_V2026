@model qHRM.Areas.Employee.Models.HrEmpBankAcct
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Edit", "HrEmpBankAcct"))
{
    <span class="alert-success ">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.AcctId)
        @Html.HiddenFor(model => model.RecStat)
        <div class="form-row">
            <div class="form-group col-md-6">
                <input asp-for="EmpSysId" hidden />
                <input asp-for="ex_AcctNo" hidden />
                <label asp-for="AcctNo" class="control-label"></label>
                <input asp-for="AcctNo" class="form-control" />
                <span asp-validation-for="AcctNo" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="AcctName" class="control-label"></label>
                <input asp-for="AcctName" class="form-control" />
                <span asp-validation-for="AcctName" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="AcctType" class="control-label"></label>
                <select asp-for="AcctType" id="drpAcctTypeE" class="form-control select2-dropdown"
                        asp-items="@(new SelectList(ViewBag.lstAcctTyp, "ElmntTxt", "ElmntTxt", Model?.AcctType))">
                    <option value="">-- Select Account Type --</option>
                </select>
                <span asp-validation-for="AcctType" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Iban" class="control-label"></label>
                <input asp-for="Iban" class="form-control" />
                <span asp-validation-for="Iban" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="BankName" class="control-label"></label>
                <input asp-for="BankName" class="form-control" />
                <span asp-validation-for="BankName" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="BranchName " class="control-label"></label>
                <input asp-for="BranchName" class="form-control" />
                <span asp-validation-for="BranchName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="OpndDate" class="control-label"></label>
                <input asp-for="OpndDate" class="form-control" />
                <span asp-validation-for="OpndDate" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group col-md-12">
            <label>
                Salary Account
                <input type="checkbox" data-ng-model="rememberMe" asp-for="SlryAcct" class="pull-right mycheckbox">
            </label>
            <span asp-validation-for="SlryAcct" class="text-danger"></span>
        </div>
        <div class="form-group">
            @if (ViewBag.RecEdit == true)
            {
                <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            }
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}

<script>
    $(function () {
        $('#modalEdit').find('.select2-dropdown').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalEdit')
        });

        $('#modalEdit').find('.select2-dropdown').on('change', function () {
            try { $(this).valid(); } catch (e) { }
        });
    });
</script>
