@model qHRM.Areas.Employee.Models.HrEmpPhoto
<h5>Are you sure you want to delete this?</h5>
@using (Html.BeginForm("Delete", "HrEmpPhoto"))
{<div>
    @Html.HiddenFor(model => model.PhtId)
    @Html.HiddenFor(model => model.EmpSysId)
    <div class="form-group">
        @Html.DisplayNameFor(model => model.Note) : @Html.DisplayFor(model => model.Note)
    </div>
    <div class="form-group">
        @Html.DisplayNameFor(model => model.CrtDateTime) : @Html.DisplayFor(model => model.CrtDateTime)
    </div>
    @if (ViewBag.RecDelete == true)
    {
        <input type="submit" value="Delete" class="btn btn-sm  btn-danger" />
    }
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary" data-dismiss="modal" />
    </div>
}