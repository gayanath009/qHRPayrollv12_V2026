@model qHRM.Areas.Employee.Models.HrEmpJobAssign
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
<div>
    <main>
        <div class="container-fluid">
            <h4 class="mt-4">Job Assignments</h4>
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item"><a href="/Employee/HrEmpGenInfo/HrEmpGenInfo_EditGet?id=@HttpContextAccessor.HttpContext.Session.GetInt32("EmpSysId")">Employee Information</a></li>
                <li class="breadcrumb-item active">Job Assignments (@HttpContextAccessor.HttpContext.Session.GetString("EmpName"))</li>
            </ol>
            <div class="card mb-4">
                <div class="card-body">
                    <div id="tabs">
                        <!--Start Tabs Start-->
                        <partial name="~/Views/Shared/_EmpNavBar.cshtml" />
                        <br />
                        <!--End Tabs End-->
                        <!--Grid-->
                        <div class="card-body">
                            <p>
                                <div>
                                    @if (ViewBag.RecAdd == true)
                                    {
                                        <a href="#" class="btn btn-sm btn-primary" id="btnCreate" onclick="createFunc(@ViewBag.EmpSysId);">
                                            Create New Assignment
                                        </a>
                                    }
                                </div>
                            </p>

                            <!--Grid-->
                            <div class="control-section">
                                <ejs-grid id="Grid" width="auto" dataSource="ViewBag.DataSource" load="loadFormattings" allowPaging="true" allowGrouping=" true" allowFiltering="true"
                                          l allowExcelExport="true" allowPdfExport="true" toolbarClick="toolbarClick" toolbar="@(new List<string>() {"ExcelExport"} )">
                                    <e-grid-filterSettings type="CheckBox"></e-grid-filterSettings>
                                    <e-grid-pagesettings pageCount=5></e-grid-pagesettings>
                                    <e-grid-columns>
                                        <e-grid-column field="StDate" headerText="Assigned Date" width="70" format='yMd'></e-grid-column>
                                        <e-grid-column field="EndDate" headerText="End Date" width="70" format='yMd'></e-grid-column>
                                        <e-grid-column field="DeptName" headerText="Department" width="100"></e-grid-column>
                                        <e-grid-column field="DesigName" headerText="Designation" width="100"></e-grid-column>
                                        <e-grid-column field="RptMngName" headerText="Reporting to" width="100"></e-grid-column>
                                        <e-grid-column field="EmpTypName" headerText="Type" width="70"></e-grid-column>
                                        <e-grid-column field="WkStatName" headerText="Status" width="60"></e-grid-column>
                                        @if (ViewBag.RecEdit == true)
                                        {
                                            <e-grid-column field="" headerText="" template="#_edit" width="60"></e-grid-column>
                                        }                                        
                                    </e-grid-columns>
                                </ejs-grid>
                            </div>
                            <!--Grid-->
                            <!--Create-->
                            <div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                <div class="modal-dialog modal-xl" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalLongTitle">New Assignment</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body" id="createModalBody">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--Create-->
                            <!--Edit-->
                            <div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                <div class="modal-dialog modal-xl" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="exampleModalLongTitle">Edit Assignment</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body" id="editModalBody">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--Edit-->


                        </div>
                        <!--Grid-->
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script type="text/x-jsrender" id="_edit">
    <a href="#" class="btn btn-sm btn-primary btn-block" onclick="editFunc(${JbAsngId})">
        <span class="glyphicon glyphicon-pencil"></span>
    </a>
</script>

<!--Open Partial Views-->
<script>
    var createFunc = function (empSysId) {
        var url = "/Employee/HrEmpJobAssign/CreateNew?empSysId=" + empSysId;
        $("#createModalBody").load(url, function () {
             $("#modalCreate").modal("show");           
        })
    }

    var editFunc = function (jbAsngId) {
        var url = "/Employee/HrEmpJobAssign/EditGet?jbAsngId=" + jbAsngId;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
            
        })
    }
</script>
<!--Open Partial Views-->

<script>
    var flValInput;
    var daterangepicker;
    function loadFormattings() {
        var grid = document.getElementsByClassName('e-grid')[0].ej2_instances[0];
        this.columns[0].format = { type: 'date', format: 'dd/MM/yyyy' };
        this.columns[1].format = { type: 'date', format: 'dd/MM/yyyy' };
    }
    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];

        if (args.item.id === 'Grid_excelexport') {
            gridObj.excelExport();
        }
    }
</script>