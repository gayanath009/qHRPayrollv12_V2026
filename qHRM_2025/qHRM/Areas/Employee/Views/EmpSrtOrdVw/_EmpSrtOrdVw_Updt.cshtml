@model qHRM.Areas.Employee.Models.EmpSrtOrdVw

@using (Html.BeginForm("Update", "EmpSrtOrdVw", FormMethod.Post))
{
    <div>
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.EmpSysId)
        @Html.HiddenFor(model => model.DeptId)
        @Html.HiddenFor(model => model.DeptSrtOrd)
        <div class="form-group row mb-2">
            <label class="col-sm-5 font-weight-bold">Department:</label>
            <div class="col-sm-7">@Html.DisplayFor(model => model.DeptName)</div>
        </div>
        <div class="form-group row mb-2">
            <label class="col-sm-5 font-weight-bold">Designation:</label>
            <div class="col-sm-7">@Html.DisplayFor(model => model.DesigName)</div>
        </div>
        <div class="form-group row mb-2">
            <label class="col-sm-5 font-weight-bold">Employee ID:</label>
            <div class="col-sm-7">@Html.DisplayFor(model => model.EmpId)</div>
        </div>
        <div class="form-group row mb-2">
            <label class="col-sm-5 font-weight-bold">Employee Name:</label>
            <div class="col-sm-7 font-weight-bold">@Html.DisplayFor(model => model.EmpName)</div>
        </div>
        <div class="form-group row mb-2">
            <label class="col-sm-5 font-weight-bold">Current Sort Order:</label>
            <div class="col-sm-7 text-primary font-weight-bold">@Html.DisplayFor(model => model.EmpSrtOrd)</div>
        </div>
        <div class="form-group row mb-2">
            <label class="col-sm-5 font-weight-bold">Dept Sort Prefix:</label>
            <div class="col-sm-7 text-muted">@Html.DisplayFor(model => model.DeptSrtOrd)</div>
        </div>
        <div class="form-group">
            <label asp-for="ex_EmpSrtOrd" class="control-label font-weight-bold">New Order within Department (e.g. 1, 2, 6...):</label>
            <input asp-for="ex_EmpSrtOrd" class="form-control form-control-sm font-weight-bold" type="number" min="1" max="999999" />
            <span asp-validation-for="ex_EmpSrtOrd" class="text-danger"></span>
        </div>

        <div class="form-row mt-3">
            <div class="col-6">
                <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            </div>
            <div class="col-6">
                <input type="button" value="Cancel" class="btn btn-sm btn-outline-secondary btn-block" data-dismiss="modal" />
            </div>
        </div>
    </div>
}