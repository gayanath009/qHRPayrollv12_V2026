@model qHRM.Areas.Employee.Models.HrEmpResidInfo
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

<form asp-action="Create" asp-controller="HrEmpResidInfo" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="ResidType" class="control-label"></label>
            <select asp-for="ResidType" id="drpTitle" class="form-control form-control-sm select2-dropdown"
                    asp-items="@(new SelectList(ViewBag.lstRestype, "ElmntTxt", "ElmntTxt"))">
                <option value="">-- Select Title --</option>
            </select>
            <span asp-validation-for="ResidType" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="PropNo" class="control-label"></label>
            <input asp-for="PropNo" class="form-control form-control-sm" />
            <span asp-validation-for="PropNo" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="BldNo" class="control-label"></label>
            <input asp-for="BldNo" class="form-control form-control-sm" />
            <span asp-validation-for="BldNo" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="Strt" class="control-label"></label>
            <input asp-for="Strt" class="form-control form-control-sm" />
            <span asp-validation-for="Strt" class="text-danger"></span>
        </div>

        <div class="form-group col-md-4">
            <label asp-for="Area" class="control-label"></label>
            <input asp-for="Area" class="form-control form-control-sm" />
            <span asp-validation-for="Area" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="State" class="control-label"></label>
            <input asp-for="State" class="form-control form-control-sm" />
            <span asp-validation-for="State" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="CntryId" class="control-label"></label>
            <select asp-for="CntryId" id="drpCntry" class="form-control form-control-sm select2-dropdown"
                    asp-items="@(new SelectList(ViewBag.lstCntry, "CntryId", "CntryNameEng"))">
                <option value="">-- Select Country --</option>
            </select>
            <span asp-validation-for="CntryId" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="TelNo" class="control-label"></label>
            <input asp-for="TelNo" class="form-control form-control-sm" />
            <span asp-validation-for="TelNo" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="MobNo" class="control-label"></label>
            <input asp-for="MobNo" class="form-control form-control-sm" />
            <span asp-validation-for="MobNo" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="InDate" class="control-label"></label>
            <input asp-for="InDate" value="@ViewBag.Today" class="form-control form-control-sm" />
            <span asp-validation-for="InDate" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <input type="checkbox" asp-for="IsToDate" class="form-check-input" id="chkIsToDate" style="margin-top:25px; margin-left:15px;">
            <label class="form-check-label" for="chkIsToDate" style="margin-top:35px; margin-left:15px;">Till Date</label>
            <span asp-validation-for="IsToDate" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="OutDate" class="control-label"></label>
            <input id="txtOutDate" value="@ViewBag.Today" asp-for="OutDate" class="form-control form-control-sm" />
            <span asp-validation-for="OutDate" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-md-12">
            <label asp-for="Note" class="control-label"></label>
            <input asp-for="Note" class="form-control form-control-sm" />
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        @if (ViewBag.RecAdd == true)
        {
            <input type="submit" value="Save" class="btn btn-primary btn-block" />
        }
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
    </div>
</form>

<script>
    $('#chkIsToDate').change(function (e) {
        if (this.checked) {            
            $('#txtOutDate').attr("disabled", true);
        }
        else {            
            $('#txtOutDate').attr("disabled", false);
        }        
    });

    $(function () {
        $('#modalCreate').find('.select2-dropdown').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalCreate')
        });

        $('#modalCreate').find('.select2-dropdown').on('change', function () {
            try { $(this).valid(); } catch (e) { }
        });
    });
</script>