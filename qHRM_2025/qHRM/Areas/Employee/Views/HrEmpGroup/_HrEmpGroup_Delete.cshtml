@model qHRM.Areas.Employee.Models.HrEmpGroup
<h5>Are you sure you want to delete this?</h5>
@using (Html.BeginForm("Delete", "HrEmpGroup"))
{<div>
    @Html.HiddenFor(model => model.GrpId)
    <div class="form-group">
        @Html.DisplayNameFor(model => model.TitleEng) : @Html.DisplayFor(model => model.TitleEng)
    </div>
    <div class="form-group">
        @Html.DisplayNameFor(model => model.DescEng) : @Html.DisplayFor(model => model.DescEng)
    </div>

    @if (ViewBag.RecDelete == true)
    {
        <input type="submit" value="Delete" class="btn btn-sm  btn-danger" />
    }
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary" data-dismiss="modal" />
    </div>
}