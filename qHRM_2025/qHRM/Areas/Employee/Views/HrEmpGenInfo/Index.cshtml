@using Syncfusion.EJ2
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --org-primary: #540033;
        --org-primary-hover: #3e0026;
        --org-primary-light: #fdf2f8;
        --org-primary-border: #fbcfe8;
        --clr-bg: #f7fafc;
        --clr-surface: #ffffff;
        --clr-border: rgba(2,6,23,0.06);
        --clr-text: #0f172a;
        --clr-muted: #475569;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
    }

    .org-page-container {
        padding: 0.75rem 0.5rem 1.5rem 0.5rem;
    }

    /* Compact Header Card */
    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border);
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--clr-text);
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: var(--org-primary-light);
        color: var(--org-primary);
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid var(--org-primary-border);
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: var(--clr-muted);
        margin-top: 0.15rem;
        line-height: 1.2;
    }
    .org-breadcrumb a {
        color: var(--clr-muted);
        text-decoration: none;
        transition: color 0.15s;
    }
    .org-breadcrumb a:hover {
        color: var(--org-primary);
    }

    /* Create Button */
    .org-btn-create {
        background: linear-gradient(135deg, #540033 0%, #750047 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: var(--radius-sm) !important;
        padding: 0.45rem 1rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.01em !important;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease !important;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.25) !important;
        text-decoration: none !important;
    }

    .org-btn-create:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(84, 0, 51, 0.35) !important;
        color: #ffffff !important;
    }

    .org-btn-create:active {
        transform: translateY(0);
    }

    /* Action Buttons in Grid */
    .org-actions-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .org-action-btn {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        transition: all 0.15s ease;
        text-decoration: none !important;
        cursor: pointer;
        font-size: 0.75rem;
        padding: 0;
        outline: none;
    }

    .org-action-edit {
        background: #fdf2f8;
        color: var(--org-primary);
        border-color: #fbcfe8;
    }

    .org-action-edit:hover {
        background: var(--org-primary);
        color: #ffffff !important;
        border-color: var(--org-primary);
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(84, 0, 51, 0.25);
    }

    .org-action-delete {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .org-action-delete:hover {
        background: #dc2626;
        color: #ffffff !important;
        border-color: #dc2626;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);
    }

    /* Modern Modals */
    .org-modal .modal-content {
        border: 1px solid var(--clr-border) !important;
        border-radius: var(--radius) !important;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.2) !important;
        overflow: hidden;
    }

    .org-modal .modal-header {
        background: linear-gradient(135deg, #540033 0%, #3b0024 100%) !important;
        color: #ffffff !important;
        padding: 1rem 1.25rem !important;
        border-bottom: none !important;
    }

    .org-modal .modal-header .modal-title {
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        display: flex;
        align-items: center;
    }

    .org-modal .modal-header .close {
        color: #ffffff !important;
        opacity: 0.8 !important;
        text-shadow: none !important;
        transition: opacity 0.15s !important;
        outline: none !important;
    }

    .org-modal .modal-header .close:hover {
        opacity: 1 !important;
    }

    .org-modal-delete .modal-header {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%) !important;
    }
</style>

<div class="org-page-container">
    <main>
        <div class="container-fluid px-0">

            <!-- COMPACT HERO HEADER -->
            <div class="org-hero-card">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
                    <div class="d-flex align-items-center">
                        <div class="org-icon-badge mr-3">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                                <h1 class="org-title">Employee Profile Directory</h1>
                                <span class="badge org-category-pill">EMPLOYEE</span>
                            </div>
                            <div class="org-breadcrumb">
                                <a href="#">Human Resource</a> / <span class="text-dark font-weight-medium">Employee</span>
                                <span class="text-muted mx-1">&bull;</span>
                                <span class="text-muted">Manage workforce profiles, employment details, and visa credentials</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                     @if (ViewBag.RecAdd == true)
                     {
                        <a href="/Employee/HrEmpGenInfo/HrEmpGenInfo_CreateNew" class="btn org-btn-create" id="btnCreate">
                            <i class="fas fa-plus-circle mr-1"></i> Create New
                        </a>
                     }
                    </div>
                </div>
            </div>

            <!-- Main Grid Card -->
            <div class="card mb-4">
                <div class="card-body">
                    <!--Grid-->
                    <div class="control-section">
                        <ejs-grid id="Grid" width="auto" dataSource="@ViewBag.DataSource" actionBegin="actionBegin" actionComplete="actionComplete" dataBound="onDataBound" allowPaging="true" allowGrouping="true"
                                  allowResizing="true" allowFiltering="true" allowSorting="true"
                                  allowExcelExport="true" allowPdfExport="true" toolbarClick="toolbarClick" toolbar="@(new List<string>() {"ExcelExport"} )"
                                  load="loadFormattings">
                            <e-grid-filterSettings type="Excel"></e-grid-filterSettings>
                            <e-grid-pagesettings pageCount=5></e-grid-pagesettings>
                            <e-grid-columns>
                                <e-grid-column field="" headerText=" " width="65" template="#_avatar" textAlign="Center"></e-grid-column>
                                <e-grid-column field="EmpId" headerText="Emp ID" width="110" template="#itemTemplate"></e-grid-column>
                                <e-grid-column field="Title" headerText="Title" width="80"></e-grid-column>
                                <e-grid-column field="FullName" headerText="Full Name" width="180"></e-grid-column>
                                <e-grid-column field="DeptName" headerText="Department" width="140"></e-grid-column>
                                <e-grid-column field="DesigName" headerText="Designation" width="140"></e-grid-column>
                                <e-grid-column field="Ex_JindDtTxt" headerText="Joined Date" width="115"></e-grid-column>
                                <e-grid-column field="SrvcInYrs" headerText="Service Yrs" width="105"></e-grid-column>
                                <e-grid-column field="Ex_DobTxt" headerText="DoB" width="115"></e-grid-column>
                                <e-grid-column field="Ex_Age" headerText="Age" width="80"></e-grid-column>                                
                                <e-grid-column field="NltyName" headerText="Nationality" width="120"></e-grid-column>                                
                                <e-grid-column field="PmtTyp" headerText="Permit Type" width="120"></e-grid-column>
                                <e-grid-column field="PmtId" headerText="QID/Visa" width="120"></e-grid-column>
                                <e-grid-column field="PmtExpDate" headerText="QID Exp Date" width="125"></e-grid-column>
                                <e-grid-column field="PstNo" headerText="Passport" width="130"></e-grid-column>
                                <e-grid-column field="PstExpDate" headerText="PP Exp Date" width="125"></e-grid-column>
                                <e-grid-column field="CurStatTxt" headerText="Status" width="110"></e-grid-column>
                                <e-grid-column field="WrkTypName" headerText="Work Type" width="120"></e-grid-column>                                
                                <e-grid-column field="" headerText="Actions" template="#_actions" width="110" textAlign="Center"></e-grid-column>
                            </e-grid-columns>
                        </ejs-grid>
                    </div>
                    <!--Grid-->
                </div>
            </div>

            <!-- MODALS -->
            <!--Delete-->
            <div class="modal fade org-modal org-modal-delete" id="modalDelete" tabindex="-1" role="dialog" aria-labelledby="modalDeleteTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalDeleteTitle">
                                <i class="fas fa-exclamation-triangle mr-2"></i> Deactivate Employee
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="deleteModalBody">
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<!-- JSRENDER TEMPLATES -->
<script type="text/x-jsrender" id="_avatar">
    <img class="img-profile rounded-circle" style="width: 32px; height: 32px; object-fit: cover; border: 1px solid #e2e8f0;" src="@Url.Content("~/attach/empImages/${PhotoName}")" onerror="this.onerror=null;this.src='@Url.Content("~/attach/empImages/user.png")';" />
</script>

<script id="itemTemplate" type="text/x-template">
    <div>
        <a rel='nofollow' class="text-primary font-weight-bold" href="/Employee/HrEmpGenInfo/HrEmpGenInfo_EditGet?id=${EmpSysId}">${EmpId}</a>
    </div>
</script>

<script type="text/x-jsrender" id="_actions">
    <div class="org-actions-wrapper">
        <a href="/Employee/HrEmpGenInfo/HrEmpGenInfo_EditGet?id=${EmpSysId}" class="org-action-btn org-action-edit" title="Edit Employee">
            <i class="fas fa-pen"></i>
        </a>
        <button type="button" class="org-action-btn org-action-delete" onclick="deleteFunc(${EmpSysId})" title="Deactivate Employee">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>
</script>

<!-- Backward Compatibility Templates -->
<script type="text/x-jsrender" id="_edit">
    <a href="/Employee/HrEmpGenInfo/HrEmpGenInfo_EditGet?id=${EmpSysId}" class="org-action-btn org-action-edit" title="Edit">
        <i class="fas fa-pen"></i>
    </a>
</script>
<script type="text/x-jsrender" id="_delete">
    <button type="button" class="org-action-btn org-action-delete" onclick="deleteFunc(${EmpSysId})" title="Delete">
        <i class="fas fa-trash-alt"></i>
    </button>
</script>

<!-- Scripts -->
<script>
    var deleteFunc = function (id) {
        var url = "/Employee/HrEmpGenInfo/HrEmpGenInfo_DeleteGet?id=" + id;
        $("#deleteModalBody").load(url, function () {
            $("#modalDelete").modal("show");
        });
    };

    function filterByWrkType(val) {
        var grid = document.getElementById("Grid").ej2_instances[0];
        if (!grid) return;
        if (val === "" || val === null) {
            grid.removeFilteredColsByField("WrkTypName");
        } else {
            grid.filterByColumn("WrkTypName", "equal", val);
        }
    }

    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];

        if (args.item.id === 'Grid_excelexport') {
            gridObj.excelExport();
        }
    }

    // Immediately clear any corrupted grid state leftover from previous sessions
    try {
        sessionStorage.removeItem('HrEmpGenInfo_GridState');
    } catch (e) { }

    // Date Range Search for Created Date
    var flValInput;
    var daterangepicker;
    var customFilter = false;
    var startDate = null;
    var endDate = null;

    function loadFormattings() {
        var grid = document.getElementsByClassName('e-grid')[0] ? document.getElementsByClassName('e-grid')[0].ej2_instances[0] : this;
        if (this.columns && this.columns.length > 13) {
            this.columns[13].format = { type: 'date', format: 'dd/MM/yyyy' };

            this.columns[13].filter = {
                type: "Menu",
                ui: {
                    create: (args) => {
                        flValInput = ej.base.createElement('input', { className: 'e-input' });
                        args.target.appendChild(flValInput);
                    },
                    write: (args) => {
                        daterangepicker = new ej.calendars.DateRangePicker({
                            change: function (e) {
                                var target = e.element;

                                if (e.value) {
                                    startDate = e.value[0];
                                    endDate = e.value[1];
                                    (startDate.toDateString() === endDate.toDateString()) ? customFilter = false : customFilter = true;
                                    (startDate.toDateString() === endDate.toDateString()) ? grid.filterByColumn('PmtExpDate', 'equal', startDate) : grid.filterByColumn('PmtExpDate', 'greaterthan', startDate);

                                }
                                else {
                                    grid.filterSettings.columns = [];
                                    grid.removeFilteredColsByField(target.id);
                                }
                            },
                        });
                        daterangepicker.appendTo(flValInput);
                    }
                },
            };
        }
    }

    var pageRestored = false;
    function onDataBound(args) {
        try {
            this.hideSpinner();
        } catch (e) { }

        if (!pageRestored) {
            pageRestored = true;
            try {
                var p = sessionStorage.getItem('HrEmpGenInfo_CurrentPage');
                if (p && parseInt(p) > 1) {
                    this.goToPage(parseInt(p));
                }
            } catch (e) { }
        }
    }

    function actionBegin(args) {
        if (args.requestType === "filtering" && args.currentFilteringColumn === "PmtExpDate" && customFilter) {
            customFilter = false;
            args.columns.push({ actualFilterValue: {}, actualOperator: {}, field: "PmtExpDate", ignoreAccent: false, isForeignKey: false, matchCase: false, operator: "lessthan", predicate: "and", uid: this.getColumnByField(args.currentFilteringColumn).uid, value: endDate });
        }

        if (args.requestType === "filtering" && args.currentFilteringColumn === "PstExpDate" && customFilter) {
            customFilter = false;
            args.columns.push({ actualFilterValue: {}, actualOperator: {}, field: "PstExpDate", ignoreAccent: false, isForeignKey: false, matchCase: false, operator: "lessthan", predicate: "and", uid: this.getColumnByField(args.currentFilteringColumn).uid, value: endDate });
        }
    }

    function actionComplete(args) {
        if (args.requestType === 'paging' && args.currentPage) {
            try {
                sessionStorage.setItem('HrEmpGenInfo_CurrentPage', args.currentPage);
            } catch (e) { }
        }
        try {
            this.hideSpinner();
        } catch (e) { }
    }
</script>