@model qHRM.Areas.Employee.Models.HrEmpGenInfo
<h5>Are you sure you want to delete this?</h5>
@using (Html.BeginForm("HrEmpGenInfo_Delete", "HrEmpGenInfo"))
{<div>
    @Html.HiddenFor(model => model.GrdId)
    <div class="form-group">
        @Html.DisplayNameFor(model => model.EmpId) : @Html.DisplayFor(model => model.EmpId)
    </div>
    <div class="form-group">
        @Html.DisplayNameFor(model => model.FirstName) : @Html.DisplayFor(model => model.FirstName)
    </div>
    <div class="form-group">
        @Html.DisplayNameFor(model => model.JoinedDate) : @Html.DisplayFor(model => model.JoinedDate)
    </div>

    @if (ViewBag.RecDelete == true)
    {
        <input type="submit" value="Delete" class="btn btn-sm  btn-danger" />
    }
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary" data-dismiss="modal" />

    </div>
}