@model qHRM.Areas.Employee.Models.HrEmpSponsor
<h5>Are you sure you want to delete this?</h5>
@using (Html.BeginForm("Delete", "HrEmpSponsor"))
{<div>
    @Html.HiddenFor(model => model.SpnsrId)
    <div class="form-group">
        @Html.DisplayNameFor(model => model.SpnsrType) : @Html.DisplayFor(model => model.SpnsrType)
    </div>
    <div class="form-group">
        @Html.DisplayNameFor(model => model.LbrCard) : @Html.DisplayFor(model => model.LbrCard)
    </div>
    @if (ViewBag.RecDelete == true)
    {
        <input type="submit" value="Delete" class="btn btn-sm  btn-danger" />
    }
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary" data-dismiss="modal" />
    </div>
}