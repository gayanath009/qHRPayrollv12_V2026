@model qHRM.Areas.Employee.Models.HrEmpPreExp
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

<form asp-controller="HrEmpPreExp" asp-action="Create" enctype="multipart/form-data">
    <span class="alert-success ">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.ExpId)
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="CompName" class="control-label"></label>
                <input asp-for="CompName" class="form-control form-control-sm" />
                <span asp-validation-for="CompName" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Position" class="control-label"></label>
                <input asp-for="Position" class="form-control form-control-sm" />
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-12">
                <label for="formControl">Attach Documents</label>
                <ejs-uploader id="fileUpload" autoUpload="false" maxFileSize="1000000"></ejs-uploader>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="StDate" class="control-label"></label>
                <input asp-for="StDate" value="@ViewBag.Today" class="form-control form-control-sm" />
                <span asp-validation-for="StDate" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="EndDate" class="control-label"></label>                
                <input asp-for="EndDate"  value="@ViewBag.Today" class="form-control form-control-sm" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            @if (ViewBag.RecAdd == true)
            {
                <input type="submit" value="Create" class="btn btn-sm btn-primary btn-block" />
            }
                <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
            </div>
    </div>
</form>
<ejs-scripts></ejs-scripts>

