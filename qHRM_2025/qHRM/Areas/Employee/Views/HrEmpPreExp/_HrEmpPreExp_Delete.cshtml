@model qHRM.Areas.Employee.Models.HrEmpPreExp
<h5>Are you sure you want to delete this?</h5>
@using (Html.BeginForm("Delete", "HrEmpPreExp"))
{<div>
        @Html.HiddenFor(model => model.ExpId)
        <div class="form-group">
            @Html.DisplayNameFor(model => model.CompName) : @Html.DisplayFor(model => model.CompName)
        </div>
        <div class="form-group">
            @Html.DisplayNameFor(model => model.Position) : @Html.DisplayFor(model => model.Position)
        </div>
        <div class="form-group">
            @Html.DisplayNameFor(model => model.StDate) : @Html.DisplayFor(model => model.StDate)
        </div>
        <div class="form-group">
            @Html.DisplayNameFor(model => model.EndDate) : @Html.DisplayFor(model => model.EndDate)
        </div>
        @if (ViewBag.RecDelete == true)
        {
            <input type="submit" value="Delete" class="btn btn-sm  btn-danger" />
        }
        <input type="button" value="Back" class="btn btn-sm btn-outline-primary" data-dismiss="modal" />
    </div>
}