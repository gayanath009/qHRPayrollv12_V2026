@model qHRM.Areas.Employee.Models.HrEmpCnfNtfLvl
@using Syncfusion.EJ2
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("CreateNtf", "HrEmpConfig"))
{
    <span class="alert-success">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.NtfLvlId)
        @Html.HiddenFor(model => model.EmpCnfId)
        @Html.HiddenFor(model => model.LwrBndryYrs)
    </div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group  col-md-4">
                <label asp-for="LwrBndryYrs" class="control-label"></label>
                <input asp-for="LwrBndryYrs" id="txtExpPmtAmt" class="form-control form-control-sm" style="text-align:right" disabled="disabled"/>
            </div>
            <div class="form-group  col-md-4">
                <label asp-for="UprBndryYrs" class="control-label"></label>
                <input asp-for="UprBndryYrs" class="form-control form-control-sm" style="text-align:right" />
                <span asp-validation-for="UprBndryYrs" class="text-danger"></span>
            </div>
            <div class="form-group  col-md-4">
                <label asp-for="EftDays" class="control-label"></label>
                <input asp-for="EftDays" class="form-control form-control-sm" style="text-align:right" />
                <span asp-validation-for="EftDays" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="Desc" class="control-label"></label>
                <input asp-for="Desc" class="form-control form-control-sm" />
                <span asp-validation-for="Desc" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group"></div>

        <div class="form-group">
            <input type="submit" value="Save" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}
<ejs-scripts></ejs-scripts>
