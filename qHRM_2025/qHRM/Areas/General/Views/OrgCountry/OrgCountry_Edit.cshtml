@model qHRM.Areas.General.Models.OrgCountry
@using Syncfusion.EJ2
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Edit", "OrgCountry"))
{
<div class="dl-horizontal">
    <span class="alert-success ">
        @Html.ValidationSummary(true)
    </span>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @Html.HiddenFor(model => model.CntryId)
    @Html.HiddenFor(model => model.RecStat)

    <div class="form-group">
        <label asp-for="CntryNameEng" class="control-label"></label>
        <input asp-for="ex_CntryNameEng" class="form-control form-control-sm" hidden />
        <input asp-for="CntryNameEng" class="form-control form-control-sm" />
        <span asp-validation-for="CntryNameEng" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Note" class="control-label"></label>
        <input asp-for="Note" class="form-control form-control-sm" />
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-sm btn-dark btn-block" />
        <input type="button" value="Close" class="btn btn-sm btn-primary btn-block" data-dismiss="modal" />
    </div>
</div>

}
<ejs-scripts></ejs-scripts>