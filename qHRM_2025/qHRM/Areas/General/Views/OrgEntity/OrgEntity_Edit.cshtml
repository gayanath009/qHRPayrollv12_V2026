@model qHRM.Areas.General.Models.OrgEntity
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Edit", "OrgEntity"))
{
<div class="dl-horizontal">
    <span class="alert-success ">
        @Html.ValidationSummary(true)
    </span>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @Html.HiddenFor(model => model.EntId)
    @Html.HiddenFor(model => model.RecStat)
    @Html.HiddenFor(model => model.CrtDateTime)

    <div class="form-group">
        <label asp-for="EntCode" class="control-label"></label>
        <input asp-for="ex_EntCode" class="form-control form-control-sm" hidden />
        <input asp-for="EntCode" class="form-control form-control-sm" />
        <span asp-validation-for="EntCode" class="text-danger"></span>
    </div>
    <div class="form-group">

        <label asp-for="NameEng" class="control-label"></label>
        <input asp-for="NameEng" class="form-control form-control-sm" />
        <span asp-validation-for="NameEng" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Desc" class="control-label"></label>
        <input asp-for="Desc" class="form-control form-control-sm" />
        <span asp-validation-for="Desc" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OrgId" class="control-label"></label>
        <input asp-for="OrgId" class="form-control form-control-sm" />
        <span asp-validation-for="OrgId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-sm btn-primary btn-block" />
        <input type="button" value="Close" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
    </div>
</div>

}


