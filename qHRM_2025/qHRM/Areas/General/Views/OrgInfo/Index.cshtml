@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orgList = ViewBag.DataSource as System.Collections.IEnumerable;
    int orgCount = 0;
    if (orgList != null)
    {
        foreach (var item in orgList) { orgCount++; }
    }
}

<style>
    /* ============================================================
       ORGANISATION PAGE COMPACT STYLING (Corporate Theme #540033)
       Grid and Card Layout matching /Payroll/HrPrSlryPrcDtl
       ============================================================ */

    :root {
        --org-primary: #540033;
        --org-primary-hover: #3e0026;
        --org-primary-light: #fdf2f8;
        --org-primary-border: #fbcfe8;
        --clr-bg: #f7fafc;
        --clr-surface: #ffffff;
        --clr-surface2: #f8fafc;
        --clr-border: rgba(2,6,23,0.06);
        --clr-text: #0f172a;
        --clr-muted: #475569;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
    }

    /* Page container */
    .org-page-container {
        padding: 0.75rem 0.5rem 1.5rem 0.5rem;
    }

    /* ─── Compact Header Card ─── */
    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border);
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--clr-text);
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: var(--org-primary-light);
        color: var(--org-primary);
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid var(--org-primary-border);
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: var(--clr-muted);
        margin-top: 0.15rem;
        line-height: 1.2;
    }
    .org-breadcrumb a {
        color: var(--clr-muted);
        text-decoration: none;
        transition: color 0.15s;
    }
    .org-breadcrumb a:hover {
        color: var(--org-primary);
    }

    /* Create Button */
    .org-btn-create {
        background: linear-gradient(135deg, #540033 0%, #750047 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: var(--radius-sm) !important;
        padding: 0.45rem 1rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.01em !important;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease !important;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.25) !important;
    }

    .org-btn-create:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(84, 0, 51, 0.35) !important;
        color: #ffffff !important;
    }

    .org-btn-create:active {
        transform: translateY(0);
    }

    /* ─── Stat Cards (matching HrPrSlryPrcDtl style) ─── */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.85rem;
        margin-bottom: 1rem;
    }
    .stat-card {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        padding: 0.85rem 1.15rem;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s, border-color 0.2s;
        box-shadow: var(--shadow-sm);
    }
    .stat-card:hover {
        transform: translateY(-2px);
        border-color: rgba(84, 0, 51, 0.25);
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: var(--radius) var(--radius) 0 0;
    }
    .stat-card.sc-primary::before { background: linear-gradient(90deg, #540033, #830050); }
    .stat-card.sc-green::before   { background: linear-gradient(90deg, #22c55e, #16a34a); }
    .stat-card.sc-cyan::before    { background: linear-gradient(90deg, #06b6d4, #0891b2); }

    .stat-card-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--clr-muted);
    }
    .stat-card-val {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--clr-text);
        margin-top: 0.2rem;
        font-variant-numeric: tabular-nums;
    }
    .stat-card-sub {
        font-size: 0.7rem;
        color: var(--clr-muted);
        margin-top: 0.15rem;
    }
    /* Code Badge */
    .org-code-badge {
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        background-color: #f1f5f9;
        color: var(--org-primary);
        font-weight: 700;
        font-size: 0.78rem;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        display: inline-block;
        letter-spacing: 0.02em;
    }

    .org-name-text {
        font-weight: 600;
        color: var(--clr-text);
        font-size: 0.82rem;
    }

    /* Action Buttons in Grid */
    .org-actions-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .org-action-btn {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        transition: all 0.15s ease;
        text-decoration: none !important;
        cursor: pointer;
        font-size: 0.75rem;
        padding: 0;
        outline: none;
    }

    .org-action-edit {
        background: #fdf2f8;
        color: var(--org-primary);
        border-color: #fbcfe8;
    }

    .org-action-edit:hover {
        background: var(--org-primary);
        color: #ffffff !important;
        border-color: var(--org-primary);
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(84, 0, 51, 0.25);
    }

    .org-action-delete {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .org-action-delete:hover {
        background: #dc2626;
        color: #ffffff !important;
        border-color: #dc2626;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);
    }

    /* Modern Modals */
    .org-modal .modal-content {
        border: 1px solid var(--clr-border) !important;
        border-radius: var(--radius) !important;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.2) !important;
        overflow: hidden;
    }

    .org-modal .modal-header {
        background: linear-gradient(135deg, #540033 0%, #3b0024 100%) !important;
        color: #ffffff !important;
        padding: 1rem 1.25rem !important;
        border-bottom: none !important;
    }

    .org-modal .modal-header .modal-title {
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        display: flex;
        align-items: center;
    }

    .org-modal .modal-header .close {
        color: #ffffff !important;
        opacity: 0.8 !important;
        text-shadow: none !important;
        transition: opacity 0.15s !important;
        outline: none !important;
    }

    .org-modal .modal-header .close:hover {
        opacity: 1 !important;
    }

    .org-modal-delete .modal-header {
        background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%) !important;
    }
</style>

<div class="org-page-container">
    <main>
        <div class="container-fluid px-0">

            <!-- COMPACT HERO HEADER -->
            <div class="org-hero-card">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
                    <div class="d-flex align-items-center">
                        <div class="org-icon-badge mr-3">
                            <i class="fas fa-sitemap"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                                <h1 class="org-title">Organisation</h1>
                                <span class="badge org-category-pill">MASTERS</span>
                            </div>
                            <div class="org-breadcrumb">
                                <a href="#">Masters</a> / <span class="text-dark font-weight-medium">Organisation</span>
                                <span class="text-muted mx-1">&bull;</span>
                                <span class="text-muted">Enterprise corporate entities &amp; company profiles</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <button type="button" class="btn org-btn-create" id="btnCreate" onclick="createFunc();">
                            <i class="fas fa-plus-circle mr-1"></i> Create New
                        </button>
                    </div>
                </div>
            </div>

            <!-- STATS QUICK RIBBON (HrPrSlryPrcDtl style) -->
            <div class="stat-grid">
                <div class="stat-card sc-primary">
                    <div class="stat-card-label">Total Organisations</div>
                    <div class="stat-card-val">@orgCount</div>
                    <div class="stat-card-sub">Registered entities</div>
                </div>
                
            </div>
            <!-- Main Grid (matching Employee/HrEmpGrade simple style) -->
            <div class="card mb-4">
                <div class="card-body">
                    <!--Grid-->
                    <div class="control-section">
                        <ejs-grid id="Grid" width="auto" dataSource="ViewBag.DataSource" allowPaging="true" allowGrouping="true" allowFiltering="true"
                                  allowExcelExport="true" allowPdfExport="true" toolbarClick="toolbarClick" toolbar="@(new List<string>() {"ExcelExport"} )">
                            <e-grid-filterSettings type="CheckBox"></e-grid-filterSettings>
                            <e-grid-pagesettings pageCount="5"></e-grid-pagesettings>
                            <e-grid-columns>
                                <e-grid-column field="OrgCode" headerText="Code" width="120" template="#_codeTemplate"></e-grid-column>
                                <e-grid-column field="NameEng" headerText="Org Name" width="220" template="#_nameTemplate"></e-grid-column>
                                <e-grid-column field="Desc" headerText="Description" width="300"></e-grid-column>
                                <e-grid-column field="" headerText="Actions" template="#_actions" width="110" textAlign="Center"></e-grid-column>
                            </e-grid-columns>
                        </ejs-grid>
                    </div>
                    <!--Grid-->
                </div>
            </div>

            <!-- MODALS -->
            <!--Create-->
            <div class="modal fade org-modal" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="modalCreateTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalCreateTitle">
                                <i class="fas fa-plus-circle mr-2"></i> Create Organisation
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="createModalBody">
                        </div>
                    </div>
                </div>
            </div>
            <!--Create-->

            <!--Edit-->
            <div class="modal fade org-modal" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="modalEditTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalEditTitle">
                                <i class="fas fa-edit mr-2"></i> Edit Organisation
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="editModalBody">
                        </div>
                    </div>
                </div>
            </div>
            <!--Edit-->

            <!--Delete-->
            <div class="modal fade org-modal org-modal-delete" id="modalDelete" tabindex="-1" role="dialog" aria-labelledby="modalDeleteTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalDeleteTitle">
                                <i class="fas fa-exclamation-triangle mr-2"></i> Delete Organisation
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body p-4" id="deleteModalBody">
                        </div>
                    </div>
                </div>
            </div>
            <!--Delete-->

        </div>
    </main>
</div>

<!-- JSRENDER COLUMN TEMPLATES -->
<script type="text/x-jsrender" id="_codeTemplate">
    <span class="org-code-badge">${OrgCode}</span>
</script>

<script type="text/x-jsrender" id="_nameTemplate">
    <div class="d-flex align-items-center">
        <div class="mr-2" style="width: 28px; height: 28px; border-radius: 6px; background: #fdf2f8; color: #540033; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;">
            <i class="fas fa-building"></i>
        </div>
        <span class="org-name-text">${NameEng}</span>
    </div>
</script>

<script type="text/x-jsrender" id="_actions">
    <div class="org-actions-wrapper">
        <button type="button" class="org-action-btn org-action-edit" onclick="editFunc(${OrgId})" title="Edit Organisation">
            <i class="fas fa-pen"></i>
        </button>
        <button type="button" class="org-action-btn org-action-delete" onclick="deleteFunc(${OrgId})" title="Delete Organisation">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>
</script>

<!-- Backward Compatibility Templates -->
<script type="text/x-jsrender" id="_edit">
    <button type="button" class="org-action-btn org-action-edit" onclick="editFunc(${OrgId})" title="Edit">
        <i class="fas fa-pen"></i>
    </button>
</script>
<script type="text/x-jsrender" id="_delete">
    <button type="button" class="org-action-btn org-action-delete" onclick="deleteFunc(${OrgId})" title="Delete">
        <i class="fas fa-trash-alt"></i>
    </button>
</script>

<!-- Scripts -->
<script>
    var createFunc = function () {
        var url = "/General/OrgInfo/CreateNew";
        $("#createModalBody").load(url, function () {
            $("#modalCreate").modal("show");
        });
    };

    var editFunc = function (id) {
        var url = "/General/OrgInfo/EditGet?id=" + id;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
        });
    };

    var deleteFunc = function (id) {
        var url = "/General/OrgInfo/DeleteGet?id=" + id;
        $("#deleteModalBody").load(url, function () {
            $("#modalDelete").modal("show");
        });
    };

    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];

        if (args.item.id === 'Grid_excelexport') {
            gridObj.excelExport();
        }
    }
</script>
