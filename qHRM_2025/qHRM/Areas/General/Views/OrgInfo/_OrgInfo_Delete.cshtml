@model qHRM.Areas.General.Models.OrgInfo

<div class="text-center mb-4">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #fef2f2; color: #dc2626; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 0.75rem;">
        <i class="fas fa-exclamation-triangle"></i>
    </div>
    <h5 class="font-weight-bold text-dark mb-1">Delete Organisation?</h5>
    <p class="text-muted small mb-0">Are you sure you want to remove this organisation record? This action cannot be undone.</p>
</div>

<div class="card mb-4" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
    <div class="card-body p-3">
        <div class="d-flex align-items-center mb-2">
            <span class="text-muted small font-weight-bold mr-2 text-uppercase" style="width: 100px;">Org Name:</span>
            <span class="font-weight-bold text-dark">@Html.DisplayFor(model => model.NameEng)</span>
        </div>
        <div class="d-flex align-items-start">
            <span class="text-muted small font-weight-bold mr-2 text-uppercase" style="width: 100px;">Description:</span>
            <span class="text-secondary small">@(string.IsNullOrEmpty(Model.Desc) ? "No description provided" : Model.Desc)</span>
        </div>
    </div>
</div>

@using (Html.BeginForm("Delete", "OrgInfo"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.OrgId)

    <div class="d-flex justify-content-end align-items-center" style="gap: 10px;">
        <button type="button" class="btn btn-light px-3 py-2 font-weight-bold" data-dismiss="modal" style="border-radius: 8px; font-size: 0.85rem; border: 1px solid #e2e8f0;">
            <i class="fas fa-times mr-1"></i> Cancel
        </button>
        <button type="submit" class="btn btn-danger px-4 py-2 font-weight-bold shadow-sm" style="border-radius: 8px; font-size: 0.85rem; background: #dc2626; border-color: #dc2626;">
            <i class="fas fa-trash-alt mr-1"></i> Confirm Delete
        </button>
    </div>
}