            //var node = diagram.nodes[0];


            //for (var i = 0; i < node.outEdges.length; i++) {
            //    var connector = diagram.getObject(node.outEdges[i]);
            //    var targetNode = diagram.getObject(connector.targetID);
            //    if (targetNode.outEdges.length > 0) {
            //        for (var j = 0; j < targetNode.outEdges.length; j++) {
            //            var targetConnector = diagram.getObject(targetNode.outEdges[j]);
            //            var childNode = diagram.getObject(targetConnector.targetID);
            //            childNode.isExpanded = false;
            //        }
            //    }
            //}
            //diagram.dataBind();
        }


        function getLayoutInfo(node, tree) {
            if (!tree.hasSubTree) {
                tree.orientation = 'Vertical';
                tree.type = 'Right';
            }
        }
        function getNodeDefaults(obj, diagram) {
            obj.height = 50;
            //obj.expandIcon = { height: 10, width: 10, shape: 'Minus', fill: 'lightgray', offset: { x: .5, y: 1 } };
            //obj.collapseIcon = { height: 10, width: 10, shape: 'Plus', fill: 'lightgray', offset: { x: .5, y: 1 } };
            obj.style = { fill: 'transparent', strokeWidth: 2 };
            obj.tooltip = { content: obj.data.Name + " ~ " + obj.data.Designation };
            obj.constraints = ej.diagrams.NodeConstraints.Default | ej.diagrams.NodeConstraints.Tooltip;
            return obj;
        }
        function getConnectorDefaults(connector, diagram) {
            connector.targetDecorator.shape = 'None';
            connector.type = 'Orthogonal';
            connector.style.strokeColor = 'gray';
            return connector;
        }
        function setNodeTemplate(obj, diagram) {
            var content = new ej.diagrams.StackPanel();
            content.id = obj.id + '_outerstack';
            content.orientation = 'Horizontal';
            content.style.strokeColor = 'gray';
            content.padding = { left: 5, right: 10, top: 5, bottom: 5 };

            var image = new ej.diagrams.ImageElement();
            image.width = 50;
            image.height = 50;
            image.style.strokeColor = 'none';
            image.source = obj.data.Image;
            image.id = obj.id + '_pic';
            var innerStack = new ej.diagrams.StackPanel();
            innerStack.style.strokeColor = 'none';
            innerStack.margin = { left: 5, right: 0, top: 0, bottom: 0 };
            innerStack.id = obj.id + '_innerstack';

            var text = new ej.diagrams.TextElement();
            text.content = obj.data.Name;
            text.style.color = 'black';
            text.style.bold = true;
            text.style.strokeColor = 'none';
            text.horizontalAlignment = 'Left';
            text.style.fill = 'none';
            text.id = obj.id + '_text1';


            var desigText = new ej.diagrams.TextElement();
            desigText.margin = { left: 0, right: 0, top: 5, bottom: 0 };
            desigText.content = obj.data.Designation;
            desigText.style.color = 'black';
            desigText.style.strokeColor = 'none';
            desigText.style.fontSize = 12;
            desigText.style.fill = 'none';
            desigText.horizontalAlignment = 'Left';
            desigText.style.textWrapping = 'Wrap';
            desigText.id = obj.id + '_desig';
            //innerStack.children = [text, desigText];

            innerStack.children = [text];

            content.children = [image, innerStack];
            return content;
        }


    </script>
}
