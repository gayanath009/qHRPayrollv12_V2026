@model qHRM.Areas.Entity.Models.OrgHoliday
<h5>Are you sure you want to cancel this?</h5>
@using (Html.BeginForm("Delete", "OrgHoliday"))
{<div>
    @Html.HiddenFor(model => model.HdId)

     <div class="card-body">
         <div class="form-row">
             <div class="form-group col-md-12">
                 <label asp-for="StDate" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.StDate)</p>
             </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-12">
                 <label asp-for="EndDate" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.EndDate)</p>
             </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-12">
                 <label asp-for="Recurring" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.Recurring_Txt)</p>
             </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-12">
                 <label asp-for="NameEng" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.NameEng)</p>
             </div>
         </div>
         <div class="form-group"></div>

         <div class="form-group">
             <input type="submit" value="DELETE" class="btn btn-sm btn-primary btn-block" />
             <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
         </div>
     </div>
</div>
}