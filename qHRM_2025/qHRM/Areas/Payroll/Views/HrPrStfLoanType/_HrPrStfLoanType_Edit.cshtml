@model qHRM.Areas.Payroll.Models.HrPrStfLoanType
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Edit", "HrPrStfLoanType"))
{
    <span class="alert-success">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.LnTypId)
        @Html.HiddenFor(model => model.EntId)
        @Html.HiddenFor(model => model.RecStat)
        @Html.HiddenFor(model => model.CrtDateTime)
    </div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="LnTypCode" class="control-label"></label>
                <input asp-for="ex_LnTypCode" class="form-control form-control-sm" hidden />
                <input asp-for="LnTypCode" class="form-control form-control-sm" />
                <span asp-validation-for="LnTypCode" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="Desc" class="control-label"></label>
                <input asp-for="Desc" class="form-control form-control-sm" />
                <span asp-validation-for="Desc" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="MaxAmt" class="control-label"></label>
                <input asp-for="MaxAmt" class="form-control form-control-sm" />
                <span asp-validation-for="MaxAmt" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="MaxInstl" class="control-label"></label>
                <input asp-for="MaxInstl" class="form-control form-control-sm" />
                <span asp-validation-for="MaxInstl" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group"></div>

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}
<ejs-scripts></ejs-scripts>
