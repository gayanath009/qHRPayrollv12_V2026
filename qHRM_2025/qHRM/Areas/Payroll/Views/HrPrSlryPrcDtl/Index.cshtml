<!-- ──────────── SCRIPTS ──────────── -->
<script>
    // ──── Stat Cards helpers ────
    function fmtNum(n) {
        if (n == null || isNaN(n)) return '—';
        return n.toLocaleString('en-QA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function updateStats(data) {
        if (!data || !data.length) {
            ['statCount','statGross','statDed','statNet'].forEach(id => document.getElementById(id).textContent = '—');
            return;
        }
        document.getElementById('statCount').textContent = data.length;
        document.getElementById('statGross').textContent = fmtNum(data.reduce((a, x) => a + (x.GrossSalary || 0), 0));
        document.getElementById('statDed').textContent   = fmtNum(data.reduce((a, x) => a + (x.TotalDeductions || 0), 0));
        document.getElementById('statNet').textContent   = fmtNum(data.reduce((a, x) => a + (x.NtSlry || 0), 0));
    }

    function setStatusBadge(stat, period) {
        var badges = {
            0: '<span class="status-badge sb-idle"><span class="dot"></span>Idle</span>',
            1: '<span class="status-badge sb-process"><span class="dot"></span>Processed</span>',
            2: '<span class="status-badge sb-verified"><span class="dot"></span>Verified</span>',
            3: '<span class="status-badge sb-complete"><span class="dot"></span>Completed</span>'
        };
        var b = badges[stat] || badges[0];
        document.getElementById('statStatus').innerHTML = b;
        document.getElementById('gridStatusBadge').innerHTML = b;
        document.getElementById('statPeriod').textContent = period || '—';
    }

    // ──── Summary Modal ────
    var SlrySummary = function (args, field) {
        var eftYr  = $("#drpYear").val();
        var eftMnt = $("#drpMonth").val();
        var url    = "/Payroll/HrPrSlryPrcDtl/GetSlrySummary";
        $("#summaryModalBody").load(url, { field: field, eftYr: eftYr, eftMn: eftMnt }, function () {
            $("#modalSummary").modal("show");
        });
    };

    var showOthrPmt = function (empSysId, typ) {
        var eftYr  = $("#drpYear").val();
        var eftMnt = $("#drpMonth").val();
        var url    = "/Payroll/HrPrSlryPrcDtl/GetAdHocTrnsByEmpId";
        $("#othrPymntModalBody").load(url, { empSysId: empSysId, eftYr: eftYr, eftMn: eftMnt, typ: typ }, function () {
            $("#modalOthrPymnt").modal("show");
        });
    };

    var showOvertime = function (empSysId, field) {
        var eftYr  = $("#drpYear").val();
        var eftMnt = $("#drpMonth").val();
        var url    = "/Payroll/HrPrSlryPrcDtl/GetOTNoPayByEmpId";
        if (field == 1) {
            $("#overtimeModalBody").load(url, { field: '_overtime', empSysId: empSysId, eftYr: eftYr, eftMn: eftMnt }, function () {
                $("#modalOvertime").modal("show");
            });
        } else {
            $("#nopayModalBody").load(url, { field: '_nopay', empSysId: empSysId, eftYr: eftYr, eftMn: eftMnt }, function () {
                $("#modalNopay").modal("show");
            });
        }
    };

    var showRemarks = function (PrcPsvRecId, PrcId) {
        var eftYr  = $("#drpYear").val();
        var eftMnt = $("#drpMonth").val();
        var url    = "/Payroll/HrPrSlryPrcDtl/GetRemarks";
        $("#rmksModalBody").load(url, { PrcPsvRecId: PrcPsvRecId, PrcId: PrcId, eftYr: eftYr, eftMnt: eftMnt }, function () {
            $("#modalRmks").modal("show");
        });
    };
</script>

<script>
    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];
        if (args.item.id === 'Grid_excelexport') { gridObj.excelExport(); }
    }
