@model qHRM.Areas.Payroll.Models.HrPrSlryPrcHdr
@using Syncfusion.EJ2
@using Syncfusion.EJ2.Notifications;
@using Microsoft.AspNetCore.Http;
@Html.AntiForgeryToken()
<script src="~/lib/jquery/dist/jquery.js"></script>

<style>
    

    :root {
        /* Light theme variables */
        --clr-bg: #f7fafc;
        --clr-surface: #ffffff;
        --clr-surface2: #f1f5f9;
        --clr-border: rgba(2,6,23,0.06);
        --clr-accent: #6366f1;
        --clr-accent2: #8b5cf6;
        --clr-success: #16a34a;
        --clr-warning: #f59e0b;
        --clr-danger: #ef4444;
        --clr-text: #0f172a;
        --clr-muted: #475569;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow: 0 6px 24px rgba(2,6,23,0.06);
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
    }

    .slry-wrap { font-family: 'Inter', sans-serif; padding: 0; }

    /* ─── Compact Header Card (OrgInfo Style) ─── */
    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border, #e2e8f0);
        padding: 0.75rem 1.25rem;
        margin: 0.75rem 2rem 1.25rem 2rem;
        box-shadow: 0 1px 6px rgba(2,6,23,0.04);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: #fdf2f8;
        color: #540033;
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid #fbcfe8;
        display: inline-block;
        line-height: 1;
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: #475569;
        margin-top: 0.15rem;
        line-height: 1.2;
    }

    /* ─── Stat Cards ─── */
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; padding: 0 2rem; }
    .stat-card { background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius); padding: 1.1rem 1.25rem; position: relative; overflow: hidden; transition: transform 0.2s, border-color 0.2s; }
    .stat-card:hover { transform: translateY(-2px); border-color: rgba(99,102,241,0.35); }
    .stat-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; border-radius: var(--radius) var(--radius) 0 0; }
    .stat-card.sc-indigo::before { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
    .stat-card.sc-green::before  { background: linear-gradient(90deg, #22c55e, #16a34a); }
    .stat-card.sc-red::before    { background: linear-gradient(90deg, #ef4444, #dc2626); }
    .stat-card.sc-amber::before  { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .stat-card.sc-cyan::before   { background: linear-gradient(90deg, #06b6d4, #0891b2); }
    .stat-card-label { font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--clr-muted); }
    .stat-card-val   { font-size: 1.35rem; font-weight: 700; color: var(--clr-text); margin-top: 0.25rem; font-variant-numeric: tabular-nums; }
    .stat-card-sub   { font-size: 0.7rem; color: var(--clr-muted); margin-top: 0.2rem; }

    /* ─── Main panel layout ─── */
    .slry-main { display: grid; grid-template-columns: 320px 1fr; gap: 1.5rem; padding: 0 2rem 2rem; }
    @@media (max-width: 1100px) { .slry-main { grid-template-columns: 1fr; } }

    /* ─── Control Panel ─── */
    .ctrl-panel { background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-sm); }
    .ctrl-panel-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--clr-muted); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
    .ctrl-panel-title::after { content: ''; flex: 1; height: 1px; background: var(--clr-border); }

    .ctrl-group { margin-bottom: 1.1rem; }
    .ctrl-label  { font-size: 0.72rem; font-weight: 600; color: var(--clr-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.35rem; }
    .ctrl-select { width: 100%; background: var(--clr-surface2); border: 1px solid var(--clr-border); color: var(--clr-text); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem; font-size: 0.85rem; outline: none; transition: border-color 0.2s; font-family: 'Inter', sans-serif; }
    .ctrl-select:focus { border-color: var(--clr-accent); }
    .ctrl-select option { background: var(--clr-surface2); }

    /* ─── Action Buttons ─── */
    .ctrl-divider { height: 1px; background: var(--clr-border); margin: 1.25rem 0; }
    .action-btn { width: 100%; border: none; border-radius: var(--radius-sm); padding: 0.65rem 1rem; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 0.65rem; font-family: 'Inter', sans-serif; letter-spacing: 0.01em; text-decoration: none; }
    .action-btn:disabled { opacity: 0.92; cursor: not-allowed; box-shadow: none !important; filter: saturate(0.95); }
    .action-btn svg { width: 16px; height: 16px; flex-shrink: 0; }

    .btn-process  { background: linear-gradient(135deg, #990049, #b80058); color: #fff; box-shadow: 0 2px 12px rgba(153,0,73,0.4); }
    .btn-process:hover:not(:disabled)  { box-shadow: 0 4px 20px rgba(153,0,73,0.6); transform: translateY(-1px); color: #fff; }
    .btn-verify   { background: linear-gradient(135deg, #06b6d4, #0891b2); color: #fff; box-shadow: 0 2px 12px rgba(6,182,212,0.35); }
    .btn-verify:hover:not(:disabled)   { box-shadow: 0 4px 20px rgba(6,182,212,0.55); transform: translateY(-1px); color: #fff; }
    .btn-complete { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; box-shadow: 0 2px 12px rgba(34,197,94,0.35); }
    .btn-complete:hover:not(:disabled) { box-shadow: 0 4px 20px rgba(34,197,94,0.55); transform: translateY(-1px); color: #fff; }
    .btn-wps      { background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; box-shadow: 0 2px 12px rgba(2,132,199,0.35); }
    .btn-wps:hover:not(:disabled)      { box-shadow: 0 4px 20px rgba(2,132,199,0.55); transform: translateY(-1px); color: #fff; }
    .btn-repro    { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; box-shadow: 0 2px 12px rgba(99,102,241,0.35); }
    .btn-repro:hover:not(:disabled)    { box-shadow: 0 4px 20px rgba(99,102,241,0.55); transform: translateY(-1px); color: #fff; }

    /* ─── Status Badge ─── */
    .status-badge { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; font-weight: 600; border-radius: 999px; padding: 0.3rem 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
    .status-badge .dot { width: 6px; height: 6px; border-radius: 50%; }
    .sb-idle     { background: rgba(148,163,184,0.12); color: #94a3b8; }     .sb-idle .dot     { background: #94a3b8; }
    .sb-process  { background: rgba(99,102,241,0.15); color: #818cf8; }      .sb-process .dot  { background: #818cf8; animation: pulse-dot 1.5s infinite; }
    .sb-verified { background: rgba(6,182,212,0.15);  color: #22d3ee; }      .sb-verified .dot { background: #22d3ee; }
    .sb-complete { background: rgba(34,197,94,0.15);  color: #4ade80; }      .sb-complete .dot { background: #4ade80; }
    @@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }

    /* ─── Re-process collapsible ─── */
    .repro-toggle { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--clr-muted); font-size: 0.78rem; font-weight: 600; user-select: none; margin-top: 0.75rem; }
    .repro-toggle input { accent-color: var(--clr-accent); width: 16px; height: 16px; cursor: pointer; }
    .repro-panel { margin-top: 0.9rem; padding: 1rem; background: var(--clr-surface2); border: 1px solid var(--clr-border); border-radius: var(--radius-sm); display: none; }
    .repro-panel.open { display: block; animation: fadeIn 0.2s ease; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }

    .radio-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0.75rem; }
    .radio-opt { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--clr-text); cursor: pointer; }
    .radio-opt input { accent-color: var(--clr-accent); cursor: pointer; }

    /* ─── Grid panel ─── */
    .grid-panel { background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); }
    .grid-panel-hdr { padding: 1rem 1.25rem; border-bottom: 1px solid var(--clr-border); display: flex; align-items: center; justify-content: space-between; }
    .grid-panel-hdr h3 { font-size: 0.85rem; font-weight: 700; color: var(--clr-text); margin: 0; }
    .grid-inner { padding: 1rem; }

    /* ─── Syncfusion grid light-theme overrides ─── */
    .e-grid { background: transparent !important; border: none !important; }
    .e-grid .e-headercell { background: #f8fafc !important; color: var(--clr-muted) !important; font-size: 0.72rem !important; font-weight: 600 !important; text-transform: uppercase !important; letter-spacing: 0.06em !important; border-color: var(--clr-border) !important; }
    .e-grid .e-rowcell { background: transparent !important; border-color: var(--clr-border) !important; color: var(--clr-text) !important; font-size: 0.8rem !important; }
    .e-grid .e-altrow .e-rowcell { background: #f8fafc !important; }
    .e-grid .e-row:hover .e-rowcell { background: rgba(99,102,241,0.06) !important; }
    .e-grid .e-footer-content, .e-grid .e-summarycell { background: #f1f5f9 !important; color: var(--clr-muted) !important; font-size: 0.75rem !important; border-color: var(--clr-border) !important; }
    .e-grid .e-summarycell a { color: var(--clr-accent) !important; text-decoration: none !important; }
    .e-grid .e-summarycell a:hover { color: var(--clr-accent2) !important; }
    .e-grid .e-pager { background: #f8fafc !important; border-color: var(--clr-border) !important; color: var(--clr-muted) !important; }
    .e-grid .e-toolbar { background: #f8fafc !important; border-color: var(--clr-border) !important; }
    .e-grid .e-toolbar .e-tbar-btn { background: var(--clr-surface) !important; color: var(--clr-text) !important; border: 1px solid var(--clr-border) !important; border-radius: 6px !important; }

    /* ─── Modal overrides ─── */
    .modal-content { background: var(--clr-surface) !important; border: 1px solid var(--clr-border) !important; border-radius: var(--radius) !important; color: var(--clr-text) !important; }
    .modal-header { border-bottom: 1px solid var(--clr-border) !important; }
    .modal-footer { border-top: 1px solid var(--clr-border) !important; }
    .modal-title { font-size: 1rem; font-weight: 700; color: var(--clr-text); }
    .close { color: var(--clr-muted) !important; opacity: 1 !important; }

    /* ─── Confirm modal pill ─── */
    .confirm-icon { width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; }
    .confirm-icon svg { width: 26px; height: 26px; }
    .ci-process  { background: rgba(153,0,73,0.18); color: #990049; }
    .ci-verify   { background: rgba(6,182,212,0.18);  color: #22d3ee; }
    .ci-complete { background: rgba(34,197,94,0.18);  color: #4ade80; }
    .ci-submit   { background: rgba(84,0,51,0.18); color: #540033; }

    .underline { text-decoration: underline; }
</style>

<div class="slry-wrap">

    <!-- COMPACT HERO HEADER -->
    <div class="org-hero-card">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
            <div class="d-flex align-items-center">
                <div class="org-icon-badge mr-3">
                    <i class="fas fa-calculator"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                        <h1 class="org-title">Salary Process</h1>
                        <span class="badge org-category-pill">PAYROLL</span>
                    </div>
                    <div class="org-breadcrumb">
                        <a href="#" class="text-secondary font-weight-bold">Payroll</a> / <span class="text-dark font-weight-medium">Salary Process</span>
                        <span class="text-muted mx-1">&bull;</span>
                        <span class="text-muted">Monthly payroll calculation, verification, and WPS generation</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="stat-grid">
        <div class="stat-card sc-indigo">
            <div class="stat-card-label">Processed</div>
            <div class="stat-card-val" id="statCount">—</div>
            <div class="stat-card-sub">Employees</div>
        </div>
        <div class="stat-card sc-green">
            <div class="stat-card-label">Total Gross</div>
            <div class="stat-card-val" id="statGross">—</div>
            <div class="stat-card-sub">QR.</div>
        </div>
        <div class="stat-card sc-red">
            <div class="stat-card-label">Total Deductions</div>
            <div class="stat-card-val" id="statDed">—</div>
            <div class="stat-card-sub">QR.</div>
        </div>
        <div class="stat-card sc-amber">
            <div class="stat-card-label">Net Payable</div>
            <div class="stat-card-val" id="statNet">—</div>
            <div class="stat-card-sub">QR.</div>
        </div>
        <div class="stat-card sc-cyan">
            <div class="stat-card-label">Status</div>
            <div style="margin-top:0.3rem" id="statStatus">
                <span class="status-badge sb-idle"><span class="dot"></span>Idle</span>
            </div>
            <div class="stat-card-sub" id="statPeriod">—</div>
        </div>
    </div>

    <!-- Main layout -->
    <div class="slry-main">

        <!-- ─── Control Panel ─── -->
        <div class="ctrl-panel">
            <div class="ctrl-panel-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/><path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.892 3.433-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.474l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"/></svg>
                Process Controls
            </div>

            <!-- Period -->
            <div class="ctrl-group">
                <div class="ctrl-label">Period</div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
                    <select id="drpYear" class="ctrl-select" asp-items="@(new SelectList(ViewBag.lstYear ?? new List<object>(), "value", "text"))" onchange="loadSalaryStat(); loadSalryHeader();">
                    </select>
                    <select id="drpMonth" class="ctrl-select" asp-items="@(new SelectList(ViewBag.lstMonth ?? new List<object>(), "value", "text"))" onchange="loadSalaryStat(); loadSalryHeader();">
                    </select>
                </div>
                <input id="crntStat" type="hidden" value="0" />
            </div>

            <!-- Staff Type -->
            <div class="ctrl-group">
                <div class="ctrl-label">Employee Category</div>
                <select id="drpStaffTyp" class="ctrl-select">
                    <option value="OUTSRC">Outsource Staff Only</option>                    
                    <option value="IN_HOUSE">In-house Staff Only</option>
                    <option value="ALL">All Staff</option>
                </select>
            </div>

            <div class="ctrl-divider"></div>

            <!-- Action buttons -->
            <button type="button" id="btnPrc" class="action-btn btn-process" data-toggle="modal" data-target="#modalProcess" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/></svg>
                Run Salary Process
            </button>

            <!-- Action: Salary Re-Process -->
            <button type="button" id="btnToggleReProcess" class="action-btn btn-repro" onclick="toggleReProcessPanel();" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/></svg>
                Salary Re-Process
            </button>
            <input type="checkbox" id="chkReProcess" style="display:none;" />

            <div id="dvReProcess" class="repro-panel">
                <div class="ctrl-label" style="margin-bottom:0.6rem;">Re-process Scope</div>
                <div class="radio-group">
                    <label class="radio-opt">
                        <input type="radio" name="gridRadios" id="chkCatEmp" checked onclick="showReProcessOptions();">
                        Employee Category
                    </label>
                    <label class="radio-opt">
                        <input type="radio" name="gridRadios" id="chkSlctdEmp" onclick="showReProcessOptions();">
                        Individual Employee
                    </label>
                    <label class="radio-opt">
                        <input type="radio" name="gridRadios" id="chkSlctdDpt" onclick="showReProcessOptions();">
                        Department
                    </label>
                </div>
                <div id="dvReProcCat" style="margin-bottom:0.5rem;">
                    <select id="drpReProcCat" class="ctrl-select">
                      <option value="OUTSRC">Outsource Staff Only</option>                    
                      <option value="IN_HOUSE">In-house Staff Only</option>
                      <option value="ALL">All Staff</option>
                    </select>
                </div>
                <div id="dvEmp" style="display:none; margin-bottom:0.5rem;">
                    <select id="drpEmployee" class="ctrl-select select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstEmployee ?? new List<object>(), "ESysId", "FulNme"))">
                        <option value="">-- Select Employee --</option>
                    </select>
                </div>
                <div id="dvDpt" style="display:none; margin-bottom:0.5rem;">
                    <select id="drpDpt" class="ctrl-select select2-dropdown"
                            asp-items="@(new SelectList(ViewBag.lstDepartment ?? new List<object>(), "DeptId", "DeptName"))">
                        <option value="">-- Select Department --</option>
                    </select>
                </div>
                <button type="button" id="btnReProcess" class="action-btn btn-repro" onclick="runSalaryReProcess();" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/></svg>
                    Run Re-Process
                </button>
            </div>

            <button type="button" id="btnVrfy" class="action-btn btn-verify" data-toggle="modal" data-target="#modalVerify" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
                Verify
            </button>

