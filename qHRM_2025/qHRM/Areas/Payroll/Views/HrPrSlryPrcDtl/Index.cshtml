        { title: 'Warning!', content: 'Please choose one or more employees.',   cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' },
        { title: 'Warning!', content: 'Please choose a department.',            cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' },
        { title: 'Success!', content: 'Salary re-process completed.',           cssClass: 'e-toast-success', icon: 'e-success toast-icons' },
        { title: 'Success!', content: 'Salary verified successfully.',          cssClass: 'e-toast-success', icon: 'e-success toast-icons' },
