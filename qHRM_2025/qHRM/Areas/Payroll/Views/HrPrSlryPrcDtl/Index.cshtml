<script>
    function toggleReProcessPanel() {
        var btn = document.getElementById("btnToggleReProcess");
        if (btn && btn.hasAttribute("disabled")) return;
        var div = document.getElementById("dvReProcess");
        if (div.classList.contains('open')) {
            div.classList.remove('open');
            var chk = document.getElementById("chkReProcess");
            if (chk) chk.checked = false;
        } else {
            div.classList.add('open');
            var chk = document.getElementById("chkReProcess");
            if (chk) chk.checked = true;
            var dvReProcCat = document.getElementById("dvReProcCat");
            if (dvReProcCat) dvReProcCat.style.display = "block";
            document.getElementById("dvEmp").style.display = "none";
            document.getElementById("dvDpt").style.display = "none";
            var chkCat = document.getElementById("chkCatEmp");
            if (chkCat) chkCat.checked = true;
        }
    }

    function showReProcess() {
        var chk  = document.getElementById("chkReProcess");
        var div  = document.getElementById("dvReProcess");
        if (chk && chk.checked) {
            div.classList.add('open');
            var dvReProcCat = document.getElementById("dvReProcCat");
            if (dvReProcCat) dvReProcCat.style.display = "block";
            document.getElementById("dvEmp").style.display = "none";
            document.getElementById("dvDpt").style.display = "none";
            var chkCat = document.getElementById("chkCatEmp");
            if (chkCat) chkCat.checked = true;
        } else {
            div.classList.remove('open');
        }
    }

    function showReProcessOptions() {
        var dvReProcCat = document.getElementById("dvReProcCat");
        var dvEmp = document.getElementById("dvEmp");
        var dvDpt = document.getElementById("dvDpt");
        if (dvReProcCat) dvReProcCat.style.display = document.getElementById("chkCatEmp").checked ? "block" : "none";
        if (dvEmp) dvEmp.style.display = document.getElementById("chkSlctdEmp").checked ? "block" : "none";
        if (dvDpt) dvDpt.style.display = document.getElementById("chkSlctdDpt").checked ? "block" : "none";
    }
</script>

<script>
    $(document).ready(function () {
        $('.select2-dropdown').select2({ theme: 'bootstrap4', width: '100%' });
        loadSalaryStat();
    });

    function getMonthName(m) {
        return ["", "January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"][parseInt(m)] || m;
    }

    // ──── Status Check ────
    function loadSalaryStat() {
        var efMnt = $("#drpMonth").val();
        var efYr  = $("#drpYear").val();
        $.ajax({
            type: "GET", url: "@(Url.Action("IsPrcStarted", "HrPrSlryPrcDtl"))",
            data: { eftYr: efYr, eftMnt: efMnt }, dataType: "json",
            success: function (slrydata) {
                if (slrydata.data == 0) {
                    $("#chkReProcess").attr("disabled", true);
                    $("#btnToggleReProcess").attr("disabled", true);
                    $("#btnPrc").removeAttr("disabled");
                } else {
                    $("#chkReProcess").removeAttr("disabled");
                    $("#btnToggleReProcess").removeAttr("disabled");
                    $("#btnPrc").attr("disabled", true);
                }
                $.ajax({
                    type: "GET", url: "@(Url.Action("IsPrcVerified", "HrPrSlryPrcDtl"))",
                    data: { eftYr: efYr, eftMnt: efMnt }, dataType: "json",
                    success: function (data) {
                        $("#crntStat").val(data.data);
                        var period = getMonthName(efMnt) + " " + efYr;
                        setStatusBadge(data.data || 0, period);
                        if (data.data == 0) {
                            $("#btnPrc").removeAttr("disabled");
                            ["btnReProcess","btnToggleReProcess","btnVrfy","btnCmpltd","btnWps"].forEach(id => {
                                var el = document.getElementById(id);
                                if (el) el.setAttribute("disabled","");
                            });
                        } else if (data.data == 1) {
                            ["btnReProcess","btnToggleReProcess","btnVrfy"].forEach(id => {
                                var el = document.getElementById(id);
                                if (el) el.removeAttribute("disabled");
                            });
                            ["btnCmpltd","btnWps"].forEach(id => {
                                var el = document.getElementById(id);
                                if (el) el.setAttribute("disabled","");
                            });
                            loadSalryHeader();
                        } else if (data.data == 2) {
                            ["btnReProcess","btnToggleReProcess","btnVrfy"].forEach(id => {
                                var el = document.getElementById(id);
                                if (el) el.setAttribute("disabled","");
                            });
                            // Complete and Generate WPS must remain deactivated until workflow approval completes
                            ["btnCmpltd","btnWps"].forEach(id => {
                                var el = document.getElementById(id);
                                if (el) el.setAttribute("disabled","");
                            });
                            loadSalryHeader();
                        }
                        $.ajax({
                            type: "GET", url: "/Payroll/HrPrSlryPrcDtl/GetWfStatus",
                            data: { eftYr: efYr, eftMnt: efMnt }, dataType: "json",
                            success: function (wf) { updateWfUi(wf, period); }
                        });
                        if (data.data == 3) {
                            ["btnReProcess","btnToggleReProcess","btnVrfy","btnCmpltd"].forEach(id => {
                                var el = document.getElementById(id);
                                if (el) el.setAttribute("disabled","");
                            });
                            document.getElementById("btnWps").removeAttribute("disabled");
                        }
                    }
                });
            }
        });
    }

    function updateWfUi(wf, period) {
        if (!wf) return;
        if (wf.prcId) $("#txtPrcId").val(wf.prcId);

        var badgeHtml = "";
        if (wf.wfStat === "PendingLevel1") {
            badgeHtml = '<span class="status-badge" style="background:rgba(245,158,11,0.15);color:#b45309;"><span class="dot" style="background:#f59e0b;"></span>Pending Level 1 (Ashhar Zaeem)</span>';
        } else if (wf.wfStat === "PendingFinal") {
            badgeHtml = '<span class="status-badge" style="background:rgba(6,182,212,0.15);color:#0e7490;"><span class="dot" style="background:#06b6d4;"></span>Pending Final (Hasan Sayed)</span>';
        } else if (wf.wfStat === "Approved") {
            badgeHtml = '<span class="status-badge sb-complete"><span class="dot"></span>Approved (Completed)</span>';
        } else if (wf.wfStat === "Rejected") {
            badgeHtml = '<span class="status-badge" style="background:rgba(239,68,68,0.15);color:#b91c1c;"><span class="dot" style="background:#ef4444;"></span>Rejected: ' + (wf.comments || '') + '</span>';
        }

        if (badgeHtml) {
            document.getElementById('statStatus').innerHTML = badgeHtml;
            document.getElementById('gridStatusBadge').innerHTML = badgeHtml;
        }

        if (wf.canSubmit) {
            $("#btnSubmitApproval").show().removeAttr("disabled");
        } else {
            $("#btnSubmitApproval").attr("disabled", "");
            if (wf.wfStat === "PendingLevel1" || wf.wfStat === "PendingFinal" || wf.wfStat === "Approved") {
                $("#btnSubmitApproval").hide();
            }
        }

        // Gating for "Complete" and "Generate WPS" buttons:
        // Must remain deactivated until the Approval Workflow is Approved!
        // Once approved, both "Complete" and "Generate WPS" buttons are activated.
        if (wf.wfStat === "Approved" || wf.prcStat == 3) {
            ["btnPrc", "btnReProcess", "btnToggleReProcess", "btnVrfy"].forEach(id => {
                var el = document.getElementById(id);
                if (el) el.setAttribute("disabled", "");
            });
            ["btnCmpltd", "btnWps"].forEach(id => {
                var el = document.getElementById(id);
                if (el) el.removeAttribute("disabled");
            });
        } else {
            // Not yet approved through workflow -> deactivate Complete and Generate WPS
            ["btnCmpltd", "btnWps"].forEach(id => {
                var el = document.getElementById(id);
                if (el) el.setAttribute("disabled", "");
            });

            if (wf.wfStat === "PendingLevel1" || wf.wfStat === "PendingFinal") {
                ["btnPrc", "btnReProcess", "btnToggleReProcess", "btnVrfy"].forEach(id => {
                    var el = document.getElementById(id);
                    if (el) el.setAttribute("disabled", "");
                });
            } else if (wf.wfStat === "Rejected") {
                ["btnReProcess", "btnToggleReProcess"].forEach(id => {
                    var el = document.getElementById(id);
                    if (el) el.removeAttribute("disabled");
                });
            }
        }
    }

    function submitSalaryForApproval() {
        var prcId = $("#txtPrcId").val();
        if (!prcId || prcId == 0) {
            alert("No verified salary process found to submit.");
            return;
        }
        $("#modalSubmitApproval").modal("show");
    }

    function runSubmitApprovalProcess() {
        var prcId = $("#txtPrcId").val();
        if (!prcId || prcId == 0) {
            alert("No verified salary process found to submit.");
            $("#modalSubmitApproval").modal("hide");
            return;
        }

        $("#btnConfirmSubmitApproval").prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Submitting...');
        $("#btnSubmitApproval").prop("disabled", true);

        $.ajax({
            type: "POST",
            url: "/Payroll/HrPrSlryPrcDtl/SubmitForApproval",
            data: { prcId: prcId },
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            success: function (res) {
                $("#modalSubmitApproval").modal("hide");
                $("#btnConfirmSubmitApproval").prop("disabled", false).html('<i class="fas fa-paper-plane mr-1"></i> Submit for Approval');
                if (res.ok) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert("Error: " + res.message);
                    $("#btnSubmitApproval").prop("disabled", false);
                }
            },
            error: function () {
                $("#modalSubmitApproval").modal("hide");
                $("#btnConfirmSubmitApproval").prop("disabled", false).html('<i class="fas fa-paper-plane mr-1"></i> Submit for Approval');
                alert("Error submitting salary process for approval.");
                $("#btnSubmitApproval").prop("disabled", false);
            }
        });
    }

    function loadSalryHeader() {
        var efMnt = $("#drpMonth").val();
        var efYr  = $("#drpYear").val();
        var grid  = document.getElementById('Grid').ej2_instances[0];
        grid.dataSource = null;
        grid.showSpinner();
        $.ajax({
            type: "GET", url: "@(Url.Action("GetLstSlryPrcHdr", "HrPrSlryPrcDtl"))",
            dataType: "json",
            success: function (hdr) { $("#txtPrcId").val(hdr.data);
                $.ajax({
                    type: "GET", url: "@(Url.Action("GetSalaryDtl", "HrPrSlryPrcDtl"))",
                    data: { prcId: hdr.data, eftYr: efYr, eftMnt: efMnt }, dataType: "json",
                    success: function (data) {
                        grid.dataSource = data.data;
                        grid.hideSpinner();
                        updateStats(data.data);
                    },
                    error: function () { grid.hideSpinner(); }
                });
            },
            error: function () { grid.hideSpinner(); }
        });
    }

    // ──── Run Process ────
    function runSalaryProcess() {
        var efMnt    = $("#drpMonth").val();
        var efYr     = $("#drpYear").val();
        var staffTyp = $("#drpStaffTyp").val();
        var grid = document.getElementById('Grid').ej2_instances[0];
        grid.dataSource = null;
        grid.showSpinner();
        $.ajax({
            type: "GET", url: "@(Url.Action("StrtPrc", "HrPrSlryPrcDtl"))",
            data: { eftYr: efYr, eftMnt: efMnt, note: "Process", staffTyp: staffTyp }, dataType: "json",
            success: function (data) {
                if (data.ok === false) {
                    toastObj.show({ title: 'Error!', content: data.data || 'Salary process execution failed.', cssClass: 'e-toast-danger', icon: 'e-error toast-icons' });
                    if (progressBtn1) progressBtn1.progressComplete();
                    grid.hideSpinner();
                    $("#modalProcess").modal('hide');
                    return;
                }
                $("#txtPrcId").val(data["PrcId"]);
                grid.dataSource = data.data;
                grid.hideSpinner();
                updateStats(data.data);
                $("#chkReProcess").removeAttr("disabled");
                $("#btnToggleReProcess").removeAttr("disabled");
                $("#btnPrc").attr("disabled", true);
                toastObj.show(toasts[0]);
                if (progressBtn1) progressBtn1.progressComplete();
                loadSalaryStat();
                loadSalryHeader();
                $("#modalProcess").modal('hide');
            },
            error: function () {
                toastObj.show(toasts[1]);
                if (progressBtn1) progressBtn1.progressComplete();
                grid.hideSpinner();
                $("#modalProcess").modal('hide');
            }
        });
    }

    // ──── Re-Process ────
    function runSalaryReProcess() {
        var errorCount = 0;
        if ($('#chkSlctdEmp').is(":checked") && $("#drpEmployee").val() == 0) { errorCount++; toastObj.show(toasts[2]); }
        if ($('#chkSlctdDpt').is(":checked") && $("#drpDpt").val() == 0)      { errorCount++; toastObj.show(toasts[3]); }
        if (errorCount > 0) return;

        var prcTyp   = "A";
        var prcId    = parseInt($("#txtPrcId").val()) || 0;
        var refId    = parseInt($("#txtPrcLogId").val()) || 0;
        var efMnt    = $("#drpMonth").val();
        var efYr     = $("#drpYear").val();
        var staffTyp = "ALL";

        if ($('#chkCatEmp').is(":checked")) {
            prcTyp = "A";
            staffTyp = $("#drpReProcCat").val();
        } else if ($('#chkSlctdEmp').is(":checked")) {
            prcTyp = "S";
            refId = $("#drpEmployee").val();
            staffTyp = "ALL";
        } else if ($('#chkSlctdDpt').is(":checked")) {
            prcTyp = "D";
            refId = $("#drpDpt").val();
            staffTyp = "ALL";
        }

        var grid = document.getElementById('Grid').ej2_instances[0];
        grid.dataSource = null;
        grid.showSpinner();
        $.ajax({
            type: "GET", url: "@(Url.Action("StrtReProc", "HrPrSlryPrcDtl"))",
            data: { prcId: prcId, refId: refId, prcTyp: prcTyp, eftYr: efYr, eftMnt: efMnt, note: "Re-Process", staffTyp: staffTyp },
            dataType: "json",
            success: function (data) {
                if (data.ok === false) {
                    toastObj.show({ title: 'Error!', content: data.data || 'Salary re-process execution failed.', cssClass: 'e-toast-danger', icon: 'e-error toast-icons' });
                    if (progressBtn2) progressBtn2.progressComplete();
                    grid.hideSpinner();
                    return;
                }
                grid.dataSource = data.data;
                grid.hideSpinner();
                updateStats(data.data);
                toastObj.show(toasts[4]);
                if (progressBtn2) progressBtn2.progressComplete();
                loadSalaryStat();
                loadSalryHeader();
            },
            error: function () {
                toastObj.show(toasts[1]);
                if (progressBtn2) progressBtn2.progressComplete();
                grid.hideSpinner();
            }
        });
    }

    // ──── Verify ────
    function runVerifyProcess() {
        var efMnt = $("#drpMonth").val();
        var efYr  = $("#drpYear").val();
        $.ajax({
            type: "GET", url: "@(Url.Action("VrfyPrc", "HrPrSlryPrcDtl"))",
            data: { eftYr: efYr, eftMnt: efMnt, mthod: 2 }, dataType: "json",
            success: function (data) {
                $("#crntStat").val(2);
                ["btnReProcess","btnVrfy"].forEach(id => document.getElementById(id).setAttribute("disabled",""));
                // Keep Complete and Generate WPS deactivated until workflow approval completes
                ["btnCmpltd","btnWps"].forEach(id => document.getElementById(id).setAttribute("disabled",""));
                setStatusBadge(2, getMonthName(efMnt) + " " + efYr);
                $("#modalVerify").modal('hide');
                loadSalryHeader();
                toastObj.show(toasts[5]);
                // Refresh workflow status so Submit for Approval button appears
                $.ajax({
                    type: "GET", url: "/Payroll/HrPrSlryPrcDtl/GetWfStatus",
                    data: { eftYr: efYr, eftMnt: efMnt }, dataType: "json",
                    success: function (wf) { updateWfUi(wf, getMonthName(efMnt) + " " + efYr); }
                });
            },
            error: function () { toastObj.show(toasts[1]); }
        });
    }

    // ──── Complete ────
    function runCmpltProcess() {
        var efMnt = $("#drpMonth").val();
        var efYr  = $("#drpYear").val();
        $.ajax({
            type: "GET", url: "@(Url.Action("VrfyPrc", "HrPrSlryPrcDtl"))",
            data: { eftYr: efYr, eftMnt: efMnt, mthod: 3 }, dataType: "json",
            success: function (data) {
                $("#crntStat").val(3);
                ["btnReProcess","btnVrfy","btnCmpltd"].forEach(id => document.getElementById(id).setAttribute("disabled",""));
                document.getElementById("btnWps").removeAttribute("disabled");
                setStatusBadge(3, getMonthName(efMnt) + " " + efYr);
                $("#modalComplete").modal('hide');
                toastObj.show(toasts[6]);
                setTimeout(function () { window.location.href = "/Payroll/HrPrSlryPrcDtl/Index"; }, 1500);
            },
            error: function () { toastObj.show(toasts[1]); }
        });
    }

    // ──── WPS ────
    function runWPSProcess() {
        var efMn = $("#drpMonth").val();
        var efYr = $("#drpYear").val();
        $.ajax({
            type: "GET", url: "@(Url.Action("GetWPSFile", "HrPrSlryPrcDtl"))",
            data: { eftYr: efYr, eftMn: efMn }, dataType: "json",
            success: function (data) { DownloadFile(data.data); }
        });
    }

    function DownloadFile(fileName) {
        var dwnurl = '/attach/wps/' + fileName;
        $.ajax({ url: dwnurl, method: 'GET', xhrFields: { responseType: 'blob' },
            success: function (data) {
                var a = document.createElement('a');
                a.href = window.URL.createObjectURL(data);
                a.download = fileName;
                document.body.append(a); a.click(); a.remove();
                window.URL.revokeObjectURL(a.href);
            }
        });
    }
</script>

<!--Start Toast-->
