@using Syncfusion.EJ2;
<div>
    <ejs-grid id="Grid1" width="auto" dataSource="ViewBag.dsOTNoPay" allowPaging="true" allowFiltering="true"
              allowExcelExport="true" toolbarClick="toolbarClick1" toolbar="@(new List<string>() {"ExcelExport"} )">

        <e-grid-filterSettings type="Excel"></e-grid-filterSettings>
        <e-grid-pagesettings pageCount=5></e-grid-pagesettings>
        <e-grid-columns>
            <e-grid-column field="FullName" headerText="Name" width="100"></e-grid-column>
            <e-grid-column field="EfctvDate" headerText="Date" width="75" format='yMd'></e-grid-column>
            <e-grid-column field="Ot_Amt" headerText="Overtime Amount" width="100"></e-grid-column>
            <e-grid-column field="OT_Hrs" headerText="Overtime Hrs." width="100"></e-grid-column>
            <e-grid-column field="Ext_OT_Hrs" headerText="Ext. Overtime Hrs." width="150"></e-grid-column>
        </e-grid-columns>
    </ejs-grid>
</div>

<script>    
    function toolbarClick1(args) {
       alert ('trigger')
        var gridObj = document.getElementById("Grid1").ej2_instances[0];
        if (args.item.id === 'Grid1_excelexport') {
            gridObj.excelExport();
        }
    }
</script>

<script type="text/javascript">
    $(function () {
        $('#modalOvertime').on('shown.bs.modal', function () {
            $(document).off('focusin.modal');
        });
    })
</script>
<ejs-scripts></ejs-scripts>