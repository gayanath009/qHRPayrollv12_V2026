@model qHRM.Areas.Payroll.Models.HrPrSlryPrcHdr
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Salary Process Approval";
    var hdr = ViewBag.Header as qHRM.Areas.Payroll.Models.HrPrSlryPrcHdr;
    var salaryList = ViewBag.SalaryList as List<qHRM.Areas.Payroll.Models.PrSlryShtVw> ?? new List<qHRM.Areas.Payroll.Models.PrSlryShtVw>();
    var history = ViewBag.History as List<qHRM.Areas.Payroll.Models.HrPrWfHistory> ?? new List<qHRM.Areas.Payroll.Models.HrPrWfHistory>();
    string periodText = hdr != null ? new DateTime(hdr.EftYear, hdr.EftMonth, 1).ToString("MMMM yyyy") : "";
}

<script src="~/js/ej2.min.js"></script>
<ejs-scripts></ejs-scripts>

@Html.AntiForgeryToken()

<style>
    :root {
        --clr-bg: #f8fafc;
        --clr-surface: #ffffff;
        --clr-surface2: #f1f5f9;
        --clr-border: #e2e8f0;
        --clr-text: #000000;
        --clr-muted: #64748b;
        --clr-accent: #6366f1;
        --clr-accent2: #4f46e5;
        --radius: 10px;
        --radius-sm: 6px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -1px rgba(0,0,0,0.04);
    }

    .approval-wrap {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        padding: 0.5rem 1.5rem 2rem;
        color: #000000;
    }

    .org-hero-card {
        background: #ffffff;
        border-radius: var(--radius);
        border: 1px solid var(--clr-border);
        padding: 1rem 1.5rem;
        margin-bottom: 1.25rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
    }
    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 4px; height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .stat-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.03em;
    }
    .sb-l1 { background: rgba(245,158,11,0.15); color: #b45309; border: 1px solid #fde68a; }
    .sb-final { background: rgba(6,182,212,0.15); color: #0e7490; border: 1px solid #a5f3fc; }
    .sb-approved { background: rgba(34,197,94,0.15); color: #15803d; border: 1px solid #bbf7d0; }
    .sb-rejected { background: rgba(239,68,68,0.15); color: #b91c1c; border: 1px solid #fecaca; }
    .sb-draft { background: rgba(100,116,139,0.15); color: #334155; border: 1px solid #cbd5e1; }

    /* ─── Stat Cards (Look, color, and feel of HrPrSlryPrcDtl) ─── */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.25rem;
    }
    .stat-card {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        padding: 1.1rem 1.25rem;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s, border-color 0.2s;
        box-shadow: var(--shadow-sm);
    }
    .stat-card:hover {
        transform: translateY(-2px);
        border-color: rgba(99,102,241,0.35);
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        border-radius: var(--radius) var(--radius) 0 0;
    }
    .stat-card.sc-indigo::before   { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
    .stat-card.sc-green::before    { background: linear-gradient(90deg, #22c55e, #16a34a); }
    .stat-card.sc-red::before      { background: linear-gradient(90deg, #ef4444, #dc2626); }
    .stat-card.sc-amber::before    { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .stat-card.sc-cyan::before     { background: linear-gradient(90deg, #06b6d4, #0891b2); }
    .stat-card.sc-purple::before   { background: linear-gradient(90deg, #8b5cf6, #a855f7); }
    .stat-card.sc-burgundy::before { background: linear-gradient(90deg, #540033, #830050); }

    .stat-card-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--clr-muted);
    }
    .stat-card-val {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 0.25rem;
        font-variant-numeric: tabular-nums;
    }
    .stat-card-sub {
        font-size: 0.7rem;
        color: var(--clr-muted);
        margin-top: 0.2rem;
    }

    /* ─── Action Toolbar ─── */
    .action-toolbar {
        background: #ffffff;
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        padding: 0.85rem 1.25rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        box-shadow: var(--shadow-sm);
    }
    .btn-approve {
        background: #16a34a;
        color: #ffffff;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: background 0.15s;
    }
    .btn-approve:hover { background: #15803d; color: #fff; }
    .btn-reject {
        background: #dc2626;
        color: #ffffff;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: background 0.15s;
    }
    .btn-reject:hover { background: #b91c1c; color: #fff; }
    .btn-report {
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        color: #334155;
        padding: 0.45rem 0.9rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
    }
    .btn-report:hover { background: #f1f5f9; color: #0f172a; text-decoration: none; }

    /* ─── Grid Panel & Table Styling ─── */
    .grid-panel {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        margin-bottom: 1.5rem;
    }
    .grid-panel-hdr {
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid var(--clr-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
    }
    .grid-panel-hdr h3 {
        font-size: 0.85rem;
        font-weight: 700;
        color: #000000;
        margin: 0;
    }
    .grid-inner { padding: 0; }

    .slry-grid-table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff !important;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .slry-grid-table th {
        background: #f8fafc !important;
        color: #475569 !important;
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        border-top: none !important;
        border-bottom: 1px solid var(--clr-border) !important;
        border-left: 1px solid var(--clr-border) !important;
        border-right: 1px solid var(--clr-border) !important;
        padding: 0.65rem 0.75rem !important;
        vertical-align: middle !important;
        white-space: nowrap !important;
    }
    .slry-grid-table td {
        background-color: #ffffff !important;
        border: 1px solid var(--clr-border) !important;
        color: #000000 !important;
        font-size: 0.8rem !important;
        padding: 0.55rem 0.75rem !important;
        vertical-align: middle !important;
    }
    .slry-grid-table td strong {
        color: #000000 !important;
    }
    .slry-grid-table tbody tr:nth-child(even) td {
        background-color: #f8fafc !important;
        color: #000000 !important;
    }
    .slry-grid-table tbody tr:hover td {
        background-color: rgba(99,102,241,0.06) !important;
        color: #000000 !important;
    }
    .slry-grid-table tfoot td {
        background-color: #f1f5f9 !important;
        color: #000000 !important;
        font-size: 0.8rem !important;
        font-weight: 700 !important;
        border-top: 2px solid var(--clr-border) !important;
        padding: 0.7rem 0.75rem !important;
    }

    /* ─── Category Badges ─── */
    .cat-badge-inhouse {
        background: #e0f2fe !important;
        color: #0284c7 !important;
        border: 1px solid #bae6fd !important;
        font-weight: 700 !important;
        font-size: 0.68rem !important;
        padding: 0.25rem 0.6rem !important;
        border-radius: 4px !important;
        display: inline-block;
        letter-spacing: 0.02em;
    }
    .cat-badge-outsource {
        background: #ede9fe !important;
        color: #7c3aed !important;
        border: 1px solid #ddd6fe !important;
        font-weight: 700 !important;
        font-size: 0.68rem !important;
        padding: 0.25rem 0.6rem !important;
        border-radius: 4px !important;
        display: inline-block;
        letter-spacing: 0.02em;
    }
</style>

<div class="approval-wrap">

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mt-3">
            <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.ErrorMessage
        </div>
    }
    else
    {
        <!-- HERO CARD -->
        <div class="org-hero-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap: 1rem;">
                <div class="d-flex align-items-center">
                    <div style="width:42px;height:42px;border-radius:8px;background:linear-gradient(135deg, #540033 0%, #830050 100%);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.15rem;margin-right:1rem;">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center" style="gap: 0.5rem;">
                            <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0;">
                                Salary Process Approval &ndash; @periodText
                            </h2>
                            @if (hdr.WfStat == "PendingLevel1")
                            {
                                <span class="stat-badge sb-l1"><i class="fas fa-clock mr-1"></i> Pending Level 1 Approval (@ViewBag.L1ApproverName)</span>
                            }
                            else if (hdr.WfStat == "PendingFinal")
                            {
                                <span class="stat-badge sb-final"><i class="fas fa-user-check mr-1"></i> Pending Final Approval (@ViewBag.FinalApproverName)</span>
                            }
                            else if (hdr.WfStat == "Approved")
                            {
                                <span class="stat-badge sb-approved"><i class="fas fa-check-circle mr-1"></i> Approved (Completed)</span>
                            }
                            else if (hdr.WfStat == "Rejected")
                            {
                                <span class="stat-badge sb-rejected"><i class="fas fa-times-circle mr-1"></i> Rejected</span>
                            }
                            else
                            {
                                <span class="stat-badge sb-draft"><i class="fas fa-pencil-alt mr-1"></i> Verified (Draft)</span>
                            }
                        </div>
                        <div style="font-size: 0.78rem; color: #64748b; margin-top: 0.2rem;">
                            Initiator: <strong>@ViewBag.InitiatorName</strong> &bull;
                            Level 1 Approver: <strong>@ViewBag.L1ApproverName</strong> &bull;
                            Final Approver: <strong>@ViewBag.FinalApproverName</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STAT METRICS CARDS (Look, color, and feel of HrPrSlryPrcDtl) -->
        <div class="stat-grid">
            <div class="stat-card sc-amber">
                <div class="stat-card-label">Staff Count</div>
                <div class="stat-card-val">@salaryList.Count</div>
                <div class="stat-card-sub">Processed Employees</div>
            </div>
            <div class="stat-card sc-indigo">
                <div class="stat-card-label">Total Gross</div>
                <div class="stat-card-val">@(((decimal)ViewBag.GrossTotal).ToString("N2")) <span style="font-size:0.8rem; font-weight:600; color:var(--clr-muted);">QAR</span></div>
                <div class="stat-card-sub">Basic + Allowances</div>
            </div>
            <div class="stat-card sc-red">
                <div class="stat-card-label">Total Deductions</div>
                <div class="stat-card-val" style="color:#b91c1c;">@(((decimal)ViewBag.DeductionsTotal).ToString("N2")) <span style="font-size:0.8rem; font-weight:600; color:#dc2626;">QAR</span></div>
                <div class="stat-card-sub">Advances, Loans, LOP</div>
            </div>
            <div class="stat-card sc-cyan">
                <div class="stat-card-label">In-House Staff Net</div>
                <div class="stat-card-val">@(((decimal)ViewBag.InHouseTotal).ToString("N2")) <span style="font-size:0.8rem; font-weight:600; color:var(--clr-muted);">QAR</span></div>
                <div class="stat-card-sub">Direct Employees</div>
            </div>
            <div class="stat-card sc-purple">
                <div class="stat-card-label">Outsource Staff Net</div>
                <div class="stat-card-val">@(((decimal)ViewBag.OutsourceTotal).ToString("N2")) <span style="font-size:0.8rem; font-weight:600; color:var(--clr-muted);">QAR</span></div>
                <div class="stat-card-sub">Outsourced Staff</div>
            </div>
            <div class="stat-card sc-burgundy">
                <div class="stat-card-label">Grand Total Net</div>
                <div class="stat-card-val" style="color:#540033;">@(((decimal)ViewBag.GrandTotal).ToString("N2")) <span style="font-size:0.8rem; font-weight:600; color:#830050;">QAR</span></div>
                <div class="stat-card-sub">Total Payable for @periodText</div>
            </div>
        </div>

        <!-- ACTION TOOLBAR -->
        <div class="action-toolbar">
            <!-- Left: Reports Viewing Buttons -->
            <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                <span style="font-size: 0.78rem; font-weight: 700; color: #475569; margin-right: 0.4rem;">
                    <i class="fas fa-file-pdf text-danger mr-1"></i> Reports:
                </span>
                <a href="/Payroll/HrSalSlip/PrintStaffSalarySheet?EftYr=@hdr.EftYear&EftMnt=@hdr.EftMonth&sctn=0" target="_blank" class="btn-report">
                    <i class="fas fa-users text-primary"></i> Detailed Staff Sheet (In-House)
                </a>
                <a href="/Payroll/HrSalSlip/PrintStaffSalarySheet?EftYr=@hdr.EftYear&EftMnt=@hdr.EftMonth&sctn=1" target="_blank" class="btn-report">
                    <i class="fas fa-user-friends text-info"></i> Detailed Staff Sheet (Outsource)
                </a>
                <a href="/Payroll/HrSalSlip/PrintStaffSalarySheet?EftYr=@hdr.EftYear&EftMnt=@hdr.EftMonth&sctn=2" target="_blank" class="btn-report">
                    <i class="fas fa-building text-secondary"></i> Detailed Staff Sheet (All)
                </a>
                <a href="/Payroll/HrSalSlip/PrintSlrySht?EftYr=@hdr.EftYear&EftMnt=@hdr.EftMonth" target="_blank" class="btn-report" style="border-color:#540033;color:#540033;">
                    <i class="fas fa-chart-pie" style="color:#540033;"></i> Salary Summary Sheet
                </a>
            </div>

            <!-- Right: Approval / Rejection Buttons -->
            <div class="d-flex align-items-center" style="gap: 0.5rem;">
                @if (ViewBag.CanApprove == true)
                {
                    <button type="button" class="btn-approve" onclick="openApprovalModal();">
                        <i class="fas fa-check-circle"></i>
                        @if (ViewBag.CanApproveFinal == true)
                        {
                            <span>Approve Salary Process (Final Approval)</span>
                        }
                        else
                        {
                            <span>Approve Salary Process (Level 1)</span>
                        }
                    </button>
                }
                @if (ViewBag.CanReject == true)
                {
                    <button type="button" class="btn-reject" onclick="openRejectModal();">
                        <i class="fas fa-times-circle"></i> Reject Process
                    </button>
                }
            </div>
        </div>

        <!-- SALARY DETAILS GRID -->
        <div class="grid-panel">
            <div class="grid-panel-hdr">
                <h3>
                    <i class="fas fa-table mr-2 text-muted"></i>Salary Breakdown Details (@salaryList.Count Employees)
                </h3>
            </div>
            <div class="grid-inner">
                <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                    <table class="slry-grid-table">
                        <thead style="position: sticky; top: 0; z-index: 10;">
                            <tr>
                                <th style="width: 80px;">Emp ID</th>
                                <th>Employee Name</th>
                                <th style="width: 100px; text-align: center;">Category</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th style="width: 100px;" class="text-right">Basic</th>
                                <th style="width: 110px;" class="text-right">Allowances</th>
                                <th style="width: 110px;" class="text-right">Gross</th>
                                <th style="width: 100px;" class="text-right">Deductions</th>
                                <th style="width: 120px;" class="text-right font-weight-bold">Net Salary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in salaryList)
                            {
                                decimal allowances = emp.HrAlwnc + emp.TrnsAlwnc + emp.PstnAlwnc + emp.ProjAlwnc + emp.IncntvAmt + emp.MobAlwnc + emp.OtAmt + emp.MedAlwnc + emp.BonusAmt + emp.OthrAlwnc + emp.OthrPmt;
                                <tr>
                                    <td><strong>@emp.EmpId</strong></td>
                                    <td>@emp.FullName</td>
                                    <td class="text-center">
                                        @if (emp.InHouse)
                                        {
                                            <span class="cat-badge-inhouse">In-House</span>
                                        }
                                        else
                                        {
                                            <span class="cat-badge-outsource">Outsource</span>
                                        }
                                    </td>
                                    <td>@emp.DeptName</td>
                                    <td>@emp.DesigName</td>
                                    <td class="text-right">@emp.Basic.ToString("N2")</td>
                                    <td class="text-right">@allowances.ToString("N2")</td>
                                    <td class="text-right font-weight-bold">@emp.GrsSlry.ToString("N2")</td>
                                    <td class="text-right font-weight-bold" style="color:#b91c1c !important;">@emp.TotDctAmt.ToString("N2")</td>
                                    <td class="text-right font-weight-bold" style="color:#540033 !important;">@emp.NtSlry.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5">Totals:</td>
                                <td class="text-right">@salaryList.Sum(x => x.Basic).ToString("N2")</td>
                                <td class="text-right">@salaryList.Sum(x => x.HrAlwnc + x.TrnsAlwnc + x.PstnAlwnc + x.ProjAlwnc + x.IncntvAmt + x.MobAlwnc + x.OtAmt + x.MedAlwnc + x.BonusAmt + x.OthrAlwnc + x.OthrPmt).ToString("N2")</td>
                                <td class="text-right font-weight-bold">@(((decimal)ViewBag.GrossTotal).ToString("N2"))</td>
                                <td class="text-right font-weight-bold" style="color:#b91c1c !important;">@(((decimal)ViewBag.DeductionsTotal).ToString("N2"))</td>
                                <td class="text-right font-weight-bold" style="color:#540033 !important; font-size:0.95rem;">@(((decimal)ViewBag.GrandTotal).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- WORKFLOW AUDIT TRAIL / TIMELINE -->
        <div class="grid-panel">
            <div class="grid-panel-hdr">
                <h3>
                    <i class="fas fa-history mr-2 text-muted"></i>Workflow Approval History & Comments
                </h3>
            </div>
            <div class="grid-inner">
                @if (!history.Any())
                {
                    <div class="p-3 text-muted text-center" style="font-size: 0.85rem;">
                        No approval actions logged yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="slry-grid-table">
                            <thead>
                                <tr>
                                    <th style="width: 140px;">Step</th>
                                    <th style="width: 110px;">Action</th>
                                    <th style="width: 180px;">Actor</th>
                                    <th style="width: 180px;">Timestamp</th>
                                    <th>Comments</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in history)
                                {
                                    <tr>
                                        <td><strong>@h.StepName</strong></td>
                                        <td>
                                            @if (h.Action == "Approved")
                                            {
                                                <span class="badge badge-success" style="font-weight:700;">Approved</span>
                                            }
                                            else if (h.Action == "Rejected")
                                            {
                                                <span class="badge badge-danger" style="font-weight:700;">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-primary" style="font-weight:700;">@h.Action</span>
                                            }
                                        </td>
                                        <td>@h.ActorName</td>
                                        <td>@h.ActionDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td style="color: #000000 !important;">@(string.IsNullOrWhiteSpace(h.Comments) ? "—" : h.Comments)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

</div>

<!-- APPROVAL MODAL -->
<div class="modal fade" id="modalApproval" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-top: 4px solid #16a34a;">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" style="color: #16a34a;">
                    <i class="fas fa-check-circle mr-1"></i> Approve Salary Process
                </h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: #475569;">
                    Are you sure you want to approve the salary process for <strong>@periodText</strong>?
                </p>
                <div class="form-group">
                    <label class="control-label font-weight-bold" style="font-size: 0.8rem;">Approval Comments (Optional):</label>
                    <textarea id="txtApproveComments" class="form-control" rows="3" placeholder="Enter comments or remarks..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmApprove" class="btn btn-sm btn-success" onclick="executeApprove();">
                    <i class="fas fa-check mr-1"></i> Confirm Approval
                </button>
            </div>
        </div>
    </div>
</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="modalReject" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-top: 4px solid #dc2626;">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" style="color: #dc2626;">
                    <i class="fas fa-times-circle mr-1"></i> Reject Salary Process
                </h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: #475569;">
                    The salary process will be rejected and returned to the initiator for necessary revisions.
                </p>
                <div class="form-group">
                    <label class="control-label font-weight-bold" style="font-size: 0.8rem;">Reason for Rejection <span class="text-danger">*</span>:</label>
                    <textarea id="txtRejectComments" class="form-control" rows="3" placeholder="Please specify why this salary process is rejected..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmReject" class="btn btn-sm btn-danger" onclick="executeReject();">
                    <i class="fas fa-times mr-1"></i> Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var prcId = @(hdr?.PrcId ?? 0);

    function openApprovalModal() {
        $('#txtApproveComments').val('');
        $('#modalApproval').modal('show');
    }

    function openRejectModal() {
        $('#txtRejectComments').val('');
        $('#modalReject').modal('show');
    }

    function executeApprove() {
        var comments = $('#txtApproveComments').val();
        $('#btnConfirmApprove').attr('disabled', '').html('<i class="fas fa-spinner fa-spin mr-1"></i> Approving...');
        $.ajax({
            url: '/Payroll/HrPrSlryPrcApproval/Approve',
            type: 'POST',
            data: { prcId: prcId, comments: comments },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function (res) {
                if (res.ok) {
                    alert(res.message);
                    window.location.reload();
                } else {
                    alert('Error: ' + res.message);
                    $('#btnConfirmApprove').removeAttr('disabled').html('<i class="fas fa-check mr-1"></i> Confirm Approval');
                }
            },
            error: function () {
                alert('An error occurred during approval.');
                $('#btnConfirmApprove').removeAttr('disabled').html('<i class="fas fa-check mr-1"></i> Confirm Approval');
            }
        });
    }

    function executeReject() {
        var comments = $('#txtRejectComments').val();
        if (!comments || !comments.trim()) {
            alert('Please enter a rejection reason.');
            $('#txtRejectComments').focus();
            return;
        }

        $('#btnConfirmReject').attr('disabled', '').html('<i class="fas fa-spinner fa-spin mr-1"></i> Rejecting...');
        $.ajax({
            url: '/Payroll/HrPrSlryPrcApproval/Reject',
            type: 'POST',
            data: { prcId: prcId, comments: comments },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function (res) {
                if (res.ok) {
                    alert(res.message);
                    window.location.reload();
                } else {
                    alert('Error: ' + res.message);
                    $('#btnConfirmReject').removeAttr('disabled').html('<i class="fas fa-times mr-1"></i> Confirm Rejection');
                }
            },
            error: function () {
                alert('An error occurred during rejection.');
                $('#btnConfirmReject').removeAttr('disabled').html('<i class="fas fa-times mr-1"></i> Confirm Rejection');
            }
        });
    }
</script>
