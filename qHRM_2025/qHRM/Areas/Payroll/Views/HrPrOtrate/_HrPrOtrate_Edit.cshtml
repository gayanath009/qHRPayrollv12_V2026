@model qHRM.Areas.Payroll.Models.HrPrOtrate
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

@using (Html.BeginForm("Edit", "HrPrOtrate"))
{
    <span class="alert-success">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.OtId)
        <div class="form-group">
            <label asp-for="OtCode" class="control-label"></label>
            <input asp-for="ex_OtCode" class="form-control form-control-sm" hidden />
            <input asp-for="OtCode" class="form-control form-control-sm" />
            <span asp-validation-for="OtCode" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DescEng" class="control-label"></label>
            <input asp-for="DescEng" class="form-control form-control-sm" />
            <span asp-validation-for="DescEng" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NmlRate" class="control-label"></label>
            <input asp-for="NmlRate" class="form-control form-control-sm" />
            <span asp-validation-for="NmlRate" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ExtRate" class="control-label"></label>
            <input asp-for="ExtRate" class="form-control form-control-sm" />
            <span asp-validation-for="ExtRate" class="text-danger"></span>
        </div>
        <div class="form-check">
            <input type="checkbox" asp-for="OnlyBasic" class="form-check-input" id="chkOnlyBasic">
            <label class="form-check-label" for="chkOnlyBasic">Apply only for basic salary</label>
            <span asp-validation-for="OnlyBasic" class="text-danger"></span>
        </div>

        <div class="form-group"></div>

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}
