                 <label asp-for="EmpSysId" class="control-label"></label>
                 <p>@ViewBag.EmpName</p>
             </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-12">
                 <label asp-for="Ref" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.Ref)</p>
             </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-6">
                 <label asp-for="EftYear" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.EftYear)</p>
