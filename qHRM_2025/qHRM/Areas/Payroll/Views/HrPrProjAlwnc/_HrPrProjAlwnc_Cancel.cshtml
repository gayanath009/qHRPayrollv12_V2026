@model qHRM.Areas.Payroll.Models.HrPrProjAlwnc
<h5>Are you sure you want to cancell this?</h5>
@using (Html.BeginForm("Cancel", "HrPrProjAlwnc", new { area = "Payroll" }, FormMethod.Post))
{
