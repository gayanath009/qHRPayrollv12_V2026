@model qHRM.Areas.Payroll.Data.PayrollContext.HrPrLvSlryVw

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/ej2.min.js"></script>
<ejs-scripts></ejs-scripts>
<ejs-treeview id="listdata"></ejs-treeview>
<div>
    <main>
        <div class="container-fluid">
            <h1 class="mt-4">Leave Encashment</h1>
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item"><a href="#">Payroll</a></li>
                <li class="breadcrumb-item active">Leave Encashment</li>
            </ol>
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group col-md-1"></div>
                        <div class="form-group col-md-4">
                            <select placeholer="Select Employee" id="drpEmp"
                                    asp-items="@(new SelectList(ViewBag.lstEmployee, "EmpSysId", "FullName"))" onchange="loadEmpSmry(0);" class="form-control form-control-sm">
                                <option value="0">Select Employee</option>
                            </select>
                        </div>
                        <div class="form-group col-md-1"></div>
                    </div>
                    <div class="form-row">
                        <div tabindex="0" class="e-card text-left">
                            <div class="form-row"></div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Emp Id</label>
                                    <input id="txtEmpId" asp-for="EmpId" disabled class="form-control form-control-sm" value="Emp Id" />
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label control-labell-sm">Name</label>
                                    <input id="txtEmpName" asp-for="EmpName" disabled class="form-control form-control-sm" value="Emp Name" />
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="control-label control-labell-sm">Leave Policy</label>
                                    <input id="txtLvPlcyName" asp-for="LvPlcyName" disabled class="form-control form-control-sm" value="Lv Plcy Name" />
                                </div>
                                <div class="form-group col-md-1"></div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Joined Date</label>
                                    <input id="dtJndDt" disabled class="form-control form-control-sm" value="Joined Date" />
                                </div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Re-Joined Date</label>
                                    <input id="dtRjndDt" disabled class="form-control form-control-sm" value="Re-joined Date" />
                                </div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Effective Working Days</label>
                                    <input id="txtEftWrkDys" asp-for="EftWrkDys" disabled class="form-control form-control-sm" value="0" style="text-align: center" />
                                </div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Gross Salary</label>
                                    <input id="txtGrsSlry" disabled class="form-control form-control-sm" value="Gross Salary" style="text-align: right" />
                                </div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Project Allowance</label>
                                    <input id="txtPrjAlwnc" disabled class="form-control form-control-sm" value="Prj Alwnc" style="text-align: right" />
                                </div>
                                <div class="form-group col-md-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div tabindex="1" class="e-card text-left">
                            <div class="form-row"></div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Leave Start Date</label>
                                    <input type="date" id="dtFrmDt" asp-for="FrmDt" class="form-control form-control-sm" value="FrmDt" />
                                </div>
                                <div class="form-group col-md-2">
                                    <label class="control-label control-labell-sm">Leave End Date</label>
                                    <input type="date" id="dtToDt" asp-for="ToDt" class="form-control form-control-sm" value="ToDt" />
                                </div>
                                <div class="form-group col-md-2">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkIncldLstMnthSlry">
                                        <label class="form-check-label" for="chkIncldLstMnthSlry">Include Leave Month Salary</label>
                                    </div>
                                </div>
                                <div class="form-group col-md-2">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkIncldPrjAlwnc">
                                        <label class="form-check-label" for="chkIncldPrjAlwnc">Include Project Allowance</label>
                                    </div>
                                </div>
                                <div class="form-group col-md-2">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkIncldTktFee" onclick="enblTktFee()">
                                        <label class="form-check-label" for="chkIncldTktFee">Include Ticket Fee</label>
                                    </div>
                                    <input id="txtTktFeeVal" asp-for="TktFee" disabled class="form-control form-control-sm" value="0.00" style="text-align: center" />
                                </div>
                                <div class="form-group col-md-1"></div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-5"></div>
                                <div class="form-group col-md-2">
                                    <input type="button" value="Calculate" class="btn btn-sm btn-outline-primary btn-block" onclick="calculate();" />
                                </div>
                                <div class="form-group col-md-5"></div>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div tabindex="2" class="e-card text-left">
                            <div class="form-row"><div class="form-group col-md-12"></div></div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Eligible for Encashment</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtElgblty" asp-for="Elgblty" disabled class="form-control form-control-sm" value="Eligibility" style="text-align: center" />
                                </div>
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-6"></div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Total Number of Days</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtWrkDys" asp-for="WrkDys" disabled class="form-control form-control-sm" value="00" style="text-align: center" />
                                </div>
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Leave Salary</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtLvSlry" asp-for="LvSlry" disabled class="form-control form-control-sm" value="0.00" style="text-align: right" />
                                </div>
                                <div class="form-group col-md-2"></div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Absent/Nopay Leaves</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtNpCnt" asp-for="NpCnt" disabled class="form-control form-control-sm" value="00" style="text-align: center" />
                                </div>
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Leave Month Salary</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtLstMntSlry" asp-for="LstMntSlry" disabled class="form-control form-control-sm" value="0.00" style="text-align: right" />
                                </div>
                                <div class="form-group col-md-2"></div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Earned Leaves</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtErndLvCnt" asp-for="ErndLvCnt" disabled class="form-control form-control-sm" value="00" style="text-align: center" />
                                </div>
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Total Ticket Fee</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtTktFee" asp-for="TktFee" disabled class="form-control form-control-sm" value="0.00" style="text-align: right" />
                                </div>
                                <div class="form-group col-md-2"></div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Per Day Salary</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtPdySlry" asp-for="PdySlry" disabled class="form-control form-control-sm" value="00" style="text-align: center" />
                                </div>
                                <div class="form-group col-md-1"></div>
                                <div class="form-group col-md-3">
                                    <label class="control-label control-labell-sm">Total Amount</label>
                                </div>
                                <div class="form-group col-md-1">
                                    <input id="txtTtlAmt" asp-for="TtlAmt" disabled class="form-control form-control-sm" value="0.00" style="text-align: right" />
                                </div>
                                <div class="form-group col-md-2"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <p>
                    <div>
                        <a href="#" class="btn btn-sm btn-primary" id="btnCreate" onclick="createFunc();">
                            Add New
                        </a>
                        @if (ViewBag.Rec_Add == true)
                        {

                        }
                    </div>
                </p>
                <!--Grid-->
                <div class="control-section">
                    <ejs-grid id="Grid" width="auto" dataSource="ViewBag.DataSource" allowPaging="true" allowFiltering="true" toolbarClick="toolbarClick">
                        <e-grid-filterSettings type="CheckBox"></e-grid-filterSettings>
                        <e-grid-pagesettings pageCount=5></e-grid-pagesettings>
                        <e-grid-columns>
                            <e-grid-column field="PrcdDt" headerText="Date" width="50"></e-grid-column>
                            <e-grid-column field="EmpId" headerText="Id" width="50"></e-grid-column>
                            <e-grid-column field="EmpName" headerText="Name" width="100"></e-grid-column>
                            <e-grid-column field="DptName" headerText="Department" width="100"></e-grid-column>
                            <e-grid-column field="LvPlcy" headerText="LV Policy" width="70"></e-grid-column>
                            <e-grid-column field="IncldPrjAlwnc" headerText="Add Project Alwnc" width="50"></e-grid-column>
                            <e-grid-column field="IncldLstMnthSlry" headerText="Add Last Month Salary" width="50"></e-grid-column>
                            <e-grid-column field="IncldTktFee" headerText="Ticket Fee" width="50"></e-grid-column>
                            <e-grid-column field="FrmDt" headerText="From Date" width="80" format='yMd'></e-grid-column>
                            <e-grid-column field="ToDt" headerText="To Date" width="80" format='yMd'></e-grid-column>
                            <e-grid-column field="EftWrkDys" headerText="Effective Days" width="50"></e-grid-column>
                            <e-grid-column field="NpCnt" headerText="No pays" width="50"></e-grid-column>
                            <e-grid-column field="ErndLvCnt" headerText="Earned Leaves" width="50"></e-grid-column>
                            <e-grid-column field="LvSlry" headerText="Leave Salary" width="70"></e-grid-column>
                            <e-grid-column field="LstMntSlry" headerText="Lv Month Salary" width="70"></e-grid-column>
                            <e-grid-column field="TktFee" headerText="Ticket Fee" width="70"></e-grid-column>

                            <e-grid-column field="" headerText="" template="#_edit" width="50"></e-grid-column>
                            <e-grid-column field="" headerText="" template="#_cancel" width="50"></e-grid-column>

                            @if (ViewBag.Rec_Edit == true)
                            {

                            }
                            @if (ViewBag.Rec_Delete == true)
                            {

                            }
                        </e-grid-columns>
                    </ejs-grid>
                </div>
                <!--Grid-->
                <!--Create-->
                <div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Add New Encashment</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" id="createModalBody">
                            </div>
                        </div>
                    </div>
                </div>
                <!--Create-->
                <!--Edit-->
                <div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Edit Encashment</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" id="editModalBody">
                            </div>
                        </div>
                    </div>
                </div>
                <!--Edit-->
                <!--Cancel-->
                <div class="modal" id="modalCancel" tabindex="-1" role="dialog">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Cancel Encashment</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" id="deleteModalBody">
                            </div>
                        </div>
                    </div>
                </div>
                <!--Delete-->
            </div>
        </div>
    </main>
</div>

<!--Command Buttons-->
<script type="text/x-jsrender" id="_edit">
    <a href="#" class="btn btn-sm btn-primary btn-block" onclick="editFunc(${ LvEncshId })">
        <span class="glyphicon glyphicon-pencil"></span>
    </a>
</script>
<script type="text/x-jsrender" id="_cancel">
    <a href="#" class="btn btn-sm btn-primary btn-block" onclick="cancelFunc(${ LvEncshId })">
        <span class="glyphicon glyphicon-trash"></span>
    </a>
</script>
<!--Command Buttons-->
<!--Open Partial Views-->
<script>
    var createFunc = function () {
        var url = "/Payroll/HrPrLvEncsh/CreateNew";
        $("#createModalBody").load(url, function () {
            $("#modalCreate").modal("show");
        })
    }

    var editFunc = function (lvEncshId) {
        var url = "/Payroll/HrPrLvEncsh/EditGet?lvEncshId=" + lvEncshId;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
        })
    }

    var deleteFunc = function (lvEncshId) {
        var url = "/Payroll/HrPrLvEncsh/DeleteGet?lvEncshId=" + lvEncshId;
        $("#deleteModalBody").load(url, function () {
            $("#modalDelete").modal("show");
        })
    }
</script>
<!--Open Partial Views-->
@*AJAX Data Load*@
<script>
    var loadEmpSmry = function (calc) {
        var empSysId = $("#drpEmp").val();

        $.ajax(
            {
                type: "GET",
                contentType: "application/json; charset=utf-8",
                url: "@(Url.Action("GetEmpData", "HrPrLvEncsh"))",
                data: { empSysId: empSysId },
                dataType: "json",
                success: function (data) {
                    $("#txtEmpId").val(data.data["EmpId"]);
                    $("#txtEmpName").val(data.data["EmpName"]);
                    $("#txtLvPlcyName").val(data.data["LvPlcyName"]);
                    $("#dtJndDt").val(data.data["JndDtTxt"]);
                    $("#dtRjndDt").val(data.data["RjndDtTxt"]);
                    $("#txtEftWrkDys").val(data.data["EftWrkgDys"]);
                    $("#txtGrsSlry").val(data.data["GrsSlryTxt"]);
                    $("#txtPrjAlwnc").val(data.data["PrjAlwncTxt"]);
                    if (calc == 0) {
                        resetCalc();
                    }
                },
                error: function (xhr, err) {
                    //toastObj.show(toasts[1]);
                }
            }
        );
    }

    function calculate() {
        var errorCount = 0;//Error Count
        var empSysId = $("#drpEmp").val();
        var frmDt = $("#dtFrmDt").val();
        var toDt = $("#dtToDt").val();
        var lstMnthSlry = $("#chkIncldLstMnthSlry").is(":checked");
        var prjAlwnc = $("#chkIncldPrjAlwnc").is(":checked");
        var tktFee = $("#chkIncldTktFee").is(":checked");
        var tktFeeVal = $("#txtTktFeeVal").val();

        if (empSysId == 0) {
            errorCount += 1;
            alert("Select an employee");
            toastObj.show(toasts[0]);
        }
        else if (frmDt == "") {
            errorCount += 1;
            alert("Select leave start date");
            toastObj.show(toasts[1]);
        }
        else if (toDt == "") {
            errorCount += 1;
            alert("Select leave end date");
            toastObj.show(toasts[2]);
        }
        if (errorCount == 0) {
            loadEmpSmry(1);
            $.ajax(
            {
                type: "GET",
                contentType: "application/json; charset=utf-8",
                url: "@(Url.Action("GetClacResult", "HrPrLvEncsh"))",
                    data: { empSysId: empSysId, frmDt: frmDt, toDt: toDt, lstMnthSlry: lstMnthSlry, prjAlwnc: prjAlwnc, tktFee: tktFee, tktFeeVal: tktFeeVal},
                dataType: "json",
                    success: function (data) {
                        $("#txtElgblty").val(data.data["Elgbl"])
                        $("#txtWrkDys").val(data.data["WrkDys"]);
                        $("#txtLvSlry").val(data.data["LvSlry"]);
                        $("#txtNpCnt").val(data.data["NpCnt"]);
                        $("#txtLstMntSlry").val(data.data["LstMntSlry"]);
                        $("#txtErndLvCnt").val(data.data["ErndLvCnt"]);
                        $("#txtTktFee").val(data.data["TktFee"]);
                        $("#txtPdySlry").val(data.data["PdySlry"]);
                        $("#txtTtlAmt").val(data.data["TtlAmt"]);
                    },
                error: function (xhr, err) {
                    //toastObj.show(toasts[1]);
                }
            }
            );
        }
    }

    function resetCalc() {
        $("#txtElgblty").val("Eligibility")
        $("#txtWrkDys").val("00");
        $("#txtLvSlry").val("0.00");
        $("#txtNpCnt").val("00");
        $("#txtLstMntSlry").val("0.00");
        $("#txtErndLvCnt").val("00");
        $("#txtTktFee").val("0.00");
        $("#txtPdySlry").val("0.00");
        $("#txtTtlAmt").val("0.00");
        chkIncldLstMnthSlry.checked = false;
        chkIncldPrjAlwnc.checked = false;
        chkIncldTktFee.checked = false;
    }

    function enblTktFee() {
        var txtTktFee = document.getElementById("txtTktFeeVal");
        if (chkIncldTktFee.checked == true) {
            txtTktFee.disabled = false;
        }
        else {
            $("#txtTktFeeVal").val("0.00");
            txtTktFee.disabled = true;
        }
    }
    
</script>

<script>
    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];
    }
</script>

<!--Start Toast Start-->
<script type="text/javascript">

    var toastObj;
    var toasts = [
        { title: 'Warning!', content: 'Select Employee.', cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' },
        { title: 'Warning!', content: 'Enter leave start date.', cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' },
        { title: 'Warning!', content: 'Enter leave end date.', cssClass: 'e-toast-warning', icon: 'e-warning toast-icons' },
    ];
    var btnEleHide = document.getElementById('hideToast');

    setTimeout(
        () => {
            toastObj.show({
                target: document.body
            });
        }, 500);

    function created() {
        toastObj = this;
    }

    function onclose(e) {
        if (e.toastContainer.childElementCount === 0) {
            btnEleHide.style.display = 'none';
        }
    }
    function onBeforeOpen() {
        btnEleHide.style.display = 'inline-block';
    }
</script>

<style>
    @@font-face {
        font-family: 'Toast_icons';
        src: url(data:application/x-font-ttf;charset=utf-8;base64,) format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    #toast_types button {
        margin: 5px;
        min-width: 160px;
        max-width: 160px;
    }

    .toast-icons {
        font-family: 'Toast_icons' !important;
        speak: none;
        font-size: 55px;
        font-style: normal;
        font-weight: normal;
        font-variant: normal;
        text-transform: none;
        line-height: 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    #toast_type .e-toast-icon.e-icons {
        height: auto;
        font-size: 30px;
    }

    .toast-icons.e-success::before {
        content: "\e701";
    }

    .toast-icons.e-error::before {
        content: "\e700";
    }

    .toast-icons.e-info::before {
        content: "\e704";
    }

    .toast-icons.e-warning::before {
        content: "\e703";
    }
</style>
<!--End Toast End-->