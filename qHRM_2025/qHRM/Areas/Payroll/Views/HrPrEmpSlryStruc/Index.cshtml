@model IEnumerable<qHRM.Areas.Payroll.Models.HrPrEmpSlryStrucVw>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/ej2.min.js"></script>
<ejs-scripts></ejs-scripts>
<ejs-treeview id="listdata"></ejs-treeview>
<style>
    /* ============================================================
       PAGE HEADER & CREATE BUTTON - ORGINFO STYLE (#540033)
       ============================================================ */
    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 0.75rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: 0 1px 6px rgba(2,6,23,0.04);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: #fdf2f8;
        color: #540033;
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        border: 1px solid #fbcfe8;
        display: inline-block;
        line-height: 1;
    }

    .org-breadcrumb {
        font-size: 0.75rem;
        color: #475569;
        margin-top: 0.15rem;
        line-height: 1.2;
    }

    /* Create Button */
    .org-btn-create {
        background: linear-gradient(135deg, #540033 0%, #750047 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 0.45rem 1rem !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        letter-spacing: 0.01em !important;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease !important;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.25) !important;
        text-decoration: none !important;
    }

    .org-btn-create:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(84, 0, 51, 0.35) !important;
        color: #ffffff !important;
    }
</style>
<div>
    <main>
        <div class="container-fluid px-0">
            <!-- COMPACT HERO HEADER -->
            <div class="org-hero-card">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center" style="gap: 0.75rem;">
                    <div class="d-flex align-items-center">
                        <div class="org-icon-badge mr-3">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap" style="gap: 0.5rem;">
                                <h1 class="org-title">Salary Structures</h1>
                                <span class="badge org-category-pill">PAYROLL</span>
                            </div>
                            <div class="org-breadcrumb">
                                <a href="#">Payroll</a> / <span class="text-dark font-weight-medium">Salary Structures</span>
                                <span class="text-muted mx-1">&bull;</span>
                                <span class="text-muted">Employee monthly salary package breakdown &amp; components</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        @if (ViewBag.RecAdd == true)
                        {
                            <button type="button" class="btn org-btn-create" id="btnCreate" onclick="createFunc();">
                                <i class="fas fa-plus-circle mr-1"></i> Add New
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <!--Grid-->
                    <div class="control-section">
                        <ejs-grid id="Grid" width="auto" dataSource="ViewBag.DataSource" allowPaging="true" allowGrouping=" true" allowFiltering="true" allowResizing="true"
                                  allowExcelExport="true" allowPdfExport="true" toolbarClick="toolbarClick" toolbar="@(new List<string>() {"ExcelExport"} )">
                            <e-grid-filterSettings type="CheckBox"></e-grid-filterSettings>
                            <e-grid-pagesettings pageCount=5></e-grid-pagesettings>
                            <e-grid-columns>
                                <e-grid-column field="EmpId" headerText="Employee Id" width="100"></e-grid-column>
                                <e-grid-column field="EmpName" headerText="Employee Name" width="125"></e-grid-column>
                                <e-grid-column field="DesigName" headerText="Designation" width="100"></e-grid-column>
                                <e-grid-column field="DeptName" headerText="Department" width="100"></e-grid-column>
                                <e-grid-column field="Basic" headerText="Basic" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="HrAlwnc" headerText="Accommodation" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="TrnsAlwnc" headerText="Transport" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="PstnAlwnc" headerText="Position" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="MedAlwnc" headerText="Medical" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="MobAlwnc" headerText="Mobile" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="ProjAlwnc" headerText="Project" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="OthrAlwnc" headerText="Other" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="SpcAlwnc" headerText="Special" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="IncntvPrc" headerText="Incentive (%)" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="PrfmAlwnc" headerText="Performance" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="AirTcktFee" headerText="Air Ticket" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="Nt_Slry" headerText="Net Salary" format="N2" textAlign="Right" width="100"></e-grid-column>
                                <e-grid-column field="OtCode" headerText="OT Code" width="100"></e-grid-column>
                                @if (ViewBag.RecEdit == true)
                                {
                                    <e-grid-column field="" headerText="" template="#_edit" width="60"></e-grid-column>
                                }
                            </e-grid-columns>
                        </ejs-grid>
                    </div>
                    <!--Grid-->
                    <!--Create-->
                    <div class="modal fade" id="modalCreate" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLongTitle">Add Salary Details</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body" id="createModalBody">
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--Create-->
                    <!--Edit-->
                    <div class="modal fade" id="modalEdit" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLongTitle">Edit Salary Details</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body" id="editModalBody">
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--Edit-->                
                </div>
            </div>
        </div>
    </main>
</div>

<!--Command Buttons-->
<script type="text/x-jsrender" id="_edit">
    <a href="#" class="btn btn-sm btn-primary btn-block" onclick="editFunc(${SlStrcId})">
        <span class="glyphicon glyphicon-pencil"></span>
    </a>
</script>

<!--Command Buttons-->
<!--Open Partial Views-->
<script>
    var createFunc = function () {
        var url = "/Payroll/HrPrEmpSlryStruc/CreateNew";
        $("#createModalBody").load(url, function () {
            $("#modalCreate").modal("show");                         
        })
    }

    var editFunc = function (id) {
        var url = "/Payroll/HrPrEmpSlryStruc/EditGet?id=" + id;
        $("#editModalBody").load(url, function () {
            $("#modalEdit").modal("show");
        })
    }
   
</script>
<!--Open Partial Views-->

<script>
    function toolbarClick(args) {
        var gridObj = document.getElementById("Grid").ej2_instances[0];
        
        if (args.item.id === 'Grid_excelexport') {
            gridObj.excelExport();
        }

    }
</script>