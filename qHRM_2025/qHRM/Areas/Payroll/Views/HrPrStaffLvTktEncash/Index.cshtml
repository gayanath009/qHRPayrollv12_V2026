                                    {
                                        <tr><td colspan="18" class="text-center text-muted py-2">No eligible in-house staff found for this cycle.</td></tr>
                                    }
                                    @foreach (var emp in internalStaff)
                                    {
                                        <tr class="emp-row" data-sysid="@emp.EmpSysId" data-cat="INTERNAL"
                                            data-encashid="@emp.EncashId" data-salary="@emp.MonthlySalary.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-dailysalary="@emp.DailySalary.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" data-netdays="@emp.NetLeaveDays"
                                            data-tktprice="@emp.TktPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" data-leavesalary="@emp.TotalLeaveSalary.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-year="@emp.PrcYear" data-month="@emp.PrcMonth"
                                            data-joined="@emp.JoinedDate.ToString("yyyy-MM-dd")"
                                            data-vacreturn="@(emp.VacationReturnDate.HasValue ? emp.VacationReturnDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-reset="@emp.NextResetDate.ToString("yyyy-MM-dd")"
                                            data-appdays="@emp.ApplicableDays" data-eligdays="@emp.EligibleLeaveDays.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-paidleave="@emp.PaidLeaveDays.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)">
                                            <td class="text-center font-weight-bold">@emp.EmpId</td>
                                            <td class="text-center">@emp.CourtesyTitle</td>
                                            <td>@emp.FullName</td>
                                            <td>@emp.Department</td>
                                            <td>@emp.Designation</td>
                                            <td class="text-center">@emp.JoinedDateStr</td>
                                            <td class="text-center">@emp.VacationReturnDateStr</td>
                                            <td>@emp.Nationality</td>
                                            <td class="text-center">@emp.NextResetDateStr</td>
                                            <td class="text-center">@emp.ApplicableDays</td>
                                            <td class="text-right">@emp.EligibleLeaveDays.ToString("F5")</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="365" value="@emp.NetLeaveDays" class="form-control form-control-sm netdays-input" onchange="onNetDaysChanged(this);" @(isCompleted ? "disabled" : "") />
                                            </td>
                                            <td class="text-right">@emp.MonthlySalary.ToString("N2")</td>
                                            <td class="text-right font-weight-bold leave-salary-cell">@(emp.TotalLeaveSalary > 0 ? emp.TotalLeaveSalary.ToString("N2") : "-")</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="4" value="@emp.TktCount" class="form-control form-control-sm tkt-input" onchange="onTktCountChanged(this);" @(isCompleted ? "disabled" : "") />
                                            </td>
                                            <td class="text-right tkt-value-cell">@emp.AirTicketValue.ToString("N2")</td>
                                            <td class="text-right font-weight-bold total-settle-cell">@emp.TotalSettlement.ToString("N2")</td>
                                            <td class="small remarks-cell">@emp.Remarks</td>
                                        </tr>
                                    }
                                    <tr class="subtotal-row" id="rowSubtotalInternal">
                                        <td colspan="13" class="text-right">Total Leave Salary &amp; Air Ticket for In-House Staff:</td>
                                        <td class="text-right font-weight-bold" id="subtotalInternalLeave">@string.Format("{0:N2}", ViewBag.InternalLeaveTotal ?? 0)</td>
                                        <td></td>
                                        <td class="text-right font-weight-bold" id="subtotalInternalTicket">@string.Format("{0:N2}", ViewBag.InternalTicketTotal ?? 0)</td>
                                        <td class="text-right font-weight-bold" id="subtotalInternalSettlement">@string.Format("{0:N2}", ViewBag.InternalSettlementTotal ?? 0)</td>
                                        <td></td>
                                    </tr>
                                }

                                @if (selectedCat == "ALL" || selectedCat == "OUTSOURCE")
                                {
                                    <tr class="group-header-row">
                                        <td colspan="18"><i class="fas fa-users-cog mr-1"></i> Outsource Staff</td>
                                    </tr>
                                    @if (!outsourceStaff.Any())
                                    {
                                        <tr><td colspan="18" class="text-center text-muted py-2">No eligible outsource staff found for this cycle.</td></tr>
                                    }
                                    @foreach (var emp in outsourceStaff)
                                    {
                                        <tr class="emp-row" data-sysid="@emp.EmpSysId" data-cat="OUTSOURCE"
                                            data-encashid="@emp.EncashId" data-salary="@emp.MonthlySalary.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-dailysalary="@emp.DailySalary.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" data-netdays="@emp.NetLeaveDays"
                                            data-tktprice="@emp.TktPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" data-leavesalary="@emp.TotalLeaveSalary.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-year="@emp.PrcYear" data-month="@emp.PrcMonth"
                                            data-joined="@emp.JoinedDate.ToString("yyyy-MM-dd")"
                                            data-vacreturn="@(emp.VacationReturnDate.HasValue ? emp.VacationReturnDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-reset="@emp.NextResetDate.ToString("yyyy-MM-dd")"
                                            data-appdays="@emp.ApplicableDays" data-eligdays="@emp.EligibleLeaveDays.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-paidleave="@emp.PaidLeaveDays.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)">
                                            <td class="text-center font-weight-bold">@emp.EmpId</td>
                                            <td class="text-center">@emp.CourtesyTitle</td>
                                            <td>@emp.FullName</td>
                                            <td>@emp.Department</td>
                                            <td>@emp.Designation</td>
                                            <td class="text-center">@emp.JoinedDateStr</td>
                                            <td class="text-center">@emp.VacationReturnDateStr</td>
                                            <td>@emp.Nationality</td>
                                            <td class="text-center">@emp.NextResetDateStr</td>
                                            <td class="text-center">@emp.ApplicableDays</td>
                                            <td class="text-right">@emp.EligibleLeaveDays.ToString("F5")</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="365" value="@emp.NetLeaveDays" class="form-control form-control-sm netdays-input" onchange="onNetDaysChanged(this);" @(isCompleted ? "disabled" : "") />
                                            </td>
                                            <td class="text-right">@emp.MonthlySalary.ToString("N2")</td>
                                            <td class="text-right font-weight-bold leave-salary-cell">@(emp.TotalLeaveSalary > 0 ? emp.TotalLeaveSalary.ToString("N2") : "-")</td>
                                            <td class="text-center">
                                                <input type="number" min="0" max="4" value="@emp.TktCount" class="form-control form-control-sm tkt-input" onchange="onTktCountChanged(this);" @(isCompleted ? "disabled" : "") />
                                            </td>
                                            <td class="text-right tkt-value-cell">@emp.AirTicketValue.ToString("N2")</td>
                                            <td class="text-right font-weight-bold total-settle-cell">@emp.TotalSettlement.ToString("N2")</td>
                                            <td class="small remarks-cell">@emp.Remarks</td>
                                        </tr>
                                    }
                                    <tr class="subtotal-row" id="rowSubtotalOutsource">
                                        <td colspan="13" class="text-right">Total Leave Salary &amp; Air Ticket for Outsource Staff:</td>
                                        <td class="text-right font-weight-bold" id="subtotalOutsourceLeave">@string.Format("{0:N2}", ViewBag.OutsourceLeaveTotal ?? 0)</td>
                                        <td></td>
                                        <td class="text-right font-weight-bold" id="subtotalOutsourceTicket">@string.Format("{0:N2}", ViewBag.OutsourceTicketTotal ?? 0)</td>
                                        <td class="text-right font-weight-bold" id="subtotalOutsourceSettlement">@string.Format("{0:N2}", ViewBag.OutsourceSettlementTotal ?? 0)</td>
                                        <td></td>
                                    </tr>
                                }

                                <!-- Grand Total -->
                                <tr class="grandtotal-row" id="rowGrandTotal">
                                    <td colspan="16" class="text-right">Grand Total Settlement:</td>
                                    <td class="text-right font-weight-bold" style="color: #540033;" id="grandTotalSettlement">@string.Format("{0:N2}", ViewBag.GrandTotal ?? 0)</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ─── Complete Process Confirmation Modal ─── -->
<div class="modal fade" id="modalCompleteEncash" tabindex="-1" role="dialog" aria-labelledby="modalCompleteEncashLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0;">
            <div class="modal-header" style="background: linear-gradient(135deg, #22c55e, #16a34a); color: #ffffff;">
                <h5 class="modal-title font-weight-bold" id="modalCompleteEncashLabel">
                    <i class="fas fa-check-circle mr-2"></i> Complete Leave Encashment Cycle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2 font-weight-bold text-gray-800" style="font-size: 1rem;">
                    Are you sure you want to complete the Leave Salary &amp; Air Ticket Encashment for <span class="text-primary">@monthName @selectedYear</span>?
                </p>
                <div class="alert alert-warning mb-0" style="font-size: 0.85rem; border-radius: 8px;">
                    <i class="fas fa-exclamation-triangle mr-1"></i>
                    <strong>Important:</strong> Once completed, the encashment process for this month will be locked as finished, and the system will automatically advance to prepare for the next cycle.
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success btn-sm px-4" id="btnConfirmCompleteModal" onclick="confirmCompleteProcess();">
                    <i class="fas fa-check mr-1"></i> Confirm &amp; Complete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function onCalculateLoad() {
        var y = $('#selYear').val();
        var m = $('#selMonth').val();
        var cat = $('#selCategory').val();
        window.location.href = '/Payroll/HrPrStaffLvTktEncash/Index?year=' + y + '&month=' + m + '&staffCat=' + cat + '&load=true';
    }

    function onNetDaysChanged(input) {
        var tr = $(input).closest('tr');
        var netDays = parseInt($(input).val());
        if (isNaN(netDays) || netDays < 0) { netDays = 0; $(input).val(0); }
        tr.data('netdays', netDays);

        var monthlySalary = parseFloat(tr.data('salary')) || 0;
        var leaveSalary = (netDays % 30 === 0 && netDays > 0) ? (netDays / 30) * monthlySalary : Math.round((monthlySalary / 30.0) * netDays * 100) / 100;
        tr.data('leavesalary', leaveSalary);

        tr.find('.leave-salary-cell').text(leaveSalary > 0 ? leaveSalary.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "-");

        var tktCount = parseInt(tr.find('.tkt-input').val()) || 0;
        var tktPrice = parseFloat(tr.data('tktprice')) || 0;
        var tktValue = Math.round(tktCount * tktPrice * 100) / 100;
        var settlement = Math.round((leaveSalary + tktValue) * 100) / 100;

        tr.find('.total-settle-cell').text(settlement.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        // Remarks update
        var remarks = "-";
        if (netDays > 0 && tktCount > 1) {
            remarks = (netDays < 10 ? "0" + netDays : netDays) + " Days Leave Salary & Air Fare Encashment (self & family)";
        } else if (netDays > 0 && tktCount <= 1) {
            remarks = (netDays < 10 ? "0" + netDays : netDays) + (netDays > 1 ? " Days" : " Day") + " Leave Salary & Air Fare Encashment";
        } else if (netDays === 0 && tktValue > 0) {
            remarks = "Air Fare Encashment";
        }
        tr.find('.remarks-cell').text(remarks);

        recalcTotals();
    }

    function onTktCountChanged(input) {
        var tr = $(input).closest('tr');
        var tktCount = parseInt($(input).val()) || 0;
        if (tktCount < 0) { tktCount = 0; $(input).val(0); }
        if (tktCount > 4) { tktCount = 4; $(input).val(4); }

        var tktPrice = parseFloat(tr.data('tktprice')) || 0;
        var leaveSalary = parseFloat(tr.data('leavesalary')) || 0;
        var netDays = parseInt(tr.find('.netdays-input').val()) || 0;

        var tktValue = Math.round(tktCount * tktPrice * 100) / 100;
        var settlement = Math.round((leaveSalary + tktValue) * 100) / 100;

        tr.find('.tkt-value-cell').text(tktValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        tr.find('.total-settle-cell').text(settlement.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        // Remarks update
        var remarks = "-";
        if (netDays > 0 && tktCount > 1) {
            remarks = (netDays < 10 ? "0" + netDays : netDays) + " Days Leave Salary & Air Fare Encashment (self & family)";
        } else if (netDays > 0 && tktCount <= 1) {
            remarks = (netDays < 10 ? "0" + netDays : netDays) + (netDays > 1 ? " Days" : " Day") + " Leave Salary & Air Fare Encashment";
        } else if (netDays === 0 && tktValue > 0) {
            remarks = "Air Fare Encashment";
        }
        tr.find('.remarks-cell').text(remarks);

        recalcTotals();
    }

    function recalcTotals() {
        var intLeave = 0, intTkt = 0, intSettle = 0;
        var outLeave = 0, outTkt = 0, outSettle = 0;

        $('.emp-row').each(function () {
            var tr = $(this);
            var cat = tr.data('cat');
            var leaveSalary = parseFloat(tr.data('leavesalary')) || 0;
            var tktCount = parseInt(tr.find('.tkt-input').val()) || 0;
            var tktPrice = parseFloat(tr.data('tktprice')) || 0;
            var tktValue = Math.round(tktCount * tktPrice * 100) / 100;
            var settlement = Math.round((leaveSalary + tktValue) * 100) / 100;

            if (cat === 'INTERNAL') {
                intLeave += leaveSalary;
                intTkt += tktValue;
                intSettle += settlement;
            } else if (cat === 'OUTSOURCE') {
                outLeave += leaveSalary;
                outTkt += tktValue;
                outSettle += settlement;
            }
        });

        $('#subtotalInternalLeave').text(intLeave.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#subtotalInternalTicket').text(intTkt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#subtotalInternalSettlement').text(intSettle.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        $('#subtotalOutsourceLeave').text(outLeave.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#subtotalOutsourceTicket').text(outTkt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#subtotalOutsourceSettlement').text(outSettle.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        var grand = intSettle + outSettle;
        $('#grandTotalSettlement').text(grand.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        $('#statLeaveTotal').text((intLeave + outLeave).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#statTicketTotal').text((intTkt + outTkt).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#statGrandTotal').text(grand.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $('#statBreakdown').html('<span style="color:#0891b2;">' + outSettle.toLocaleString('en-US', { maximumFractionDigits: 0 }) + '</span> / <span style="color:#475569;">' + intSettle.toLocaleString('en-US', { maximumFractionDigits: 0 }) + '</span>');
    }

    function saveAllConfirm() {
        var items = [];
        $('.emp-row').each(function () {
            var tr = $(this);
            var netDays = parseInt(tr.find('.netdays-input').val()) || 0;
            var tktCount = parseInt(tr.find('.tkt-input').val()) || 0;
            var tktPrice = parseFloat(tr.data('tktprice')) || 0;
            var leaveSalary = parseFloat(tr.data('leavesalary')) || 0;
            var tktValue = Math.round(tktCount * tktPrice * 100) / 100;
            var settlement = Math.round((leaveSalary + tktValue) * 100) / 100;

            items.push({
                encashId: parseInt(tr.data('encashid')) || 0,
                prcYear: parseInt(tr.data('year')),
                prcMonth: parseInt(tr.data('month')),
                empSysId: parseInt(tr.data('sysid')),
                staffCategory: tr.data('cat'),
                joinedDate: tr.data('joined'),
                vacationReturnDate: tr.data('vacreturn') ? tr.data('vacreturn') : null,
                nextResetDate: tr.data('reset'),
                applicableDays: parseInt(tr.data('appdays')),
                eligibleLeaveDays: parseFloat(tr.data('eligdays')),
                paidLeaveDays: parseFloat(tr.data('paidleave')),
                netLeaveDays: netDays,
                monthlySalary: parseFloat(tr.data('salary')),
                dailySalary: parseFloat(tr.data('dailysalary')),
                totalLeaveSalary: leaveSalary,
                tktCount: tktCount,
                tktPrice: tktPrice,
                airTicketValue: tktValue,
                totalSettlement: settlement,
                remarks: tr.find('.remarks-cell').text().trim()
            });
        });

        if (items.length === 0) {
            showAppNotification("Leave Encashment", "No employee records to confirm.", "warning");
            return;
        }

        $('#btnSaveAll').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Saving...');

        $.ajax({
            type: "POST",
            url: "/Payroll/HrPrStaffLvTktEncash/SaveConfirm",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(items),
            success: function (res) {
                $('#btnSaveAll').prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Confirm &amp; Save');
                if (res.ok) {
                    $('#btnSubmitEncashWf')
                        .prop('disabled', false)
                        .removeAttr('disabled')
                        .css({
                            'opacity': '1',
                            'pointer-events': 'auto',
                            'cursor': 'pointer',
                            'filter': 'none'
                        });

                    $('.status-badge')
                        .removeClass('sb-idle sb-process sb-complete')
                        .addClass('sb-verified')
                        .find('span:last-child')
                        .text('Status: Verified');

                    showAppNotification("Leave Encashment", res.message, "success");
                } else {
                    showAppNotification("Leave Encashment", "Error: " + res.message, "danger");
                }
            },
            error: function (err) {
                $('#btnSaveAll').prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Confirm &amp; Save');
                showAppNotification("Leave Encashment", "Request error: " + err.statusText, "danger");
            }
        });
    }

    function submitEncashmentWorkflow() {
        if (!confirm("Are you sure you want to submit this Leave Salary & Air Ticket Encashment for Level 1 Approval?")) {
            return;
        }
        $('#btnSubmitEncashWf').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Submitting...');
        $.ajax({
            type: "POST",
            url: "/Payroll/HrPrStaffLvTktEncash/SubmitForApproval",
            data: { year: @selectedYear, month: @selectedMonth },
            success: function (res) {
                if (res.ok) {
                    showFlashToastAndReload("Leave Encashment Workflow", res.message, "success");
                } else {
                    showAppNotification("Leave Encashment Workflow", "Error: " + res.message, "danger");
                    $('#btnSubmitEncashWf').prop('disabled', false).html('<i class="fas fa-paper-plane mr-1"></i> Submit for Approval Workflow');
                }
            },
            error: function (err) {
                showAppNotification("Leave Encashment Workflow", "Request error: " + err.statusText, "danger");
                $('#btnSubmitEncashWf').prop('disabled', false).html('<i class="fas fa-paper-plane mr-1"></i> Submit for Approval Workflow');
            }
        });
    }

    function openCompleteModal() {
        $('#modalCompleteEncash').modal('show');
    }

    function confirmCompleteProcess() {
        $('#btnConfirmCompleteModal').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Completing...');
        $.ajax({
            type: "POST",
            url: "/Payroll/HrPrStaffLvTktEncash/CompleteProcess",
            data: { year: @selectedYear, month: @selectedMonth },
            success: function (res) {
                $('#btnConfirmCompleteModal').prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Confirm &amp; Complete');
                $('#modalCompleteEncash').modal('hide');
                if (res.ok) {
                    sessionStorage.setItem('app_flash_toast', JSON.stringify({
                        title: "Leave Encashment",
                        message: res.message,
                        type: "success"
                    }));
                    window.location.href = '/Payroll/HrPrStaffLvTktEncash/Index';
                } else {
                    showAppNotification("Leave Encashment", "Error: " + res.message, "danger");
                }
            },
            error: function (err) {
                $('#btnConfirmCompleteModal').prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Confirm &amp; Complete');
                showAppNotification("Leave Encashment", "Request error: " + err.statusText, "danger");
            }
        });
    }
</script>
