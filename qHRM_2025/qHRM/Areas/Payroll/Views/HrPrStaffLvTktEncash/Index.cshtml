@model IEnumerable<qHRM.Areas.Payroll.Models.HrPrStaffLvTktEncashVw>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Staff Leave Salary & Air Ticket Encashment";

    int selectedYear = ViewBag.Year ?? DateTime.Now.Year;
    int selectedMonth = ViewBag.Month ?? DateTime.Now.Month;
    string selectedCat = ViewBag.StaffCat ?? "OUTSOURCE";
    bool isLoaded = ViewBag.IsLoaded ?? false;

    var internalStaff = Model?.Where(x => x.StaffCategory == "INTERNAL").ToList() ?? new List<qHRM.Areas.Payroll.Models.HrPrStaffLvTktEncashVw>();
    var outsourceStaff = Model?.Where(x => x.StaffCategory == "OUTSOURCE").ToList() ?? new List<qHRM.Areas.Payroll.Models.HrPrStaffLvTktEncashVw>();

    string monthName = new DateTime(selectedYear, selectedMonth, 1).ToString("MMMM");
    int prevMonth = selectedMonth == 1 ? 12 : selectedMonth - 1;
    int prevYear = selectedMonth == 1 ? selectedYear - 1 : selectedYear;
    string cutoffPeriodText = $"Cut off period 21/{prevMonth:D2}/{prevYear % 100:D2} to 20/{selectedMonth:D2}/{selectedYear % 100:D2}";

    string wfStat = ViewBag.WfStat as string ?? "Draft";
    int prcStat = ViewBag.PrcStat ?? 1;
    bool isInitiator = ViewBag.IsInitiator ?? false;
    bool isApproved = ViewBag.IsApproved ?? false;
    bool isCompleted = ViewBag.IsCompleted ?? false;
    bool isSaved = ViewBag.IsSaved ?? false;
    bool canSubmit = ViewBag.CanSubmit ?? false;
    bool canCompleteAndWps = ViewBag.CanCompleteAndWps ?? false;
    bool canGenerateWps = ViewBag.CanGenerateWps ?? false;

    string statusBadgeClass = "sb-idle";
    string wfStatDisplay = wfStat;
    if (wfStat == "PendingLevel1" || wfStat == "PendingFinal") { statusBadgeClass = "sb-process"; wfStatDisplay = "Pending Approval"; }
    else if (isCompleted) { statusBadgeClass = "sb-complete"; wfStatDisplay = "Completed"; }
    else if (isApproved) { statusBadgeClass = "sb-complete"; wfStatDisplay = "Approved"; }
    else if (wfStat == "Rejected") { statusBadgeClass = "sb-idle"; wfStatDisplay = "Rejected"; }
    else if (wfStat == "Verified" || prcStat == 2) { statusBadgeClass = "sb-verified"; wfStatDisplay = "Verified"; }

    decimal totalLeave = (ViewBag.InternalLeaveTotal ?? 0m) + (ViewBag.OutsourceLeaveTotal ?? 0m);
    decimal totalTicket = (ViewBag.InternalTicketTotal ?? 0m) + (ViewBag.OutsourceTicketTotal ?? 0m);
    decimal grandTotal = ViewBag.GrandTotal ?? 0m;
}

<style>
    :root {
        --clr-bg: #f7fafc;
        --clr-surface: #ffffff;
        --clr-surface2: #f1f5f9;
        --clr-border: rgba(2,6,23,0.08);
        --clr-accent: #6366f1;
        --clr-accent2: #8b5cf6;
        --clr-success: #16a34a;
        --clr-warning: #f59e0b;
        --clr-danger: #ef4444;
        --clr-text: #0f172a;
        --clr-muted: #475569;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow: 0 6px 24px rgba(2,6,23,0.06);
        --shadow-sm: 0 1px 6px rgba(2,6,23,0.04);
    }

    .slry-wrap { font-family: 'Inter', sans-serif; padding: 0; }

    /* ─── Header Hero Card ─── */
    .org-hero-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid var(--clr-border, #e2e8f0);
        padding: 0.85rem 1.35rem;
        margin: 0.75rem 2rem 1.25rem 2rem;
        box-shadow: 0 1px 6px rgba(2,6,23,0.04);
        position: relative;
        overflow: hidden;
    }

    .org-hero-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #540033 0%, #830050 100%);
    }

    .org-icon-badge {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: linear-gradient(135deg, #540033 0%, #750047 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        box-shadow: 0 2px 8px rgba(84, 0, 51, 0.2);
        flex-shrink: 0;
    }

    .org-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
    }

    .org-category-pill {
        background-color: #fdf2f8;
        color: #540033;
        font-weight: 700;
        font-size: 0.65rem;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        border: 1px solid #fbcfe8;
        display: inline-block;
        line-height: 1;
    }

    .org-breadcrumb {
        font-size: 0.78rem;
        color: #475569;
        margin-top: 0.2rem;
        line-height: 1.25;
    }

    /* ─── Stat KPI Cards (Matched with Salary Process Layout) ─── */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding: 0 2rem;
    }

    .stat-card {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        padding: 1.1rem 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s, border-color 0.2s;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        border-color: rgba(99,102,241,0.35);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: var(--radius) var(--radius) 0 0;
    }

    .stat-card.sc-indigo::before { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
    .stat-card.sc-green::before  { background: linear-gradient(90deg, #22c55e, #16a34a); }
    .stat-card.sc-red::before    { background: linear-gradient(90deg, #ef4444, #dc2626); }
    .stat-card.sc-amber::before  { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .stat-card.sc-cyan::before   { background: linear-gradient(90deg, #06b6d4, #0891b2); }

    .stat-card-label {
        font-size: 0.68rem !important;
        font-weight: 600 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.08em !important;
        color: var(--clr-muted);
    }

    .stat-card-val {
        font-size: 1.35rem !important;
        font-weight: 700 !important;
        color: var(--clr-text);
        margin-top: 0.25rem;
        line-height: 1.15;
        font-variant-numeric: tabular-nums;
    }

    .stat-card-sub {
        font-size: 0.7rem;
        color: var(--clr-muted);
        margin-top: 0.2rem;
        font-weight: 500;
    }

    /* ─── Main Panel Layout ─── */
    .slry-main {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 1.5rem;
        padding: 0 2rem 2rem;
    }

    @@media (max-width: 1100px) {
        .slry-main { grid-template-columns: 1fr; }
    }

    /* ─── Control Panel ─── */
    .ctrl-panel {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        padding: 1.4rem;
        box-shadow: var(--shadow-sm);
        height: fit-content;
    }

    .ctrl-panel-title {
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--clr-muted);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .ctrl-panel-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--clr-border);
    }

    .ctrl-group { margin-bottom: 1.1rem; }
    .ctrl-label  { font-size: 0.74rem; font-weight: 700; color: var(--clr-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.35rem; display: block; }
    .ctrl-select { width: 100%; background: var(--clr-surface2); border: 1px solid var(--clr-border); color: var(--clr-text); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem; font-size: 0.85rem; outline: none; transition: border-color 0.2s; font-family: 'Inter', sans-serif; }
    .ctrl-select:focus { border-color: var(--clr-accent); }
    .ctrl-divider { height: 1px; background: var(--clr-border); margin: 1.2rem 0; }

    /* ─── Action Buttons ─── */
    .action-btn {
        width: 100%;
        border: none;
        border-radius: var(--radius-sm);
        padding: 0.65rem 1rem;
        font-size: 0.84rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
        font-family: 'Inter', sans-serif;
        letter-spacing: 0.01em;
        text-decoration: none !important;
    }

    .action-btn:disabled, .action-btn[disabled] {
        opacity: 0.38 !important;
        cursor: not-allowed !important;
        box-shadow: none !important;
        filter: grayscale(35%) !important;
        pointer-events: none !important;
    }

    .btn-process {
        background: linear-gradient(135deg, #990049, #b80058);
        color: #fff !important;
        box-shadow: 0 2px 12px rgba(153,0,73,0.4);
    }
    .btn-process:hover:not(:disabled) {
        box-shadow: 0 4px 20px rgba(153,0,73,0.6);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .btn-verify {
        background: linear-gradient(135deg, #06b6d4, #0891b2);
        color: #fff !important;
        box-shadow: 0 2px 12px rgba(6,182,212,0.35);
    }
    .btn-verify:hover:not(:disabled) {
        box-shadow: 0 4px 20px rgba(6,182,212,0.55);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .btn-submit-wf {
        background: linear-gradient(135deg, #540033, #700044);
        color: #fff !important;
        box-shadow: 0 2px 12px rgba(84,0,51,0.35);
    }
    .btn-submit-wf:hover:not(:disabled) {
        box-shadow: 0 4px 20px rgba(84,0,51,0.55);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .btn-complete {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff !important;
        box-shadow: 0 2px 12px rgba(34,197,94,0.35);
    }
    .btn-complete:hover:not(:disabled) {
        box-shadow: 0 4px 20px rgba(34,197,94,0.55);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .btn-wps {
        background: linear-gradient(135deg, #0284c7, #0369a1);
        color: #fff !important;
        box-shadow: 0 2px 12px rgba(2,132,199,0.35);
    }
    .btn-wps:hover:not(:disabled) {
        box-shadow: 0 4px 20px rgba(2,132,199,0.55);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .btn-repro {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff !important;
        box-shadow: 0 2px 12px rgba(99,102,241,0.35);
    }
    .btn-repro:hover:not(:disabled) {
        box-shadow: 0 4px 20px rgba(99,102,241,0.55);
        transform: translateY(-1px);
        color: #fff !important;
    }

    /* ─── Status Badge ─── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.76rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.35rem 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .status-badge .dot { width: 7px; height: 7px; border-radius: 50%; }
    .sb-idle     { background: rgba(148,163,184,0.15); color: #64748b; } .sb-idle .dot { background: #94a3b8; }
    .sb-process  { background: rgba(99,102,241,0.15);  color: #6366f1; } .sb-process .dot { background: #6366f1; animation: pulse-dot 1.5s infinite; }
    .sb-verified { background: rgba(6,182,212,0.15);   color: #0891b2; } .sb-verified .dot { background: #06b6d4; }
    .sb-complete { background: rgba(34,197,94,0.15);   color: #16a34a; } .sb-complete .dot { background: #22c55e; }

    @@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }

    /* ─── Grid Panel ─── */
    .grid-panel {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
    }

    .grid-panel-hdr {
        padding: 0.9rem 1.35rem;
        border-bottom: 1px solid var(--clr-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .grid-panel-hdr h3 {
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--clr-text);
        margin: 0;
    }

    .grid-inner { padding: 0; }

    .grid-container {
        max-height: 520px;
        overflow-y: auto;
        overflow-x: auto;
    }

    /* ─── Encashment Table ─── */
    .encash-table {
        color: #111827 !important;
        background-color: #ffffff !important;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        margin-bottom: 0;
    }

    .encash-table th {
        background-color: #540033 !important;
        color: #ffffff !important;
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        text-align: center;
        vertical-align: middle !important;
        border: 1px solid #440028 !important;
        padding: 7px 5px !important;
        white-space: normal !important;
        word-break: normal;
        line-height: 1.25;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .encash-table td {
        color: #111827 !important;
        font-size: 0.8rem !important;
        vertical-align: middle !important;
        border: 1px solid #e2e8f0 !important;
        padding: 6px 7px !important;
        background-color: #ffffff;
    }

    .group-header-row td {
        background-color: #f1f5f9 !important;
        font-weight: 700 !important;
        color: #540033 !important;
        font-size: 0.85rem;
    }

    .subtotal-row td {
        background-color: #faf5ff !important;
        font-weight: 700 !important;
        border-top: 2px solid #540033 !important;
        border-bottom: 2px solid #540033 !important;
    }

    .grandtotal-row td {
        background-color: #fdf2f8 !important;
        font-weight: 800 !important;
        font-size: 0.95rem !important;
        border-top: 2px solid #540033 !important;
        border-bottom: 3px double #540033 !important;
    }

    .tkt-input, .netdays-input {
        width: 58px !important;
        text-align: center !important;
        font-weight: 700 !important;
        color: #111827 !important;
        background-color: #f8fafc !important;
        border: 1px solid #94a3b8 !important;
        border-radius: 4px;
        padding: 3px 4px !important;
        display: inline-block;
    }

    .tb-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.38rem 0.85rem;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: var(--radius-sm);
        text-decoration: none !important;
        transition: all 0.15s ease;
        border: 1px solid transparent;
    }
    .tb-btn-excel { background: #fdf2f8; color: #990049 !important; border-color: #fbcfe8; }
    .tb-btn-excel:hover { background: #fce7f3; }
    .tb-btn-print { background: #f1f5f9; color: #334155 !important; border-color: #cbd5e1; }
    .tb-btn-print:hover { background: #e2e8f0; }
</style>

<div class="slry-wrap">
    <!-- ─── Compact Header Card (Matching Salary Process) ─── -->
    <div class="org-hero-card">
        <div class="d-flex align-items-center justify-content-between flex-wrap" style="gap: 1rem;">
            <div class="d-flex align-items-center" style="gap: 1rem;">
                <div class="org-icon-badge">
                    <i class="fas fa-plane-departure"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center" style="gap: 0.5rem;">
                        <h2 class="org-title">Staff Leave Salary &amp; Air Ticket Encashment</h2>
                        <span class="org-category-pill">PAYROLL</span>
                    </div>
                    <div class="org-breadcrumb">
                        Payroll / Leave Salary &amp; Air Ticket Encashment &bull; Monthly leave salary and air ticket calculation, verification, and settlement generation
                    </div>
                </div>
            </div>
            <div>
                <div class="status-badge @statusBadgeClass">
                    <span class="dot"></span>
                    <span>Status: @wfStatDisplay</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── Stat Cards (Matching Salary Process Layout with Large Fonts) ─── -->
    <div class="stat-grid">
        <!-- Card 1: Processed Employees -->
        <div class="stat-card sc-indigo">
            <div class="stat-card-label">PROCESSED EMPLOYEES</div>
            <div class="stat-card-val" id="statEmpCount">@(Model?.Count() ?? 0)</div>
            <div class="stat-card-sub">Eligible Staff</div>
        </div>

        <!-- Card 2: Total Leave Salary -->
        <div class="stat-card sc-green">
            <div class="stat-card-label">TOTAL LEAVE SALARY</div>
            <div class="stat-card-val" id="statLeaveTotal">@string.Format("{0:N2}", totalLeave)</div>
            <div class="stat-card-sub">QR. (In-House + Outsource)</div>
        </div>

        <!-- Card 3: Total Air Tickets -->
        <div class="stat-card sc-red">
            <div class="stat-card-label">TOTAL AIR TICKETS</div>
            <div class="stat-card-val" id="statTicketTotal">@string.Format("{0:N2}", totalTicket)</div>
            <div class="stat-card-sub">QR. (Ticket Allowance)</div>
        </div>

        <!-- Card 4: Net Settlement (Grand Total) -->
        <div class="stat-card sc-amber">
            <div class="stat-card-label">NET SETTLEMENT (GRAND TOTAL)</div>
            <div class="stat-card-val" id="statGrandTotal" style="color: #b45309;">@string.Format("{0:N2}", grandTotal)</div>
            <div class="stat-card-sub">QR. Net Payable</div>
        </div>

        <!-- Card 5: Category Breakdown -->
        <div class="stat-card sc-cyan">
            <div class="stat-card-label">OUTSOURCE / IN-HOUSE</div>
            <div class="stat-card-val" id="statBreakdown" style="font-size: 1.1rem; margin-top: 0.25rem;">
                <span style="color:#0891b2;">@string.Format("{0:N0}", ViewBag.OutsourceSettlementTotal ?? 0)</span> / 
                <span style="color:#475569;">@string.Format("{0:N0}", ViewBag.InternalSettlementTotal ?? 0)</span>
            </div>
            <div class="stat-card-sub">Outsource vs In-House (QR)</div>
        </div>
    </div>

    <!-- ─── Main 2-Column Section (320px Controls + Grid) ─── -->
    <div class="slry-main">
        <!-- ─── Left: Process Controls ─── -->
        <div class="ctrl-panel">
            <div class="ctrl-panel-title">
                <i class="fas fa-cog"></i> Process Controls
            </div>

            <!-- Period Selection -->
            <div class="ctrl-group">
                <label class="ctrl-label">Period</label>
                <div class="d-flex" style="gap: 0.5rem;">
                    <select id="selYear" class="ctrl-select" style="width: 42%;">
                        @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                        {
                            <option value="@y" selected="@(y == selectedYear ? "selected" : null)">@y</option>
                        }
                    </select>
                    <select id="selMonth" class="ctrl-select" style="width: 58%;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            string mName = new DateTime(2026, m, 1).ToString("MMMM");
                            <option value="@m" selected="@(m == selectedMonth ? "selected" : null)">@mName</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Employee Category -->
            <div class="ctrl-group">
                <label class="ctrl-label">Employee Category</label>
                <select id="selCategory" class="ctrl-select">
                    <option value="OUTSOURCE" selected="@(selectedCat == "OUTSOURCE" ? "selected" : null)">Outsource Staff Only</option>
                    <option value="INTERNAL" selected="@(selectedCat == "INTERNAL" ? "selected" : null)">In-House Staff Only</option>
                    <option value="ALL" selected="@(selectedCat == "ALL" ? "selected" : null)">All Staff</option>
                </select>
            </div>

            <!-- Cut-off info -->
            <div class="ctrl-group">
                <div class="p-2 border rounded text-muted text-center" style="font-size: 0.72rem; background: var(--clr-surface2);">
                    <i class="fas fa-calendar-alt mr-1"></i> @cutoffPeriodText
                </div>
            </div>

            <div class="ctrl-divider"></div>

            <!-- Button Stack -->
            <!-- 1. Calculate / Load -->
            <button type="button" class="action-btn btn-process" id="btnCalculateLoad" onclick="onCalculateLoad();">
                <i class="fas fa-play"></i> Calculate / Load
            </button>

            <!-- 2 & 3: Only visible once Calculate/Load has been clicked -->
            @if (isLoaded)
            {
                <!-- 2. Confirm & Save (Cyan like Verify) -->
                <button type="button" class="action-btn btn-verify" id="btnSaveAll" onclick="saveAllConfirm();" @(isCompleted ? "disabled" : "")>
                    <i class="fas fa-check"></i> Confirm &amp; Save
                </button>

                <!-- 3. Submit for Approval Workflow (Deep Purple) - Enabled only after Confirm & Save -->
                <button type="button" class="action-btn btn-submit-wf" id="btnSubmitEncashWf" onclick="submitEncashmentWorkflow();" @(canSubmit ? "" : "disabled")>
                    <i class="fas fa-paper-plane"></i> Submit for Approval Workflow
                </button>
            }

            <!-- 4. Complete Button (Green) - Disabled during approval, enabled when Approved -->
            <button type="button" class="action-btn btn-complete" id="btnCompleteEncash" onclick="openCompleteModal();" @(canCompleteAndWps ? "" : "disabled")>
                <i class="fas fa-check-circle"></i> Complete
            </button>

            <!-- 5. Generate WPS Button (Blue) - Disabled during approval, enabled when Approved -->
            <a href="/Payroll/HrPrStaffLvTktEncash/GenerateWps?year=@selectedYear&month=@selectedMonth&staffCat=@selectedCat" 
               class="action-btn btn-wps" id="btnGenerateWps" @(canGenerateWps ? "" : "disabled")>
                <i class="fas fa-download"></i> Generate WPS
            </a>

            <!-- Excel Export & Print Report in Control Panel (Only visible when loaded) -->
            @if (isLoaded)
            {
                <div class="ctrl-divider"></div>
                <a href="/Payroll/HrPrStaffLvTktEncash/ExportExcel?year=@selectedYear&month=@selectedMonth&staffCat=@selectedCat" class="action-btn btn-repro">
                    <i class="fas fa-file-excel"></i> Excel Export
                </a>
                <a href="/Payroll/HrPrStaffLvTktEncash/PrintReport?year=@selectedYear&month=@selectedMonth&staffCat=@selectedCat" target="_blank" class="action-btn" style="background: #475569; color: #fff;">
                    <i class="fas fa-print"></i> Print Report
                </a>
            }
        </div>

        <!-- ─── Right: Grid Panel ─── -->
        <div class="grid-panel">
            <div class="grid-panel-hdr">
                <div class="d-flex align-items-center" style="gap: 0.75rem;">
                    <h3>Encashment Details</h3>
                    <span class="badge badge-light border text-muted" style="font-size: 0.75rem;">@monthName @selectedYear</span>
                </div>
                <div class="d-flex align-items-center" style="gap: 0.5rem;">
                    @if (isLoaded)
                    {
                        <a href="/Payroll/HrPrStaffLvTktEncash/ExportExcel?year=@selectedYear&month=@selectedMonth&staffCat=@selectedCat" class="tb-btn tb-btn-excel">
                            <i class="fas fa-file-excel"></i> Excel Export
                        </a>
                        <a href="/Payroll/HrPrStaffLvTktEncash/PrintReport?year=@selectedYear&month=@selectedMonth&staffCat=@selectedCat" target="_blank" class="tb-btn tb-btn-print">
                            <i class="fas fa-print"></i> Print Report
                        </a>
                    }
                    <div class="status-badge @statusBadgeClass" style="padding: 0.25rem 0.75rem; font-size: 0.72rem;">
                        <span class="dot"></span>
                        <span>@wfStatDisplay</span>
                    </div>
                </div>
            </div>

            <div class="grid-inner">
                @if (!isLoaded)
                {
                    <div class="text-center py-5 text-muted" style="padding: 3.5rem 1.5rem;">
                        <i class="fas fa-calculator fa-3x mb-3 text-gray-300"></i>
                        <h5 class="font-weight-bold text-gray-700">No Records Loaded</h5>
                        <p class="small text-muted mb-0" style="max-width: 480px; margin: 0 auto;">
                            Select the cycle <strong>Period</strong> and <strong>Employee Category</strong> on the left, then click <strong>"Calculate / Load"</strong> to view eligible staff leave salary and air ticket encashment.
                        </p>
                    </div>
                }
                else
                {
                    <div class="grid-container">
                        <table class="table table-bordered table-sm encash-table mb-0" id="encashGridTable">
                            <thead>
                                <tr>
                                    <th style="width: 80px; min-width: 80px;">Employee ID</th>
                                    <th style="width: 55px; min-width: 55px;">Title</th>
                                    <th style="width: 150px; min-width: 150px;">Full Name</th>
                                    <th style="width: 130px; min-width: 130px;">Department</th>
                                    <th style="width: 140px; min-width: 140px;">Designation</th>
                                    <th style="width: 85px; min-width: 85px;">Joined Date</th>
