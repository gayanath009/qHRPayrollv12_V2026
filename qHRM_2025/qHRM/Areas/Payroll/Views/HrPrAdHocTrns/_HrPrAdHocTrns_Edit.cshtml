@model qHRM.Areas.Payroll.Models.HrPrAdHocTrns
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Edit", "HrPrAdHocTrns", new { area = "Payroll" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <span class="alert-success">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.TrnId)
        @Html.HiddenFor(model => model.TrnTypId)
        @Html.HiddenFor(model => model.EmpSysId)
    </div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="EmpSysId" class="control-label"></label>
                <p>@ViewBag.EmpName</p>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="TrnTypId" class="control-label"></label>
                <p>@ViewBag.TrnTyp</p>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="TrnDate" class="control-label"></label>
                <input asp-for="TrnDate" class="form-control form-control-sm" />
                <span asp-validation-for="TrnDate" class="text-danger"></span>
            </div>
            <div class="form-group  col-md-3">
                <label asp-for="EftYear" class="control-label"></label>
                <input asp-for="EftYear" class="form-control form-control-sm" />
                <span asp-validation-for="EftYear" class="text-danger"></span>
            </div>
            <div class="form-group col-md-3">
                <label asp-for="EftMonth" class="control-label"></label>
                <select asp-for="EftMonth" id="drpMonthsE" class="form-control form-control-sm select2-dropdown"
                        asp-items="@(new SelectList(ViewBag.lstMonths, "Indx", "ElmntTxt", Model?.EftMonth))">
                    <option value="">-- Select Month --</option>
                </select>
                <span asp-validation-for="EftMonth" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Ref" class="control-label"></label>
                <input asp-for="Ref" class="form-control form-control-sm" />
                
            </div>
            <div class="form-group col-md-6">
                <label asp-for="TrnAmt" class="control-label"></label>
                <input asp-for="TrnAmt" class="form-control form-control-sm" style="text-align:right" />
                <span asp-validation-for="TrnAmt" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="ShtRmk" class="control-label"></label>
                <input asp-for="ShtRmk" class="form-control form-control-sm" />
                <span asp-validation-for="ShtRmk" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="Desc" class="control-label"></label>
                <input asp-for="Desc" class="form-control form-control-sm" />
                <span asp-validation-for="Desc" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group"></div>

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}

<script>
    $(function () {
        $('#modalEdit').find('.select2-dropdown').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalEdit')
        });

        $('#modalEdit').find('.select2-dropdown').on('change', function () {
            try { $(this).valid(); } catch (e) { }
        });
    });
</script>
