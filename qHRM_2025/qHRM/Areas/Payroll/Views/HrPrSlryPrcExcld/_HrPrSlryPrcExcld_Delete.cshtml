@model qHRM.Areas.Payroll.Models.HrPrSlryPrcExcld
<h5>Are you sure you want to cancel this?</h5>
@using (Html.BeginForm("Delete", "HrPrSlryPrcExcld"))
{<div>
    @Html.HiddenFor(model => model.ExcldId)

     <div class="card-body">
         <div class="form-row">
             <div class="form-group col-md-12">
                 <label asp-for="EmpSysId" class="control-label"></label>
                 <p>@ViewBag.EmpName</p>
             </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-6">
                 <label asp-for="StYear" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.StYear)</p>
             </div>
             <div class="form-group col-md-6">
                <label asp-for="StMonth" class="control-label"></label>
                <p>@Html.DisplayFor(model => model.StMonth)</p>
            </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-6">
                 <label asp-for="NoMnths" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.NoMnths)</p>
             </div>
         </div>
         <div class="form-row">
             <div class="form-group col-md-12">
                 <label asp-for="Note" class="control-label"></label>
                 <p>@Html.DisplayFor(model => model.Note)</p>
             </div>
         </div>
         <div class="form-group"></div>

         <div class="form-group">
             <input type="submit" value="DELETE" class="btn btn-sm btn-primary btn-block" />
             <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
         </div>
     </div>
</div>
}