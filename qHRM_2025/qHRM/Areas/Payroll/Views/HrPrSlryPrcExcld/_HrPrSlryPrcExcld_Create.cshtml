@model qHRM.Areas.Payroll.Models.HrPrSlryPrcExcld
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
@using (Html.BeginForm("Create", "HrPrSlryPrcExcld"))
{
    <span class="alert-success">
        @Html.ValidationSummary(true)
    </span>
    <div class="dl-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @Html.HiddenFor(model => model.ExcldId)
    </div>
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="EmpSysId" class="control-label"></label>
                <select asp-for="EmpSysId" id="drpEmp" class="form-control form-control-sm select2-dropdown"
                        asp-items="@(new SelectList(ViewBag.lstEmp, "EmpSysId", "EmpDesc"))">
                    <option value="">-- Select Employee --</option>
                </select>
                <span asp-validation-for="EmpSysId" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="StYear" class="control-label"></label>
                <input asp-for="StYear" class="form-control form-control-sm" />
                <span asp-validation-for="StYear" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="StMonth" class="control-label"></label>
                <select asp-for="StMonth" id="drpMonths" class="form-control form-control-sm select2-dropdown"
                        asp-items="@(new SelectList(ViewBag.lstMonths, "Indx", "ElmntTxt"))">
                    <option value="">-- Select Month --</option>
                </select>
                <span asp-validation-for="StMonth" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="NoMnths" class="control-label"></label>
                <input asp-for="NoMnths" class="form-control form-control-sm" />
                <span asp-validation-for="NoMnths" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="Note" class="control-label"></label>
                <input asp-for="Note" class="form-control form-control-sm" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group"></div>

        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}

<script>
    $(function () {
        $('#modalCreate').find('.select2-dropdown').select2({
            theme: 'bootstrap4',
            width: '100%',
            dropdownParent: $('#modalCreate')
        });

        $('#modalCreate').find('.select2-dropdown').on('change', function () {
            try { $(this).valid(); } catch (e) { }
        });
    });
</script>
