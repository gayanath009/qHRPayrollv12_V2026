@model qHRM.Areas.Payroll.Models.HrPrStfLoanPmtExp
@using (Html.BeginForm("CancelExp", "HrPrStfLoanPmt"))
{
    @Html.HiddenFor(model => model.LnPmtExpId)
    @Html.HiddenFor(model => model.StfLnId)
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-12">
                <label class="control-label">Employee</label>
                <input class="form-control form-control-sm" value=" @ViewBag.EmpDtl" readonly />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label class="control-label">Loan Code</label>
                <input class="form-control form-control-sm" value=" @ViewBag.LnCode" readonly />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="EntryDate" class="control-label"></label>
                <input asp-for="EntryDate" class="form-control form-control-sm" readonly />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group  col-md-6">
                <label asp-for="ExpPmtAmt" class="control-label"></label>
                <input asp-for="ExpPmtAmt" id="txtExpPmtAmt" class="form-control form-control-sm" style="text-align:right" readonly/>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group  col-md-6">
                <label asp-for="ExpInstl" class="control-label"></label>
                <input asp-for="ExpInstl" class="form-control form-control-sm" style="text-align:right" readonly/>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="EftYear" class="control-label"></label>
                <input asp-for="EftYear" class="form-control form-control-sm" readonly/>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="EftMonth" class="control-label"></label> 
                <input asp-for="EftMonth" class="form-control form-control-sm" readonly />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="Note" class="control-label"></label>
                <input asp-for="Note" class="form-control form-control-sm" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group"></div>

        <div class="form-group">
            <input type="submit" value="Cancel" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}
