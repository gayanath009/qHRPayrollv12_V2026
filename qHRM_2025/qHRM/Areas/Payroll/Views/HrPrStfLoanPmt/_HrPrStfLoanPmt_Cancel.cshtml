@model qHRM.Areas.Payroll.Models.HrPrStfLoanPmt
@using (Html.BeginForm("Cancel", "HrPrStfLoanPmt"))
{
    @Html.HiddenFor(model => model.LnPmtId)
    @Html.HiddenFor(model => model.StfLnId)
    <div class="card-body">
        <div class="form-row">
            <div class="form-group col-md-12">
                <label class="control-label">Employee</label>
                <input class="form-control form-control-sm" value=" @ViewBag.EmpDtl" readonly />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label class="control-label">Loan Code</label>
                <input class="form-control form-control-sm" value=" @ViewBag.LnCode" readonly />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="PmtDate" class="control-label"></label>
                <input asp-for="PmtDate" class="form-control form-control-sm" readonly/>
                <span asp-validation-for="PmtDate" class="text-danger"></span>
            </div>
            <div class="form-group  col-md-6">
                <label asp-for="PmtAmt" class="control-label"></label>
                <input asp-for="PmtAmt" class="form-control form-control-sm" style="text-align:right" readonly/>
                <span asp-validation-for="PmtAmt" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label class="control-label">Payment Mode</label>
                <input class="form-control form-control-sm" value="Manual" readonly />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-12">
                <label asp-for="Note" class="control-label"></label>
                <input asp-for="Note" class="form-control form-control-sm" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group"></div>

        <div class="form-group">
            <input type="submit" value="Cancel" class="btn btn-sm btn-primary btn-block" />
            <input type="button" value="Back" class="btn btn-sm btn-outline-primary btn-block" data-dismiss="modal" />
        </div>
    </div>
}
