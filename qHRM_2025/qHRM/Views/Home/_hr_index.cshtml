<script type="text/javascript">

    function getSalarySheet() {
        var path = '/attach/slrySheet/';

        var Yr = $("#slryFilterYear").val() || $("#drpYear").val() || new Date().getFullYear();
        var Mnt = $("#slryFilterMonth").val() || $("#drpMonth").val() || (new Date().getMonth() + 1);

        var monthNames = ["", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        var mntName = monthNames[parseInt(Mnt)] || ("Month " + Mnt);

        $("#slrySheetModalTitle").html('<i class="fas fa-file-invoice-dollar mr-2"></i>Salary Sheet - ' + mntName + ' ' + Yr);
        $("#slrySheetLoader").show();
        $("#slrySheetError").hide();
        $("#slrySheetFrameContainer").hide();
        $("#slrySheetDownloadBtn").hide();
        $("#slrySheetNewTabBtn").hide();

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '/Home/PrintSalarySheet',
            dataType: "json",
            data: { eftMnt: Mnt, eftYr: Yr },
            success: function (data) {
                $("#slrySheetLoader").hide();
                if (data && (data.ok === true || data.ok === "true") && data.data && data.data !== "0" && data.data !== 0) {
                    var pdfUrl = path + data.data + "?v=" + new Date().getTime();
                    $("#slrySheetIframe").attr("src", pdfUrl);
                    $("#slrySheetFrameContainer").show();
                    $("#slrySheetDownloadBtn").attr("href", pdfUrl).attr("download", data.data).show();
                    $("#slrySheetNewTabBtn").attr("href", pdfUrl).show();
                    
                    if (typeof toastObj !== 'undefined' && toastObj && typeof toasts !== 'undefined' && toasts[0]) {
                        toastObj.show(toasts[0]);
                    }
                } else {
                    $("#slrySheetErrorTitle").text("No Salary Records Found");
                    $("#slrySheetErrorMsg").text("No salary records are available for " + mntName + " " + Yr + ". Please ensure salary details have been processed or calculated for this month.");
                    $("#slrySheetError").show();
                }
            },
            error: function (xhr, err) {
                $("#slrySheetLoader").hide();
                $("#slrySheetErrorTitle").text("Error Loading Salary Sheet");
                $("#slrySheetErrorMsg").text("Unable to generate the salary sheet report. Please try again.");
                $("#slrySheetError").show();
            }
        });
    }

    function DownloadFile(fileName) {
        var path = '/attach/slrySheet/';
        var dwnurl = path.concat(fileName);
        $.ajax({
            url: dwnurl,
            method: 'GET',
            xhrFields: {
                responseType: 'blob'
            },
            success: function (data) {
                var a = document.createElement('a');
                var url = window.URL.createObjectURL(data);
                a.href = url;
                a.download = fileName;
                document.body.append(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            },
            error: function (xhr, err) {

                toastObj.show(toasts[1]);
            }
        });
    }
</script>

