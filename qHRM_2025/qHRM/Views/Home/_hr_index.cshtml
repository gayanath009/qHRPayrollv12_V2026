<script>
    function queryCellInfo(args) {
        //var args = QueryCellInfoEventArgs;
        var actual = 0;
        var allocated = 0;

        if (args.column.field === 'ActlEmpCnt') {
            actual = args.data['ActlEmpCnt'];
        }
        if (args.column.field === 'AlctdEmpCnt') {
            allocated = args.data["AlctdEmpCnt"]
        }

        if (actual <= allocated) {
            if (args.column.field === 'ActlEmpCnt') {
                args.cell.setAttribute('style', 'background-color:#02a33a ;color:white;');
            }
        }
        else {
            if (args.column.field === 'ActlEmpCnt') {
                args.cell.setAttribute('style', 'background-color:#b80614 ;color:white;');
            }
        }
    }


