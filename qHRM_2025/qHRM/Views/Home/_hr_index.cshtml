<script>

    $(document).ready(function () {
        $("#Slrydwnld").hide();
        onSalaryPeriodChange();
    });

    function onHierarchyEmpChange() {
        var empSysId = $("#ddlHierarchyEmp").val();
        load7DaysAttendance(empSysId);
    }

    function load7DaysAttendance(empSysId) {
        $("#attnRefreshIcon").addClass("fa-spin");
        $.ajax({
            type: "GET",
            url: '/Home/GetEmployee7DayAttendance',
            data: { empSysId: empSysId },
            dataType: "json",
            success: function (res) {
                $("#attnRefreshIcon").removeClass("fa-spin");
                if (res && res.ok && res.data) {
                    var d = res.data;
                    $("#lblAttnDateRange").text(d.dateRangeText || "Recent 7 Days");
                    $("#kpiAttnPresent").text(d.presentDays);
                    $("#kpiAttnAbsent").text(d.absentDays);
                    $("#kpiAttnLate").text(d.lateCount);
                    $("#kpiAttnHours").text(d.totalWorkHoursFormatted || "0h 00m");

                    var tbody = $("#tbody7DaysAttendance");
                    tbody.empty();
                    if (d.days && d.days.length > 0) {
                        $.each(d.days, function (i, day) {
                            var lateHtml = day.lateMinutes > 0 ? ('<span class="text-warning font-weight-bold">' + day.lateMinutes + '</span>') : '<span class="text-muted">-</span>';
                            var earlyHtml = day.earlyLeaveMinutes > 0 ? ('<span class="text-danger">' + day.earlyLeaveMinutes + '</span>') : '<span class="text-muted">-</span>';
                            var otHtml = day.otMinutes > 0 ? ('<span class="text-success font-weight-bold">' + day.otMinutes + '</span>') : '<span class="text-muted">-</span>';

                            var row = '<tr>' +
                                '<td class="text-left pl-3 font-weight-bold text-dark"><span class="text-muted mr-1">' + day.dayName + ',</span> ' + day.dateFormatted + '</td>' +
                                '<td>' + (day.inTime || '--') + '</td>' +
                                '<td>' + (day.outTime || '--') + '</td>' +
                                '<td><span class="badge badge-light border">' + (day.workHours || '--') + '</span></td>' +
                                '<td>' + lateHtml + '</td>' +
                                '<td>' + earlyHtml + '</td>' +
                                '<td>' + otHtml + '</td>' +
                                '<td><span class="badge ' + (day.statusClass || 'badge-secondary') + ' px-2 py-1">' + (day.status || 'Unknown') + '</span></td>' +
                                '</tr>';
                            tbody.append(row);
                        });
                    } else {
                        tbody.append('<tr><td colspan="8" class="text-muted py-3">No attendance records found for this employee.</td></tr>');
                    }
                }
            },
            error: function () {
                $("#attnRefreshIcon").removeClass("fa-spin");
            }
        });
    }

    function onSalaryPeriodChange() {
        var yr = parseInt($("#slryFilterYear").val(), 10) || new Date().getFullYear();
        var mn = parseInt($("#slryFilterMonth").val(), 10) || (new Date().getMonth() + 1);
        var cat = $("#slryFilterCat").val() || "ALL";
        $("#drpYear").val(yr);
        $("#drpMonth").val(mn);
        loadCompanySalarySummary(yr, mn, cat);
    }

    function formatCurrency(num) {
        if (isNaN(num) || num === null || num === undefined) return "0.00";
        return parseFloat(num).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function loadCompanySalarySummary(year, month, staffCat) {
        if (!staffCat) {
            staffCat = $("#slryFilterCat").val() || "ALL";
        }
        $("#slryRefreshIcon").addClass("fa-spin");
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetCompanySalarySummary", "Home")',
            data: { year: year, month: month, staffCat: staffCat },
            dataType: "json",
            success: function (res) {
                $("#slryRefreshIcon").removeClass("fa-spin");
                if (res && res.ok && res.data) {
                    var d = res.data;
                    var s = {
                        year: d.Year !== undefined ? d.Year : d.year,
                        month: d.Month !== undefined ? d.Month : d.month,
                        monthName: d.MonthName !== undefined ? d.MonthName : d.monthName,
                        staffCategory: d.StaffCategory !== undefined ? d.StaffCategory : d.staffCategory,
                        categoryText: d.CategoryText !== undefined ? d.CategoryText : d.categoryText,
                        isProcessed: d.IsProcessed !== undefined ? d.IsProcessed : d.isProcessed,
                        statusText: d.StatusText !== undefined ? d.StatusText : d.statusText,
                        employeeCount: d.EmployeeCount !== undefined ? d.EmployeeCount : (d.employeeCount || 0),
                        totalBasic: parseFloat(d.TotalBasic !== undefined ? d.TotalBasic : d.totalBasic) || 0,
                        totalHousing: parseFloat(d.TotalHousing !== undefined ? d.TotalHousing : d.totalHousing) || 0,
                        totalTransport: parseFloat(d.TotalTransport !== undefined ? d.TotalTransport : d.totalTransport) || 0,
                        totalOtherAllowances: parseFloat(d.TotalOtherAllowances !== undefined ? d.TotalOtherAllowances : d.totalOtherAllowances) || 0,
                        totalOvertime: parseFloat(d.TotalOvertime !== undefined ? d.TotalOvertime : d.totalOvertime) || 0,
                        totalBonus: parseFloat(d.TotalBonus !== undefined ? d.TotalBonus : d.totalBonus) || 0,
                        totalAllowances: parseFloat(d.TotalAllowances !== undefined ? d.TotalAllowances : d.totalAllowances) || 0,
                        totalGross: parseFloat(d.TotalGross !== undefined ? d.TotalGross : d.totalGross) || 0,
                        totalDeductions: parseFloat(d.TotalDeductions !== undefined ? d.TotalDeductions : d.totalDeductions) || 0,
                        totalNet: parseFloat(d.TotalNet !== undefined ? d.TotalNet : d.totalNet) || 0,
                        staffLoan: parseFloat(d.StaffLoan !== undefined ? d.StaffLoan : d.staffLoan) || 0,
                        salaryAdvance: parseFloat(d.SalaryAdvance !== undefined ? d.SalaryAdvance : d.salaryAdvance) || 0,
                        noPay: parseFloat(d.NoPay !== undefined ? d.NoPay : d.noPay) || 0,
                        otherRecoveries: parseFloat(d.OtherRecoveries !== undefined ? d.OtherRecoveries : d.otherRecoveries) || 0
                    };

                    var catLabel = s.categoryText ? (" • " + s.categoryText) : "";
                    $("#lblSlryMonthText").text((s.monthName || "Payroll Overview") + catLabel);

                    if (s.isProcessed) {
                        $("#lblSlryStatusBadge").removeClass("badge-info badge-warning badge-secondary").addClass("badge-success").text(s.statusText || "Processed & Finalized");
                    } else {
                        $("#lblSlryStatusBadge").removeClass("badge-success badge-info badge-warning").addClass("badge-secondary").text(s.statusText || "Not Processed");
                    }

                    $("#valTotalGross").text(formatCurrency(s.totalGross)).addClass("text-primary").attr("style", "color: #540033 !important;");
                    $("#valTotalNet").text(formatCurrency(s.totalNet));
                    $("#valTotalDeductions").text(formatCurrency(s.totalDeductions));
                    $("#valEmployeeCount").text(s.employeeCount || 0);

                    $("#valBasic").text(formatCurrency(s.totalBasic) + " QAR");
                    $("#valHousing").text(formatCurrency(s.totalHousing) + " QAR");
                    $("#valTransport").text(formatCurrency(s.totalTransport) + " QAR");
                    $("#valOtherAlwnc").text(formatCurrency(s.totalOtherAllowances) + " QAR");
                    $("#valOvertimeBonus").text(formatCurrency(s.totalOvertime + s.totalBonus) + " QAR");

                    var gross = s.totalGross;
                    if (gross > 0) {
                        var pBasic = Math.min(100, (s.totalBasic / gross * 100));
                        var pHousing = Math.min(100, (s.totalHousing / gross * 100));
                        var pTransport = Math.min(100, (s.totalTransport / gross * 100));
                        var pOther = Math.min(100, (s.totalOtherAllowances / gross * 100));
                        var pOt = Math.min(100, ((s.totalOvertime + s.totalBonus) / gross * 100));
                        var pDct = Math.min(100, (s.totalDeductions / gross * 100));

                        $("#badgeBasicShare").text("Basic: " + pBasic.toFixed(1) + "%");
                        $("#progBasic").css("width", pBasic + "%");
                        $("#progHousing").css("width", pHousing + "%");
                        $("#progTransport").css("width", pTransport + "%");
                        $("#progOtherAlwnc").css("width", pOther + "%");
                        $("#progOvertimeBonus").css("width", pOt + "%");
                        $("#badgeDeductionShare").text(pDct.toFixed(1) + "% of Gross");
                    } else {
                        $("#badgeBasicShare").text("Basic: 0%");
                        $("#progBasic").css("width", "0%");
                        $("#progHousing").css("width", "0%");
                        $("#progTransport").css("width", "0%");
                        $("#progOtherAlwnc").css("width", "0%");
                        $("#progOvertimeBonus").css("width", "0%");
                        $("#badgeDeductionShare").text("0% of Gross");
                    }

                    $("#valStaffLoan").text(formatCurrency(s.staffLoan) + " QAR");
                    $("#valSalaryAdvance").text(formatCurrency(s.salaryAdvance) + " QAR");
                    $("#valNoPay").text(formatCurrency(s.noPay) + " QAR");
                    $("#valOtherRecoveries").text(formatCurrency(s.otherRecoveries) + " QAR");
                }
            },
            error: function () {
                $("#slryRefreshIcon").removeClass("fa-spin");
            }
        });
    }

    function getSalarySheetFromSection() {
        var yr = $("#slryFilterYear").val();
        var mn = $("#slryFilterMonth").val();
        $("#drpYear").val(yr);
        $("#drpMonth").val(mn);
        getSalarySheet();
    }


