<script type="text/javascript">

    function getSalarySheet() {
        var dwnurl = "";
        var path = '/attach/slrySheet/';

        var Yr = $("#drpYear").val()
        var Mnt = $("#drpMonth").val()
        $.ajax({
            type: "GET", //GET
            contentType: "application/json; charset=utf-8",
            url: '/Home/PrintSalarySheet',
            dataType: "json",
            data: { eftMnt: Mnt, eftYr: Yr },
            success: function (data) {
                //console.log(data);
                if (data.data == 0) {
                    toastObj.show(toasts[2]);
                }
                else {

                    toastObj.show(toasts[0]);
                    DownloadFile(data.data);
                    //Update Download Button href//
                    dwnurl = path.concat(data.data);
                    //alert(dwnurl);
                    $("#Slrydwnld").show();
                    //$("#Slrydwnld").prop("href", dwnurl);

                    $("#Slrydwnld").prop("href", dwnurl);

                }
            },
            error: function (xhr, err) {
                toastObj.show(toasts[1]);
            }
        });
    }

    function DownloadFile(fileName) {
        var path = '/attach/slrySheet/';
        var dwnurl = path.concat(fileName);
        $.ajax({
            url: dwnurl,
            method: 'GET',
            xhrFields: {
                responseType: 'blob'
            },
            success: function (data) {
                var a = document.createElement('a');
                var url = window.URL.createObjectURL(data);
                a.href = url;
                a.download = fileName;
                document.body.append(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            },
            error: function (xhr, err) {

                toastObj.show(toasts[1]);
            }
        });
    }
</script>

