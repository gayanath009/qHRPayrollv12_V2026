                                            <span class="text-success small font-weight-bold text-uppercase">Net Payout</span>
                                            <i class="fas fa-hand-holding-usd text-success" style="font-size: 1.1rem;"></i>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <span class="small font-weight-bold text-success mr-1">QAR</span>
                                            <h4 class="mb-0 font-weight-bold text-success" id="valTotalNet">
                                                @(initSlry != null ? initSlry.TotalNet.ToString("N2") : "0.00")
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
                                    <div class="p-3 rounded border" style="background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-left: 4px solid #dc2626 !important;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-danger small font-weight-bold text-uppercase">Total Deductions</span>
                                            <i class="fas fa-receipt text-danger" style="font-size: 1.1rem;"></i>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <span class="small font-weight-bold text-danger mr-1">QAR</span>
                                            <h4 class="mb-0 font-weight-bold text-danger" id="valTotalDeductions">
                                                @(initSlry != null ? initSlry.TotalDeductions.ToString("N2") : "0.00")
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
                                    <div class="p-3 rounded border" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-left: 4px solid #2563eb !important;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-primary small font-weight-bold text-uppercase">Beneficiaries</span>
                                            <i class="fas fa-users text-primary" style="font-size: 1.1rem;"></i>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <h4 class="mb-0 font-weight-bold text-primary" id="valEmployeeCount">
                                                @(initSlry != null ? initSlry.EmployeeCount.ToString() : "0")
                                            </h4>
                                            <span class="small text-muted ml-1">Staff Members</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Salary Breakdown & Distribution Panels -->
                            <div class="row">
                                <!-- Components Distribution -->
                                <div class="col-12 col-lg-7 mb-3 mb-lg-0">
                                    <div class="p-3 rounded border bg-white h-100">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <span class="font-weight-bold text-dark small text-uppercase"><i class="fas fa-chart-pie mr-1 text-primary"></i>Salary Components Breakdown</span>
                                            <span class="badge badge-light border text-muted" id="badgeBasicShare">
                                                Basic: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalBasic / initSlry.TotalGross * 100).ToString("0.0") : "0")%
                                            </span>
                                        </div>
                                        
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle text-primary mr-1" style="font-size: 0.6rem;"></i><strong>Basic Salary</strong></span>
                                                <span class="font-weight-bold" id="valBasic">@(initSlry != null ? initSlry.TotalBasic.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-primary" id="progBasic" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalBasic / initSlry.TotalGross * 100).ToString("0") : "0")%;"></div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #0d9488; font-size: 0.6rem;"></i><strong>Housing Allowance</strong></span>
                                                <span class="font-weight-bold" id="valHousing">@(initSlry != null ? initSlry.TotalHousing.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progHousing" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalHousing / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #0d9488;"></div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #7c3aed; font-size: 0.6rem;"></i><strong>Transport Allowance</strong></span>
                                                <span class="font-weight-bold" id="valTransport">@(initSlry != null ? initSlry.TotalTransport.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progTransport" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalTransport / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #7c3aed;"></div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #d97706; font-size: 0.6rem;"></i><strong>Other Allowances & Incentives</strong></span>
                                                <span class="font-weight-bold" id="valOtherAlwnc">@(initSlry != null ? initSlry.TotalOtherAllowances.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progOtherAlwnc" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalOtherAllowances / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #d97706;"></div>
                                            </div>
                                        </div>

                                        <div>
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #059669; font-size: 0.6rem;"></i><strong>Overtime & Bonuses</strong></span>
                                                <span class="font-weight-bold" id="valOvertimeBonus">@(initSlry != null ? (initSlry.TotalOvertime + initSlry.TotalBonus).ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progOvertimeBonus" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? ((initSlry.TotalOvertime + initSlry.TotalBonus) / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #059669;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Deductions Breakdown Panel -->
                                <div class="col-12 col-lg-5">
                                    <div class="p-3 rounded border bg-white h-100">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <span class="font-weight-bold text-dark small text-uppercase"><i class="fas fa-file-invoice mr-1 text-danger"></i>Deductions & Recoveries</span>
                                            <span class="badge badge-light border text-danger" id="badgeDeductionShare">
                                                @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalDeductions / initSlry.TotalGross * 100).ToString("0.0") : "0")% of Gross
                                            </span>
                                        </div>

                                        <ul class="list-group list-group-flush small">
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-hand-holding-usd text-muted mr-2"></i>Staff Loan Repayments</span>
                                                <span class="font-weight-bold text-dark" id="valStaffLoan">@(initSlry != null ? initSlry.StaffLoan.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-money-check text-muted mr-2"></i>Salary Advances</span>
                                                <span class="font-weight-bold text-dark" id="valSalaryAdvance">@(initSlry != null ? initSlry.SalaryAdvance.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-user-times text-muted mr-2"></i>No-Pay Deductions</span>
                                                <span class="font-weight-bold text-dark" id="valNoPay">@(initSlry != null ? initSlry.NoPay.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-undo text-muted mr-2"></i>Other Recoveries</span>
                                                <span class="font-weight-bold text-dark" id="valOtherRecoveries">@(initSlry != null ? initSlry.OtherRecoveries.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--Row 3-->
                    <br /><br />
                    <div class="modal fade" id="modalEmpByNtly" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document" style="max-width: 95%; max-height:95%">
