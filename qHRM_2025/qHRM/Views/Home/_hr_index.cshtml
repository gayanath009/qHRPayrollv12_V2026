                                                        <e-grid-column field="Status" headerText="Status" width="60"></e-grid-column>
                                                    </e-grid-columns>
                                                </ejs-grid>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-primary" data-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="modalSlrySheetView" tabindex="-1" role="dialog" aria-labelledby="exampleSlrySheetView" aria-hidden="true">
                        <div class="modal-dialog modal-xl" role="document" style="max-width: 95%; max-height: 95%;">
                            <div class="modal-content" style="border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                                <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; align-items: center;">
                                    <h5 class="modal-title font-weight-bold" id="slrySheetModalTitle" style="color: #540033; font-size: 1.1rem;">
                                        <i class="fas fa-file-invoice-dollar mr-2"></i>Salary Sheet
                                    </h5>
                                    <div class="ml-auto d-flex align-items-center">
                                        <a id="slrySheetDownloadBtn" href="#" download class="btn btn-sm btn-outline-primary mr-2" style="display:none; border-radius: 6px; font-weight: 600;">
                                            <i class="fas fa-download mr-1"></i> Download PDF
                                        </a>
                                        <a id="slrySheetNewTabBtn" href="#" target="_blank" class="btn btn-sm btn-outline-secondary mr-3" style="display:none; border-radius: 6px; font-weight: 600;">
                                            <i class="fas fa-external-link-alt mr-1"></i> Open in New Tab
                                        </a>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="outline: none;">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="modal-body p-3" style="background: #f1f5f9; min-height: 600px;">
                                    <div id="slrySheetLoader" class="text-center py-5">
                                        <div class="spinner-border" role="status" style="width: 3rem; height: 3rem; color: #540033;">
                                            <span class="sr-only">Loading...</span>
                                        </div>
                                        <p class="mt-3 text-muted font-weight-bold" style="font-size: 0.95rem;">Preparing and loading Salary Sheet, please wait...</p>
                                    </div>

                                    <div id="slrySheetError" class="alert alert-warning text-center mx-auto my-5 py-4" style="display:none; max-width: 600px; border-radius: 10px; background: #fffbeb; border-color: #fde68a;">
                                        <i class="fas fa-exclamation-circle fa-2x mb-2 text-warning"></i>
                                        <h6 class="font-weight-bold text-dark" id="slrySheetErrorTitle">No Salary Records Found</h6>
                                        <p class="mb-0 text-muted" id="slrySheetErrorMsg">No salary records are available for the selected month.</p>
                                    </div>

                                    <div id="slrySheetFrameContainer" style="display:none; width: 100%; height: 75vh; min-height: 650px;">
                                        <iframe id="slrySheetIframe" src="" style="width: 100%; height: 100%; border: 1px solid #cbd5e1; border-radius: 8px; background: #ffffff;" frameborder="0"></iframe>
