                                                        <e-grid-column field="FullName" headerText="Full Name" width="125"></e-grid-column>
                                                        <e-grid-column field="DeptName" headerText="Department" width="150"></e-grid-column>
                                                        <e-grid-column field="Grade" headerText="Grade" width="50"></e-grid-column>
                                                        <e-grid-column field="Ex_JoinedDate" headerText="Joined Date" width="50"></e-grid-column>
                                                        <e-grid-column field="Ex_DobTxt" headerText="DOB" width="50"></e-grid-column>
                                                        <e-grid-column field="Ex_Age" headerText="Age" width="50"></e-grid-column>
                                                    </e-grid-columns>
                                                </ejs-grid>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-primary" data-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <!-- Department wise Summary -->
