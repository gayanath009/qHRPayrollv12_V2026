                                                                <e-aggregate-column field="ActlInEmpCnt" type="Sum" footerTemplate="${Sum}"></e-aggregate-column>
                                                                <e-aggregate-column field="ActlOsEmpCnt" type="Sum" footerTemplate="${Sum}"></e-aggregate-column>
                                                            </e-aggregate-columns>
                                                        </e-grid-aggregate>
                                                    </e-grid-aggregates>
                                                    <e-grid-columns>
                                                        <e-grid-column template="#itemTemplate" field="NltyName" headerText="Nationality" width="70" customAttributes=@(new { @class="customcss" })></e-grid-column>
                                                        <e-grid-column field="AlctdEmpCnt" headerText="Allocated" width="40" textAlign="Right" customAttributes=@(new { @class="customcss" })></e-grid-column>
                                                        <e-grid-column field="ActlEmpCnt" headerText="Actual" width="40" textAlign="Right" customAttributes=@(new { @class="customcss" })></e-grid-column>
                                                        <e-grid-column field="ActlInEmpCnt" headerText="In-Hs" width="40" textAlign="Right" customAttributes=@(new { @class="customcss" })></e-grid-column>
                                                        <e-grid-column field="ActlOsEmpCnt" headerText="Out-Src" width="40" textAlign="Right" customAttributes=@(new { @class="customcss" })></e-grid-column>
                                                    </e-grid-columns>
                                                </ejs-grid>
                                            </div>
                                            <div class="form-group col-md-1"></div>
                                        </div>
                                    </div>
                                    <div id="divNltyEmpDtl" style="display:none;">
                                        <div class="form-row">
                                            <div class="form-group col-md-12">
                                                <div class="form-row">
                                                    <div class="form-group col-md-3">
                                                        <button type="button" class="btn btn-outline-primary" onclick="hideNltyEmpDtl()">Back</button>
                                                    </div>
