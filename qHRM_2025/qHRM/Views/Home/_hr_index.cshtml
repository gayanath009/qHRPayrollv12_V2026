                                            @(ViewBag.InitSalarySummary != null ? ((CompanySalarySummaryDto)ViewBag.InitSalarySummary).StatusText : "Not Processed")
                                        </span>
                                    </h6>
                                    <small class="text-muted" id="lblSlryMonthText">
                                        @(ViewBag.InitSalarySummary != null ? (((CompanySalarySummaryDto)ViewBag.InitSalarySummary).MonthName + (!string.IsNullOrEmpty(((CompanySalarySummaryDto)ViewBag.InitSalarySummary).CategoryText) ? " • " + ((CompanySalarySummaryDto)ViewBag.InitSalarySummary).CategoryText : "")) : "Payroll Overview")
                                    </small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center flex-wrap">
                                <label class="mr-2 mb-0 small font-weight-bold text-muted"><i class="fas fa-calendar-alt mr-1"></i>Month:</label>
                                <select id="slryFilterYear" class="form-control form-control-sm mr-1" style="width: 85px; border-radius: 8px; font-weight: 600;" onchange="onSalaryPeriodChange()">
                                    @if (ViewBag.lstYear != null)
                                    {
                                        foreach (var yr in ViewBag.lstYear)
                                        {
                                            <option value="@yr.Value" selected="@(yr.Value.ToString() == ViewBag.DefaultSalaryYear?.ToString() ? "selected" : null)">@yr.Text</option>
                                        }
                                    }
                                </select>
                                <select id="slryFilterMonth" class="form-control form-control-sm mr-2" style="width: 110px; border-radius: 8px; font-weight: 600;" onchange="onSalaryPeriodChange()">
                                    @if (ViewBag.lstMonth != null)
                                    {
                                        foreach (var mn in ViewBag.lstMonth)
                                        {
                                            <option value="@mn.Value" selected="@(mn.Value.ToString() == ViewBag.DefaultSalaryMonth?.ToString() ? "selected" : null)">@mn.Text</option>
                                        }
                                    }
                                </select>
                                <label class="mr-1 mb-0 small font-weight-bold text-muted"><i class="fas fa-users mr-1"></i>Staff:</label>
                                <select id="slryFilterCat" class="form-control form-control-sm mr-2" style="width: 145px; border-radius: 8px; font-weight: 600;" onchange="onSalaryPeriodChange()">
                                    <option value="ALL" selected>All Staff</option>
                                    <option value="OUTSRC">Outsource Staff</option>
                                    <option value="IN_HOUSE">In-House Staff</option>
                                </select>
                                @if ((@HttpContextAccessor.HttpContext.Session.GetInt32("userGrpId") == 1) || (@HttpContextAccessor.HttpContext.Session.GetInt32("userGrpId") == 2) || (@HttpContextAccessor.HttpContext.Session.GetInt32("userGrpId") == 7))
                                {
                                    <button class="btn-brand-maroon-sm mr-1" data-toggle="modal" data-target="#modalSlrySheetView" style="font-size: 0.78rem; padding: 4px 10px;" onclick="getSalarySheetFromSection()">
                                        <i class="fas fa-file-invoice-dollar mr-1"></i> Salary Sheet
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" onclick="onSalaryPeriodChange()" title="Reload Salary Overview" style="border-radius: 8px;">
                                    <i class="fas fa-sync-alt" id="slryRefreshIcon"></i>
                                </button>
                                <!-- Hidden selectors to preserve compatibility with existing modal scripts -->
                                <select id="drpYear" class="d-none" asp-items="@(new SelectList(ViewBag.lstYear, "value", "text"))"></select>
                                <select id="drpMonth" class="d-none" asp-items="@(new SelectList(ViewBag.lstMonth, "value", "text", ViewBag.SelectedMonth))"></select>
                                <a id="Slrydwnld" class="btn" style="display:none"><i class="fa fa-download"></i></a>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            @{
                                var initSlry = (CompanySalarySummaryDto)ViewBag.InitSalarySummary;
                            }
                            <!-- 4 Hero Stat Cards -->
                            <div class="row mb-3">
                                <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
                                    <div class="p-3 rounded border" style="background: linear-gradient(135deg, #fdf4ff 0%, #fae8ff 100%); border-left: 4px solid #540033 !important;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="small font-weight-bold text-uppercase text-primary" style="color: #540033 !important;">Total Gross Salary</span>
                                            <i class="fas fa-coins text-primary" style="color: #540033 !important; font-size: 1.1rem;"></i>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <span class="small font-weight-bold mr-1 text-primary" style="color: #540033 !important;">QAR</span>
                                            <h4 class="mb-0 font-weight-bold text-primary" style="color: #540033 !important;" id="valTotalGross">
                                                @(initSlry != null ? initSlry.TotalGross.ToString("N2") : "0.00")
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
                                    <div class="p-3 rounded border" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 4px solid #059669 !important;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-success small font-weight-bold text-uppercase">Net Payout</span>
                                            <i class="fas fa-hand-holding-usd text-success" style="font-size: 1.1rem;"></i>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <span class="small font-weight-bold text-success mr-1">QAR</span>
                                            <h4 class="mb-0 font-weight-bold text-success" id="valTotalNet">
                                                @(initSlry != null ? initSlry.TotalNet.ToString("N2") : "0.00")
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
                                    <div class="p-3 rounded border" style="background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-left: 4px solid #dc2626 !important;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-danger small font-weight-bold text-uppercase">Total Deductions</span>
                                            <i class="fas fa-receipt text-danger" style="font-size: 1.1rem;"></i>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <span class="small font-weight-bold text-danger mr-1">QAR</span>
                                            <h4 class="mb-0 font-weight-bold text-danger" id="valTotalDeductions">
                                                @(initSlry != null ? initSlry.TotalDeductions.ToString("N2") : "0.00")
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
                                    <div class="p-3 rounded border" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-left: 4px solid #2563eb !important;">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-primary small font-weight-bold text-uppercase">Beneficiaries</span>
                                            <i class="fas fa-users text-primary" style="font-size: 1.1rem;"></i>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <h4 class="mb-0 font-weight-bold text-primary" id="valEmployeeCount">
                                                @(initSlry != null ? initSlry.EmployeeCount.ToString() : "0")
                                            </h4>
                                            <span class="small text-muted ml-1">Staff Members</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Salary Breakdown & Distribution Panels -->
                            <div class="row">
                                <!-- Components Distribution -->
                                <div class="col-12 col-lg-7 mb-3 mb-lg-0">
                                    <div class="p-3 rounded border bg-white h-100">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <span class="font-weight-bold text-dark small text-uppercase"><i class="fas fa-chart-pie mr-1 text-primary"></i>Salary Components Breakdown</span>
                                            <span class="badge badge-light border text-muted" id="badgeBasicShare">
                                                Basic: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalBasic / initSlry.TotalGross * 100).ToString("0.0") : "0")%
                                            </span>
                                        </div>
                                        
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle text-primary mr-1" style="font-size: 0.6rem;"></i><strong>Basic Salary</strong></span>
                                                <span class="font-weight-bold" id="valBasic">@(initSlry != null ? initSlry.TotalBasic.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-primary" id="progBasic" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalBasic / initSlry.TotalGross * 100).ToString("0") : "0")%;"></div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #0d9488; font-size: 0.6rem;"></i><strong>Housing Allowance</strong></span>
                                                <span class="font-weight-bold" id="valHousing">@(initSlry != null ? initSlry.TotalHousing.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progHousing" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalHousing / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #0d9488;"></div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #7c3aed; font-size: 0.6rem;"></i><strong>Transport Allowance</strong></span>
                                                <span class="font-weight-bold" id="valTransport">@(initSlry != null ? initSlry.TotalTransport.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progTransport" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalTransport / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #7c3aed;"></div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #d97706; font-size: 0.6rem;"></i><strong>Other Allowances & Incentives</strong></span>
                                                <span class="font-weight-bold" id="valOtherAlwnc">@(initSlry != null ? initSlry.TotalOtherAllowances.ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progOtherAlwnc" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalOtherAllowances / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #d97706;"></div>
                                            </div>
                                        </div>

                                        <div>
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span><i class="fas fa-circle mr-1" style="color: #059669; font-size: 0.6rem;"></i><strong>Overtime & Bonuses</strong></span>
                                                <span class="font-weight-bold" id="valOvertimeBonus">@(initSlry != null ? (initSlry.TotalOvertime + initSlry.TotalBonus).ToString("N2") : "0.00") QAR</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" id="progOvertimeBonus" role="progressbar" style="width: @(initSlry != null && initSlry.TotalGross > 0 ? ((initSlry.TotalOvertime + initSlry.TotalBonus) / initSlry.TotalGross * 100).ToString("0") : "0")%; background-color: #059669;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Deductions Breakdown Panel -->
                                <div class="col-12 col-lg-5">
                                    <div class="p-3 rounded border bg-white h-100">
                                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                            <span class="font-weight-bold text-dark small text-uppercase"><i class="fas fa-file-invoice mr-1 text-danger"></i>Deductions & Recoveries</span>
                                            <span class="badge badge-light border text-danger" id="badgeDeductionShare">
                                                @(initSlry != null && initSlry.TotalGross > 0 ? (initSlry.TotalDeductions / initSlry.TotalGross * 100).ToString("0.0") : "0")% of Gross
                                            </span>
                                        </div>

                                        <ul class="list-group list-group-flush small">
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-hand-holding-usd text-muted mr-2"></i>Staff Loan Repayments</span>
                                                <span class="font-weight-bold text-dark" id="valStaffLoan">@(initSlry != null ? initSlry.StaffLoan.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-money-check text-muted mr-2"></i>Salary Advances</span>
                                                <span class="font-weight-bold text-dark" id="valSalaryAdvance">@(initSlry != null ? initSlry.SalaryAdvance.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-user-times text-muted mr-2"></i>No-Pay Deductions</span>
                                                <span class="font-weight-bold text-dark" id="valNoPay">@(initSlry != null ? initSlry.NoPay.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                <span><i class="fas fa-undo text-muted mr-2"></i>Other Recoveries</span>
                                                <span class="font-weight-bold text-dark" id="valOtherRecoveries">@(initSlry != null ? initSlry.OtherRecoveries.ToString("N2") : "0.00") QAR</span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Attendance & Cycle Review Section (Cycle Based, All Employees Filter) -->
                    <div class="card shadow-sm mb-4" style="border: 1px solid #e2e8f0; border-radius: 12px;" id="secAttendanceReview">
                        <div class="card-header bg-white py-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between">
                                <!-- Left: Title & Selected Cycle -->
                                <div class="d-flex align-items-center mb-2 mb-xl-0">
                                    <div class="mr-2" style="width: 36px; height: 36px; border-radius: 8px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 1.05rem;">
                                        <i class="fas fa-calendar-check"></i>
                                    </div>
                                    <div>
                                        <h6 class="m-0 font-weight-bold" style="color: #1e293b; font-size: 0.95rem;">
                                            Attendance &amp; Cycle Review
                                            <span class="badge badge-light border text-muted ml-1" style="font-size: 0.72rem; font-weight: 600;">Cycle: 21st – 20th</span>
                                        </h6>
                                        <small class="text-muted" id="cycleRangeLabel">
                                            Selected cycle: <strong>@DateTime.Parse(defCycleFrom).ToString("dd MMM yyyy") – @DateTime.Parse(defCycleTo).ToString("dd MMM yyyy")</strong>
                                        </small>
                                    </div>
                                </div>

                                <!-- Right: Employee Filter, Cycle Navigation, Date Range, & Regularization Hub -->
                                <div class="d-flex align-items-center flex-wrap" style="gap: 8px;">
                                    <!-- Employee Selector (All Employees) -->
                                    <div class="d-inline-flex align-items-center bg-light p-1 rounded border">
                                        <span class="small font-weight-bold text-muted px-1"><i class="fas fa-user mr-1"></i>Employee:</span>
                                        <select id="ddlAttnEmp" class="form-control form-control-sm border-0 bg-white" style="min-width: 220px; max-width: 300px; border-radius: 6px; font-weight: 600; color: #334155;" onchange="onAttnEmpChange();">
                                            @if (ViewBag.lstHierarchyEmployees != null)
                                            {
                                                foreach (var emp in (IEnumerable<HrEmpGen>)ViewBag.lstHierarchyEmployees)
                                                {
                                                    <option value="@emp.ESysId" selected="@(emp.ESysId == selectedEmpSysId ? "selected" : null)">@emp.FulNme</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- Quick Cycle Navigation Buttons -->
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-cycle-nav" onclick="changeCycleOffset(-1);">
                                            <i class="fas fa-chevron-left mr-1"></i> Prev Cycle
                                        </button>
                                        <button type="button" class="btn btn-sm btn-cycle-current active" id="btnCurrentCycle" onclick="changeCycleOffset(0);">
                                            Current Cycle
                                        </button>
                                        <button type="button" class="btn btn-sm btn-cycle-nav" onclick="changeCycleOffset(1);">
                                            Next Cycle <i class="fas fa-chevron-right ml-1"></i>
                                        </button>
                                    </div>

                                    <!-- Date Range Inputs -->
                                    <div class="d-inline-flex align-items-center bg-light p-1 rounded border">
                                        <span class="small font-weight-bold text-muted px-1">From:</span>
                                        <input type="date" id="attnFromDate" class="form-control form-control-sm border-0 bg-white" style="width: 135px; border-radius: 6px; font-weight: 600;" value="@defCycleFrom" />
                                        <span class="small font-weight-bold text-muted px-1">To:</span>
                                        <input type="date" id="attnToDate" class="form-control form-control-sm border-0 bg-white" style="width: 135px; border-radius: 6px; font-weight: 600;" value="@defCycleTo" />
                                        <button class="btn btn-sm btn-primary ml-1" style="border-radius: 6px; padding: 2px 10px; font-size: 0.78rem;" onclick="applyCustomDateRange();" title="Apply Custom Dates">
                                            <i class="fas fa-filter"></i> Apply
                                        </button>
                                    </div>

                                    <!-- Direct Regularization Hub Link -->
                                    <a href="/Attendance/HrEmpAttendExp" class="btn-brand-maroon-sm" title="Attendance Regularization Hub">
                                        <i class="fas fa-business-time mr-1"></i> Regularization Hub
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <!-- KPI Statistics Row (4 Cards) -->
                            <div class="row justify-content-center mb-3" id="attnKpiRow">
                                <div class="col-6 col-sm-6 col-md-3 col-lg-3 mb-2">
                                    <div class="stat-kpi-card">
                                        <div class="stat-kpi-icon" style="background: #ecfdf5; color: #10b981;">
                                            <i class="fas fa-user-check"></i>
                                        </div>
                                        <div>
                                            <div class="stat-kpi-value text-success" id="kpiPresent">@(initAttn?.Last7PresentDays ?? 0)</div>
                                            <div class="stat-kpi-label">Present Days</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-6 col-md-3 col-lg-3 mb-2">
                                    <div class="stat-kpi-card">
                                        <div class="stat-kpi-icon" style="background: #fef2f2; color: #ef4444;">
                                            <i class="fas fa-user-times"></i>
                                        </div>
                                        <div>
                                            <div class="stat-kpi-value text-danger" id="kpiAbsent">@(initAttn?.Last7AbsentDays ?? 0)</div>
                                            <div class="stat-kpi-label">Absent Days</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-6 col-md-3 col-lg-3 mb-2">
                                    <div class="stat-kpi-card">
                                        <div class="stat-kpi-icon" style="background: #fffbeb; color: #f59e0b;">
                                            <i class="fas fa-clock"></i>
                                        </div>
                                        <div>
                                            <div class="stat-kpi-value text-warning" id="kpiLate">@(initAttn?.Last7LateCount ?? 0)</div>
                                            <div class="stat-kpi-label">Late Arrivals</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-6 col-md-3 col-lg-3 mb-2">
                                    <div class="stat-kpi-card">
                                        <div class="stat-kpi-icon" style="background: #eff6ff; color: #3b82f6;">
                                            <i class="fas fa-file-signature"></i>
                                        </div>
                                        <div>
                                            <div class="stat-kpi-value text-primary" id="kpiRegularized">@(initAttn?.Last7RegularizedCount ?? 0)</div>
                                            <div class="stat-kpi-label">Regularized</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- View Mode Filter Bar (Last 7 Days vs Full Cycle) -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <ul class="nav nav-pills attn-pills" id="attnViewModePills">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="btnModeLast7" href="javascript:void(0);" onclick="toggleAttnViewMode('last7');">
                                            <i class="fas fa-calendar-week mr-1"></i> Last 7 Days
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="btnModeFull" href="javascript:void(0);" onclick="toggleAttnViewMode('full');">
                                            <i class="fas fa-list-ul mr-1"></i> Full Cycle (Scrollable)
                                        </a>
                                    </li>
                                </ul>
                                <div class="small text-muted font-italic" id="attnScrollNotice">
                                    <i class="fas fa-arrows-alt-v mr-1"></i> Showing last 7 days of cycle. Switch to "Full Cycle" or scroll to explore all cycle dates.
                                </div>
                            </div>

                            <!-- Scrollable Attendance Table -->
                            <div class="table-responsive rounded border bg-white scrollable-attn-body" id="attnTableContainer">
                                <table class="table dashboard-table mb-0 text-center" id="tblAttendanceCycle">
                                    <thead>
                                        <tr>
                                            <th class="text-left pl-3" style="width: 20%;">DATE &amp; DAY</th>
                                            <th style="width: 12%;">CHECK IN</th>
                                            <th style="width: 12%;">CHECK OUT</th>
                                            <th style="width: 14%;">WORK DURATION</th>
                                            <th style="width: 14%;">STATUS</th>
                                            <th style="width: 14%;">NOTE</th>
                                            <th style="width: 14%;">ACTION</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblAttendanceCycleBody">
                                        @if (initAttn != null && initAttn.Days != null && initAttn.Days.Any())
                                        {
                                            int dayIdx = 0;
                                            foreach (var day in initAttn.Days)
                                            {
                                                dayIdx++;
                                                string rowClass = dayIdx > 7 ? "cycle-past-row d-none" : "cycle-past-row";
                                                <tr class="@rowClass">
                                                    <td class="text-left pl-3 font-weight-bold text-dark">
                                                        @day.DateFormatted
                                                        <span class="badge badge-light border text-muted ml-1" style="font-size: 0.72rem;">@day.DayName</span>
                                                    </td>
                                                    <td>
                                                        <span class="font-weight-bold @(day.InTime != "--" ? "text-dark" : "text-muted")">@day.InTime</span>
                                                    </td>
                                                    <td>
                                                        <span class="font-weight-bold @(day.OutTime != "--" ? "text-dark" : "text-muted")">@day.OutTime</span>
                                                    </td>
                                                    <td class="font-weight-bold text-dark">
                                                        @day.WorkHours
                                                    </td>
                                                    <td>
                                                        <span class="badge @day.StatusClass" style="padding: 0.35rem 0.75rem; font-size: 0.82rem; font-weight: 700; border-radius: 12px;">
                                                            @day.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-muted small" style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@day.Note">
                                                        @(string.IsNullOrEmpty(day.Note) ? "--" : day.Note)
                                                    </td>
                                                    <td>
                                                        @if (day.HasRegularization)
                                                        {
                                                            if (string.Equals(day.RegularizationStatus, "Approved", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <span class="badge badge-light text-success border" style="font-size: 0.74rem;">
                                                                    <i class="fas fa-check-circle mr-1"></i>Approved
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-light text-warning border" style="font-size: 0.74rem;">
                                                                    <i class="fas fa-hourglass-half mr-1"></i>Pending
                                                                </span>
                                                            }
                                                        }
                                                        else if (day.Date == DateTime.Today)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-outline-secondary" disabled style="border-radius: 12px; font-size: 0.75rem; padding: 2px 10px; opacity: 0.5; cursor: not-allowed;" title="Regularization not allowed for today">
                                                                <i class="fas fa-business-time mr-1"></i>Regularize
                                                            </button>
                                                        }
                                                        else if (day.Date.DayOfWeek == DayOfWeek.Friday || day.Date.DayOfWeek == DayOfWeek.Saturday || string.Equals(day.Status, "Weekend", StringComparison.OrdinalIgnoreCase) || string.Equals(day.Status, "Off Day", StringComparison.OrdinalIgnoreCase) || day.IsWeekend)
                                                        {
                                                            <a href="/Attendance/HrEmpAttendExp" class="text-muted" style="font-size: 0.76rem;" title="View in Regularization Hub">
                                                                <i class="fas fa-external-link-alt"></i>
                                                            </a>
                                                        }
                                                        else if (day.Date < DateTime.Today && (day.Status == "Absent" || day.LateMinutes > 0 || day.InTime == "--" || day.OutTime == "--"))
                                                        {
                                                            <a href="/Attendance/HrEmpAttendExp" class="btn btn-xs btn-outline-primary" style="border-radius: 12px; font-size: 0.75rem; padding: 2px 10px; font-weight: 600;" title="Apply Regularization for this date">
                                                                <i class="fas fa-business-time mr-1"></i>Regularize
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="/Attendance/HrEmpAttendExp" class="text-muted" style="font-size: 0.76rem;" title="View in Regularization Hub">
                                                                <i class="fas fa-external-link-alt"></i>
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted">No attendance records found for this period.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
