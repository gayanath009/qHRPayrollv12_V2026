                                        <div class="form-group col-md-6">
                                            <ejs-chart id="chtDlyAtndSmry" title="Last Week Staff Attendance Count" width="120%" pointClick="chtDlyAtndSmryPointClick">
                                                <e-chart-tooltipsettings enable="true">
                                                </e-chart-tooltipsettings>
