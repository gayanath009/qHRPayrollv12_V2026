                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <span class="small font-weight-bold mr-1 text-primary" style="color: #540033 !important;">QAR</span>
                                            <h4 class="mb-0 font-weight-bold text-primary" style="color: #540033 !important;" id="valTotalGross">
                                                @(initSlry != null ? initSlry.TotalGross.ToString("N2") : "0.00")
                                            </h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
