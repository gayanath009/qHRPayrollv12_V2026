    // Attendance Details Functions
    function chtDlyAtndSmryPointClick(args) {
        var gridDayAtndc = document.getElementById('gridDayAtndc').ej2_instances[0];
        var chtDayAttnSmry = document.getElementById('chtDayAttnSmry').ej2_instances[0];
        var divChtDayAtndc = document.getElementById("divChtDayAtndc");

        divChtDayAtndc.style.display = "block";
        divVwDayAtndc.style.display = "block";

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '/Home/GetEmpDlyAttnSmry',
            dataType: "json",
            data: { slctdDate: args.point.x },
            success: function (data) {
                console.log(data);
                chtDayAttnSmry.series[0].dataSource = data.data;
                chtDayAttnSmry.title = "Staff Attendance on " + args.point.x;
                $('#lblAttdChartHeading').text(args.point.x);

            },
            error: function (xhr, err) {

            }
        });

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
