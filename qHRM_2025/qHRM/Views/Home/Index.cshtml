@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor
@{
    string dashBoard = (HttpContextAccessor.HttpContext?.Session?.GetString("userDashboard") ?? "outsource_emp_index.cshtml").Trim();
    if (string.IsNullOrWhiteSpace(dashBoard) || dashBoard == "_emp_index_.cshtml")
    {
        dashBoard = "outsource_emp_index.cshtml";
    }
}
<partial name="~/Views/Home/@dashBoard"/>



