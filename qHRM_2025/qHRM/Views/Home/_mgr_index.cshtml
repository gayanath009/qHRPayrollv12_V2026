<!-- ==================== JAVASCRIPT ==================== -->
<script>
    // =========================================================================
    // ATTENDANCE & CYCLE REVIEW MANAGEMENT (MANAGER & SUBORDINATES)
    // =========================================================================
    var currentCycleOffset = 0;
    var currentViewMode = 'last7';
    var cachedAttendanceDays = @Html.Raw(initAttn != null && initAttn.Days != null ? Newtonsoft.Json.JsonConvert.SerializeObject(initAttn.Days) : "[]");
    var cachedAttendanceSummary = @Html.Raw(initAttn != null ? Newtonsoft.Json.JsonConvert.SerializeObject(initAttn) : "null");

    $(document).ready(function () {
        if ($("#tblAttendanceCycleBody tr").length <= 1 && $("#tblAttendanceCycleBody").text().indexOf("Loading") >= 0) {
            loadAttendanceCycleData();
        }
    });

    function onAttnEmpChange() {
        loadAttendanceCycleData();
    }

    function changeCycleOffset(offsetChange) {
        if (offsetChange === 0) {
            currentCycleOffset = 0;
            $("#btnCurrentCycle").addClass("active");
            $(".btn-cycle-nav").removeClass("active");
        } else {
            currentCycleOffset += offsetChange;
            $("#btnCurrentCycle").removeClass("active");
            $(".btn-cycle-nav").removeClass("active");
        }
        loadAttendanceCycleData();
    }

    function applyCustomDateRange() {
        var fromDate = document.getElementById("attnFromDate").value;
        var toDate = document.getElementById("attnToDate").value;
        if (!fromDate || !toDate) {
            alert("Please select both From and To dates.");
            return;
        }
        $(".btn-cycle-nav, .btn-cycle-current").removeClass("active");
        loadAttendanceCycleData(fromDate, toDate);
    }

    function toggleAttnViewMode(mode) {
        currentViewMode = mode;
        if (mode === 'last7') {
            $("#btnModeLast7").addClass("active");
            $("#btnModeFull").removeClass("active");
            $("#attnScrollNotice").html('<i class="fas fa-calendar-week mr-1"></i> Showing last 7 days of cycle. Switch to "Full Cycle" to view all dates.');
        } else {
            $("#btnModeFull").addClass("active");
            $("#btnModeLast7").removeClass("active");
            $("#attnScrollNotice").html('<i class="fas fa-arrows-alt-v mr-1"></i> Showing full cycle dates. Scroll up/down to inspect past dates.');
        }
        updateAttendanceKpiCards(currentViewMode);
        renderAttendanceRows(cachedAttendanceDays);
    }

    function updateAttendanceKpiCards(mode) {
        var pres = 0, abs = 0, late = 0, reg = 0;

        if (mode === 'last7') {
            if (cachedAttendanceSummary && (cachedAttendanceSummary.Last7PresentDays !== undefined || cachedAttendanceSummary.last7PresentDays !== undefined)) {
                pres = (cachedAttendanceSummary.Last7PresentDays !== undefined) ? cachedAttendanceSummary.Last7PresentDays : cachedAttendanceSummary.last7PresentDays;
                abs = (cachedAttendanceSummary.Last7AbsentDays !== undefined) ? cachedAttendanceSummary.Last7AbsentDays : cachedAttendanceSummary.last7AbsentDays;
                late = (cachedAttendanceSummary.Last7LateCount !== undefined) ? cachedAttendanceSummary.Last7LateCount : cachedAttendanceSummary.last7LateCount;
                reg = (cachedAttendanceSummary.Last7RegularizedCount !== undefined) ? cachedAttendanceSummary.Last7RegularizedCount : cachedAttendanceSummary.last7RegularizedCount;
            } else {
                var days7 = (cachedAttendanceDays || []).slice(0, 7);
                for (var i = 0; i < days7.length; i++) {
                    var d = days7[i];
                    var dStatus = (d.Status || d.status || '').toLowerCase();
                    var dRegStatus = (d.RegularizationStatus || d.regularizationStatus || '').toLowerCase();
                    var dLateMinutes = (d.LateMinutes !== undefined) ? d.LateMinutes : (d.lateMinutes || 0);

                    if (dStatus === 'present' || dStatus === 'regularized' || dStatus === 'checked in') pres++;
                    if (dStatus.indexOf('absent') >= 0) abs++;
                    if (dLateMinutes > 0) late++;
                    if (dStatus === 'regularized' || dRegStatus === 'approved') reg++;
                }
            }
        } else {
            // Full cycle
            if (cachedAttendanceSummary && (cachedAttendanceSummary.PresentDays !== undefined || cachedAttendanceSummary.presentDays !== undefined)) {
                pres = (cachedAttendanceSummary.PresentDays !== undefined) ? cachedAttendanceSummary.PresentDays : cachedAttendanceSummary.presentDays;
                abs = (cachedAttendanceSummary.AbsentDays !== undefined) ? cachedAttendanceSummary.AbsentDays : cachedAttendanceSummary.absentDays;
                late = (cachedAttendanceSummary.LateCount !== undefined) ? cachedAttendanceSummary.LateCount : cachedAttendanceSummary.lateCount;
                reg = (cachedAttendanceSummary.RegularizedCount !== undefined) ? cachedAttendanceSummary.RegularizedCount : cachedAttendanceSummary.regularizedCount;
            } else {
                var days = cachedAttendanceDays || [];
                for (var i = 0; i < days.length; i++) {
                    var d = days[i];
                    var dStatus = (d.Status || d.status || '').toLowerCase();
                    var dRegStatus = (d.RegularizationStatus || d.regularizationStatus || '').toLowerCase();
                    var dLateMinutes = (d.LateMinutes !== undefined) ? d.LateMinutes : (d.lateMinutes || 0);

                    if (dStatus === 'present' || dStatus === 'regularized' || dStatus === 'checked in') pres++;
                    if (dStatus.indexOf('absent') >= 0) abs++;
                    if (dLateMinutes > 0) late++;
                    if (dStatus === 'regularized' || dRegStatus === 'approved') reg++;
                }
            }
        }

        $("#kpiPresent").text(pres);
        $("#kpiAbsent").text(abs);
        $("#kpiLate").text(late);
        $("#kpiRegularized").text(reg);
    }

    function loadAttendanceCycleData(customFrom, customTo) {
        var empEl = document.getElementById("ddlAttnEmp");
        var targetEmpId = (empEl ? parseInt(empEl.value) : 0) || @selectedEmpSysId;
        var params = {
            empSysId: targetEmpId,
            cycleOffset: currentCycleOffset
        };

        if (customFrom && customTo) {
            params.fromDate = customFrom;
            params.toDate = customTo;
            params.cycleOffset = null;
        }

        $("#tblAttendanceCycleBody").html('<tr><td colspan="7" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i> Loading cycle attendance records...</td></tr>');

        $.ajax({
            type: "GET",
            url: "/Home/GetMyAttendanceCycle",
            data: params,
            dataType: "json",
            success: function (res) {
                if (res && (res.ok || res.success) && res.data) {
                    var summary = res.data;
                    var fromD = res.fromDate || res.FromDate;
                    var toD = res.toDate || res.ToDate;
                    if (fromD && toD) {
                        document.getElementById("attnFromDate").value = fromD;
                        document.getElementById("attnToDate").value = toD;
                        $("#cycleRangeLabel").html('Current cycle: <strong>' + formatDatePretty(fromD) + ' – ' + formatDatePretty(toD) + '</strong>');
                    }

                    cachedAttendanceSummary = summary;
                    cachedAttendanceDays = summary.Days || summary.days || [];
                    updateAttendanceKpiCards(currentViewMode);
                    renderAttendanceRows(cachedAttendanceDays);
                } else {
                    $("#tblAttendanceCycleBody").html('<tr><td colspan="7" class="text-center py-4 text-danger">Failed to load attendance records.</td></tr>');
                }
            },
            error: function (xhr, status, error) {
                console.warn("Error fetching cycle attendance: " + error);
                $("#tblAttendanceCycleBody").html('<tr><td colspan="7" class="text-center py-4 text-danger">Error retrieving attendance data.</td></tr>');
            }
        });
    }

    function renderAttendanceRows(days) {
        if (!days || days.length === 0) {
            $("#tblAttendanceCycleBody").html('<tr><td colspan="7" class="text-center py-4 text-muted">No attendance records found for this employee.</td></tr>');
            return;
        }

        var html = '';
        var limit = (currentViewMode === 'last7') ? Math.min(7, days.length) : days.length;
        var today = new Date();
        today.setHours(0,0,0,0);

        for (var i = 0; i < limit; i++) {
            var d = days[i];
            var dDateStr = d.DateFormatted || d.dateFormatted || '';
            var dDayName = d.DayName || d.dayName || '';
            var dIn = d.InTime || d.inTime || '--';
            var dOut = d.OutTime || d.outTime || '--';
            var dHours = d.WorkHours || d.workHours || '0h 00m';
            var dStatus = d.Status || d.status || '--';
            var dStatusClass = d.StatusClass || d.statusClass || 'badge-light text-muted border';
            var dNote = d.Note || d.note || '';
            var dLate = d.LateMinutes || d.lateMinutes || 0;
            var hasReg = d.HasRegularization || d.hasRegularization || false;
            var regStat = d.RegularizationStatus || d.regularizationStatus || '';

            var rowDate = d.Date ? new Date(d.Date) : (d.date ? new Date(d.date) : null);
            var isToday = (d.IsToday !== undefined) ? d.IsToday : ((d.isToday !== undefined) ? d.isToday : false);
            if (!isToday && rowDate) {
                var now = new Date();
                isToday = (rowDate.getFullYear() === now.getFullYear() && rowDate.getMonth() === now.getMonth() && rowDate.getDate() === now.getDate());
            }
            var isWeekend = (d.IsWeekend !== undefined) ? d.IsWeekend : ((d.isWeekend !== undefined) ? d.isWeekend : false);
            if (!isWeekend && rowDate) {
                var dayOfWeek = rowDate.getDay();
                isWeekend = (dayOfWeek === 5 || dayOfWeek === 6); // 5 = Friday, 6 = Saturday
            }
            if (!isWeekend && (dDayName === 'Fri' || dDayName === 'Sat' || dStatus.toLowerCase() === 'weekend' || dStatus.toLowerCase() === 'off day')) {
                isWeekend = true;
            }
            var isPast = !isToday && rowDate && (rowDate < today);

            var actionHtml = '';
            if (hasReg) {
                if ((regStat || '').toLowerCase() === 'approved') {
                    actionHtml = '<span class="badge badge-light text-success border" style="font-size: 0.74rem;"><i class="fas fa-check-circle mr-1"></i>Approved</span>';
                } else {
                    actionHtml = '<span class="badge badge-light text-warning border" style="font-size: 0.74rem;"><i class="fas fa-hourglass-half mr-1"></i>Pending</span>';
                }
            } else if (isToday) {
                actionHtml = '<button type="button" class="btn btn-xs btn-outline-secondary" disabled style="border-radius: 12px; font-size: 0.75rem; padding: 2px 10px; opacity: 0.5; cursor: not-allowed;" title="Regularization not allowed for today"><i class="fas fa-business-time mr-1"></i>Regularize</button>';
            } else if (isWeekend) {
                actionHtml = '<a href="/Attendance/HrEmpAttendExp" class="text-muted" style="font-size: 0.76rem;" title="View in Regularization Hub"><i class="fas fa-external-link-alt"></i></a>';
            } else if (isPast && (dStatus === 'Absent' || dLate > 0 || dIn === '--' || dOut === '--')) {
                actionHtml = '<a href="/Attendance/HrEmpAttendExp" class="btn btn-xs btn-outline-primary" style="border-radius: 12px; font-size: 0.75rem; padding: 2px 10px; font-weight: 600;" title="Apply Regularization"><i class="fas fa-business-time mr-1"></i>Regularize</a>';
            } else {
                actionHtml = '<a href="/Attendance/HrEmpAttendExp" class="text-muted" style="font-size: 0.76rem;" title="View in Regularization Hub"><i class="fas fa-external-link-alt"></i></a>';
            }

            var noteDisplay = dNote ? escapeHtml(dNote) : '--';

            html += '<tr>' +
                '<td class="text-left pl-3 font-weight-bold text-dark">' + escapeHtml(dDateStr) + ' <span class="badge badge-light border text-muted ml-1" style="font-size: 0.72rem;">' + escapeHtml(dDayName) + '</span></td>' +
                '<td><span class="font-weight-bold ' + (dIn !== '--' ? 'text-dark' : 'text-muted') + '">' + escapeHtml(dIn) + '</span></td>' +
                '<td><span class="font-weight-bold ' + (dOut !== '--' ? 'text-dark' : 'text-muted') + '">' + escapeHtml(dOut) + '</span></td>' +
                '<td class="font-weight-bold text-dark">' + escapeHtml(dHours) + '</td>' +
                '<td><span class="badge ' + escapeHtml(dStatusClass) + '" style="padding: 0.35rem 0.75rem; font-size: 0.82rem; font-weight: 700; border-radius: 12px;">' + escapeHtml(dStatus) + '</span></td>' +
                '<td class="text-muted small" style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="' + noteDisplay + '">' + noteDisplay + '</td>' +
                '<td>' + actionHtml + '</td>' +
                '</tr>';
        }

        $("#tblAttendanceCycleBody").html(html);
    }

    function formatDatePretty(dateStr) {
        if (!dateStr) return '';
        var d = new Date(dateStr);
        if (isNaN(d.getTime())) return dateStr;
        return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function escapeHtml(text) {
        if (!text) return '';
        var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.toString().replace(/[&<>"']/g, function(m) { return map[m]; });
    }

    // --- Team Attendance Log Grid & Chart ---
    function toolbarClick(args) {
