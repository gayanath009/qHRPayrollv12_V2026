<!-- ==================== JAVASCRIPT ==================== -->
<script>
    // --- 7-Day Attendance Hierarchy Switcher ---
    function onHierarchyEmpChange() {
        var empSysId = $("#ddlHierarchyEmp").val();
        load7DaysAttendance(empSysId);
    }

    function load7DaysAttendance(empSysId) {
        $("#attnRefreshIcon").addClass("fa-spin");
        $.ajax({
            type: "GET",
            url: '/Home/GetEmployee7DayAttendance',
            data: { empSysId: empSysId },
            dataType: "json",
            success: function (res) {
                $("#attnRefreshIcon").removeClass("fa-spin");
                if (res && res.ok && res.data) {
                    var d = res.data;
                    $("#lblAttnDateRange").text(d.dateRangeText || "Recent 7 Days");
                    $("#kpiAttnPresent").text(d.presentDays);
                    $("#kpiAttnAbsent").text(d.absentDays);
                    $("#kpiAttnLate").text(d.lateCount);
                    $("#kpiAttnHours").text(d.totalWorkHoursFormatted || "0h 00m");

                    var tbody = $("#tbody7DaysAttendance");
                    tbody.empty();
                    if (d.days && d.days.length > 0) {
                        $.each(d.days, function (i, day) {
                            var lateHtml = day.lateMinutes > 0 ? ('<span class="text-warning font-weight-bold">' + day.lateMinutes + '</span>') : '<span class="text-danger" style="font-weight:600;">-</span>';
                            var earlyHtml = day.earlyLeaveMinutes > 0 ? ('<span class="text-danger font-weight-bold">' + day.earlyLeaveMinutes + '</span>') : '<span class="text-danger" style="font-weight:600;">-</span>';
                            var otHtml = day.otMinutes > 0 ? ('<span class="text-success font-weight-bold">' + day.otMinutes + '</span>') : '<span class="text-danger" style="font-weight:600;">-</span>';

                            var row = '<tr>' +
                                '<td class="text-left pl-3 font-weight-bold text-dark"><span class="text-muted mr-1">' + day.dayName + ',</span> ' + day.dateFormatted + '</td>' +
                                '<td>' + (day.inTime && day.inTime !== '--' ? day.inTime : '-') + '</td>' +
                                '<td>' + (day.outTime && day.outTime !== '--' ? day.outTime : '-') + '</td>' +
                                '<td><span class="badge badge-light border">' + (day.workHours || '--') + '</span></td>' +
                                '<td>' + lateHtml + '</td>' +
                                '<td>' + earlyHtml + '</td>' +
                                '<td>' + otHtml + '</td>' +
                                '<td><span class="badge ' + (day.statusClass || 'badge-secondary') + ' px-2 py-1">' + (day.status || 'Unknown') + '</span></td>' +
                                '</tr>';
                            tbody.append(row);
                        });
                    } else {
                        tbody.append('<tr><td colspan="8" class="text-muted py-3">No attendance records found for this employee.</td></tr>');
                    }
                }
            },
            error: function () {
                $("#attnRefreshIcon").removeClass("fa-spin");
            }
        });
    }

    // --- Team Attendance Log Grid & Chart ---
    function toolbarClick(args) {
        var gridObj = document.getElementById("GridAttd").ej2_instances[0];
        if (args.item.id === 'GridAttd_excelexport') {
            gridObj.excelExport();
        }
    }

    function enblDateFltr() {
        var dtFrom = document.getElementById("dtFrom");
        var dtTo = document.getElementById("dtTo");
        dtFrom.disabled = false;
        dtTo.disabled = false;

        var grid = document.getElementById('GridAttd').ej2_instances[0];
        grid.dataSource = null;
        grid.hideSpinner();

        var drpEmp = $("#drpEmp").val();
        var sDateVal = $("#dtFrom").val();
        var eDateVal = $("#dtTo").val();

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: "@(Url.Action("GetAtndcLogs", "Home"))",
            dataType: "json",
            data: { refId: drpEmp, sDate: sDateVal, eDate: eDateVal },
            success: function (data) {
                grid.dataSource = data.data;
                grid.hideSpinner();
            },
            error: function () {
                alert("Grid Error");
            }
        });

        loadAttdSmry("DAILY_SMRY", drpEmp, sDateVal, eDateVal);
    }

    function loadAttdSmry(field, drpEmp, sData, eDate) {
        var chtAtndcSmry = document.getElementById('chtAtndcSmry').ej2_instances[0];
        chtAtndcSmry.series[0].dataSource = null;

        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '/Home/GetAtndcSmry',
            data: { field: field, empId: drpEmp, sDate: sData, eDate: eDate },
            dataType: "json",
            success: function (data) {
                chtAtndcSmry.series[0].dataSource = data.data;
            },
            error: function () {
            }
        });
    }

    // --- Card Controls Modal Scripts ---
    var initialRender = true;
    function OnDataBound() {
        if (initialRender) {
            var summaryCell = this.aggregateModule.footerRenderer.contentTable.querySelector('.e-summarycell');
            if (summaryCell) {
                summaryCell.innerText = "Total Employees";
            }
            initialRender = false;
        }
    }

    function chtEmpByNtlyPointClick(args) {
        var grid = document.getElementById('gridECht').ej2_instances[0];
        var divNltyEmpSmry = document.getElementById("divNltyEmpSmry");
