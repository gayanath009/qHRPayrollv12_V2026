<!-- Modal 3: Last Week Staff Attendance Summary -->
<div class="modal fade" id="modalChtDlyAtndSmry" tabindex="-1" role="dialog" aria-labelledby="exampleChtDlyAtndSmry" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document" style="max-width: 95%; max-height:95%;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" style="color: #1e293b;">Last Week Staff Attendance Count</h5>
