            data: { slctdDate: sDate, status: args.point.x },
            success: function (data) {
                gridDayAtndc.dataSource = data.data;
            },
            error: function () {
            }
        });
    }

    function hideDlyAttd() {
        var divChtDayAtndc = document.getElementById("divChtDayAtndc");
        var divVwDayAtndc = document.getElementById("divVwDayAtndc");
        if (divChtDayAtndc) divChtDayAtndc.style.display = "none";
        if (divVwDayAtndc) divVwDayAtndc.style.display = "none";
    }
</script>
