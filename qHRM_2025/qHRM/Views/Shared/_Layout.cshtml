    <script>

        $(document).ready(function () {
            GetNotifications(); //Push Notification List
            GetNotificationCount(); //Push Notification Count
        });


        function updatePushList() {
            setTimeout(function () {
                GetNotifications()
            }, 6000);

        }


        function updatePushCount() {
            setTimeout(function () {
                GetNotificationCount()
            }, 6000);

        }

        function GetNotifications() {
            $.ajax({
                url: '/Home/GetNotifyList',
                method: 'GET',
                success: function (data) {
                    var items = (data && data.data) ? data.data : [];
                    if (!items || items.length === 0) {
                        $("#notification-content").html(
                            '<div class="text-center py-4 text-muted small">' +
                            '<i class="fas fa-inbox fa-2x mb-2 d-block text-gray-300"></i>' +
                            'No notifications' +
                            '</div>'
                        );
                        return;
                    }

                    var html = '';
                    $.each(items, function (i, obj) {
                        var subj = obj.Subject || obj.subject || 'Notification';
                        var msg = obj.Message || obj.message || '';
                        var reqId = obj.ReqId || obj.reqId || 0;
                        var isRead = (obj.PushReadStat !== undefined && obj.PushReadStat !== null) ? obj.PushReadStat : (obj.pushReadStat || false);
                        var crtDate = obj.CrtDateTime || obj.crtDateTime || '';
                        var timeStr = '';

                        if (crtDate) {
                            try {
                                var d = new Date(crtDate);
                                timeStr = d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            } catch (e) {
                                timeStr = crtDate;
                            }
                        }

                        var targetUrl = (reqId > 0) ? ('/Leave/HrLvRegister/Index?openLvId=' + reqId) : '#';
                        var unreadBg = (!isRead) ? 'background-color: #f8fafc; border-left: 3px solid #540033;' : 'border-left: 3px solid transparent;';
                        var boldClass = (!isRead) ? 'font-weight-bold text-gray-900' : 'text-gray-800';

                        html += '<a class="dropdown-item d-flex align-items-start py-2 px-3 border-bottom" href="' + targetUrl + '" style="' + unreadBg + ' text-decoration: none; white-space: normal; transition: background 0.15s;">' +
                                '  <div class="mr-2 mt-1" style="flex-shrink: 0;">' +
                                '    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: ' + (!isRead ? '#fbeff6' : '#f1f5f9') + '; color: #540033;">' +
                                '      <i class="fas fa-calendar-alt fa-sm"></i>' +
                                '    </div>' +
                                '  </div>' +
                                '  <div style="flex-grow: 1; min-width: 0;">' +
                                '    <div class="' + boldClass + '" style="font-size: 0.82rem; line-height: 1.3; margin-bottom: 2px;">' + subj + '</div>' +
                                '    <div class="text-muted small" style="font-size: 0.75rem; line-height: 1.3; color: #64748b !important;">' + msg + '</div>' +
                                (timeStr ? ('    <div class="text-xs text-muted mt-1" style="font-size: 0.68rem; color: #94a3b8 !important;"><i class="far fa-clock mr-1"></i>' + timeStr + '</div>') : '') +
                                '  </div>' +
                                '</a>';
                    });

                    $("#notification-content").html(html);
                }
            });
            updatePushList();
        }

        function GetNotificationCount() {
            $.ajax({
                url: '/Home/GetNotifyCount',
                method: 'GET',
                success: function (data) {
                    var items = (data && data.data) ? data.data : [];
                    var recCount = items.length;
                    if (recCount > 0) {
                        $("#notification").show().text(recCount > 99 ? '99+' : recCount);
                    } else {
                        $("#notification").hide();
                    }
                }
            });
            updatePushCount();
        }

        function ReadNotifications() {
            $.ajax({
                url: '/Home/ReadNotify',
                method: 'GET',
                success: function (data) {
                    $("#notification").hide();
                }
            });
        }

        $("#sidebarToggle").click(function (e) {
            e.preventDefault();
            $("#accordionSidebar").toggleClass("toggled");
        });

    </script>
