    <!-- Global Fix for Bootstrap Modal + Syncfusion EJ2 Controls -->
    <script>
        // 1. Permanently neutralize Bootstrap's internal modal focus & scrollbar mechanics
        // to stop the 60fps focus-bounce and 17px body shudder with Syncfusion popups
        if (typeof $.fn.modal !== 'undefined' && $.fn.modal.Constructor) {
            $.fn.modal.Constructor.prototype._enforceFocus = function () { };
            $.fn.modal.Constructor.prototype._setScrollbar = function () { };
            $.fn.modal.Constructor.prototype._resetScrollbar = function () { };
            $.fn.modal.Constructor.prototype._checkScrollbar = function () { };
            $.fn.modal.Constructor.prototype._adjustDialog = function () { };
            $.fn.modal.Constructor.prototype._resetAdjustments = function () { };
        }

        // 2. Automatically lift any modal out of parent cards/grids and attach directly to <body>
        // to prevent parent overflow:hidden / z-index / position clipping
        $(document).on('show.bs.modal', '.modal', function () {
            if (!$(this).parent().is('body')) {
                $(this).appendTo('body');
            }
            $(this).removeClass('fade');
        });

        // 3. Unbind any focus trapping and refresh EJ2 controls on modal shown
        $(document).on('shown.bs.modal', '.modal', function () {
            $(document).off('focusin.modal');
            $(document).off('focusin.bs.modal');
            var modalEl = this;
            setTimeout(function () {
                $(modalEl).find('.e-control').each(function () {
                    if (this.ej2_instances && this.ej2_instances.length > 0) {
                        try { this.ej2_instances[0].refresh(); } catch (e) { }
                    }
                });
            }, 50);
        });

        // 4. Global initialization for Select2 Searchable Dropdowns across all pages & modals
        $(function () {
            $('.select2-dropdown').select2({
                theme: 'bootstrap4',
                width: '100%'
            });
        });

        $(document).on('shown.bs.modal', '.modal', function () {
            var $modal = $(this);
            $modal.find('.select2-dropdown').each(function () {
                $(this).select2({
                    theme: 'bootstrap4',
                    width: '100%',
                    dropdownParent: $modal
                });
            });
        });

        $(document).on('shown.bs.collapse shown.bs.tab', function (e) {
            $(e.target).find('.select2-dropdown').each(function () {
                if (!$(this).data('select2')) {
                    $(this).select2({
                        theme: 'bootstrap4',
                        width: '100%'
                    });
                } else {
                    $(this).next('.select2-container').css('width', '100%');
                }
            });
        });
    </script>

